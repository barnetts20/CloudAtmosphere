#pragma once

// ---------------------------------------------------------------------------
// Constants shared by the gas giant material path and the sim compute path.
//
// WHY THIS FILE EXISTS AT ALL.
//
// PI is defined by /Engine/Private/Common.ush. A material Custom node is
// compiled inside MaterialTemplate.ush, which has already included that, so
// anything written for a Custom node gets PI for free and never notices the
// dependency. A global compute shader includes /Engine/Public/Platform.ush and
// does not.
//
// GasGiantJets.ush is now consumed from BOTH contexts, so it inherited an
// ambient definition on one path and lost it on the other the moment it was
// split out of GasGiantFlow.ush. That failed as seven undeclared-identifier
// errors in a file that had not changed.
//
// Pulling Common.ush into the compute path would fix it and is what most
// engine compute shaders do, but it is the wrong fix here: PeriodicNoise.ush
// and NoiseBakeCS.usf are deliberately Platform.ush-only, and Common.ush is a
// large dependency to take on for one constant. It would also be a redundant
// include on the material path.
//
// So: define it, guarded, in one place both sides include. The guard is
// load-bearing rather than defensive -- on the material path Common.ush has
// already defined PI, and this file is included after it.
// ---------------------------------------------------------------------------

#ifndef PI
#define PI 3.1415926535897932f
#endif

// The flow-control attribute macros have the same split as PI, and the same
// fix. GasGiantFlow.ush uses BRANCH; a material Custom node inherits it from
// MaterialTemplate.ush, a Platform.ush-only compute shader may not. Guarded, so
// whichever side already has them keeps its own definition.
//
// The failure without this is an undeclared-identifier error inside an unchanged
// file, reported against the include rather than against the caller that pulled
// it onto a new path.

#ifndef BRANCH
#define BRANCH [branch]
#endif

#ifndef FLATTEN
#define FLATTEN [flatten]
#endif

#ifndef LOOP
#define LOOP [loop]
#endif

#ifndef UNROLL
#define UNROLL [unroll]
#endif

// ---------------------------------------------------------------------------
// Deck shadow map encoding
//
// The map stores the DEPTHS AT WHICH FIXED OPTICAL DEPTHS ARE CROSSED, not the
// optical depth at fixed depths. Inverting it this way places the nodes by
// transmittance rather than by geometry, so they concentrate wherever the deck
// is dense -- which is the top of the density ramp, where view transmittance is
// spent and where a fit anchored at the shell entry is worst.
//
// Depths are offsets from the analytic cull-sphere entry, in atmosphere
// thicknesses. Small, positive, and reconstructible in full precision on the
// reading side, which is what keeps fp16 resolving a fraction of a gradient.
//
// The thresholds are on the FASTEST absorption channel, matching
// GG_SHADOW_SATURATION. Both the bake and the reconstruction read them from
// here; two copies would drift and the shadow would land at the wrong depth.
// ---------------------------------------------------------------------------

#ifndef GG_SHADOW_TAU0
#define GG_SHADOW_TAU0 0.25f
#endif

#ifndef GG_SHADOW_TAU1
#define GG_SHADOW_TAU1 1.0f
#endif

#ifndef GG_SHADOW_TAU2
#define GG_SHADOW_TAU2 3.0f
#endif

/** Written where a threshold is never reached, and where the ray misses the
 *  shell. Far past any real chord, so reconstruction reads zero optical depth
 *  rather than needing a validity test. */
#ifndef GG_SHADOW_NO_DECK
#define GG_SHADOW_NO_DECK 1000.0f
#endif
