#pragma once

#include "/Plugin/CloudAtmosphere/Private/AtmosphereTypes.ush"
#include "/Plugin/CloudAtmosphere/Private/AtmospherePlan.ush"
#include "/Plugin/CloudAtmosphere/Private/AtmosphereSetup.ush"
#include "/Plugin/CloudAtmosphere/Private/TerrestrialDeck.ush"
#include "/Plugin/CloudAtmosphere/Private/TerrestrialShadow.ush"

// The cloud field's side of the march, every model's: the slab over an opaque
// planet, the deep deck (TR_DEEP_DECK) with no surface, which saturates and
// stops where it provably has, and air alone (ATMO_FIELD_CLOUDS 0), with no
// cloud band. The march sees only the Field_ functions, the FieldParams and
// FieldMaterialParams names and the two texture macros defined here, so this
// is included before it.

/** Optical depth at which the deep deck's shadow read stops growing, on its
 *  most transmissive term (see ATMO_SHADOW_SATURATION): about 1e-7. The slab's 5
 *  leaves the octaves a percent of the sun at any depth. */
#ifndef TR_DEEP_SHADOW_SATURATION
#define TR_DEEP_SHADOW_SATURATION 16.0f
#endif

/** The diffuse light's decay per optical depth of deck above it is
 *  sqrt(3 (1 - albedo)(1 - g)). This is g, the effective anisotropy; the
 *  absorption is floored at DeepDarkening so a white deck still darkens. */
#ifndef TR_DEEP_DIFFUSE_G
#define TR_DEEP_DIFFUSE_G 0.5f
#endif

/** 0 for air alone: the march compiles no cloud path. */
#ifndef ATMO_FIELD_CLOUDS
#define ATMO_FIELD_CLOUDS 1
#endif

/** Claims the march's field slot; the march fails to compile without it. */
#define ATMO_FIELD_INCLUDED 1

/** The field's types under the march's names. PITFALL: neither may shadow a
 *  type the shared headers declare; the collision fails far from here. */
#define FieldParams TRFieldParams
#define FieldMaterialParams TRScatterParams

/** The field's textures, as a declaration and as a forwarding list, since HLSL
 *  holds no texture in a struct. PITFALL: the two must stay in step, or the
 *  march fails on an argument count far from any texture. */
#define FIELD_TEXTURE_DECL \
	Texture2DArray FlowField, \
	SamplerState FlowSampler, \
	Texture3D DetailVolume, \
	SamplerState DetailSampler, \
	Texture3D StructureVolume, \
	SamplerState StructureSampler

#define FIELD_TEXTURE_ARGS \
	FlowField, FlowSampler, DetailVolume, DetailSampler, StructureVolume, StructureSampler

/** The clouds' material and how they are lit. Fair-weather cloud and storm
 *  cloud, blended by the column's material coordinate, which follows the sim's
 *  storm; under the deep deck a third set takes over the buried interior
 *  (TR_DeepMaterialWeight). A material is float2(coordinate, deep share).
 *
 *  Scatter     Single-scattering albedo: what fraction of extinction is
 *              scattered rather than absorbed, per channel.
 *  Extinction  rgb tint, amount in a: a MULTIPLIER on the solved extinction,
 *              1 neutral. */
struct TRScatterParams
{
    float3 CloudScatter;
    float3 StormScatter;

    float4 CloudExtinction;
    float4 StormExtinction;

    float3 DeepScatter;
    float4 DeepExtinction;

	/** The depth below the base the deep material takes over across. */
    float4 DeepMaterial;

	/** TR_MaterialTintRange of the tints: (smallest, largest). */
    float2 TintRange;

	/** Dual-lobe phase: forward g, backward g magnitude, forward share. */
    float ForwardG;
    float BackwardG;
    float ForwardWeight;

	/** Octave i sees the optical depth toward the light scaled by
	 *  OctaveAttenuation^i, weighs the same power, and uses the phase with both
	 *  lobes' g scaled by OctaveEccentricity^i. Octave 0 is single scattering.
	 *  OctaveCount is whole and in [1, ATMO_MS_MAX_OCTAVES]. */
    float OctaveCount;
    float OctaveAttenuation;
    float OctaveEccentricity;

	/** Width of the ambient terminator, in cosine of sun elevation. */
    float AmbientTerminator;

	/** How fast the Mie forward lobe dies behind cloud, per optical depth. */
    float MieLobeDecay;
};

/** A sample's material: its coordinate, and under the deep deck the deep
 *  share its depth below the base (Sample.w) gives. */
float2 TR_SampleMaterial(float4 Sample, TRScatterParams S)
{
#if TR_DEEP_DECK
    return float2(Sample.y, TR_DeepMaterialWeight(Sample.w, S.DeepMaterial));
#else
    return float2(Sample.y, 0.0f);
#endif
}

/** Albedo of a material. */
float3 TR_TypeScatter(float2 Material, TRScatterParams S)
{
    const float3 Scatter = lerp(S.CloudScatter, S.StormScatter, saturate(Material.x));

#if TR_DEEP_DECK
    return lerp(Scatter, S.DeepScatter, Material.y);
#else
    return Scatter;
#endif
}

/** Extinction multiplier of a material, tint times amount: what the view ray
 *  applies to the solved coefficient. */
float3 TR_TypeExtinction(float2 Material, TRScatterParams S)
{
    const float3 Extinction = lerp(S.CloudExtinction.rgb * S.CloudExtinction.a,
		S.StormExtinction.rgb * S.StormExtinction.a, saturate(Material.x));

#if TR_DEEP_DECK
    return lerp(Extinction, S.DeepExtinction.rgb * S.DeepExtinction.a, Material.y);
#else
    return Extinction;
#endif
}

/** Extinction tint alone of a material. The light ray's amounts are already
 *  in the shadow map's depth; its colour is applied where the depth is read. */
float3 TR_TypeTint(float2 Material, TRScatterParams S)
{
    const float3 Tint = lerp(S.CloudExtinction.rgb, S.StormExtinction.rgb, saturate(Material.x));

#if TR_DEEP_DECK
    return lerp(Tint, S.DeepExtinction.rgb, Material.y);
#else
    return Tint;
#endif
}

/** Whether a planned segment carries cloud: the band, and under the deep deck
 *  whatever lies below it.
 *
 *  THE FLAG ALONE ON THE SLAB, BECAUSE THE BAND IS BOUNDED BOTH WAYS.
 *  cloudInnerRadius is the lowest the base can fall, so below it there is no
 *  cloud to miss -- and above the top the same. Marching either as cloud would
 *  spend the field's fetches on provably empty air, which on a grazing ray is
 *  the longest span on the ray. */
bool Field_SegmentIsCloud(float3 Origin, float3 Dir, float3 Segment, PlanetParams Planet)
{
#if !ATMO_FIELD_CLOUDS
    return false;
#elif TR_DEEP_DECK
	// Under the band the deep deck is full and still owes extinction.
    const float3 Mid = Origin + Dir * ((Segment.x + Segment.y) * 0.5f);

    return Segment.z > 0.5f || length(Mid - Planet.planetPos) < Planet.cloudInnerRadius;
#else
    return Segment.z > 0.5f;
#endif
}

/** Fills TRScatterParams from the Material, Deep, Phase and Multiple
 *  Scattering groups, Ambient's AmbientTerminator and Air's MieLobeDecay. Set
 *  the cloud and storm sets equal for a single material. */
TRScatterParams TR_BuildScatter(
	float3 CloudScatter,
	float4 CloudExtinction,
	float3 StormScatter,
	float4 StormExtinction,
	float StormBalance,
	float3 DeepScatter,
	float4 DeepExtinction,
	float4 DeepMaterial,
	float ForwardG,
	float BackwardG,
	float ForwardWeight,
	float OctaveCount,
	float OctaveAttenuation,
	float OctaveEccentricity,
	float AmbientTerminator,
	float MieLobeDecay)
{
    TRScatterParams S;

    S.CloudScatter = CloudScatter;
    S.StormScatter = StormScatter;

    S.CloudExtinction = CloudExtinction;
    S.StormExtinction = StormExtinction;
    S.DeepScatter = DeepScatter;
    S.DeepExtinction = DeepExtinction;
    S.DeepMaterial = DeepMaterial;
    S.TintRange = TR_MaterialTintRange(
		CloudExtinction.rgb, StormExtinction.rgb, DeepExtinction.rgb, StormBalance);

    S.ForwardG = ForwardG;
    S.BackwardG = BackwardG;
    S.ForwardWeight = ForwardWeight;

    S.OctaveCount = clamp(round(OctaveCount), 1.0f, float(ATMO_MS_MAX_OCTAVES));
    S.OctaveAttenuation = saturate(OctaveAttenuation);
    S.OctaveEccentricity = saturate(OctaveEccentricity);

	// Floored where zero is degenerate: the width divides a smoothstep's.
    S.AmbientTerminator = max(AmbientTerminator, 1e-4f);
    S.MieLobeDecay = max(MieLobeDecay, 0.0f);

    return S;
}

/** TR_BuildScatter from the pass's uniforms, which carry exactly these names;
 *  StormBalance is CloudResponse.z, as TR_BuildField unpacks it. */
#define TR_BUILD_SCATTER() TR_BuildScatter( \
	CloudScatter, CloudExtinction, StormScatter, StormExtinction, CloudResponse.z, \
	DeepScatter, DeepExtinction, DeepMaterial, \
	ForwardG, BackwardG, ForwardWeight, \
	OctaveCount, OctaveAttenuation, OctaveEccentricity, \
	AmbientTerminator, MieLobeDecay)

/** Fills CompositeParams for the field. The cloud radii come from the field:
 *  the highest a top reaches and the lowest a base falls, so the fine band is
 *  exactly the span that can hold cloud. The extinction is solved, grey, by
 *  TR_CloudBeta, as the bake solves it. PITFALL: cloudScatBeta and cloudAbsBeta
 *  are not a scattering/absorption split: the first is the view ray's whole
 *  coefficient, the second LightExtinctionFraction of it, for the light. */
CompositeParams TR_BuildAtmo(
	float2 SvPosition,
	float3 RayDir,
	float3 PlanetOffset,
	float SceneDepth,
	float3 LightDirection,
	float3 LightColor,
	float3 RayleighBeta,
	float RayleighScaleHeight,
	float3 MieBeta,
	float MieScaleHeight,
	float MieG,
	float3 AbsorptionBeta,
	float AbsorptionAltitude,
	float AbsorptionFalloff,
	float3 AtmosphereAmbient,
	float AtmosphereAmbientFloor,
	float CloudOpticalDepth,
	float LightExtinctionFraction,
	float3 CloudAmbient,
	float CloudAmbientFloor,
	float AtmosphereSteps,
	float CloudSteps,
	float ChordSpread,
	float4 SurfaceShadow,
	TRFieldParams F)
{
	// The field-wide reach, not this camera's, or the step lattice moves with it:
	// the radius the shadow map covers.
#if ATMO_FIELD_CLOUDS
    const float CloudOuter = TR_ShadowCullRadius(F);
#else
    const float CloudOuter = F.PlanetRadius;
#endif

	// The band is geometric, not optical, so retuning the opacity moves no
	// step; held at the surface, where the planet cuts the ray anyway.
#if !ATMO_FIELD_CLOUDS
	// No band: both radii at the surface, where the ray stops anyway.
    const float CloudInner = F.PlanetRadius;
#elif TR_DEEP_DECK
	// The deep deck's band ends where every column is full: below it nothing
	// varies, and coarse steps saturate. Held off the centre, which the band may
	// reach on a deep fill.
    const float CloudInner = max(F.PlanetRadius + F.Thickness * TR_DeckFull(F), 0.1f * F.PlanetRadius);
#else
    const float CloudInner = max(
		F.PlanetRadius + F.Thickness * TR_BaseMin(F),
		F.PlanetRadius);
#endif

	// Grey: the material's tint and amount are applied per sample from
	// TRScatterParams, on the view ray and at the light ray's receiver.
#if ATMO_FIELD_CLOUDS
    const float3 CloudScatterBeta = TR_CloudBeta(F, CloudOpticalDepth).xxx;
#else
    const float3 CloudScatterBeta = float3(0.0f, 0.0f, 0.0f);
#endif

    CompositeParams Params = Atmo_BuildParams(
		SvPosition, RayDir, PlanetOffset,
		F.PlanetRadius, F.PlanetRadius + F.Thickness, CloudOuter, CloudInner,
		SceneDepth, LightDirection, LightColor,
		float4(RayleighBeta, RayleighScaleHeight),
		float4(MieBeta, MieScaleHeight),
		float4(AbsorptionBeta, AbsorptionAltitude),
		AbsorptionFalloff,
		float4(AtmosphereAmbient, AtmosphereAmbientFloor), MieG,
		CloudScatterBeta, CloudScatterBeta * LightExtinctionFraction,
		float4(CloudAmbient, CloudAmbientFloor),
		(int) AtmosphereSteps, (int) CloudSteps,
		ChordSpread);

	// ONE PIN FOR THE GROUP'S SCALARS, Z FREE, matching how the field's packed
	// pins travel. FAtmosphereSurfaceShadowParams::Pack writes this layout and
	// nothing checks that the two still agree.
    Params.surfaceShadowParams.enabled = SurfaceShadow.x;
    Params.surfaceShadowParams.directFraction = saturate(SurfaceShadow.y);
    Params.surfaceShadowParams.strength = max(SurfaceShadow.w, 0.0f);

    return Params;
}

/** TR_BuildAtmo from the pass's uniforms, which carry exactly these names. The
 *  per-pixel terms, and the field, arrive as arguments. PlanetOffset is the
 *  planet's centre less the view's camera, formed in double before it is
 *  bound. */
#define TR_BUILD_ATMO(SvPosition, RayDir, SceneRayDistance, F) TR_BuildAtmo( \
	SvPosition, RayDir, PlanetOffset, SceneRayDistance, \
	LightDirection, LightColor, \
	RayleighBeta, RayleighScaleHeight, MieBeta, MieScaleHeight, MieG, \
	AbsorptionBeta, AbsorptionAltitude, AbsorptionFalloff, \
	AtmosphereAmbient, AtmosphereAmbientFloor, \
	CloudOpticalDepth, LightExtinctionFraction, CloudAmbient, CloudAmbientFloor, \
	AtmosphereSteps, CloudSteps, ChordSpread, SurfaceShadow, F)

// ---------------------------------------------------------------------------
// The march's hooks
// ---------------------------------------------------------------------------

/** Whether an opaque terminus is the field itself, moving with it: the deep
 *  deck's is; the slab's is the planet. */
bool Field_TerminusIsField()
{
    return TR_DEEP_DECK != 0;
}

/** Where the view ray stops, and whether it is opaque there. The slab's planet
 *  is a surface, so the sphere clips the ray, but only over sky. PITFALL:
 *  clipped where geometry was drawn, geometry below the sphere (a crater, a sea
 *  floor) draws as in-scatter over black.
 *
 *  The deep deck stops at a radius TR_DEEP_OPAQUE_DEPTH optical depths below
 *  where every column is full. PITFALL: a long step through saturated deck
 *  instead takes one shadowed light read, and the in-scatter vanishes in a
 *  ring. */
void Field_Terminus(
	float3 Origin,
	float3 Dir,
	CompositeParams Atmo,
	FieldParams F,
	FieldMaterialParams S,
	out float OutMaxDist,
	out bool OutOpaque)
{
    OutMaxDist = Atmo.mainRayParams.sceneDepth;
    OutOpaque = false;

#if TR_DEEP_DECK
	// Counted down from where the deck is full, against the least extinction
	// any material in use has, in atmosphere thicknesses.
    const float BetaMin = Atmo.cloudParams.cloudScatBeta.x * F.Thickness
		* TR_MaterialLeastExtinction(S.CloudExtinction, S.StormExtinction, S.DeepExtinction, F.StormBalance);

    const float Radius = TR_DeepTerminusRadius(F, BetaMin);

    if (Radius <= 0.0f)
    {
        return;
    }
#else
    if (OutMaxDist < ATMO_NO_OCCLUDER_DISTANCE)
    {
        return;
    }

    const float Radius = F.PlanetRadius;
#endif

    const float2 Hit = Atmo_RaySphere(Origin, Dir, Atmo.planetParams.planetPos, Radius);

    if (Hit.x > 0.0f && Hit.x < OutMaxDist)
    {
        OutMaxDist = Hit.x;
        OutOpaque = true;
    }
}

/** Density and material at a planet-local point, as (density, material,
 *  pressure or buried deck, depth below the base); see TR_Density. StepHalfHeight is the sample's own
 *  half-extent along the radius, which the field integrates its height profile
 *  across.
 *
 *  THE SAMPLE IS OPAQUE TO THE MARCH beyond its density. It carries it from here
 *  to Field_Albedo and Field_Extinction without interpreting it. */
float4 Field_Sample(
	FIELD_TEXTURE_DECL,
	float3 LocalPos,
	float StepHalfHeight,
	FieldParams F)
{
    return TR_Density(
		FlowField, FlowSampler, DetailVolume, DetailSampler,
		StructureVolume, StructureSampler, LocalPos, StepHalfHeight, F);
}

/** Single-scattering albedo of a sample's material. */
float3 Field_Albedo(float4 Sample, FieldMaterialParams S)
{
    return TR_TypeScatter(TR_SampleMaterial(Sample, S), S);
}

/** Extinction multiplier the VIEW ray applies, tint times amount. */
float3 Field_Extinction(float4 Sample, FieldMaterialParams S)
{
    return TR_TypeExtinction(TR_SampleMaterial(Sample, S), S);
}

/** Share of the sky's ambient light that reaches a sample, per channel: 1
 *  outside cloud, where Sample is zero.
 *
 *  THE DEEP DECK BURIES IT. Diffuse light decays through thick scattering
 *  cloud as exp(-sqrt(3 (1 - albedo)(1 - g)) tau), tau the deck above the
 *  sample (TR_DeepBuried); the channels the material absorbs most go dark
 *  first. The air's ambient takes the same share. The cloud above the base
 *  lets it all through, as the slab does. */
float3 Field_AmbientShare(float4 Sample, float3 Albedo, CompositeParams Atmo, FieldParams F,
	FieldMaterialParams S)
{
#if TR_DEEP_DECK
    const float3 Tau = Atmo.cloudParams.cloudScatBeta * Field_Extinction(Sample, S)
		* (F.Thickness * Sample.z);

    const float3 Decay = sqrt(3.0f * max(1.0f - Albedo, F.DeepDarkening)
		* (1.0f - TR_DEEP_DIFFUSE_G));

    return exp(-Decay * Tau);
#else
    return float3(1.0f, 1.0f, 1.0f);
#endif
}

/** Air densities at Height above the surface, as (rayleigh, mie, absorber).
 *
 *  THE SLAB'S AIR ENDS AT THE SURFACE; the deep deck's goes on below it, held
 *  at the surface's density, since the surface there is only the coordinate
 *  origin. PITFALL: cut off at the surface under the deep deck, the air's
 *  in-scatter and extinction step from their maximum to zero across a sphere,
 *  which a camera near it sees as a hard line. Not extrapolated: the profile
 *  grows without bound below zero. */
float3 Field_AirDensity(float Height, CompositeParams Atmo)
{
#if TR_DEEP_DECK
    return Atmo_Density(max(Height, 0.0f),
		Atmo.scatteringParams.rayScaleH, Atmo.scatteringParams.mieScaleH,
		Atmo.scatteringParams.absHeight, Atmo.scatteringParams.absFalloff);
#else
    return (Height > 0.0f)
		? Atmo_Density(Height,
			Atmo.scatteringParams.rayScaleH, Atmo.scatteringParams.mieScaleH,
			Atmo.scatteringParams.absHeight, Atmo.scatteringParams.absFalloff)
		: float3(0.0f, 0.0f, 0.0f);
#endif
}

/** The light path's air below the surface, where the transmittance table does
 *  not reach: R and Mu, a world radius and the light's cosine, move to where
 *  the path leaves the surface sphere, and the density integral of the part
 *  below, at the surface's density, is returned. Zero for the slab, whose air
 *  ends at the surface. PITFALL: read at the sample's own radius, the table
 *  lights buried air as if at the surface, and deep hollows brighten with
 *  depth. */
float3 Field_AirBuried(float3 FromCentre, float3 LightDir, CompositeParams Atmo, inout float R, inout float Mu)
{
#if TR_DEEP_DECK
    const float Radius = Atmo.planetParams.planetRadius;
    const float Inside = R * R - Radius * Radius;

    if (Inside >= 0.0f)
    {
        return float3(0.0f, 0.0f, 0.0f);
    }

    const float Along = R * Mu;
    const float Length = sqrt(Along * Along - Inside) - Along;

    R = Radius;
    Mu = dot(FromCentre + LightDir * Length, LightDir) / max(Radius, 1e-4f);

    return Length * Field_AirDensity(0.0f, Atmo);
#else
    return float3(0.0f, 0.0f, 0.0f);
#endif
}

/** Optical depth at which the shadow read stops growing, on its most
 *  transmissive term. */
float Field_ShadowSaturation()
{
#if TR_DEEP_DECK
    return TR_DEEP_SHADOW_SATURATION;
#else
    return ATMO_SHADOW_SATURATION;
#endif
}

/** Extinction TINT at a receiver, the light ray's amounts already being in the
 *  shadow map. One coarse column read, paid only where the map shadows at all.
 *
 *  THE RECEIVER'S OWN MATERIAL COLOURS WHAT SHADOWED IT. The map holds one
 *  depth, not the colours of everything the light crossed, and weather systems
 *  are far wider than the cloud is deep, so the path stays mostly in the
 *  receiver's material. Off at a system's edge at low sun. Read from the
 *  weather alone, so without the deep share. */
float3 Field_LightTint(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	float3 LocalPos,
	FieldParams F,
	FieldMaterialParams S)
{
    return TR_TypeTint(float2(TR_TypeCoarse(FlowField, FlowSampler, LocalPos, F), 0.0f), S);
}

/** Field_LightTint from a sample already taken at the receiver, its deep
 *  share included: no second column. */
float3 Field_SampleLightTint(float4 Sample, FieldMaterialParams S)
{
    return TR_TypeTint(TR_SampleMaterial(Sample, S), S);
}

/** The tint to fall back on where nothing shadowed the receiver, so the branch
 *  above is skipped rather than taken with a null result. */
float3 Field_NeutralTint(FieldMaterialParams S)
{
    return S.CloudExtinction.rgb;
}

/** The map's geometry for this field. */
AtmoShadowFrame Field_ShadowFrame(FieldParams F)
{
    return TR_ShadowFrame(F);
}

/** What the bake folded into the map's depths, for the reader to divide back
 *  out: the light coefficient times the largest tint channel in use.
 *
 *  AND THE SMALLEST, as the second channel. The caller exponentiates the depth
 *  at the receiver's tint over the largest, so the ceiling has to be set
 *  against the most transmissive term or saturated cloud glows through it. */
float2 Field_FoldConstant(CompositeParams Atmo, FieldMaterialParams S)
{
    return float2(Atmo.cloudParams.cloudAbsBeta.x * S.TintRange.y,
		S.TintRange.x / max(S.TintRange.y, 1e-8f));
}
