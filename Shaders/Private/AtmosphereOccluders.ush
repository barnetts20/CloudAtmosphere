#pragma once

// Opaque-geometry occlusion for a light-space bake, as one scalar per ray.
// Model-independent: no field header, so both bakes include it unchanged.
//
// A CAPTURE IS SELF-DESCRIBING. Everything needed to project into it travels in
// AtmoOccluderFrame, so the bake never assumes a capture shares a cascade's
// basis, extent or centre. Matching them makes the resample an identity;
// mismatching costs resolution, never placement.
//
// THE DEPTH IS LINEAR AND ORTHOGRAPHIC -- distance from the capture plane along
// the direction light travels. PITFALL: the engine's PERSPECTIVE device-Z
// conversion subtracts an epsilon that saturates depth at planetary range (half
// the true distance at 1000 km). The orthographic conversion carries no such
// term, so a capture left perspective inherits that error silently.

/** No occluder. Finite rather than infinite: it passes through the bake's min()
 *  and world-unit clamps as an ordinary number. */
#define ATMO_OCC_NO_HIT 3.402823e+38f

/** Lateral taps per ray. Sets how many steps the soft edge has: the boundary
 *  texels report a fraction of this, and the reader's bilinear blend smooths
 *  between them. Eight is enough for a footprint of a texel or two; a wider one
 *  bands without more. */
#ifndef ATMO_OCC_SUBSAMPLES
#define ATMO_OCC_SUBSAMPLES 8
#endif

/** Unit-disc offsets, scaled to texels by the caller's footprint radius. A
 *  SPIRAL RATHER THAN A GRID because the footprint is a disc at any radius past
 *  one texel, where a grid's rows print as bands along the edge.
 *
 *  COVERAGE, NOT A MINIMUM. The fraction of taps that hit is how far the node
 *  clamp is applied, so a silhouette crossing the footprint gives a graded edge.
 *  Taking the minimum instead would dilate the occluder and leave the edge as
 *  hard as it was, only bigger. The nearest hit still sets the DEPTH, which
 *  keeps the umbra where the blocker is. */
static const float2 AtmoOcc_SubOffsets[8] =
{
    float2(0.2500f, 0.0000f),
    float2(-0.3193f, 0.2925f),
    float2(0.0490f, -0.5568f),
    float2(0.4026f, 0.5248f),
    float2(-0.7386f, -0.1307f),
    float2(0.6993f, -0.4455f),
    float2(-0.2334f, 0.8708f),
    float2(-0.4458f, -0.8595f),
};

/** One capture's placement, planet-local, in world units.
 *
 *  U AND V ARE THE IMAGE'S OWN AXES -- right and up, read off the capture
 *  component's transform rather than rebuilt from the light, so a mirrored basis
 *  is not expressible. Valid gates every fetch: a placeholder black texture
 *  reads as depth 0, an occluder sitting on the capture plane, which would
 *  shadow the whole level. */
struct AtmoOccluderFrame
{
    float3 U;
    float3 V;

	/** Plane centre in (U, V). */
    float2 Centre;

	/** Half-width of the capture. */
    float Extent;

	/** Capture plane's distance from the planet centre, along +L. */
    float PlaneDist;

	/** Far clip, from the plane. Background reads at or past it. */
    float Far;

    float Valid;
};

/** Unpacks the three float4s the CPU sends per level, three uniform slots
 *  instead of seven. FGasGiantOccluderFrame's pack helpers mirror this layout,
 *  and nothing checks that they still agree. */
AtmoOccluderFrame AtmoOcc_MakeFrame(float4 PackedU, float4 PackedV, float4 PackedPlane)
{
    AtmoOccluderFrame Frame;

    Frame.U = PackedU.xyz;
    Frame.Extent = PackedU.w;

    Frame.V = PackedV.xyz;
    Frame.PlaneDist = PackedV.w;

    Frame.Centre = PackedPlane.xy;
    Frame.Far = PackedPlane.z;
    Frame.Valid = PackedPlane.w;

    return Frame;
}

/** Planet-local position to capture UV. Only the perpendicular components
 *  matter, so any point on the ray gives the same UV.
 *
 *  V IS FLIPPED because a render target's first row is the top of the image,
 *  where the view's up axis points. Unflipped, shadows land mirrored about the
 *  capture's horizontal centre line -- plausible on a symmetric scene and wrong
 *  everywhere else. */
bool AtmoOcc_Project(AtmoOccluderFrame Frame, float3 LocalPos, out float2 OutUV)
{
    const float2 Plane = float2(dot(LocalPos, Frame.U), dot(LocalPos, Frame.V));

    const float2 Relative = (Plane - Frame.Centre) / max(Frame.Extent, 1e-4f);

    OutUV = float2(Relative.x * 0.5f + 0.5f, 0.5f - Relative.y * 0.5f);

    return Frame.Valid > 0.0f && all(abs(Relative) < 1.0f);
}

/** Capture depth to the bake's ray parameter. The capture origin sits at
 *  +L * PlaneDist, so an occluder at depth Z is at dot(pos, -L) = Z - PlaneDist,
 *  and the bake's origin is at dot(Origin, -L) = -HalfChord. A negative result
 *  is an occluder above the shell entry. */
float AtmoOcc_RayDepth(float Z, AtmoOccluderFrame Frame, float HalfChord)
{
    return Z - Frame.PlaneDist + HalfChord;
}

// -- Encoding -------------------------------------------------------------
//
// AN OCCLUDER IS ITS OWN TERM, NOT A CHANGE TO THE DECK'S. Clamping the deck's
// crossing depths can only say "every remaining threshold is crossed here",
// which is all-or-nothing: once the nodes sit above the receiver the
// reconstruction saturates, so a half-covered texel reads exactly like a fully
// covered one and there is no soft edge to be had. Optical depth from geometry
// is therefore stored separately and ADDED at read time, where coverage and
// distance are both linear and both do what they look like they do.
//
// THREE TERMS, EVALUATED AS A LINE. Depth of the blocker, optical depth at the
// blocker, and the rate that decays behind it. Everything authored folds in
// here, so the reader takes no parameters and the material needs none.

/** Pulls the shadow's edge inward by discarding coverage below Inset and
 *  rescaling what is left.
 *
 *  EVERY STAGE SPREADS OUTWARD. The footprint is centred on the texel, so half
 *  of it reaches past the true silhouette; the texel is then reconstructed
 *  across its neighbours, and the occluder term is filtered again on the way
 *  out. Together they put a rim of shadow outside the blocker, which shows as a
 *  halo when the view looks down the light and the shadow is otherwise hidden
 *  behind the object casting it.
 *
 *  THE TRADE IS DETACHMENT. Inset far enough and the shadow separates from its
 *  object where they meet -- the same bargain a depth bias makes against shadow
 *  acne. Half the footprint is about where the two are balanced.
 *
 *  PITFALL: coverage is quantised to 1/ATMO_OCC_SUBSAMPLES, and the inset
 *  rescales what remains, so a high inset leaves few steps across the penumbra.
 *  Wanting both a deep inset and a smooth edge means more taps. */
float AtmoOcc_InsetCoverage(float Coverage, float Inset)
{
    return saturate((Coverage - Inset) / max(1.0f - Inset, 1e-3f));
}

/** Packs an occluder for one texel ray. Depth and Falloff are in the same units
 *  the reader's Depth arrives in. Coverage is the fraction of the footprint the
 *  blocker fills; zero writes a texel that contributes nothing, which is also
 *  what a cleared target reads as. Falloff of zero never decays. */
float4 AtmoOcc_Encode(float Depth, float Coverage, float Inset, float Strength, float Falloff)
{
    const float Covered = AtmoOcc_InsetCoverage(Coverage, Inset);

    if (Covered <= 0.0f)
    {
        return (float4) 0.0f;
    }

    const float Peak = Covered * Strength;

    return float4(Depth, Peak, (Falloff > 0.0f) ? (Peak / Falloff) : 0.0f, 0.0f);
}

/** Optical depth a stored occluder adds at a given depth. Zero in front of the
 *  blocker, its peak at the blocker, decaying linearly behind it.
 *
 *  THE DECAY IS A PATH LENGTH THROUGH THE MEDIUM: distance past the blocker is
 *  the light path between it and the receiver, so this reads as scattered light
 *  filling the shadow back in -- darkest directly under an object and gone once
 *  the deck is far enough below.
 *
 *  LINEAR IN ALL THREE TERMS, so unlike the deck's nodes this may be
 *  interpolated before it is evaluated, and one bilinear tap serves where the
 *  nodes need four. */
float AtmoOcc_Tau(float4 Encoded, float Depth)
{
    const float Past = Depth - Encoded.x;

    return (Past >= 0.0f) ? max(Encoded.y - Encoded.z * Past, 0.0f) : 0.0f;
}

/** Nearest occluder on one ray from one level, in the bake's ray parameter, and
 *  what fraction of the footprint it covers. Returns whether the level COVERS
 *  the ray, separately from whether it found anything, so a caller walking
 *  finest to coarsest stops at the first level that owns the point.
 *
 *  FootprintWorld is the radius of the disc sampled, IN WORLD UNITS, not texels.
 *  A texel spans an order of magnitude more ground on the coarse cascade than
 *  the fine one, so a footprint in texels erodes an order of magnitude more
 *  there and each cascade ends up with a differently sized shadow -- a step
 *  outward at every boundary the walk crosses. Floored at half a texel so the
 *  taps still spread when the radius falls below what the level can resolve.
 *
 *  PITFALL: stopping at the first covering level means an occluder culled from
 *  that level -- by its view distance cap or its cadence -- is not recovered
 *  from a coarser level that did capture it. A min across all levels instead
 *  lets a coarse texel's half-texel bleed override the fine level wherever the
 *  two overlap. */
bool AtmoOcc_QueryLevel(
	Texture2D DepthTexture,
	SamplerState DepthSampler,
	AtmoOccluderFrame Frame,
	float3 LocalPos,
	float HalfChord,
	float FootprintWorld,
	out float OutRayDepth,
	out float OutCoverage)
{
    OutRayDepth = ATMO_OCC_NO_HIT;
    OutCoverage = 0.0f;

    float2 UV;

    if (!AtmoOcc_Project(Frame, LocalPos, UV))
    {
        return false;
    }

	// From the texture, not the frame, so the footprint is right even when a
	// level is bound at a size the cascade is not.
    uint Width, Height;
    DepthTexture.GetDimensions(Width, Height);

    const float2 TexelUV = 1.0f / float2(max(Width, 1u), max(Height, 1u));

    const float2 Radius = max(
		FootprintWorld / max(2.0f * Frame.Extent, 1e-4f), 0.5f * TexelUV);

    float Nearest = ATMO_OCC_NO_HIT;
    float Hits = 0.0f;

    UNROLL

    for (int Sub = 0; Sub < ATMO_OCC_SUBSAMPLES; Sub++)
    {
        const float2 Offset = AtmoOcc_SubOffsets[Sub] * Radius;

        const float Z = DepthTexture.SampleLevel(DepthSampler, UV + Offset, 0.0f).r;

		// Zero is the capture plane, which sits outside the shell where nothing
		// real can be, so it is how a cleared or never-rendered target reads.
		// At or past the far clip is background.
        if (Z > 0.0f && Z < Frame.Far)
        {
            Hits += 1.0f;
            Nearest = min(Nearest, Z);
        }
    }

    if (Hits > 0.0f)
    {
        OutRayDepth = AtmoOcc_RayDepth(Nearest, Frame, HalfChord);
        OutCoverage = Hits / float(ATMO_OCC_SUBSAMPLES);
    }

    return true;
}
