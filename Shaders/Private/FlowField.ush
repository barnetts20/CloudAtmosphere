#pragma once

// Reading the flow simulation's output: how a sample is taken, and what its
// channels mean.
//
// SHARED BY THE SIM AND EVERY FIELD THAT READS IT. The solver advects along the
// velocity this rebuilds and a cloud field warps along the same one, so a second
// copy would put the clouds on a different flow from the one that made them.
// Nothing here knows what the field above it looks like.
//
// THE OUTPUT IS A CUBE, NOT THE SIM'S GRID. The sim runs on longitude by
// sin(latitude), whose columns converge at the poles; it resamples its output
// each frame onto an equi-angular cube, six faces packed 3 x 2 into each slice,
// each face ringed by a gutter copied from its neighbours. No point on the
// sphere is singular, and a filtered read never leaves its face's tile. Near
// an edge a read cross-fades the faces that meet there (FLOW_ATLAS_BLEND).
//
// VELOCITY IS STORED IN EACH FACE'S OWN TANGENT BASIS, which is defined
// everywhere on the face, and Flow_Sample turns it back into east and north.
// The gutter texels hold the neighbour's data in THIS face's basis, since the
// resample evaluates every texel by direction.
//
// FOUR SLICE RANGES. For a sim of L layers the texture holds 4L slices: [0, L)
// are FLOW, [L, 2L) WEATHER, [2L, 3L) and [3L, 4L) the two NOISE phases, layer
// for layer. L is Slices / 4, so no reader needs it passed.
//
// THE LAYERS ARE A STACK, 0 ON TOP. The weather slice of a layer describes the
// column from the top of the stack down to it, so the lowest layer's is the
// whole sky seen from above; the noise slices' w carry the layer's own state.

/** What the interpretation functions read. A FIELD SUPPLIES IT RATHER THAN
 *  EMBEDDING THE MATH: the sense of a rotation and the width of the band where
 *  it stops meaning anything are properties of the planet, not of the reader. */
struct FlowReadParams
{
	/** sin of the latitude at which the hemisphere sign has fully flipped. */
    float HemisphereHalfWidth;

	/** How far local vorticity widens that half-width. */
    float HemisphereVariance;

	/** Offset and gain applied to the band signal, in that order. */
    float BandBias;
    float BandSharpness;
};

/** Flow field reconstruction: 0 hardware bilinear, one tap, C0; 1 cubic
 *  B-spline, four taps, C2. A performance handle. If blocks survive at 1 the
 *  edge is a genuine step in the sim data, and the answer is sim resolution or
 *  a softer BandSharpness. */
#ifndef FLOW_FIELD_FILTER
#define FLOW_FIELD_FILTER 1
#endif

/** Texels either side of a face edge over which neighbouring faces cross-fade.
 *  Each face resamples the sim on its own lattice, so their reconstructions
 *  disagree at grid-scale detail and a hard switch shows as a seam; carried
 *  noise magnifies it, since a displacement mismatch shifts the noise phase.
 *  0 disables the blend. */
#ifndef FLOW_ATLAS_BLEND
#define FLOW_ATLAS_BLEND 2
#endif

/** Gutter texels around each face in the atlas: the blend band plus the
 *  B-spline's two-texel footprint. PITFALL: FlowSimShader::AtlasGutter sizes
 *  the texture in C++ and must equal this, or every face reads its neighbour's
 *  tile. */
#ifndef FLOW_ATLAS_GUTTER
#define FLOW_ATLAS_GUTTER (FLOW_ATLAS_BLEND + 2)
#endif

// -- Cube atlas ---------------------------------------------------------------

/** A face's frame: M the outward axis, U and V the in-face axes. Any fixed
 *  choice works, since writer and reader both take it from here. */
void Flow_FaceFrame(uint Face, out float3 M, out float3 U, out float3 V)
{
    V = float3(0.0f, 0.0f, 1.0f);

    if (Face == 0u)
    {
        M = float3(1, 0, 0);
        U = float3(0, 1, 0);
    }
    else if (Face == 1u)
    {
        M = float3(-1, 0, 0);
        U = float3(0, -1, 0);
    }
    else if (Face == 2u)
    {
        M = float3(0, 1, 0);
        U = float3(-1, 0, 0);
    }
    else if (Face == 3u)
    {
        M = float3(0, -1, 0);
        U = float3(1, 0, 0);
    }
    else if (Face == 4u)
    {
        M = float3(0, 0, 1);
        U = float3(0, 1, 0);
        V = float3(-1, 0, 0);
    }
    else
    {
        M = float3(0, 0, -1);
        U = float3(0, 1, 0);
        V = float3(1, 0, 0);
    }
}

/** The face a direction falls on: its largest component. */
uint Flow_Face(float3 N)
{
    const float3 A = abs(N);

    if (A.x >= A.y && A.x >= A.z)
    {
        return (N.x >= 0.0f) ? 0u : 1u;
    }

    if (A.y >= A.z)
    {
        return (N.y >= 0.0f) ? 2u : 3u;
    }

    return (N.z >= 0.0f) ? 4u : 5u;
}

/** Equi-angular face coordinates in [-1, 1]: the angle from the face centre
 *  along each axis over 45 degrees, so texels subtend near-equal angles. */
float2 Flow_FaceCoord(float3 N, uint Face)
{
    float3 M, U, V;
    Flow_FaceFrame(Face, M, U, V);

    const float InvMajor = 1.0f / max(dot(N, M), 1e-6f);

    return atan(float2(dot(N, U), dot(N, V)) * InvMajor) * (4.0f / PI);
}

/** The inverse: a direction from face coordinates, valid past [-1, 1] into the
 *  gutter. */
float3 Flow_FaceDirection(uint Face, float2 Coord)
{
    float3 M, U, V;
    Flow_FaceFrame(Face, M, U, V);

    const float2 T = tan(Coord * (0.25f * PI));

    return normalize(M + U * T.x + V * T.y);
}

/** The tangent basis a face stores velocity in: U projected onto the tangent
 *  plane, and N cross that. Smooth over the whole face and its gutter. */
void Flow_FaceBasis(float3 N, uint Face, out float3 T1, out float3 T2)
{
    float3 M, U, V;
    Flow_FaceFrame(Face, M, U, V);

    T1 = normalize(U - N * dot(N, U));
    T2 = cross(N, T1);
}

/** Face edge in texels, from the atlas width: 3 * (Face + 2 * Gutter). */
float Flow_AtlasFaceSize(float AtlasWidth)
{
    return AtlasWidth / 3.0f - 2.0f * FLOW_ATLAS_GUTTER;
}

/** Atlas texel coordinate (texel centres at +0.5) of face coordinates. */
float2 Flow_AtlasTexel(uint Face, float2 Coord, float FaceSize)
{
    const float Tile = FaceSize + 2.0f * FLOW_ATLAS_GUTTER;
    const float2 Origin = float2((float) (Face % 3u), (float) (Face / 3u)) * Tile;

    return Origin + FLOW_ATLAS_GUTTER + (Coord * 0.5f + 0.5f) * FaceSize;
}

/** Layers the sim runs: a quarter of the texture's slices, which hold the
 *  flow, the weather, and the two noise phases, L slices each. */
float Flow_LayerCount(Texture2DArray FlowField)
{
    uint Width, Height, Slices, Levels;
    FlowField.GetDimensions(0, Width, Height, Slices, Levels);

    return (float) (Slices / 4u);
}

/** The bottom of the stack, whose weather slice is the whole column. */
float Flow_LowestLayer(Texture2DArray FlowField)
{
    return Flow_LayerCount(FlowField) - 1.0f;
}

/** The faces a direction reads and their weights, which sum to one. Slot k
 *  is the face on axis k facing N; a slot with zero weight is not read. A face
 *  weighs in wherever N lies within FLOW_ATLAS_BLEND texels of it, so up to
 *  three contribute at a corner and one across most of a face. */
struct FlowFaceSet
{
    uint Face[3];
    float2 Coord[3];
    float Weight[3];
};

FlowFaceSet Flow_FaceSet(float3 N, float FaceSize)
{
    FlowFaceSet Set;

#if FLOW_ATLAS_BLEND > 0

    const float Band = 2.0f * FLOW_ATLAS_BLEND / FaceSize;

    float Total = 0.0f;

	[unroll]
    for (uint Axis = 0; Axis < 3u; ++Axis)
    {
        Set.Face[Axis] = 2u * Axis + (N[Axis] < 0.0f ? 1u : 0u);
        Set.Coord[Axis] = Flow_FaceCoord(N, Set.Face[Axis]);

		// Neighbouring faces' coordinates across an edge sum to two, so the
		// ramp centred on the edge hands one face's weight to the other.
        const float2 Ramp = 1.0f - smoothstep(1.0f - Band, 1.0f + Band, abs(Set.Coord[Axis]));

        Set.Weight[Axis] = Ramp.x * Ramp.y;
        Total += Set.Weight[Axis];
    }

	[unroll]
    for (uint Slot = 0; Slot < 3u; ++Slot)
    {
        Set.Weight[Slot] /= Total;
    }

#else

    const uint Primary = Flow_Face(N);

	[unroll]
    for (uint Axis = 0; Axis < 3u; ++Axis)
    {
        Set.Face[Axis] = Primary;
        Set.Coord[Axis] = Flow_FaceCoord(N, Primary);
        Set.Weight[Axis] = Axis == 0u ? 1.0f : 0.0f;
    }

#endif

    return Set;
}

/** Face size and texel size of the atlas bound as FlowField. */
void Flow_AtlasMetrics(Texture2DArray FlowField, out float FaceSize, out float2 InvSize)
{
    uint Width, Height, Slices, Levels;
    FlowField.GetDimensions(0, Width, Height, Slices, Levels);

    FaceSize = Flow_AtlasFaceSize((float) Width);
    InvSize = 1.0f / float2(Width, Height);
}

/** Samples one slice of one face's tile, raw. Any sampler state works: every
 *  tap stays inside the tile for coordinates within the blend band. */
float4 Flow_SampleTile(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	uint Face,
	float2 Coord,
	float Slice,
	float FaceSize,
	float2 InvSize)
{
    const float2 Pixel = Flow_AtlasTexel(Face, Coord, FaceSize);

#if FLOW_FIELD_FILTER == 0

    return FlowField.SampleLevel(FlowSampler, float3(Pixel * InvSize, Slice), 0.0f);

#else

	// Bilinear is continuous in value but not in gradient, and anything built
	// on this field responds to its slope, so the slope jumps surface as
	// faceting along the texel grid. The cubic is approximating: it does not
	// pass through the texel values, so a one-texel step in the field stops
	// being one in the surface. Four bilinear taps, each placed at the offset
	// that reproduces a pair's weights; the footprint is two texels either side,
	// which the gutter holds beyond the blend band.
    const float2 Texel = Pixel - 0.5f;
    const float2 Corner = floor(Texel);
    const float2 Frac = Texel - Corner;

    const float2 F2 = Frac * Frac;
    const float2 F3 = F2 * Frac;

    const float2 W0 = (-F3 + 3.0f * F2 - 3.0f * Frac + 1.0f) / 6.0f;
    const float2 W1 = (3.0f * F3 - 6.0f * F2 + 4.0f) / 6.0f;
    const float2 W2 = (-3.0f * F3 + 3.0f * F2 + 3.0f * Frac + 1.0f) / 6.0f;
    const float2 W3 = F3 / 6.0f;

    const float2 S0 = W0 + W1;
    const float2 S1 = W2 + W3;

    const float2 UV0 = (Corner + 0.5f + (W1 / S0 - 1.0f)) * InvSize;
    const float2 UV1 = (Corner + 0.5f + (W3 / S1 + 1.0f)) * InvSize;

    return
		  S0.x * S0.y * FlowField.SampleLevel(FlowSampler, float3(UV0.x, UV0.y, Slice), 0.0f)
		+ S1.x * S0.y * FlowField.SampleLevel(FlowSampler, float3(UV1.x, UV0.y, Slice), 0.0f)
		+ S0.x * S1.y * FlowField.SampleLevel(FlowSampler, float3(UV0.x, UV1.y, Slice), 0.0f)
		+ S1.x * S1.y * FlowField.SampleLevel(FlowSampler, float3(UV1.x, UV1.y, Slice), 0.0f);

#endif
}

/** Samples one slice of the atlas by direction, raw, blended across face
 *  edges. For scalar slices only: the flow slice's velocity is in each face's
 *  own basis and has to be rotated before it blends, which Flow_Sample does. */
float4 Flow_SampleSlice(Texture2DArray FlowField, SamplerState FlowSampler, float3 N, float Slice)
{
    float FaceSize;
    float2 InvSize;
    Flow_AtlasMetrics(FlowField, FaceSize, InvSize);

    const FlowFaceSet Set = Flow_FaceSet(N, FaceSize);

    float4 Result = 0.0f;

	[unroll]
    for (uint Slot = 0; Slot < 3u; ++Slot)
    {
        [branch]
        if (Set.Weight[Slot] > 0.0f)
        {
            Result += Set.Weight[Slot] * Flow_SampleTile(
				FlowField, FlowSampler, Set.Face[Slot], Set.Coord[Slot], Slice, FaceSize, InvSize);
        }
    }

    return Result;
}

/** Samples a layer's flow slice by direction.
 *
 *  Returns (u_east, u_north, pressure, vorticity):
 *    xy  Tangent velocity, physical speed on the unit sphere; rebuild the 3D
 *        vector with Flow_TangentVelocity. Stored in the face's basis and
 *        turned into east and north here.
 *    z   Pressure: the layer's Montgomery potential less its zonal mean,
 *        soft-saturated into (-1, 1). Positive in highs in BOTH hemispheres.
 *    w   Normalized vorticity, near [-1,1], positive counterclockwise. The band
 *        signal.
 *
 *  PITFALL: w is a rotation sense, not cyclone or anticyclone -- which one a
 *  sense is flips at the equator. Read it through Flow_Band, never raw. */
float4 Flow_Sample(Texture2DArray FlowField, SamplerState FlowSampler, float3 N, float Layer)
{
    float FaceSize;
    float2 InvSize;
    Flow_AtlasMetrics(FlowField, FaceSize, InvSize);

    const FlowFaceSet Set = Flow_FaceSet(N, FaceSize);

    float3 Velocity = 0.0f;
    float2 Scalars = 0.0f;

	[unroll]
    for (uint Slot = 0; Slot < 3u; ++Slot)
    {
        [branch]
        if (Set.Weight[Slot] > 0.0f)
        {
            const float4 S = Flow_SampleTile(
				FlowField, FlowSampler, Set.Face[Slot], Set.Coord[Slot], Layer, FaceSize, InvSize);

            float3 T1, T2;
            Flow_FaceBasis(N, Set.Face[Slot], T1, T2);

            Velocity += Set.Weight[Slot] * (T1 * S.x + T2 * S.y);
            Scalars += Set.Weight[Slot] * S.zw;
        }
    }

    const float C = max(length(N.xy), 1e-5f);

    return float4(
		dot(Velocity, float3(-N.y, N.x, 0.0f) / C),
		dot(Velocity, float3(-N.z * N.x / C, -N.z * N.y / C, C)),
		Scalars);
}

/** Samples a layer's weather slice. Returns (W, cloud, altitude, storm):
 *    x  The layer's own vertical motion, soft-saturated into (-1, 1),
 *       positive rising. No hemisphere interpretation.
 *    y  Cloud cover in [0, 1] of the column from the top of the stack down to
 *       this layer: where air has been rising and condensing, carried by the
 *       wind.
 *    z  Altitude in [0, 1] the column's cloud formed at, bottom of the stack
 *       to top, cloud-weighted; zero in clear air. On a single layer it is the
 *       ascent the cloud condensed at.
 *    w  Storm intensity in [0, 1], the strongest in the column. */
float4 Flow_SampleWeather(Texture2DArray FlowField, SamplerState FlowSampler, float3 N, float Layer)
{
    return Flow_SampleSlice(FlowField, FlowSampler, N, Layer + Flow_LayerCount(FlowField));
}

/** Samples a layer's two noise displacements, phase A then phase B: xyz
 *  offsets from N, in radians, to the coordinate the noise is sampled at. Each
 *  grows from zero as its phase ages and resets where its crossfade weight is
 *  zero; see Flow_NoiseWeightA. */
void Flow_SampleNoise(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	float3 N,
	float Layer,
	out float3 OutA,
	out float3 OutB)
{
    const float L = Flow_LayerCount(FlowField);

    float FaceSize;
    float2 InvSize;
    Flow_AtlasMetrics(FlowField, FaceSize, InvSize);

    const FlowFaceSet Set = Flow_FaceSet(N, FaceSize);

    OutA = 0.0f;
    OutB = 0.0f;

	[unroll]
    for (uint Slot = 0; Slot < 3u; ++Slot)
    {
        [branch]
        if (Set.Weight[Slot] > 0.0f)
        {
            OutA += Set.Weight[Slot] * Flow_SampleTile(
				FlowField, FlowSampler, Set.Face[Slot], Set.Coord[Slot], Layer + 2.0f * L, FaceSize, InvSize).xyz;
            OutB += Set.Weight[Slot] * Flow_SampleTile(
				FlowField, FlowSampler, Set.Face[Slot], Set.Coord[Slot], Layer + 3.0f * L, FaceSize, InvSize).xyz;
        }
    }
}

/** Samples a layer's own state from the noise slices' w. Returns (height,
 *  humidity):
 *    x  Height of the layer's top surface, soft-saturated into (-1, 1): the
 *       free surface for layer 0, the interface above it for the rest. Raised
 *       positive. What a deck's relief can take its height from.
 *    y  Relative humidity, 0 dry, 1 saturated. */
float2 Flow_SampleLayerState(Texture2DArray FlowField, SamplerState FlowSampler, float3 N, float Layer)
{
    const float L = Flow_LayerCount(FlowField);

    return float2(
		Flow_SampleSlice(FlowField, FlowSampler, N, Layer + 2.0f * L).w,
		Flow_SampleSlice(FlowField, FlowSampler, N, Layer + 3.0f * L).w);
}

/** Phase A's crossfade weight from its phase in [0, 1): zero at the reset,
 *  one half a period later. Phase B's is one minus this. */
float Flow_NoiseWeightA(float PhaseA)
{
    return 1.0f - abs(2.0f * frac(PhaseA) - 1.0f);
}

/** +1 in the northern hemisphere, -1 in the southern, smoothly through zero at
 *  the equator. N is a unit direction in the field's frame, Flow its sample.
 *
 *  THE SIGN FLIP IS EXACTLY A LATITUDE CIRCLE: the Coriolis parameter is
 *  2 omega sin(latitude), with no longitude term, so which rotation sense is
 *  cyclonic changes at latitude zero everywhere. What varies is the WIDTH of the
 *  indifferent band either side. HemisphereBlend sets the quiet-air width and
 *  HemisphereVariance widens it with |zeta|.
 *
 *  PITFALL: a constant width makes the band a perfect annulus, and a vortex
 *  straddling the equator is then bisected along a fixed latitude however strong
 *  it is. */
float Flow_Hemisphere(float4 Flow, float3 N, FlowReadParams P)
{
    const float HalfWidth = P.HemisphereHalfWidth * (1.0f + P.HemisphereVariance * abs(Flow.w));

    return tanh(N.z / HalfWidth);
}

/** Pressure from a flow sample: positive in highs, in both hemispheres. The sim
 *  writes a Montgomery potential, which carries no rotation sense, so nothing
 *  is flipped. */
float Flow_Pressure(float4 Flow, float3 N, FlowReadParams P)
{
    return Flow.z;
}

/** The band value from a flow sample: vorticity made anticyclonic-positive in
 *  both hemispheres, biased and sharpened. Positive is a zone, negative a belt,
 *  zero a boundary -- the same in the north as in the south. */
float Flow_Band(float4 Flow, float3 N, FlowReadParams P)
{
    return (-Flow.w * Flow_Hemisphere(Flow, N, P) + P.BandBias) * P.BandSharpness;
}

/** Arc length of one flow texel at a given radius, in world units: the finest
 *  thing a field built on the flow can vary over. An equi-angular face spans 90
 *  degrees in near-equal texels. */
float Flow_TexelArc(Texture2DArray FlowField, float Radius)
{
    uint Width, Height, Slices, Levels;
    FlowField.GetDimensions(0, Width, Height, Slices, Levels);

    return (0.5f * PI * Radius) / max(Flow_AtlasFaceSize((float) Width), 1.0f);
}

/** Rebuilds the 3D tangent velocity from the stored east/north components. No
 *  trig: with c = length(N.xy) the basis is east = (-N.y, N.x, 0)/c and north =
 *  (-N.z*N.x/c, -N.z*N.y/c, c). Guarded at the poles, where c goes to zero and
 *  east is undefined -- no texel sits on a pole, but a shading point can. */
float3 Flow_TangentVelocity(float3 N, float2 Components)
{
    const float C = max(length(N.xy), 1e-5f);

    const float3 East = float3(-N.y, N.x, 0.0f) / C;
    const float3 North = float3(-N.z * N.x / C, -N.z * N.y / C, C);

    return East * Components.x + North * Components.y;
}
