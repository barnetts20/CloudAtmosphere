#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Plugin/CloudAtmosphere/Private/TerrestrialShadow.ush"
#include "/Plugin/CloudAtmosphere/Private/AtmosphereShadowBake.ush"

// Terrestrial cloud band shadow map: this field's side of the bake.
//
// THE MARCH IS NOT HERE. The ray setup, the step lattice, the crossing
// accumulation and the occluder band live in AtmosphereShadowBake.ush and
// AtmosphereShadowBakeLoop.ush, which any bake writing this format shares. What
// remains below is the deck's own -- its uniforms, its extinction, its fades,
// where a ray enters it -- exposed to that loop through the BakeField_ hooks at
// the bottom of the file.
//
// THE FIELD THE LIGHT SEES MUST BE THE FIELD THE EYE SEES. Every derived
// quantity here comes from TR_BuildField, TR_Density and TR_CloudBeta, the same
// functions the material calls from the same authored values. A second
// derivation on either side fails silently: the shadows stay smooth and
// plausible and land in the wrong place.

Texture2DArray FlowTarget;
SamplerState FlowTargetSampler;

Texture3D DetailVolume;
SamplerState DetailVolumeSampler;

Texture3D StructureVolume;
SamplerState StructureVolumeSampler;


/** Each band's extinction: rgb tint, amount in a. The map stores one scalar
 *  depth, so the bake weights density by the amounts and folds in the largest
 *  tint channel; colour is applied from the receiver's band where the depth is
 *  read, and albedo belongs to the scattering site. */
float4 ExtinctionNegative;
float4 ExtinctionPositive;
float4 ExtinctionBase;
float BandScale;

/** Solved into the light ray's coefficient by TR_CloudBeta, as the material
 *  solves it. */
float CloudOpticalDepth;
float LightExtinctionFraction;

// -- TR_BuildField's arguments, in its order -------------------------------
//
// The same values the material passes, under the same names, so there is one
// derivation of the deck rather than two. Any addition to TR_BuildField's
// signature has to appear here and in FGasGiantShadowParams.

float PlanetRadius;
float HeightScale;
float Time;
float CloudBase;
float CloudThickness;
float CeilingFalloff;
float TopSoftness;
float BottomSoftness;
float TopCurve;
float BottomCurve;
float BaseRelief;
float BaseStormDrop;
float BandSharpness;
float BandBias;
float HemisphereBlend;
float HemisphereVariance;
float BandRelief;
float PressureRelief;
float VortexThreshold;
float StormTowerRelief;
float ReliefThinning;
float RotationWeight;
float WarpTime;
float DeepShearRatio;
float TurbulenceFloor;
float CrossfadePeriod;
float EdgeBias;
float ErosionDepth;
float4 StructureNoiseWeights;
float StructureScale;
float StructureAspect;
float StructureRelief;
float StructureErosion;
float StructureFlowInherit;
float StructureShearInherit;
float StructureFadeNear;
float StructureFadeSpan;
float StructureBandMix;
float StructureCrossfade;
float4 DetailNoiseWeights;
float DetailScale;
float DetailAspect;
float DetailRelief;
float DetailErosion;
float DetailFlowInherit;
float DetailShearInherit;
float DetailFadeNear;
float DetailFadeSpan;
float DetailBandMix;
float DetailCrossfade;
float CloudSlope;

TRFieldParams TRShadow_Field()
{
    return TR_BUILD_FIELD();
}

/** Per-layer level of detail at a point, from its distance to the camera, in
 *  planet radii. MUST MATCH the view march's expression, or the deck the light
 *  sees carries layers the eye has dropped -- lumpy shadows on a smooth surface,
 *  which reads as dirt rather than as under-resolved noise. */
void TRShadow_Fades(float3 LocalPos, TRFieldParams F, out float OutDetail, out float OutStructure)
{
    const float Distance =
		length(LocalPos - ShadowCameraLocal) / max(F.PlanetRadius, 1e-4f);

    OutDetail = 1.0f - smoothstep(F.DetailFadeNear, F.DetailFadeFar, Distance);
    OutStructure = 1.0f - smoothstep(F.StructureFadeNear, F.StructureFadeFar, Distance);
}

/** Per-band extinction amount, blended by the signed band. Mirrors
 *  TR_BandRamp and TR_BandTint on the a channel instead of rgb: sign
 *  picks the family, the ramp runs from Base at zero to that family at full
 *  magnitude, and a plain two-way lerp would blend the families through their
 *  midpoint and lose the boundary between them.
 *
 *  PITFALL: the view ray applies tint and amount together, as
 *  lerp(Base.rgb * Base.a, Hue.rgb * Hue.a, |T|), while the light path is this
 *  amount times a separately ramped tint. Lerp of products against product of
 *  lerps: equal at both ends, differing mid-ramp by a quarter of
 *  (Base.rgb - Hue.rgb)(Base.a - Hue.a). That is the price of one scalar depth
 *  channel, not a defect to fix here. */
float TRShadow_BandAlpha(float Band)
{
    const float T = clamp(Band * BandScale, -1.0f, 1.0f);

    const float Hue = (T < 0.0f) ? ExtinctionNegative.a : ExtinctionPositive.a;

    return lerp(ExtinctionBase.a, Hue, abs(T));
}

/** Extinction at a point, averaged across the texel's footprint. Averaged as
 *  SIGMA: averaging optical depths or whole sub-rays would push the nonlinear
 *  part of the reconstruction through the mean and reintroduce the bias the map
 *  exists to remove.
 *
 *  BOTH LAYERS, BOTH FADES. Detail is erosion -- TR_Density applies it as a
 *  carve, lowering mean density rather than only adding variation -- so dropping
 *  it would leave the shadow deck uniformly denser than the visible one. A layer
 *  may only be dropped from the map if it moves the variance and not the mean.
 *  The fades vary over planet radii, so they are evaluated once per step. */
float TRShadow_Sigma(
	float3 Pos,
	float3 BasisU,
	float3 BasisV,
	float TexelWorld,
	float StepHalfHeight,
	float AbsMax,
	TRFieldParams F)
{
    float FadeDetail, FadeStructure;
    TRShadow_Fades(Pos, F, FadeDetail, FadeStructure);

    F.DetailFade = FadeDetail;
    F.StructureFade = FadeStructure;

    float Density = 0.0f;

    UNROLL

    for (int Sub = 0; Sub < ATMO_BAKE_SUBSAMPLES; Sub++)
    {
        const float2 Offset = (ATMO_BAKE_SUBSAMPLES > 1)
			? AtmoBake_SubOffsets[Sub] * TexelWorld
			: float2(0.0f, 0.0f);

        const float3 SubPos = Pos + BasisU * Offset.x + BasisV * Offset.y;

        const float4 Deck = TR_Density(
			FlowTarget, FlowTargetSampler,
			DetailVolume, DetailVolumeSampler,
			StructureVolume, StructureVolumeSampler,
			SubPos, StepHalfHeight, F);

		// Band scales extinction, so a belt shadows more than a zone, and it
		// arrives on the same fetch the density came from.
        Density += Deck.x * TRShadow_BandAlpha(Deck.y);
    }

    return Density * AbsMax / float(ATMO_BAKE_SUBSAMPLES);
}

// ---------------------------------------------------------------------------
// The loop's hooks
//
// Defined over this file's own uniforms, so none of them carries a texture in
// its signature. AtmosphereShadowBakeLoop.ush is included below, after these.
// ---------------------------------------------------------------------------

#define BakeFieldParams TRFieldParams

BakeFieldParams BakeField_Params()
{
    return TRShadow_Field();
}

/** The shell the map covers, at UNFADED bounds: the map is shared by every pixel
 *  so no one camera's fades may narrow it. */
float BakeField_CullRadius(BakeFieldParams F)
{
    return TR_ShadowCullRadius(F);
}

float BakeField_CascadeExtent(BakeFieldParams F, int Level)
{
    return TR_ShadowCascadeExtent(F, Level);
}

/** Highest the field can reach, in thicknesses, with both layers at full
 *  strength. Bounds the cone trace below. */
float BakeField_TopBound(BakeFieldParams F)
{
    return TR_TopMax(F, 1.0f, 1.0f);
}

/** Where the light ray first reaches the slab. The trace takes either surface,
 *  so a ray grazing under the field and climbing back into it on the far side
 *  still finds the cloud it must shadow. */
float BakeField_Entry(float3 Origin, float3 Dir, float RayLength, float TopMax,
	BakeFieldParams F)
{
	// The miss flag is the view march's: the bake marches from wherever the
	// trace stopped either way, and a ray that reaches no cloud accumulates
	// nothing and writes the sentinel.
    bool bMissed;

    return TR_SlabEntry(
		FlowTarget, FlowTargetSampler, Origin, Dir, 0.0f, RayLength, TopMax, F, bMissed);
}

/** The radial advance a step is allowed. The ramps are the only part of the
 *  profile that varies, so the budget is spent on the finer of the two -- sized
 *  against the top's alone, a sharp base is crossed in one step and the map
 *  holds a hard edge the march resolves softly. */
float BakeField_HeightStep(BakeFieldParams F)
{
    return min(F.SpanTop, F.SpanBase) * F.Thickness
		/ max(ATMO_BAKE_STEPS_PER_GRADIENT, 1.0f);
}

float BakeField_LateralArc(float Radius)
{
    return Flow_TexelArc(FlowTarget, Radius);
}

/** PER WORLD UNIT, matching what AtmosphereSetup hands the march after its own
 *  divide by thickness. The largest tint channel any band can have is folded in
 *  so the stored thresholds mean transmittance on the fastest channel anywhere;
 *  Field_FoldConstant divides the same product back out on the read side. */
float BakeField_FoldConstant(BakeFieldParams F)
{
    return TR_CloudBeta(F, CloudOpticalDepth) * LightExtinctionFraction / F.Thickness
		* TR_ExtinctionTintRange(
			ExtinctionNegative.rgb, ExtinctionPositive.rgb, ExtinctionBase.rgb).y;
}

float BakeField_Sigma(float3 Pos, float3 BasisU, float3 BasisV, float TexelWorld,
	float StepHalfHeight, float AbsMax, BakeFieldParams F)
{
    return TRShadow_Sigma(Pos, BasisU, BasisV, TexelWorld, StepHalfHeight, AbsMax, F);
}

#include "/Plugin/CloudAtmosphere/Private/AtmosphereShadowBakeLoop.ush"

[numthreads(ATMO_BAKE_THREADS, ATMO_BAKE_THREADS, 1)]
void MainShadowBakeCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    AtmoBake_Texel(DispatchThreadId);
}
