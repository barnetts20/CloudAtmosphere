#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Plugin/CloudAtmosphere/Private/TerrestrialShadow.ush"
#include "/Plugin/CloudAtmosphere/Private/AtmosphereShadowBake.ush"

// The cloud field's shadow map, both models' (TR_DEEP_DECK, the pass's
// permutation, selects the gas giant's deep deck): this field's side of the bake.
//
// THE MARCH IS NOT HERE. The ray setup, the step lattice and the crossing
// accumulation live in AtmosphereShadowBake.ush and
// AtmosphereShadowBakeLoop.ush, which any bake writing this format shares. What
// remains below is the field's own -- its uniforms, its extinction, where a ray
// enters it -- exposed to that loop through the BakeField_ hooks at the bottom
// of the file.
//
// THE FIELD THE LIGHT SEES MUST BE THE FIELD THE EYE SEES. Every derived
// quantity here comes from TR_BuildField, TR_Density and TR_CloudBeta, the same
// functions the march calls from the same authored values. A second
// derivation on either side fails silently: the shadows stay smooth and
// plausible and land in the wrong place.

Texture2DArray FlowTarget;
SamplerState FlowTargetSampler;

Texture3D DetailVolume;
SamplerState DetailVolumeSampler;

Texture3D StructureVolume;
SamplerState StructureVolumeSampler;

/** One texel: the priority threshold MainCoverageCS solved this frame. */
Texture2D<float> CoverageThreshold;

/** The material sets' extinction: rgb tint, amount in a; and the deep
 *  material's depth and the floor's softness. The map stores one scalar depth, so the bake weights density by
 *  the amount at each sample's material and folds in the largest tint channel;
 *  colour is applied from the receiver's material where the depth is read. */
float4 CloudExtinction;
float4 StormExtinction;
float4 DeepExtinction;
float4 DeepMaterial;

/** Solved into the light ray's coefficient by TR_CloudBeta, as the march
 *  solves it. */
float CloudOpticalDepth;
float LightExtinctionFraction;

// -- TR_BuildField's arguments, under the march's uniform names -------------

float PlanetRadius;
float HeightScale;
float4 CloudProfile;
float4 CloudCurves;
float4 CloudCoverage;
float4 CloudType;
float4 CloudLid;
float4 CloudLift;
float4 CloudMotion;
float4 NoiseLevels;
float4 StructureSampling;
float4 StructureWarp;
float4 DetailSampling;
float4 DetailWarp;
float4 CloudGenusStratus;
float4 CloudGenusStratocumulus;
float4 CloudGenusCumulus;
float4 CloudGenusCirrus;
float4 ShadowCascades;
float4 CloudResponse;

/** First cascade that samples the detail volume. Coarser levels take the
 *  detail layer's mean erosion without a fetch: their texels span more than a
 *  detail feature, so the subsamples could only alias it. */
#ifndef TR_SHADOW_DETAIL_LEVEL
#define TR_SHADOW_DETAIL_LEVEL 2
#endif

TRFieldParams TRShadow_Field()
{
    TRFieldParams F = TR_BUILD_FIELD();

	// One dispatch per level, so the level being baked is ShadowFirstLevel.
    F.DetailFade = (ShadowFirstLevel >= TR_SHADOW_DETAIL_LEVEL) ? 1.0f : 0.0f;

    return F;
}

/** Extinction amount of a sample's material, TR_TypeTint on the a channel.
 *  PITFALL: the view ray lerps tint times amount, the light path this amount
 *  times a separately lerped tint; they differ mid-blend, the price of one
 *  scalar depth channel. */
float TRShadow_Amount(float4 Deck)
{
    const float Amount = lerp(CloudExtinction.a, StormExtinction.a, saturate(Deck.y));

#if TR_DEEP_DECK
    return lerp(Amount, DeepExtinction.a, TR_DeepMaterialWeight(Deck.w, DeepMaterial));
#else
    return Amount;
#endif
}

/** Extinction at a point, averaged across the texel's footprint. Averaged as
 *  SIGMA: averaging optical depths or whole sub-rays would push the nonlinear
 *  part of the reconstruction through the mean and reintroduce the bias the map
 *  exists to remove.
 *
 *  BOTH LAYERS, IN EVERY CASCADE, the detail at least as its mean. Detail
 *  erosion lowers mean density rather than only adding variation, so dropping
 *  it would leave the shadowing cloud uniformly denser than the visible one.
 *  Where it is fetched, the subsamples band-limit it against the texel, reading
 *  the noise at the mip their spacing resolves. See TR_SHADOW_DETAIL_LEVEL. */
float TRShadow_Sigma(
	float3 Pos,
	float3 BasisU,
	float3 BasisV,
	float TexelWorld,
	float StepHalfHeight,
	float AbsMax,
	TRFieldParams F)
{
	// Half a texel between subsamples, in radians of arc, under the rule the
	// view march uses for a pixel.
    F.PixelFootprint = 0.5f * TexelWorld * max(length(BasisU), length(BasisV))
		/ max(length(Pos), 1e-4f);

    float Density = 0.0f;

    UNROLL

    for (int Sub = 0; Sub < ATMO_BAKE_SUBSAMPLES; Sub++)
    {
        const float2 Offset = (ATMO_BAKE_SUBSAMPLES > 1)
			? AtmoBake_SubOffsets[Sub] * TexelWorld
			: float2(0.0f, 0.0f);

        const float3 SubPos = Pos + BasisU * Offset.x + BasisV * Offset.y;

        const float4 Deck = TR_Density(
			FlowTarget, FlowTargetSampler,
			DetailVolume, DetailVolumeSampler,
			StructureVolume, StructureVolumeSampler,
			SubPos, StepHalfHeight, F);

		// Type scales extinction, so storm cloud shadows more than fair-weather
		// cloud, and it arrives on the same fetch the density came from.
        Density += Deck.x * TRShadow_Amount(Deck);
    }

    return Density * AbsMax / float(ATMO_BAKE_SUBSAMPLES);
}

// ---------------------------------------------------------------------------
// The loop's hooks
//
// Defined over this file's own uniforms, so none of them carries a texture in
// its signature. AtmosphereShadowBakeLoop.ush is included below, after these.
// ---------------------------------------------------------------------------

#define BakeFieldParams TRFieldParams

BakeFieldParams BakeField_Params()
{
    return TRShadow_Field();
}

/** The shell the map covers: the field-wide bound, shared by every pixel. */
float BakeField_CullRadius(BakeFieldParams F)
{
    return TR_ShadowCullRadius(F);
}

float BakeField_CascadeExtent(BakeFieldParams F, int Level)
{
    return TR_ShadowCascadeExtent(F, Level);
}

/** Highest the field can reach, in thicknesses. Bounds the cone trace below. */
float BakeField_TopBound(BakeFieldParams F)
{
    return TR_TopMax(F);
}

/** Where the light ray stops: the planet under the slab; under the deep deck,
 *  the radius the light is provably extinguished by, on the least extinction
 *  any material in use has. Light-side, so LightExtinctionFraction is in it. */
float BakeField_TerminusRadius(BakeFieldParams F)
{
#if TR_DEEP_DECK
    return TR_DeepTerminusRadius(F, TR_CloudBeta(F, CloudOpticalDepth) * LightExtinctionFraction
		* TR_MaterialLeastExtinction(CloudExtinction, StormExtinction, DeepExtinction, F.StormBalance));
#else
    return F.PlanetRadius;
#endif
}

/** Where the light ray first reaches a slab. The trace takes either surface,
 *  so a ray grazing under the cloud and climbing back into it on the far side
 *  still finds the cloud it must shadow. */
float BakeField_Entry(float3 Origin, float3 Dir, float RayLength, float TopMax,
	BakeFieldParams F)
{
    return TR_SlabEntry(FlowTarget, FlowTargetSampler, Origin, Dir, 0.0f, RayLength, TopMax, F);
}

/** The radial advance a step is allowed, spent on a ramp of the profile, which
 *  both ends share. Coarser, a ramp is crossed in one step and the map holds a
 *  hard edge the march resolves softly. */
float BakeField_HeightStep(BakeFieldParams F)
{
    return F.SpanTop * F.Thickness
		/ max(ATMO_BAKE_STEPS_PER_GRADIENT, 1.0f);
}

float BakeField_LateralArc(float Radius)
{
    return Flow_TexelArc(FlowTarget, Radius);
}

/** Per world unit, as AtmosphereSetup hands the march its coefficients. The
 *  largest tint channel in use is folded in, so the stored thresholds mean
 *  transmittance on the fastest channel; Field_FoldConstant divides it out. */
float BakeField_FoldConstant(BakeFieldParams F)
{
    return TR_CloudBeta(F, CloudOpticalDepth) * LightExtinctionFraction / F.Thickness
		* TR_MaterialTintRange(CloudExtinction.rgb, StormExtinction.rgb, DeepExtinction.rgb, F.StormBalance).y;
}

float BakeField_Sigma(float3 Pos, float3 BasisU, float3 BasisV, float TexelWorld,
	float StepHalfHeight, float AbsMax, BakeFieldParams F)
{
    return TRShadow_Sigma(Pos, BasisU, BasisV, TexelWorld, StepHalfHeight, AbsMax, F);
}

#include "/Plugin/CloudAtmosphere/Private/AtmosphereShadowBakeLoop.ush"

[numthreads(ATMO_BAKE_THREADS, ATMO_BAKE_THREADS, 1)]
void MainShadowBakeCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    AtmoBake_Texel(DispatchThreadId);
}

// ---------------------------------------------------------------------------
// The coverage threshold
//
// The priority threshold that covers CloudCover of the planet: a histogram of
// TR_Priority over equal-area directions, read from the top. One group, ahead
// of the bake and the march, which read the texel it writes.
// ---------------------------------------------------------------------------

#define TR_COVERAGE_THREADS 256
#define TR_COVERAGE_BINS TR_COVERAGE_THREADS

/** Directions sampled, on a Fibonacci sphere. Each is one column read, so a
 *  bin holds about 16 at 4096; finer than the flow, the samples repeat it. */
#ifndef TR_COVERAGE_SAMPLES
#define TR_COVERAGE_SAMPLES 4096
#endif

RWTexture2D<float> CoverageUAV;

groupshared uint CoverageBins[TR_COVERAGE_BINS];

[numthreads(TR_COVERAGE_THREADS, 1, 1)]
void MainCoverageCS(uint Thread : SV_GroupIndex)
{
    CoverageBins[Thread] = 0u;

    GroupMemoryBarrierWithGroupSync();

    const TRFieldParams F = TR_BUILD_FIELD_AT(0.0f);

    for (uint i = Thread; i < TR_COVERAGE_SAMPLES; i += TR_COVERAGE_THREADS)
    {
        const float Z = 1.0f - (2.0f * float(i) + 1.0f) / float(TR_COVERAGE_SAMPLES);
        const float Ring = sqrt(max(1.0f - Z * Z, 0.0f));
        const float Phi = float(i) * 2.39996323f;

        const TRColumnInputs In = TR_ReadColumn(
			FlowTarget, FlowTargetSampler, float3(Ring * cos(Phi), Ring * sin(Phi), Z), F);

        const uint Bin = min(uint(saturate(TR_Priority(In.Weather, F)) * TR_COVERAGE_BINS), TR_COVERAGE_BINS - 1u);

        InterlockedAdd(CoverageBins[Bin], 1u);
    }

    GroupMemoryBarrierWithGroupSync();

    if (Thread != 0u)
    {
        return;
    }

	// From the top until CloudCover of the samples lie above, interpolated
	// within the bin that reaches it. Held at or above CoverageSoftness so a
	// column without cloud is never covered.
    const float Soft = F.CoverageSoftness;
    const float Wanted = saturate(F.CloudCover) * float(TR_COVERAGE_SAMPLES);

    float Threshold = 1.0f + Soft;
    float Above = 0.0f;

    if (Wanted > 0.0f)
    {
        for (int Bin = TR_COVERAGE_BINS - 1; Bin >= 0; Bin--)
        {
            const float Count = float(CoverageBins[Bin]);

            if (Above + Count >= Wanted)
            {
                Threshold = (float(Bin + 1) - (Wanted - Above) / max(Count, 1.0f)) / float(TR_COVERAGE_BINS);
                break;
            }

            Above += Count;
        }
    }

    CoverageUAV[uint2(0, 0)] = clamp(Threshold, Soft, 1.0f + Soft);
}
