#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Plugin/CloudAtmosphere/Private/TerrestrialShadow.ush"
#include "/Plugin/CloudAtmosphere/Private/AtmosphereShadowBake.ush"

// Terrestrial cloud shadow map: this field's side of the bake.
//
// THE MARCH IS NOT HERE. The ray setup, the step lattice, the crossing
// accumulation and the occluder band live in AtmosphereShadowBake.ush and
// AtmosphereShadowBakeLoop.ush, which any bake writing this format shares. What
// remains below is the field's own -- its uniforms, its extinction, where a ray
// enters it -- exposed to that loop through the BakeField_ hooks at the bottom
// of the file.
//
// THE FIELD THE LIGHT SEES MUST BE THE FIELD THE EYE SEES. Every derived
// quantity here comes from TR_BuildField, TR_Density and TR_CloudBeta, the same
// functions the material calls from the same authored values. A second
// derivation on either side fails silently: the shadows stay smooth and
// plausible and land in the wrong place.

Texture2DArray FlowTarget;
SamplerState FlowTargetSampler;

Texture3D DetailVolume;
SamplerState DetailVolumeSampler;

Texture3D StructureVolume;
SamplerState StructureVolumeSampler;


/** The two material sets' extinction: rgb tint, amount in a. The map stores
 *  one scalar depth, so the bake weights density by the amount at each sample's
 *  cloud type and folds in the largest tint channel; colour is applied from the
 *  receiver's type where the depth is read. */
float4 CloudExtinction;
float4 StormExtinction;

/** Solved into the light ray's coefficient by TR_CloudBeta, as the material
 *  solves it. */
float CloudOpticalDepth;
float LightExtinctionFraction;

// -- TR_BuildField's arguments, under the material's pin names --------------

float PlanetRadius;
float HeightScale;
float Time;
float4 CloudProfile;
float4 CloudCurves;
float4 CloudCoverage;
float4 CloudType;
float4 CloudLid;
float4 CloudLift;
float4 CloudMotion;
float4 NoiseLevels;
float4 StructureSampling;
float4 StructureWarp;
float4 DetailSampling;
float4 DetailWarp;
float4 CloudGenusStratus;
float4 CloudGenusStratocumulus;
float4 CloudGenusCumulus;
float4 CloudGenusCirrus;
float4 ShadowCascades;

/** First cascade that samples the detail volume. Coarser levels take the
 *  detail layer's mean erosion without a fetch: their texels span more than a
 *  detail feature, so the subsamples could only alias it. */
#ifndef TR_SHADOW_DETAIL_LEVEL
#define TR_SHADOW_DETAIL_LEVEL 2
#endif

TRFieldParams TRShadow_Field()
{
    TRFieldParams F = TR_BUILD_FIELD();

	// One dispatch per level, so the level being baked is ShadowFirstLevel.
    F.DetailFade = (ShadowFirstLevel >= TR_SHADOW_DETAIL_LEVEL) ? 1.0f : 0.0f;

    return F;
}

/** Extinction amount at a cloud type. Mirrors TR_TypeTint on the a channel.
 *
 *  PITFALL: the view ray applies tint and amount together, as a lerp of
 *  products, while the light path is this amount times a separately lerped
 *  tint. Equal at both ends, differing mid-way by a quarter of
 *  (Cloud.rgb - Storm.rgb)(Cloud.a - Storm.a): the price of one scalar depth
 *  channel. */
float TRShadow_TypeAlpha(float Type)
{
    return lerp(CloudExtinction.a, StormExtinction.a, saturate(Type));
}

/** The view march's column keyframes, one cache per bake thread. The loop's one
 *  per-ray hook is BakeField_Entry, which begins it; Sigma reads it. The
 *  subsamples share the centre ray's column: a texel spans at most about one
 *  flow texel, over which the B-spline column barely varies, and it is the
 *  noise inside the texel the subsamples exist to band-limit. */
static TRRayCache TRShadow_Ray;

/** Extinction at a point, averaged across the texel's footprint. Averaged as
 *  SIGMA: averaging optical depths or whole sub-rays would push the nonlinear
 *  part of the reconstruction through the mean and reintroduce the bias the map
 *  exists to remove.
 *
 *  BOTH LAYERS, IN EVERY CASCADE, the detail at least as its mean. Detail
 *  erosion lowers mean density rather than only adding variation, so dropping
 *  it would leave the shadowing cloud uniformly denser than the visible one.
 *  Where it is fetched, the subsamples band-limit it against the texel, reading
 *  the noise at the mip their spacing resolves. See TR_SHADOW_DETAIL_LEVEL. */
float TRShadow_Sigma(
	float3 Pos,
	float3 BasisU,
	float3 BasisV,
	float TexelWorld,
	float StepHalfHeight,
	float AbsMax,
	TRFieldParams F)
{
	// Half a texel between subsamples, in radians of arc, under the rule the
	// view march uses for a pixel.
    F.PixelFootprint = 0.5f * TexelWorld * max(length(BasisU), length(BasisV))
		/ max(length(Pos), 1e-4f);

    // The centre's parameter on the cached ray: T - TPerigee is dot(Pos, Dir).
    const float T = dot(Pos, TRShadow_Ray.Dir) + TRShadow_Ray.TPerigee;

    float Density = 0.0f;

    UNROLL

    for (int Sub = 0; Sub < ATMO_BAKE_SUBSAMPLES; Sub++)
    {
        const float2 Offset = (ATMO_BAKE_SUBSAMPLES > 1)
			? AtmoBake_SubOffsets[Sub] * TexelWorld
			: float2(0.0f, 0.0f);

        const float3 SubPos = Pos + BasisU * Offset.x + BasisV * Offset.y;

        const float4 Deck = TR_DensityOnRay(
			FlowTarget, FlowTargetSampler,
			DetailVolume, DetailVolumeSampler,
			StructureVolume, StructureVolumeSampler,
			SubPos, T, StepHalfHeight, F, TRShadow_Ray);

		// Type scales extinction, so storm cloud shadows more than fair-weather
		// cloud, and it arrives on the same fetch the density came from.
        Density += Deck.x * TRShadow_TypeAlpha(Deck.y);
    }

    return Density * AbsMax / float(ATMO_BAKE_SUBSAMPLES);
}

// ---------------------------------------------------------------------------
// The loop's hooks
//
// Defined over this file's own uniforms, so none of them carries a texture in
// its signature. AtmosphereShadowBakeLoop.ush is included below, after these.
// ---------------------------------------------------------------------------

#define BakeFieldParams TRFieldParams

BakeFieldParams BakeField_Params()
{
    return TRShadow_Field();
}

/** The shell the map covers: the field-wide bound, shared by every pixel. */
float BakeField_CullRadius(BakeFieldParams F)
{
    return TR_ShadowCullRadius(F);
}

float BakeField_CascadeExtent(BakeFieldParams F, int Level)
{
    return TR_ShadowCascadeExtent(F, Level);
}

/** Highest the field can reach, in thicknesses. Bounds the cone trace below. */
float BakeField_TopBound(BakeFieldParams F)
{
    return TR_TopMax(F);
}

/** Where the light ray first reaches a slab. The trace takes either surface,
 *  so a ray grazing under the cloud and climbing back into it on the far side
 *  still finds the cloud it must shadow. */
float BakeField_Entry(float3 Origin, float3 Dir, float RayLength, float TopMax,
	BakeFieldParams F)
{
	// The miss flag is the view march's: the bake marches from wherever the
	// trace stopped either way, and a ray that reaches no cloud accumulates
	// nothing and writes the sentinel.
    TRShadow_Ray = TR_RayCacheBegin(FlowTarget, Origin, Dir, F);

    bool bMissed;

    return TR_SlabEntry(
		FlowTarget, FlowTargetSampler, Origin, Dir, 0.0f, RayLength, TopMax, F, bMissed);
}

/** The radial advance a step is allowed, spent on the finer of the profile's
 *  two ramps -- sized against the top's alone, a sharp base is crossed in one
 *  step and the map holds a hard edge the march resolves softly. */
float BakeField_HeightStep(BakeFieldParams F)
{
    return min(F.SpanTop, F.SpanBase) * F.Thickness
		/ max(ATMO_BAKE_STEPS_PER_GRADIENT, 1.0f);
}

float BakeField_LateralArc(float Radius)
{
    return Flow_TexelArc(FlowTarget, Radius);
}

/** PER WORLD UNIT, matching what AtmosphereSetup hands the march after its own
 *  divide by thickness. The largest tint channel either set has is folded in
 *  so the stored thresholds mean transmittance on the fastest channel anywhere;
 *  Field_FoldConstant divides the same product back out on the read side. */
float BakeField_FoldConstant(BakeFieldParams F)
{
    return TR_CloudBeta(F, CloudOpticalDepth) * LightExtinctionFraction / F.Thickness
		* TR_ExtinctionTintRange(
			CloudExtinction.rgb, StormExtinction.rgb, CloudExtinction.rgb).y;
}

float BakeField_Sigma(float3 Pos, float3 BasisU, float3 BasisV, float TexelWorld,
	float StepHalfHeight, float AbsMax, BakeFieldParams F)
{
    return TRShadow_Sigma(Pos, BasisU, BasisV, TexelWorld, StepHalfHeight, AbsMax, F);
}

#include "/Plugin/CloudAtmosphere/Private/AtmosphereShadowBakeLoop.ush"

[numthreads(ATMO_BAKE_THREADS, ATMO_BAKE_THREADS, 1)]
void MainShadowBakeCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    AtmoBake_Texel(DispatchThreadId);
}
