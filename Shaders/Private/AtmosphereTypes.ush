#pragma once

// ---------------------------------------------------------------------------
// Parameter structs and shared helpers for the atmosphere raymarcher.
//
// MIGRATED VERBATIM. Every expression in this file and its siblings is
// character-for-character what the Custom node contained, reorganised into
// files and nothing more. That is deliberate: the migration is verifiable only
// if the render is pixel-identical before and after, and any improvement folded
// in here would make a difference impossible to attribute.
//
// The known faults are recorded where they live, as comments, and left alone.
// See the notes on step sizing in AtmosphereMarch.ush.
//
// WHY STRUCTS RATHER THAN LONG PARAMETER LISTS.
//
// The march is recursive in the sense that the main ray spawns a light ray at
// every step, and both need the same planet, scattering and cloud state. Passed
// as loose parameters that is fifty-odd arguments threaded through two call
// levels, and every one is a chance for two call sites to disagree.
//
// Bundled, adding a parameter touches the struct and the one place that fills
// it. The gas giant density function is on its way to the same treatment for
// the same reason.
// ---------------------------------------------------------------------------

struct CloudParams
{
	float cloudScale;
	float2 cloudHeightCurve;
	float cloudCoverage;
	float cloudDensityMult;
	float4 cloudNoiseWeights;
	float4 cloudNoiseInvert;
	float4 detailNoiseWeights;
	float4 detailNoiseInvert;
	float detailNoiseScale;
	float detailNoiseErode;
	float4 animationWeights;
	float4 cloudPhaseParams;
	float3 cloudScatBeta;
	float3 cloudAbsBeta;
	float3 cloudAmb;
};

struct PlanetParams
{
	float3 planetPos;
	float planetRadius;
	float planetRadiusSq;
	float atmoRadius;
	float cloudOuterRadius;
	float cloudInnerRadius;
	float cloudOuterRadiusSq;
	float cloudInnerRadiusSq;
};

struct ScatterParams
{
	float cosTheta;
	float3 rayBeta;
	float3 mieBeta;
	float3 absBeta;
	float atmoAmbient;
	float rayScaleH;
	float mieScaleH;
	float absHeight;
	float absFalloff;
	float phaseR;
	float phaseM;
};

struct MainRayParams
{
	float2 svxy;
	float3 originalCameraPos;
	float3 cameraPos;
	float3 cameraDir;
	float3 lightCol;
	float sceneDepth;
	int atmoSteps;
	int cloudSteps;
	float jitterFactor;
	float stepScaleFactor;
};

struct LightRayParams
{
	float3 samplePos;
	float3 lightDir;
	int atmoLightSteps;
	int cloudLightSteps;
	float jitterFactor;
	float stepSizeMult;
	int parentStepIndex;
};

struct CompositeParams
{
	PlanetParams planetParams;
	ScatterParams scatteringParams;
	CloudParams cloudParams;
	MainRayParams mainRayParams;
	LightRayParams lightRayParams;
};

// ---------------------------------------------------------------------------
// Free functions
//
// These were members of a SharedFunctions struct that carried the cloud texture
// and its sampler. As free functions taking the texture explicitly they can be
// called from anywhere without threading an object through, which matters once
// the density function becomes swappable between the terrestrial and gas giant
// models.
// ---------------------------------------------------------------------------

/** Ray against a sphere. Returns (near, far), or (-1,-1) on a miss.
 *
 *  Direction must be normalized: the quadratic drops its leading coefficient on
 *  that assumption, so an unnormalized direction silently scales both roots. */
float2 Atmo_RaySphere(float3 origin, float3 dir, float3 center, float radius)
{
	float3 oc = origin - center;
	float b = dot(oc, dir);
	float c = dot(oc, oc) - radius * radius;
	float disc = b * b - c;

	if (disc < 0.0)
	{
		return float2(-1.0, -1.0);
	}

	float sq = sqrt(disc);

	return float2(-b - sq, -b + sq);
}

/** Rayleigh phase. Symmetric forward and back, which is why the sky is bright
 *  in both directions and Mie is not. */
float Atmo_PhaseRayleigh(float cosTheta)
{
	return 3.0 / (16.0 * 3.14159265) * (1.0 + cosTheta * cosTheta);
}

/** Henyey-Greenstein. Used for Mie directly, and twice inside the dual lobe. */
float Atmo_PhaseHG(float cosTheta, float g)
{
	float g2 = g * g;

	return (1.0 - g2) / (4.0 * 3.14159265 * pow(1.0 + g2 - 2.0 * g * cosTheta, 1.5));
}

/** Two HG lobes, forward and back, mixed.
 *
 *  Cloud droplets scatter strongly forward and weakly back, and a single lobe
 *  cannot do both -- which is what makes a cloud lit from behind glow at its
 *  edge while staying bright when lit from in front. The floor at 0.05 stands
 *  in for the multiple scattering that keeps a real cloud's shadow side from
 *  going black. */
float Atmo_PhaseDualLobe(float cosTheta, float gForward, float gBack, float forwardWeight)
{
	float forward = Atmo_PhaseHG(cosTheta, gForward);
	float backward = Atmo_PhaseHG(cosTheta, -gBack);

	return max(lerp(backward, forward, forwardWeight), .05);
}

/** Rayleigh, Mie and absorber density at an altitude, as (ray, mie, abs).
 *
 *  The first two are exponential with their own scale heights. The absorber is
 *  a Lorentzian centred on absHeight and multiplied by the Rayleigh profile --
 *  ozone, which sits in a layer rather than falling off from the ground. */
float3 Atmo_Density(float height, float rayScaleH, float mieScaleH, float absHeight, float absFalloff)
{
	float rayDensity = exp(-height / rayScaleH);
	float mieDensity = exp(-height / mieScaleH);

	float safeFalloff = max(absFalloff, 0.0001);
	float denom = (absHeight - height) / safeFalloff;
	float absDensity = (1.0 / (denom * denom + 1.0)) * rayDensity;

	return float3(rayDensity, mieDensity, absDensity);
}

/** Step size growing with progress along the ray.
 *
 *  THE DENOMINATOR IS A FIXED REFERENCE, NOT THE RAY'S OWN SPAN.
 *
 *  It used to be rayLength, the length of this particular ray's plan. Two rays
 *  crossing the same world point at different angles therefore reached
 *  different points on the growth ramp, so the step size at a given place
 *  depended on the geometry of the ray that got there -- and the surface where
 *  that quantity changes is a curve on screen.
 *
 *  The numerator stays per-ray, and should: distance travelled INTO the
 *  atmosphere is a real, physically meaningful quantity, and spending budget
 *  near the entry is what growth is for. It was the denominator that made it
 *  a locus.
 *
 *  referenceLength is the atmosphere's own thickness, identical for every ray,
 *  so growthRate now means "how much the step has grown after crossing one
 *  atmosphere depth" rather than "after crossing however much this ray had". */
float Atmo_AdaptiveStepSize(float baseStep, float pos, float rayStart, float referenceLength, float growthRate)
{
	float t = saturate((pos - rayStart) / referenceLength);

	return baseStep * (1.0 + t * growthRate);
}

/** Per-pixel seed for the main ray, from the integer pixel coordinate. */
float Atmo_RaySeed(float2 svxy)
{
	uint2 pixelCoord = uint2(svxy);

	uint pixSeed = pixelCoord.x * 1664525u + pixelCoord.y * 1013904223u;
	pixSeed = (pixSeed ^ (pixSeed >> 16)) * 2654435769u;
	pixSeed = (pixSeed ^ (pixSeed >> 16));

	return float(pixSeed) / 4294967295.0;
}

/** Golden-ratio advance through the sequence, one value per step.
 *
 *  Every step is jittered, not just the first. Offsetting only the first step
 *  translates the lattice per pixel but leaves each ray on a regular grid, and
 *  a regular grid beats against any structure of comparable period. 0.618033 is
 *  the standard advance because its continued fraction converges slowest, which
 *  is the formal statement of having no short period. */
float Atmo_StepJitter(float seed, int stepIndex)
{
	return frac(seed + float(stepIndex) * 0.618033);
}
