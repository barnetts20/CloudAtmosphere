#pragma once

// Parameter structs and shared math for the atmosphere march. Compiled into
// material Custom nodes and into AtmosphereTransmittance.usf.
//
// Space is camera-relative: the view ray starts at the origin and planetPos is
// the planet centre relative to the camera. Lengths are world units.

/** Jitter span as a fraction of a step. At 1 each sample is uniform over its own
 *  step, a stratified estimator with no gaps or overlap; below 1 the step lattice
 *  returns as banding, above 1 strata overlap. 0 is a diagnostic that exposes
 *  step banding. */
#ifndef ATMO_STEP_JITTER
#define ATMO_STEP_JITTER 1.0
#endif

/** Cloud state. The gas giant path reads only cloudScatBeta, cloudAbsBeta and
 *  cloudAmb; the rest serve the terrestrial density. */
struct CloudParams
{
    float cloudScale;
    float2 cloudHeightCurve;
    float cloudCoverage;
    float cloudDensityMult;
    float4 cloudNoiseWeights;
    float4 cloudNoiseInvert;
    float4 detailNoiseWeights;
    float4 detailNoiseInvert;
    float detailNoiseScale;
    float detailNoiseErode;
    float4 animationWeights;
    float4 cloudPhaseParams; // (gForward, gBack, forwardWeight, multi-scatter weight)
    float3 cloudScatBeta; // per world unit
    float3 cloudAbsBeta; // per world unit
    float4 cloudAmb; // rgb colour, a night-side floor for Atmo_AmbientFactor
};

/** Planet and shell radii. The cloud radii bound the band the march spends
 *  cloudSteps on. */
struct PlanetParams
{
    float3 planetPos; // camera-relative centre
    float planetRadius;
    float atmoRadius;
    float cloudOuterRadius;
    float cloudInnerRadius;
    float cloudOuterRadiusSq;
    float cloudInnerRadiusSq;
};

struct ScatterParams
{
    float cosTheta; // dot(view, light)
    float3 rayBeta; // per world unit, at zero altitude
    float3 mieBeta;
    float3 absBeta;
    float4 atmoAmbient; // rgb colour, a night-side floor
    float rayScaleH; // world units
    float mieScaleH;
    float absHeight;
    float absFalloff;
    float phaseR; // phases at cosTheta, constant per pixel
    float phaseM;
};

struct MainRayParams
{
    float2 svxy; // pixel position, jitter seed
    float3 originalCameraPos; // absolute camera position, for world-anchored noise
    float3 cameraPos; // ray origin, always zero
    float3 cameraDir;
    float3 lightCol;
    float sceneDepth; // ray length limit
    int atmoSteps;
    int cloudSteps;
    float stepScaleFactor; // growthRate for Atmo_AdaptiveStepSize
};

/** Light-ray state, filled per view step by the march. */
struct LightRayParams
{
    float3 samplePos;
    float3 lightDir;
    float stepSizeMult; // parent step's growth, carried into the terrestrial light march
    int parentStepIndex; // salts the light ray's jitter
};

/** Everything one march reads, built once per pixel. */
struct CompositeParams
{
    PlanetParams planetParams;
    ScatterParams scatteringParams;
    CloudParams cloudParams;
    MainRayParams mainRayParams;
    LightRayParams lightRayParams;
};

/** Ray against a sphere: (near, far) distances along dir, or (-1, -1) on a miss.
 *  dir must be normalized.
 *
 *  Pitfall: the discriminant is a small difference of large squares, and no one
 *  form holds it in fp32 everywhere. Within 1.5 radii it is b^2 - (L - r)(L + r),
 *  which keeps the altitude L - r exact near the surface; beyond, r^2 - |perp|^2
 *  from the ray's perpendicular offset, whose error grows with L * r rather than
 *  L^2. Each form alone is one to three orders of magnitude worse on the other
 *  side, and the worst case is the grazing ray at the limb. */
float2 Atmo_RaySphere(float3 origin, float3 dir, float3 center, float radius)
{
    const float3 oc = origin - center;
    const float b = dot(oc, dir);
    const float dist2 = dot(oc, oc);
    const float dist = sqrt(dist2);
    const float3 perp = oc - b * dir;
    const float r2 = radius * radius;

    const float disc = (dist2 > 2.25 * r2)
        ? r2 - dot(perp, perp)
        : b * b - (dist - radius) * (dist + radius);

    if (disc < 0.0)
    {
        return float2(-1.0, -1.0);
    }

    const float sq = sqrt(disc);

    return float2(-b - sq, -b + sq);
}

/** Rayleigh phase, per steradian. */
float Atmo_PhaseRayleigh(float cosTheta)
{
    return 3.0 / (16.0 * PI) * (1.0 + cosTheta * cosTheta);
}

/** Henyey-Greenstein phase, per steradian. g > 0 scatters forward. */
float Atmo_PhaseHG(float cosTheta, float g)
{
    const float g2 = g * g;

    return (1.0 - g2) / (4.0 * PI * pow(1.0 + g2 - 2.0 * g * cosTheta, 1.5));
}

/** Forward and back HG lobes mixed by forwardWeight. Normalized, with no floor:
 *  light reaching the shadow side is the caller's multiple-scattering term. */
float Atmo_PhaseDualLobe(float cosTheta, float gForward, float gBack, float forwardWeight)
{
    return lerp(Atmo_PhaseHG(cosTheta, -gBack), Atmo_PhaseHG(cosTheta, gForward), forwardWeight);
}

/** Ambient weight at a sun elevation (cosine): ambientFloor on the night side,
 *  1 on the day side, smoothstepped across +-terminator. Shared by air and cloud
 *  ambient on both paths, so they agree on where night starts. */
float Atmo_AmbientFactor(float sunElevation, float terminator, float ambientFloor)
{
    return lerp(saturate(ambientFloor), 1.0, smoothstep(-terminator, terminator, sunElevation));
}

/** Air densities at an altitude, as (rayleigh, mie, absorber). Rayleigh and Mie
 *  fall off exponentially; the absorber is a Lorentzian layer centred on
 *  absHeight, scaled by the Rayleigh profile. Takes the profile as AtmoT_Profile
 *  returns it, already clamped away from zero, so nothing is guarded per sample. */
float3 Atmo_Density(float height, float rayScaleH, float mieScaleH, float absHeight, float absFalloff)
{
    const float rayDensity = exp(-height / rayScaleH);
    const float mieDensity = exp(-height / mieScaleH);

    const float denom = (absHeight - height) / absFalloff;
    const float absDensity = (1.0 / (denom * denom + 1.0)) * rayDensity;

    return float3(rayDensity, mieDensity, absDensity);
}

/** Step size at pos: baseStep, growing linearly to baseStep * (1 + growthRate)
 *  over referenceLength of travel from rayStart, then held.
 *
 *  Pitfall: referenceLength must be the same for every ray (the atmosphere
 *  thickness). A per-ray length makes the step at a point depend on the ray that
 *  reached it, and the transition prints as a curve on screen. */
float Atmo_AdaptiveStepSize(float baseStep, float pos, float rayStart, float referenceLength, float growthRate)
{
    const float t = saturate((pos - rayStart) / referenceLength);

    return baseStep * (1.0 + t * growthRate);
}

/** White-noise value in [0,1) from a pixel and a salt, for light rays: at a
 *  handful of steps a structured sequence prints as a grid. Callers salt by step
 *  index so light rays decorrelate from each other and from the view ray. */
float Atmo_HashJitter(float2 svxy, uint salt)
{
    const uint2 p = uint2(svxy);

    uint h = p.x * 0x9E3779B1u;
    h ^= p.y * 0x85EBCA77u;
    h ^= salt * 0xC2B2AE3Du;

    h ^= h >> 16;
    h *= 0x85EBCA6Bu;
    h ^= h >> 13;
    h *= 0xC2B2AE35u;
    h ^= h >> 16;

    return float(h >> 8) * (1.0 / 16777216.0);
}

/** View-ray jitter in [0,1): interleaved gradient noise, which a small blur
 *  resolves cleanly, with its input advanced per step.
 *
 *  Pitfall: advancing the output instead (one seed plus a golden-ratio step)
 *  gives every step the same spatial pattern shifted, and the errors sum into
 *  rings about the view centre. Pitfall: hashing a linear combination of x and y
 *  leaves lattice-line correlation that no blur radius removes. */
float Atmo_StepJitter(float2 svxy, int stepIndex)
{
    const float2 p = svxy + 5.588238 * float(stepIndex);

    return frac(52.9829189 * frac(0.06711056 * p.x + 0.00583715 * p.y));
}
