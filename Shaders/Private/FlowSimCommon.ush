#pragma once

#include "/Plugin/CloudAtmosphere/Private/FlowField.ush"

// Grid, topology and operators for the flow sim.
//
// THE GRID IS A CYLINDER, NOT A TORUS. Longitude wraps with period exactly
// 2 pi; latitude does not. The top and bottom rows are adjacent to the POLES,
// not to each other, and treating this as a torus joins the north pole to the
// south so material advected out of the arctic arrives in the antarctic. Every
// read here is an explicit Load through SimWrapCoord, because the pole is a
// topological fold no address mode expresses -- but the OUTPUT texture the
// material samples needs WRAP on U and CLAMP on V.
//
// THE LATITUDE COORDINATE IS MU = sin(latitude). The spherical Laplacian in
// (lambda, mu) has two closed-form coefficients and no cross terms; cells are
// equal AREA, so a zonal mean is a plain row mean and the global mean a plain
// mean of those; and the material's V coordinate comes free as 0.5 + 0.5 * N.z
// with no asin.
//
// TEXEL CENTRES SIT BETWEEN THE POLES, NOT ON THEM. Cell-centred, so mu runs
// over [-1 + dmu/2, 1 - dmu/2] and the poles are cell FACES. Every flux across a
// polar face carries a factor (1 - mu^2) or cos(latitude) that is EXACTLY ZERO
// there, so no operator needs a polar boundary condition.
//
// THE STAGGERING. Scalars sit at cell centres. Face velocities sit on the WEST
// face (east component u) and the SOUTH face (north component v) of their cell,
// so row 0's v is the south polar face and is identically zero, and the north
// face of the last row is the north pole and is never stored.
//
// The fold survives in one place: INTERPOLATION of centre fields. A departure
// point can land past the pole, and crossing it means lambda -> lambda + pi.
// SimWrapCoord is the only function that knows this.
//
// PITFALL: FACE COMPONENTS MUST NEVER BE READ THROUGH THE FOLD. East and north
// both reverse across a pole, so a folded face value arrives with its sign
// flipped. Face operators wrap longitude only and treat out-of-range rows as the
// zero-flux polar face; only scalars and Cartesian vectors cross the fold.

/** Grid dimensions. x = longitude columns, y = latitude rows, z = layer count.
 *  Longitude must be even: the polar fold offsets by N_lon/2 columns, and an odd
 *  width lands the reflection half a texel off. */
int3 SimGridSize;

/** float3(1/N_lon, 1/N_lat, 1/N_layers). */
float3 SimInvGridSize;

// -- Coordinates ------------------------------------------------------------

float SimDLon()
{
    return (2.0f * PI) * SimInvGridSize.x;
}

float SimDMu()
{
    return 2.0f * SimInvGridSize.y;
}

/** Longitude of column i, in radians, at the texel CENTRE. i - 0.5 is the
 *  column's west face. */
float SimColumnToLon(float I)
{
    return (I + 0.5f) * SimInvGridSize.x * (2.0f * PI);
}

/** mu = sin(latitude) of row j, at the texel CENTRE. Never reaches +-1. */
float SimRowToMu(float J)
{
    return -1.0f + 2.0f * (J + 0.5f) * SimInvGridSize.y;
}

/** mu at the FACE between row J-1 and row J. Reaches exactly -1 at J = 0 and
 *  exactly +1 at J = N_lat, which is what zeroes the polar flux. */
float SimFaceToMu(float J)
{
    return -1.0f + 2.0f * J * SimInvGridSize.y;
}

/** cos(latitude) at row J's centre. Strictly positive. */
float SimRowCos(int J)
{
    const float Mu = SimRowToMu((float) J);

    return sqrt(1.0f - Mu * Mu);
}

/** cos(latitude) at row J's south face. Exactly zero at J = 0 and J = N_lat. */
float SimFaceCos(int J)
{
    const float Mu = SimFaceToMu((float) J);

    return sqrt(max(1.0f - Mu * Mu, 0.0f));
}

/** Unit direction from grid coordinates. Right-handed, Z along the rotation
 *  axis, matching the material's planet-local space. */
float3 SimDirection(float Lon, float Mu)
{
    const float C = sqrt(max(1.0f - Mu * Mu, 0.0f));

    float SinL, CosL;
    sincos(Lon, SinL, CosL);

    return float3(C * CosL, C * SinL, Mu);
}

/** Local east and north unit vectors at a direction. Undefined exactly on a
 *  pole, which no texel centre or stored face reaches. */
float3 SimEast(float3 N)
{
    const float C = max(length(N.xy), 1e-6f);

    return float3(-N.y, N.x, 0.0f) / C;
}

float3 SimNorth(float3 N)
{
    const float C = max(length(N.xy), 1e-6f);

    return float3(-N.z * N.x / C, -N.z * N.y / C, C);
}

/** Continuous grid coordinates from a unit direction. The inverse of
 *  SimDirection, in texel-index space so integer values land on centres. */
float2 SimDirectionToGrid(float3 N)
{
    float Lon = atan2(N.y, N.x);

	// atan2 returns (-pi, pi]; the grid runs [0, 2 pi).
    Lon = (Lon < 0.0f) ? Lon + 2.0f * PI : Lon;

    const float I = Lon * (1.0f / (2.0f * PI)) * SimGridSize.x - 0.5f;
    const float J = (N.z + 1.0f) * 0.5f * SimGridSize.y - 0.5f;

    return float2(I, J);
}

// -- Topology ---------------------------------------------------------------

/** Fold an arbitrary integer texel coordinate onto the grid. THE ONE PLACE THE
 *  SPHERE'S TOPOLOGY LIVES, and valid for scalars and Cartesian vectors only.
 *
 *  Latitude is a MIRROR with a half-turn in longitude, because stepping north
 *  past the pole comes back down the far side: row -1 is row 0 at longitude +
 *  pi. A clamp instead would duplicate the polar row and give the interpolator a
 *  flat spot exactly where the flow crosses the pole. */
int2 SimWrapCoord(int2 C)
{
    const int NLon = SimGridSize.x;
    const int NLat = SimGridSize.y;

	// Handles ONE crossing exactly. A departure point cannot travel more than a
	// fraction of the grid in a step, so a second crossing does not arise.
    if (C.y < 0)
    {
        C.y = -1 - C.y;
        C.x += NLon / 2;
    }
    else if (C.y >= NLat)
    {
        C.y = 2 * NLat - 1 - C.y;
        C.x += NLon / 2;
    }

	// Two-step modulo so negative inputs land correctly; HLSL % keeps the sign
	// of the dividend.
    C.x = ((C.x % NLon) + NLon) % NLon;

    return C;
}

/** Longitude wrap alone, for face components. */
int SimWrapColumn(int I)
{
    const int NLon = SimGridSize.x;

    return ((I % NLon) + NLon) % NLon;
}

// -- Sampling ---------------------------------------------------------------

/** Point read of a scalar field with full topology handling. */
float SimLoad(Texture2DArray<float> Field, int2 C, uint Layer)
{
    const int2 W = SimWrapCoord(C);

    return Field.Load(int4(W.x, W.y, Layer, 0));
}

float4 SimLoad4(Texture2DArray<float4> Field, int2 C, uint Layer)
{
    const int2 W = SimWrapCoord(C);

    return Field.Load(int4(W.x, W.y, Layer, 0));
}

/** Catmull-Rom weights for one axis. */
void SimCubicWeights(float F, out float W0, out float W1, out float W2, out float W3)
{
    const float F2 = F * F;
    const float F3 = F2 * F;

    W0 = 0.5f * (-F3 + 2.0f * F2 - F);
    W1 = 0.5f * (3.0f * F3 - 5.0f * F2 + 2.0f);
    W2 = 0.5f * (-3.0f * F3 + 4.0f * F2 + F);
    W3 = 0.5f * (F3 - F2);
}

/** Bicubic (Catmull-Rom) interpolation at continuous grid coordinates. Sixteen
 *  taps, all through SimWrapCoord, so it is correct across the longitude seam
 *  and across the poles; hardware bilinear cannot be used because no address
 *  mode expresses the polar fold.
 *
 *  PITFALL: BILINEAR HERE WOULD KILL THE INVERSE CASCADE. Semi-Lagrangian
 *  advection is not conservative, and its error is a numerical diffusion whose
 *  magnitude the interpolator sets. Bilinear diffuses at about the grid scale
 *  per step, the eddies starve, and the planet relaxes to perfect bands with no
 *  weather -- which reads as weak forcing and is not.
 *
 *  Catmull-Rom overshoots at sharp gradients: the anti-diffusion that keeps
 *  filaments sharp, and unacceptable for a quantity that must stay positive.
 *
 *  INDEX SPACE, NOT UV SPACE: texel centres sit on INTEGERS, because that is what
 *  SimDirectionToGrid produces. PITFALL: the half-integer form
 *  floor(G - 0.5) + 0.5 is for UV*Size coordinates, and used here it samples at
 *  G - 0.5 in both axes -- a constant half-texel drift per step that reads as a
 *  mysterious current. */
float SimSampleCubic(Texture2DArray<float> Field, float2 Grid, uint Layer)
{
    const float2 Base = floor(Grid);
    const float2 F = Grid - Base;

    const int2 C0 = (int2) Base - int2(1, 1);

    float WX0, WX1, WX2, WX3;
    SimCubicWeights(F.x, WX0, WX1, WX2, WX3);

    float WY0, WY1, WY2, WY3;
    SimCubicWeights(F.y, WY0, WY1, WY2, WY3);

    const float WX[4] = { WX0, WX1, WX2, WX3 };
    const float WY[4] = { WY0, WY1, WY2, WY3 };

    float Sum = 0.0f;

	[unroll]
    for (int J = 0; J < 4; J++)
    {
		[unroll]
        for (int I = 0; I < 4; I++)
        {
            Sum += WX[I] * WY[J] * SimLoad(Field, C0 + int2(I, J), Layer);
        }
    }

    return Sum;
}

/** SimSampleCubic over a four-channel field. The Cartesian velocity crosses the
 *  fold correctly because a 3D vector does not change sign there. */
float4 SimSampleCubic4(Texture2DArray<float4> Field, float2 Grid, uint Layer)
{
    const float2 Base = floor(Grid);
    const float2 F = Grid - Base;

    const int2 C0 = (int2) Base - int2(1, 1);

    float WX0, WX1, WX2, WX3;
    SimCubicWeights(F.x, WX0, WX1, WX2, WX3);

    float WY0, WY1, WY2, WY3;
    SimCubicWeights(F.y, WY0, WY1, WY2, WY3);

    const float WX[4] = { WX0, WX1, WX2, WX3 };
    const float WY[4] = { WY0, WY1, WY2, WY3 };

    float4 Sum = 0.0f;

	[unroll]
    for (int J = 0; J < 4; J++)
    {
		[unroll]
        for (int I = 0; I < 4; I++)
        {
            Sum += WX[I] * WY[J] * SimLoad4(Field, C0 + int2(I, J), Layer);
        }
    }

    return Sum;
}

// -- Trajectories -----------------------------------------------------------

/** A backtrace: where the parcel arriving at P came from, and the rotation that
 *  carries the departure point's tangent plane onto P's. */
struct SimTrajectory
{
    float3 Departure;
    float3 Axis;
    float SinT;
    float CosT;
};

/** EXACT GREAT-CIRCLE BACKTRACE, not normalize(P - V dt). Displacing along the
 *  tangent and renormalizing moves along a CHORD, short by cos(theta), which
 *  accumulates over hundreds of steps into a slow poleward or equatorward creep
 *  of everything the flow carries. V must be tangent at P. */
SimTrajectory SimBacktrace(float3 P, float3 V, float Dt)
{
    SimTrajectory T;
    T.Departure = P;
    T.Axis = float3(0.0f, 0.0f, 1.0f);
    T.SinT = 0.0f;
    T.CosT = 1.0f;

    const float Speed = length(V);

    if (Speed > 1e-8f)
    {
        const float3 UHat = V / Speed;

        sincos(Speed * Dt, T.SinT, T.CosT);

        T.Departure = normalize(P * T.CosT - UHat * T.SinT);

		// Departure x P = sin(theta) (P x UHat), so this is the axis that
		// rotates the departure point forward onto P.
        T.Axis = normalize(cross(P, UHat));
    }

    return T;
}

/** A vector sampled at the departure point, carried to the arrival point by the
 *  trajectory's rotation (Rodrigues). This is the parallel transport that
 *  supplies the sphere's metric terms, so nothing else adds them. */
float3 SimTransport(float3 V, SimTrajectory T)
{
    return V * T.CosT
		+ cross(T.Axis, V) * T.SinT
		+ T.Axis * dot(T.Axis, V) * (1.0f - T.CosT);
}

// -- Operators --------------------------------------------------------------

/** The five-point spherical Laplacian in (lambda, mu), FLUX FORM, which is why
 *  the polar boundary condition disappears: the latitude coefficients sit at
 *  cell faces, where (1 - mu^2) is exactly zero at a pole. It is also exactly
 *  div(grad) of the C-grid operators in FlowSim.usf, which is what makes the
 *  Helmholtz solve consistent with the velocity correction.
 *
 *  Returns the operator and the DIAGONAL coefficient together: the solver needs
 *  both, and computing them separately is how the two drift apart. */
void SimLaplacianCoeffs(int Row, out float CLon, out float ALo, out float AHi)
{
    const float DLon = SimDLon();
    const float DMu = SimDMu();

    const float Mu = SimRowToMu((float) Row);

    const float MuLo = SimFaceToMu((float) Row);
    const float MuHi = SimFaceToMu((float) (Row + 1));

    ALo = (1.0f - MuLo * MuLo) / (DMu * DMu);
    AHi = (1.0f - MuHi * MuHi) / (DMu * DMu);

	// Finite on a cell-centred grid. The polar row's coefficient exceeds the
	// equator's by about N_lat/2: stiff but bounded.
    CLon = 1.0f / ((1.0f - Mu * Mu) * DLon * DLon);
}

/** The operator, given its five taps. Separate from the loads because HLSL
 *  cannot write one function over both a UAV and an SRV. */
float SimLaplacianFromTaps(
	int Row,
	float Centre,
	float West,
	float East,
	float South,
	float North,
	out float OutDiagonal)
{
    float CLon, ALo, AHi;
    SimLaplacianCoeffs(Row, CLon, ALo, AHi);

    OutDiagonal = -(2.0f * CLon + ALo + AHi);

    return CLon * (West - 2.0f * Centre + East)
		+ AHi * (North - Centre)
		- ALo * (Centre - South);
}

float SimLaplacian(Texture2DArray<float> Field, int2 C, uint Layer, out float OutDiagonal)
{
    return SimLaplacianFromTaps(
		C.y,
		SimLoad(Field, C, Layer),
		SimLoad(Field, C + int2(-1, 0), Layer),
		SimLoad(Field, C + int2(1, 0), Layer),
		SimLoad(Field, C + int2(0, -1), Layer),
		SimLoad(Field, C + int2(0, 1), Layer),
		OutDiagonal);
}

/** Half-width, in texels, of the longitudinal box filter at this latitude.
 *
 *  THE POLE PROBLEM. Physical longitudinal spacing is cos(phi) * dlambda, which
 *  goes to zero at the poles: grid-scale longitudinal modes there are far finer
 *  than anywhere else and the Laplacian's 1/(1-mu^2) coefficient makes them the
 *  stiffest in the solve. A running mean over 1/cos(phi) texels removes exactly
 *  the wavenumbers the grid carries but the physical spacing cannot support.
 *
 *  What it costs is polar detail. Discrete long-lived polar vortex clusters
 *  would not emerge from a solve at this resolution anyway and belong on an
 *  authored path. */
int SimFilterHalfWidth(float Mu, float FilterLatitude, int MaxHalfWidth)
{
    const float CosPhi = sqrt(max(1.0f - Mu * Mu, 0.0f));

    if (CosPhi >= FilterLatitude)
    {
        return 0;
    }

    const float Width = FilterLatitude / max(CosPhi, 1e-4f);

    return clamp((int) round((Width - 1.0f) * 0.5f), 0, MaxHalfWidth);
}
