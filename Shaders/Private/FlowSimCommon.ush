#pragma once

// Grid, topology and operators for the flow sim.
//
// The grid is a cylinder, not a torus: longitude wraps with period 2 pi; the top
// and bottom rows border the POLES, not each other. Every read is an explicit Load
// through SimWrapCoord, since no address mode expresses the polar fold. The output
// fields sample is resampled onto a cube atlas with no fold; see FlowField.ush.
//
// The latitude coordinate is mu = sin(latitude): equal-area cells (a zonal mean is
// a plain row mean) and a Laplacian with no cross terms. Cell-centred, so the poles
// are cell FACES, where every flux carries a factor (1 - mu^2) that is exactly
// zero; no operator needs a polar boundary condition.
//
// Staggering: scalars at cell centres; u on the WEST face and v on the SOUTH face.
// Row 0's v is the south pole and identically zero; the north pole face is not stored.
//
// PITFALL: face components must never be read through the fold, since east and
// north reverse across a pole. Face operators wrap longitude only and treat
// out-of-range rows as the zero-flux polar face.
//
// Sim scalars come from FlowSimUB (FFlowSimUniformParameters in FlowSimShaders.h).
// PITFALL: each SimName alias here and in FlowSim.usf is a macro, so no local,
// parameter or struct member may reuse one of those names.

/** Grid dimensions: x = longitude columns, y = latitude rows, z = layer count.
 *  Longitude must be even: the polar fold offsets by N_lon/2 columns. */
#define SimGridSize FlowSimUB.GridSize

/** (1/N_lon, 1/N_lat). */
#define SimInvGridSize FlowSimUB.InvGridSize

// -- Coordinates ------------------------------------------------------------

float SimDLon()
{
    return (2.0f * PI) * SimInvGridSize.x;
}

float SimDMu()
{
    return 2.0f * SimInvGridSize.y;
}

/** Longitude of column I's centre, in radians; I - 0.5 is its west face. */
float SimColumnToLon(float I)
{
    return (I + 0.5f) * SimInvGridSize.x * (2.0f * PI);
}

/** mu = sin(latitude) of row j, at the texel CENTRE. Never reaches +-1. */
float SimRowToMu(float J)
{
    return -1.0f + 2.0f * (J + 0.5f) * SimInvGridSize.y;
}

/** mu at the face between rows J-1 and J: exactly -1 at J = 0, +1 at J = N_lat. */
float SimFaceToMu(float J)
{
    return -1.0f + 2.0f * J * SimInvGridSize.y;
}

/** cos(latitude) at row J's centre. Strictly positive. */
float SimRowCos(int J)
{
    const float Mu = SimRowToMu((float) J);

    return sqrt(1.0f - Mu * Mu);
}

/** cos(latitude) at row J's south face. Exactly zero at J = 0 and J = N_lat. */
float SimFaceCos(int J)
{
    const float Mu = SimFaceToMu((float) J);

    return sqrt(max(1.0f - Mu * Mu, 0.0f));
}

/** Unit direction from grid coordinates; right-handed, Z along the rotation axis. */
float3 SimDirection(float Lon, float Mu)
{
    const float C = sqrt(max(1.0f - Mu * Mu, 0.0f));

    float SinL, CosL;
    sincos(Lon, SinL, CosL);

    return float3(C * CosL, C * SinL, Mu);
}

/** Local east and north unit vectors; undefined exactly on a pole, never sampled. */
float3 SimEast(float3 N)
{
    const float C = max(length(N.xy), 1e-6f);

    return float3(-N.y, N.x, 0.0f) / C;
}

float3 SimNorth(float3 N)
{
    const float C = max(length(N.xy), 1e-6f);

    return float3(-N.z * N.x / C, -N.z * N.y / C, C);
}

/** Inverse of SimDirection, in texel-index space (integers land on centres). */
float2 SimDirectionToGrid(float3 N)
{
    float Lon = atan2(N.y, N.x);

	// atan2 returns (-pi, pi]; the grid runs [0, 2 pi).
    Lon = (Lon < 0.0f) ? Lon + 2.0f * PI : Lon;

    const float I = Lon * (1.0f / (2.0f * PI)) * SimGridSize.x - 0.5f;
    const float J = (N.z + 1.0f) * 0.5f * SimGridSize.y - 0.5f;

    return float2(I, J);
}

// -- Topology ---------------------------------------------------------------

/** Folds an integer texel coordinate onto the grid: the one place the sphere's
 *  topology lives, valid for scalars and Cartesian vectors only. Latitude mirrors
 *  with a half-turn in longitude (row -1 is row 0 at lon + pi); a clamp would
 *  duplicate the polar row and flatten interpolation across the pole. */
int2 SimWrapCoord(int2 C)
{
    const int NLon = SimGridSize.x;
    const int NLat = SimGridSize.y;

	// Handles one crossing; a departure point never travels far enough for two.
    if (C.y < 0)
    {
        C.y = -1 - C.y;
        C.x += NLon / 2;
    }
    else if (C.y >= NLat)
    {
        C.y = 2 * NLat - 1 - C.y;
        C.x += NLon / 2;
    }

	// Two-step modulo: HLSL % keeps the sign of the dividend.
    C.x = ((C.x % NLon) + NLon) % NLon;

    return C;
}

/** Longitude wrap alone, for face components. */
int SimWrapColumn(int I)
{
    const int NLon = SimGridSize.x;

    return ((I % NLon) + NLon) % NLon;
}

// -- Sampling ---------------------------------------------------------------

/** Point read of a scalar field with full topology handling. */
float SimLoad(Texture2DArray<float> Field, int2 C, uint Layer)
{
    const int2 W = SimWrapCoord(C);

    return Field.Load(int4(W.x, W.y, Layer, 0));
}

float4 SimLoad4(Texture2DArray<float4> Field, int2 C, uint Layer)
{
    const int2 W = SimWrapCoord(C);

    return Field.Load(int4(W.x, W.y, Layer, 0));
}

/** Catmull-Rom weights for one axis. */
void SimCubicWeights(float F, out float W0, out float W1, out float W2, out float W3)
{
    const float F2 = F * F;
    const float F3 = F2 * F;

    W0 = 0.5f * (-F3 + 2.0f * F2 - F);
    W1 = 0.5f * (3.0f * F3 - 5.0f * F2 + 2.0f);
    W2 = 0.5f * (-3.0f * F3 + 4.0f * F2 + F);
    W3 = 0.5f * (F3 - F2);
}

/** Bicubic (Catmull-Rom) interpolation at continuous grid coordinates. All 16
 *  taps go through SimWrapCoord, so it is correct across the seam and the poles.
 *  Overshoots at sharp gradients, so unsuitable for quantities that must stay
 *  positive. Four channels: Cartesian velocity keeps its sign across the fold.
 *  PITFALL: bilinear here diffuses at grid scale per step; the eddies starve and
 *  the planet relaxes to plain bands, which looks like weak forcing.
 *  PITFALL: index space, centres on integers (as SimDirectionToGrid produces). The
 *  UV-space form floor(G - 0.5) + 0.5 samples half a texel off, a constant drift
 *  that reads as a spurious current. */
float4 SimSampleCubic4(Texture2DArray<float4> Field, float2 Grid, uint Layer)
{
    const float2 Base = floor(Grid);
    const float2 F = Grid - Base;

    const int2 C0 = (int2) Base - int2(1, 1);

    float WX0, WX1, WX2, WX3;
    SimCubicWeights(F.x, WX0, WX1, WX2, WX3);

    float WY0, WY1, WY2, WY3;
    SimCubicWeights(F.y, WY0, WY1, WY2, WY3);

    const float WX[4] = { WX0, WX1, WX2, WX3 };
    const float WY[4] = { WY0, WY1, WY2, WY3 };

    float4 Sum = 0.0f;

	[unroll]
    for (int J = 0; J < 4; J++)
    {
		[unroll]
        for (int I = 0; I < 4; I++)
        {
            Sum += WX[I] * WY[J] * SimLoad4(Field, C0 + int2(I, J), Layer);
        }
    }

    return Sum;
}

// -- Trajectories -----------------------------------------------------------

/** A backtrace: where the parcel arriving at P came from, and the rotation that
 *  carries the departure point's tangent plane onto P's. */
struct SimTrajectory
{
    float3 Departure;
    float3 Axis;
    float SinT;
    float CosT;
};

/** Exact great-circle backtrace. normalize(P - V dt) moves along a chord, short
 *  by cos(theta), which accumulates into a slow meridional creep of everything
 *  advected. V must be tangent at P. */
SimTrajectory SimBacktrace(float3 P, float3 V, float Dt)
{
    SimTrajectory T;
    T.Departure = P;
    T.Axis = float3(0.0f, 0.0f, 1.0f);
    T.SinT = 0.0f;
    T.CosT = 1.0f;

    const float Speed = length(V);

    if (Speed > 1e-8f)
    {
        const float3 UHat = V / Speed;

        sincos(Speed * Dt, T.SinT, T.CosT);

        T.Departure = normalize(P * T.CosT - UHat * T.SinT);

		// Axis that rotates the departure point forward onto P.
        T.Axis = normalize(cross(P, UHat));
    }

    return T;
}

/** Carries a vector sampled at the departure point to the arrival point
 *  (Rodrigues). This parallel transport supplies the sphere's metric terms. */
float3 SimTransport(float3 V, SimTrajectory T)
{
    return V * T.CosT
		+ cross(T.Axis, V) * T.SinT
		+ T.Axis * dot(T.Axis, V) * (1.0f - T.CosT);
}

// -- Operators --------------------------------------------------------------

/** Five-point spherical Laplacian in (lambda, mu), flux form: the latitude
 *  coefficients sit on faces and vanish at the poles. Exactly div(grad) of the
 *  C-grid operators in FlowSim.usf, keeping the Helmholtz solve consistent with
 *  the velocity correction. One source for the operator and its diagonal, so the
 *  solver's two cannot drift apart. */
void SimLaplacianCoeffs(int Row, out float CLon, out float ALo, out float AHi)
{
    const float DLon = SimDLon();
    const float DMu = SimDMu();

    const float Mu = SimRowToMu((float) Row);

    const float MuLo = SimFaceToMu((float) Row);
    const float MuHi = SimFaceToMu((float) (Row + 1));

    ALo = (1.0f - MuLo * MuLo) / (DMu * DMu);
    AHi = (1.0f - MuHi * MuHi) / (DMu * DMu);

	// Finite on a cell-centred grid; the polar row's is ~N_lat/2 times the equator's.
    CLon = 1.0f / ((1.0f - Mu * Mu) * DLon * DLon);
}

/** The operator, given its five taps. Separate from the loads because HLSL
 *  cannot write one function over both a UAV and an SRV. */
float SimLaplacianFromTaps(
	int Row,
	float Centre,
	float West,
	float East,
	float South,
	float North,
	out float OutDiagonal)
{
    float CLon, ALo, AHi;
    SimLaplacianCoeffs(Row, CLon, ALo, AHi);

    OutDiagonal = -(2.0f * CLon + ALo + AHi);

    return CLon * (West - 2.0f * Centre + East)
		+ AHi * (North - Centre)
		- ALo * (Centre - South);
}

float SimLaplacian(Texture2DArray<float> Field, int2 C, uint Layer, out float OutDiagonal)
{
    return SimLaplacianFromTaps(
		C.y,
		SimLoad(Field, C, Layer),
		SimLoad(Field, C + int2(-1, 0), Layer),
		SimLoad(Field, C + int2(1, 0), Layer),
		SimLoad(Field, C + int2(0, -1), Layer),
		SimLoad(Field, C + int2(0, 1), Layer),
		OutDiagonal);
}

/** Half-width, in texels, of the longitudinal box filter at this latitude, held
 *  within the row. Physical spacing cos(phi) dlambda vanishes at the poles; a
 *  running mean over 1/cos(phi) texels removes the modes that spacing cannot
 *  support, which are also the stiffest in the solve. Costs polar detail. */
int SimFilterHalfWidth(float Mu, float FilterLatitude)
{
    const float CosPhi = sqrt(max(1.0f - Mu * Mu, 0.0f));

    if (CosPhi >= FilterLatitude)
    {
        return 0;
    }

    const float Width = FilterLatitude / max(CosPhi, 1e-4f);

    return clamp((int) round((Width - 1.0f) * 0.5f), 0, (SimGridSize.x - 1) / 2);
}
