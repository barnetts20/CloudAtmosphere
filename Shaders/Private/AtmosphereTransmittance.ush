#pragma once

#include "/Plugin/CloudAtmosphere/Private/AtmosphereTypes.ush"

// Air transmittance table: density integrals from a point to the top of the
// atmosphere, indexed by altitude and the cosine toward the light. rgb are the
// Rayleigh, Mie and absorber integrals -- geometry alone, so any spectrum reads
// the table without a rebake and the betas turn it into optical depth. Radii are
// in atmosphere thicknesses. The mapping, its inverse and the profile derivation
// are shared by the bake and the march; a second copy fails silently, the air
// keeping its colour and taking the wrong depth.
//
// PITFALL: the mapping saturates at the horizon, so rays below it read the
// horizon's integral. Occlusion is the analytic planet shadow's, and a table
// that represented it too would darken those samples twice.

/** Table size. Must match AtmosphereTransmittance::Width and Height: the bake
 *  is defined from C++, the material's lookup reads these. */
#ifndef ATMO_TRANSMITTANCE_WIDTH
#define ATMO_TRANSMITTANCE_WIDTH 256
#endif

#ifndef ATMO_TRANSMITTANCE_HEIGHT
#define ATMO_TRANSMITTANCE_HEIGHT 64
#endif

/** Air profile in thickness units from the authored pins, as (Rayleigh scale
 *  height, Mie scale height, absorber altitude, absorber half-width). The one
 *  derivation: the march scales it by thickness, the bake takes it as it comes.
 *  Pitfall: the clamps belong here, not in Atmo_Density, which sees the march's
 *  scaled copy and the bake's unscaled one -- floored there, an authored zero
 *  means a different altitude on each path. */
float4 AtmoT_Profile(float RayleighA, float MieA, float AbsorptionA, float AbsorptionFalloff)
{
    return float4(max(RayleighA, 1e-4f), max(MieA, 1e-4f), AbsorptionA, max(AbsorptionFalloff, 1e-4f));
}

/** Atmosphere thickness in world units: the unit the table is written in. */
float AtmoT_Thickness(float PlanetRadius, float AtmoRadius)
{
    return max(AtmoRadius - PlanetRadius, 1e-4f);
}

/** Planet and atmosphere-top radii in thickness units. */
float2 AtmoT_Radii(float PlanetRadius, float AtmoRadius)
{
    const float Thickness = AtmoT_Thickness(PlanetRadius, AtmoRadius);

    return float2(PlanetRadius / Thickness, AtmoRadius / Thickness);
}

/** sqrt(R^2 - Bottom^2), written so the two do not cancel at low altitude. */
float AtmoT_Rho(float R, float Bottom)
{
    const float Height = max(R - Bottom, 0.0f);

    return sqrt(Height * (2.0f * Bottom + Height));
}

/** Distance from radius R along cosine Mu to the atmosphere top. */
float AtmoT_DistanceToTop(float R, float Mu, float Top)
{
    const float Disc = (Top - R) * (Top + R) + (R * Mu) * (R * Mu);

    return max(-R * Mu + sqrt(max(Disc, 0.0f)), 0.0f);
}

/** Unit coordinate to a texture coordinate landing on texel centres at both
 *  ends; a plain [0,1] reads half a texel past each edge row. */
float AtmoT_UnitToUV(float X, float Size)
{
    return 0.5f / Size + X * (1.0f - 1.0f / Size);
}

/** Texture coordinate for a point at radius R looking along cosine Mu; wants a
 *  clamped sampler. Bruneton's mapping: altitude through Rho, cosine through
 *  distance to the top between its extremes, concentrating texels near the
 *  ground and near the horizon. R clamps into the shell, so a sample below the
 *  surface reads the surface. */
float2 AtmoT_UV(float R, float Mu, float Bottom, float Top)
{
    R = clamp(R, Bottom, Top);

    const float H = sqrt(max(Top * Top - Bottom * Bottom, 1e-8f));
    const float Rho = AtmoT_Rho(R, Bottom);

    const float D = AtmoT_DistanceToTop(R, Mu, Top);
    const float DMin = Top - R;
    const float DMax = Rho + H;

    const float XMu = saturate((D - DMin) / max(DMax - DMin, 1e-6f));
    const float XR = Rho / H;

    return float2(
		AtmoT_UnitToUV(XMu, ATMO_TRANSMITTANCE_WIDTH),
		AtmoT_UnitToUV(XR, ATMO_TRANSMITTANCE_HEIGHT));
}

/** Inverse of AtmoT_UV, from unit coordinates. XMu 0 is straight up, 1 the
 *  horizon; XR 0 is the surface, 1 the atmosphere top. */
void AtmoT_RMu(float XMu, float XR, float Bottom, float Top, out float R, out float Mu)
{
    const float H = sqrt(max(Top * Top - Bottom * Bottom, 1e-8f));
    const float Rho = H * XR;

    R = sqrt(Rho * Rho + Bottom * Bottom);

    const float DMin = Top - R;
    const float DMax = Rho + H;
    const float D = DMin + XMu * (DMax - DMin);

    Mu = (D <= 1e-6f) ? 1.0f : (H * H - Rho * Rho - D * D) / (2.0f * R * D);
    Mu = clamp(Mu, -1.0f, 1.0f);
}

/** Density integrals from radius R along cosine Mu to the atmosphere top, in
 *  thickness units. Multiply by each beta and by thickness for optical depth. */
float3 AtmoT_Lookup(Texture2D Table, SamplerState TableSampler, float R, float Mu, float Bottom, float Top)
{
    return Table.SampleLevel(TableSampler, AtmoT_UV(R, Mu, Bottom, Top), 0.0f).rgb;
}
