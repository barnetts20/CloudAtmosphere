#pragma once

#include "/Plugin/CloudAtmosphere/Private/TerrestrialDeck.ush"
#include "/Plugin/CloudAtmosphere/Private/AtmosphereShadowMap.ush"

// The cloud field's side of the shadow map, both models: the cull radius,
// depth unit and cascade half-widths it gives the frame. The format, the
// reconstruction and the cascade walk are AtmosphereShadowMap.ush's.

#define TR_ExtinctionTintRange(Cloud, Storm) AtmoShadow_ExtinctionTintRange(Cloud, Storm)

/** The deep material's share at Depth below a column's base, an atmosphere
 *  fraction: whole DeepMaterial.x below the base. */
float TR_DeepMaterialWeight(float Depth, float4 DeepMaterial)
{
    return smoothstep(0.0f, max(DeepMaterial.x, 1e-5f), Depth);
}

/** TR_ExtinctionTintRange over every material in use, the deep deck's
 *  included. The bake's fold constant and the march's reader both take it
 *  from here. */
float2 TR_MaterialTintRange(float3 Cloud, float3 Storm, float3 Deep)
{
    const float2 Range = TR_ExtinctionTintRange(Cloud, Storm);

#if TR_DEEP_DECK
    return float2(min(Range.x, min(Deep.x, min(Deep.y, Deep.z))), max(Range.y, max(Deep.x, max(Deep.y, Deep.z))));
#else
    return Range;
#endif
}

/** The least extinction, tint times amount, across the materials in use: what
 *  the deep terminus counts the light out against. */
float TR_MaterialLeastExtinction(float4 Cloud, float4 Storm, float4 Deep)
{
    float3 Low = min(Cloud.rgb * Cloud.a, Storm.rgb * Storm.a);

#if TR_DEEP_DECK
    Low = min(Low, Deep.rgb * Deep.a);
#endif

    return min(Low.x, min(Low.y, Low.z));
}

/** The radius the map covers: the field-wide top bound, the march's
 *  cloudOuterRadius. PITFALL: a map read against another radius than it was
 *  written at slides the whole shadow toward the limb. */
float TR_ShadowCullRadius(TRFieldParams F)
{
    return F.PlanetRadius + F.Thickness * TR_TopMax(F);
}

/** Half-width of a cascade, from the authored radii in planet radii. Every
 *  level carries the whole field, a finer one more finely around the camera.
 *  Held non-increasing, since the authored values need not be; a zero extent
 *  collapses its level and the walk skips it. */
float TR_ShadowCascadeExtent(TRFieldParams F, int Level)
{
    const float Disc = TR_ShadowCullRadius(F) * ATMO_SHADOW_EXTENT_MARGIN;

    if (Level <= 0)
    {
        return Disc;
    }

    const float Level1 = min(F.PlanetRadius * F.ShadowCascade1, Disc);

    if (Level == 1)
    {
        return Level1;
    }

    return min(F.PlanetRadius * F.ShadowCascade2, Level1);
}

/** The field's frame: the only place it meets the map's format. */
AtmoShadowFrame TR_ShadowFrame(TRFieldParams F)
{
    AtmoShadowFrame Frame;

    Frame.CullRadius = TR_ShadowCullRadius(F);
    Frame.Thickness = F.Thickness;

    UNROLL

    for (int Level = 0; Level < ATMO_SHADOW_CASCADES; Level++)
    {
        Frame.Extents[Level] = TR_ShadowCascadeExtent(F, Level);
    }

    return Frame;
}
