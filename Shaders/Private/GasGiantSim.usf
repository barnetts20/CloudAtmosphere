// Gas giant flow sim. Vorticity-streamfunction on a sphere, in sin(latitude).
//
// A VORTICITY SOLVE RATHER THAN WOUND NOISE, because two-dimensional turbulence
// cascades energy UPWARD in scale: eddies merge and grow instead of shredding,
// and vortices persist because they are fed rather than because they were
// excluded from the shear.
//
// THE STEP ORDER, WHICH IS NOT ARBITRARY.
//
//   Velocity   u = N x grad(psi) from the current psi. Also writes the texture
//              the material samples, so this pass serves both.
//   Advect     Semi-Lagrangian on ABSOLUTE vorticity.
//   Reduce     Row means, then the global mean.
//   Force      Nudge the zonal mean, force the eddies, drag, layer coupling,
//              and project out the global mean.
//   Filter     Longitudinal box filter in the polar rows.
//   Poisson    Red-black SOR for the new psi, warm-started from the old one.
//
// Velocity comes first because advection needs a velocity consistent with the
// vorticity it is advecting; reduce comes after advect because the forcing
// nudges what the flow has become, not what it was at the top of the step.
//
// EVERYTHING IS NON-DIMENSIONAL ON A UNIT SPHERE. No planet radius appears
// anywhere, and velocities are angular rates in radians per unit time -- the
// same unit GG_ZonalRate produces, so the sim's output and the material's jet
// profile are commensurate by construction and there is no conversion to get
// wrong. One unit of time is whatever those radians are per.

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Plugin/CloudAtmosphere/Private/GasGiantJets.ush"
#include "/Plugin/CloudAtmosphere/Private/GasGiantSimCommon.ush"

// THREAD GROUP SIZES COME FROM C++. GasGiantSimShaders.cpp pushes all three as
// defines and GasGiantSimulation.cpp sizes every dispatch from the same
// constants, so a group size and its group count cannot disagree. PITFALL: a
// literal here instead would leave the two linked only by coincidence, and a
// mismatch under-covers the grid silently.

// -- Shared parameters ------------------------------------------------------
//
// Declared at file scope and consumed by whichever kernels need them. Each
// kernel's C++ FParameters struct should declare only the subset it actually
// binds; anything declared there and unused here is stripped by the compiler
// and shows up as an unbound parameter warning, which is the signal that the
// struct and the kernel have drifted apart.

/** x BandCount, y JetStrength, z EquatorialBoost, w Asymmetry. */
float4 SimJetParams;

/** Offsets the jet profile so zones and belts need not be the same width. */
float SimWidthBias;

/** Per layer: x JetScale, y BoostScale, z ForcingScale, w DragScale.
 *
 *  THIS IS THE VERTICAL WIND SHEAR. Taylor-Proudman makes the flow invariant
 *  along the rotation axis, so a 3D solve is mostly wasted -- columns move
 *  together. What a stack of 2D layers buys that a single layer does not is
 *  layers that disagree, and JetScale is how they disagree: a deeper layer with
 *  a weaker or wider profile produces genuine shear against the layer above it,
 *  and the material reads the difference as depth.
 *
 *  All four are MULTIPLIERS on the shared profile rather than independent
 *  profiles. Independent profiles would let the layers' jets sit at different
 *  latitudes, and then the bands drawn from the shared profile would register
 *  with none of them. */
float4 SimLayerProfile[8];

float SimDeltaTime;
float SimTime;

/** 2 * Omega, the planetary vorticity coefficient. f = SimPlanetaryVorticity * mu.
 *
 *  BETA IS NOT OPTIONAL, and it is this one number. Jets exist because the
 *  Coriolis parameter VARIES with latitude, which makes the inverse cascade
 *  anisotropic -- north-south motion radiates Rossby waves and east-west motion
 *  does not -- so energy feeds preferentially into zonal modes and the cascade
 *  arrests at the Rhines scale instead of running to the domain scale.
 *
 *  PITFALL: at zero the cascade is isotropic. Eddies still merge, but into one
 *  planet-sized vortex rather than into jets, and no amount of forcing produces
 *  banding. With prescribed jets the nudge papers over it and the field looks
 *  roughly right while being driven entirely by the nudge, which is the version
 *  of this failure that survives review. */
float SimPlanetaryVorticity;

// -- Resources --------------------------------------------------------------

Texture2DArray<float> SimVorticitySRV;
Texture2DArray<float> SimPsiSRV;
Texture2DArray<float4> SimVelocitySRV;

RWTexture2DArray<float> SimVorticityUAV;
RWTexture2DArray<float> SimPsiUAV;
RWTexture2DArray<float4> SimVelocityUAV;

/** Zonal mean of vorticity, (row, layer). */
Texture2D<float> SimRowMeanSRV;
RWTexture2D<float> SimRowMeanUAV;

/** Zonal mean of the streamfunction, (row, layer). EXISTS SO THAT ALPHA CAN
 *  CARRY THE EDDY FIELD RATHER THAN RAW PSI: psi for the mean flow is the
 *  integral of the jet profile, a large smooth function of latitude that swamps
 *  the eddy part, so a material reading raw psi as pressure gets a latitude ramp
 *  with the storms buried in it -- lifting cloud tops by it raises whole bands
 *  rather than vortices. Subtracting the row mean leaves the departure from
 *  zonal symmetry: zero in undisturbed flow, positive in anticyclones, negative
 *  in cyclones. */
Texture2D<float> SimPsiRowMeanSRV;
RWTexture2D<float> SimPsiRowMeanUAV;

/** Area mean of vorticity over the whole sphere, (0, layer). */
Texture2D<float> SimGlobalMeanSRV;
RWTexture2D<float> SimGlobalMeanUAV;

/** Band-limited tiling noise, sampled once per texel per step as the stochastic
 *  forcing. A baked volume rather than inline FBM: a 3D fetch is roughly four
 *  times cheaper than two octaves of Perlin, and this runs at every sim texel
 *  every step. */
Texture3D<float4> SimForcingNoise;
SamplerState SimForcingNoiseSampler;

/** Which channel of the volume carries the forcing. */
int SimForcingChannel;

/** 1 when the channel is stored SIGNED, 0 when unipolar [0,1]. Must match the
 *  bake: a unipolar decode on a signed channel maps [-1,1] onto [-3,1], biased
 *  and double amplitude, which as forcing is a constant vorticity source with
 *  noise riding on it. */
int SimForcingBipolar;

/** Snapshot transfer buffers: vorticity for the whole grid, then psi, each
 *  layer-major then row then column. One allocation because the two are always
 *  transferred together.
 *
 *  A structured buffer rather than an RHI texture update in either direction,
 *  since buffer readback needs no per-slice handling and a compute pass keeps
 *  both directions inside the RDG graph the sim already builds -- so state is
 *  captured at a defined point in the step order rather than whenever a copy
 *  happened to land. */
StructuredBuffer<float> SimRestoreBuffer;
RWStructuredBuffer<float> SimCaptureBuffer;

/** Zero when no volume is bound. PITFALL: the decode recentres a unipolar bake,
 *  and a missing volume binds black, which decodes to a CONSTANT -1 rather than
 *  to nothing -- a uniform vorticity source rather than an absent one, which the
 *  solvability projection only removes a step late. */
int SimHasForcing;

// -- Helpers ----------------------------------------------------------------

/** Per-layer jet profile. Layer 0 is the visible top deck. */
void SimLayerJets(uint Layer, out float BandCount, out float JetStrength, out float Boost, out float Asymmetry)
{
    const float4 Profile = SimLayerProfile[min(Layer, 7u)];

    BandCount = SimJetParams.x;
    JetStrength = SimJetParams.y * Profile.x;
    Boost = SimJetParams.z * Profile.y;
    Asymmetry = SimJetParams.w;
}

/** Planetary vorticity at this latitude. */
float SimPlanetary(float Mu)
{
    return SimPlanetaryVorticity * Mu;
}

float SimSampleForcing(float3 UVW)
{
    if (SimHasForcing == 0)
    {
        return 0.0f;
    }

    const float4 S = SimForcingNoise.SampleLevel(SimForcingNoiseSampler, UVW, 0.0f);

    const float Raw = (SimForcingChannel == 0) ? S.r
		: (SimForcingChannel == 1) ? S.g
		: (SimForcingChannel == 2) ? S.b : S.a;

	// Both branches centre on zero. Forcing with a DC offset is a uniform
	// vorticity source, which the solvability projection then has to remove
	// every step.
    return (SimForcingBipolar != 0) ? Raw : (Raw * 2.0f - 1.0f);
}

bool SimOutOfBounds(uint3 Id)
{
    return any(int3(Id) >= SimGridSize);
}

// INITIALISATION, CONSTRUCTED RATHER THAN SPUN UP FROM REST. The expensive part
// of a real spin-up is the inverse cascade organising jets out of isotropic
// forcing, and the jets here are prescribed, so that phase is skipped entirely.
// What remains is eddies finding a self-consistent relationship with jets that
// already exist, which is tens of turnovers rather than thousands.
//
// That makes baking the converged state OPTIONAL: worth doing at ship time if a
// planet must look identical every session, but running it at load keeps the
// profile parameters live rather than things that need a re-bake to be seen.

/** Zonal streamfunction per row, by quadrature. Dispatch (N_lat, LayerCount, 1).
 *
 *  psi_zonal(mu) = -integral of R(mu') dmu' from -1 to mu, since for a zonal
 *  flow of angular rate R, u_east = -cos(phi) dpsi/dmu with u_east = R cos(phi)
 *  gives dpsi/dmu = -R directly. A per-row 1D pass, since computing a 1D
 *  integral for every column is N_lon times the work for an identical answer.
 *
 *  Midpoint rule on the grid's own rows, so the discrete psi is consistent with
 *  the discrete Laplacian that will invert it. Consistency matters more than
 *  order of accuracy here: the first Poisson solve should have almost nothing
 *  to do. */
[numthreads(GG_SIM_THREADS_1D, 1, 1)]
void MainInitZonalPotentialCS(uint3 Id : SV_DispatchThreadID)
{
    const int Row = (int) Id.x;
    const uint Layer = Id.y;

    if (Row >= SimGridSize.y || (int) Layer >= SimGridSize.z)
    {
        return;
    }

    float BandCount, JetStrength, Boost, Asymmetry;
    SimLayerJets(Layer, BandCount, JetStrength, Boost, Asymmetry);

    const float DMu = 2.0f * SimInvGridSize.y;

    float Psi = 0.0f;

	[loop]
    for (int J = 0; J <= Row; J++)
    {
        const float Mu = SimRowToMu((float) J);
        const float R = GG_ZonalRate(Mu, BandCount, JetStrength, Boost, Asymmetry, SimWidthBias);

		// Half weight on the row being written, so the accumulated value lands
		// at the texel CENTRE rather than at its upper face. Getting this wrong
		// offsets psi by half a row, which puts the jets half a band off the
		// vorticity that is supposed to be producing them.
        const float Weight = (J == Row) ? 0.5f : 1.0f;

        Psi -= R * DMu * Weight;
    }

	// Written into the row-mean buffer, which is idle at init and has exactly
	// the right shape. Called out because a per-row streamfunction living in
	// something named RowMean reads as a copy-paste error otherwise; it is not,
	// and the alternative is a second (N_lat x Layers) resource allocated for
	// the lifetime of the sim to be used once.
    SimRowMeanUAV[int2(Row, Layer)] = Psi;
}

/** Broadcast the per-row zonal streamfunction across longitude. Dispatch
 *  (N_lon, N_lat, LayerCount).
 *
 *  PURELY ZONAL, with no eddy seed. Held sub-marginal the jets are
 *  barotropically unstable and grow their own eddies from round-off within tens
 *  of turnovers; held super-marginal they are stable and a seed grows nothing
 *  either, the stochastic forcing being the eddy source there. Neither regime
 *  needs one. */
[numthreads(GG_SIM_THREADS_2D, GG_SIM_THREADS_2D, 1)]
void MainInitPotentialCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    const int2 C = int2(Id.xy);
    const uint Layer = Id.z;

    SimPsiUAV[int3(C, Layer)] = SimRowMeanSRV.Load(int3(C.y, Layer, 0));
}

/** Vorticity from the zonal streamfunction, through the SAME discrete operator
 *  the solver will invert. Dispatch (N_lon, N_lat, LayerCount).
 *
 *  Not the analytic vorticity: the grid Laplacian of the grid streamfunction
 *  lands exactly in the RANGE of the discrete operator, so the first Poisson
 *  solve reproduces the seed psi to round-off and the sim starts in equilibrium
 *  with itself. The continuum expression leaves a truncation-sized residual
 *  everywhere, which the solver radiates away over its first several steps --
 *  at high latitude, where the operator is stiffest, a ring of spurious
 *  circulation appearing and then decaying. */
[numthreads(GG_SIM_THREADS_2D, GG_SIM_THREADS_2D, 1)]
void MainInitVorticityCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    float Diagonal;
    SimVorticityUAV[int3(Id)] = SimLaplacian(SimPsiSRV, int2(Id.xy), Id.z, Diagonal);
}

// ---------------------------------------------------------------------------
// Velocity, and the texture the material reads
// ---------------------------------------------------------------------------

/** Writes float4(u_east, u_north, psi_eddy, zeta_normalized). RGBA16F, which is
 *  ample: everything here is O(1) after normalization. Dispatch
 *  (N_lon, N_lat, LayerCount).
 *
 *  TANGENT COMPONENTS RATHER THAN A 3D VECTOR, WHICH BUYS A CHANNEL. A tangent
 *  vector on a sphere has two degrees of freedom, and the material rebuilds the
 *  third from the direction it already has with no trig -- about ten ALU against
 *  a whole channel.
 *
 *  THE CHANNEL GOES TO VORTICITY, which is what the bands are. Drawing them
 *  analytically from latitude instead puts them off the flow that makes them,
 *  since zeta and the rate profile do not share zero crossings; sampling zeta
 *  removes the second definition, and because the sim TRANSPORTS zeta the bands
 *  arrive already meandering and wrapped around vortices.
 *
 *  NORMALIZED HERE, NOT IN THE MATERIAL. Zeta scales with
 *  JetStrength * BandCount, so a raw value would need both threaded into the
 *  material purely to divide by them. Dividing here makes the channel a signed
 *  band signal near [-1,1] and lets the material forget the jet profile exists.
 *  Psi in z is the EDDY field, zonal mean removed; see SimPsiRowMeanSRV. */
[numthreads(GG_SIM_THREADS_2D, GG_SIM_THREADS_2D, 1)]
void MainVelocityCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    const int2 C = int2(Id.xy);
    const uint Layer = Id.z;

    const float DLon = (2.0f * PI) * SimInvGridSize.x;
    const float DMu = 2.0f * SimInvGridSize.y;

    const float Lon = SimColumnToLon((float) C.x);
    const float Mu = SimRowToMu((float) C.y);
    const float CosPhi = sqrt(1.0f - Mu * Mu);

	// Taps inline: there is exactly one consumer of the streamfunction gradient,
	// so a helper in the common header would be an entry point nothing calls.
    const float Psi = SimLoad(SimPsiSRV, C, Layer);

    const float West = SimLoad(SimPsiSRV, C + int2(-1, 0), Layer);
    const float East = SimLoad(SimPsiSRV, C + int2(1, 0), Layer);
    const float South = SimLoad(SimPsiSRV, C + int2(0, -1), Layer);
    const float North = SimLoad(SimPsiSRV, C + int2(0, 1), Layer);

	// u = N x grad(psi), which on the sphere gives
	//     u_east  = -cos(phi) dpsi/dmu
	//     u_north =  (1/cos(phi)) dpsi/dlambda
	//
	// Centred differences, both through SimWrapCoord, so the longitude one is
	// correct at the seam and the mu one crosses the pole by the mirror -- right
	// there, since the mirrored value is the real field on the far side rather
	// than a boundary approximation. The 1/cos(phi) on the north component is the
	// one genuinely singular term, bounded by the cell-centred grid and by the
	// zonal filter, which is what keeps it off the CFL at high latitude.
    const float UEast = -CosPhi * ((North - South) / (2.0f * DMu));
    const float UNorth = ((East - West) / (2.0f * DLon)) / CosPhi;

	// The zonal part removed, so z is the EDDY streamfunction. Applied only to
	// the value written out: the row mean varies with latitude, so subtracting it
	// before differencing would corrupt the zonal velocity it must leave alone.
    const float PsiMean = SimPsiRowMeanSRV.Load(int3(C.y, Layer, 0));

	// Zonal vorticity scale: the peak of |2 mu R - (1-mu^2) R'|, dominated by
	// the R' term, which is what carries the band wavenumber. Per layer, so a
	// layer running a weaker profile normalizes against its own contrast rather
	// than the top deck's.
    float BandCount, JetStrength, Boost, Asymmetry;
    SimLayerJets(Layer, BandCount, JetStrength, Boost, Asymmetry);

    const float ZetaScale = max(JetStrength * 0.6897f * BandCount * PI, 1e-4f);

    const float Vorticity = SimLoad(SimVorticitySRV, C, Layer);

	// Psi scale. Psi is velocity times length, so an eddy of speed ~JetStrength
	// at the band scale ~1/(BandCount*pi) gives this. Approximate, which is
	// fine: the soft saturation below is what actually bounds the channel.
    const float PsiScale = max(JetStrength / max(BandCount * PI, 1e-3f), 1e-5f);

    const float PsiNorm = (Psi - PsiMean) / PsiScale;

	// SOFT SATURATION, so the channel is GUARANTEED to lie in [-1,1]. Not
	// cosmetic: GG_TopBounds bounds the marched span in closed form from the
	// relief amounts, and that bound assumes this channel is bounded. Unbounded,
	// a strong vortex pushes its cloud top above the computed outer radius and
	// the march clips it -- a storm with its top sliced flat, which reads as a
	// geometry bug rather than a bounds one. x / sqrt(1 + x^2) is linear near
	// zero, asymptotes to +-1, costs one rsqrt, and compresses rather than
	// clips.
    const float PsiSat = PsiNorm * rsqrt(1.0f + PsiNorm * PsiNorm);

    SimVelocityUAV[int3(C, Layer)] = float4(UEast, UNorth, PsiSat, Vorticity / ZetaScale);
}

// ---------------------------------------------------------------------------
// Advection
// ---------------------------------------------------------------------------

/** Semi-Lagrangian advection of ABSOLUTE vorticity q = omega + f. Dispatch
 *  (N_lon, N_lat, LayerCount).
 *
 *  ABSOLUTE RATHER THAN RELATIVE, AND THIS IS WHERE BETA ENTERS. Relative
 *  vorticity is not materially conserved on a rotating sphere; absolute
 *  vorticity is. Advecting omega alone loses the Rossby wave restoring force
 *  entirely, and with it the arrest of the cascade. Sample q at the departure
 *  point, subtract f at the ARRIVAL point: a parcel that moved poleward arrives
 *  with the f it had where it came from, so its relative vorticity drops to
 *  compensate, and that difference IS the beta effect.
 *
 *  THE BACKTRACE IS AN EXACT GREAT-CIRCLE ROTATION, not normalize(N - u dt).
 *  PITFALL: displacing along the tangent and renormalizing moves along a CHORD,
 *  short by cos(theta), dragging the departure point toward its starting
 *  latitude. Third order in one step and tolerable in isolation, but systematic,
 *  and it accumulates over hundreds of steps into a slow poleward or
 *  equatorward creep of everything the flow carries. With a = N x u_hat the
 *  frame {N, u_hat, a} is orthonormal and a x N is u_hat, so Rodrigues collapses
 *  to two terms and one sincos. */
[numthreads(GG_SIM_THREADS_2D, GG_SIM_THREADS_2D, 1)]
void MainAdvectCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    const int2 C = int2(Id.xy);
    const uint Layer = Id.z;

    const float Lon = SimColumnToLon((float) C.x);
    const float Mu = SimRowToMu((float) C.y);
    const float3 N = SimDirection(Lon, Mu);

	// RECONSTRUCTED, not read as .xyz. PITFALL: the velocity texture stores
	// east/north COMPONENTS in xy with psi and vorticity in zw, so reading .xyz
	// treats the streamfunction as a third velocity component and advects along a
	// vector that is not tangent, not divergence-free and not the flow. The sim
	// collapses to a lopsided blob within a few hundred steps while every
	// diagnostic still reports plausible numbers.
    const float4 Flow = SimVelocitySRV.Load(int4(C.x, C.y, Layer, 0));

    const float3 Velocity = GG_TangentVelocity(N, Flow.xy);

    const float Speed = length(Velocity);

    float3 Departure = N;

    if (Speed > 1e-8f)
    {
        const float3 UHat = Velocity / Speed;
        const float Theta = Speed * SimDeltaTime;

        float SinT, CosT;
        sincos(Theta, SinT, CosT);

		// Backward along the great circle: forward is N cos + UHat sin.
        Departure = normalize(N * CosT - UHat * SinT);
    }

    const float2 Grid = SimDirectionToGrid(Departure);

	// mu at the departure point is just its z component. No asin, and no
	// dependence on the interpolation, so the planetary vorticity being
	// subtracted is exact rather than reconstructed.
    const float QDeparture = SimSampleCubic(SimVorticitySRV, Grid, Layer) + SimPlanetary(Departure.z);

    SimVorticityUAV[int3(C, Layer)] = QDeparture - SimPlanetary(Mu);
}

// REDUCTIONS. Both are trivially cheap because the grid is equal-area: a zonal
// mean is a plain row mean, the global mean a plain mean of those, no area
// weights anywhere. On any other spherical grid both carry a cos(phi) or a
// Jacobian, and getting one slightly wrong produces a slightly nonzero global
// mean that the Poisson solve cannot satisfy.

/** Dispatch (N_lat, LayerCount, 1). */
[numthreads(GG_SIM_THREADS_1D, 1, 1)]
void MainReduceRowsCS(uint3 Id : SV_DispatchThreadID)
{
    const int Row = (int) Id.x;
    const uint Layer = Id.y;

    if (Row >= SimGridSize.y || (int) Layer >= SimGridSize.z)
    {
        return;
    }

    float Sum = 0.0f;

	[loop]
    for (int I = 0; I < SimGridSize.x; I++)
    {
        Sum += SimVorticitySRV.Load(int4(I, Row, Layer, 0));
    }

    SimRowMeanUAV[int2(Row, Layer)] = Sum * SimInvGridSize.x;
}

/** Zonal mean of the streamfunction, one value per row.
 *
 *  Separate from MainReduceRowsCS because the two are needed at different
 *  points in the step: the vorticity mean feeds the nudge, which runs after
 *  advection, while this feeds the velocity pass, which runs before it.
 *
 *  Dispatch (N_lat, LayerCount, 1). */
[numthreads(GG_SIM_THREADS_1D, 1, 1)]
void MainReducePsiRowsCS(uint3 Id : SV_DispatchThreadID)
{
    const int Row = (int) Id.x;
    const uint Layer = Id.y;

    if (Row >= SimGridSize.y || (int) Layer >= SimGridSize.z)
    {
        return;
    }

    float Sum = 0.0f;

	[loop]
    for (int I = 0; I < SimGridSize.x; I++)
    {
        Sum += SimPsiSRV.Load(int4(I, Row, Layer, 0));
    }

    SimPsiRowMeanUAV[int2(Row, Layer)] = Sum * SimInvGridSize.x;
}

/** Dispatch (LayerCount, 1, 1). */
[numthreads(GG_SIM_THREADS_LAYERS, 1, 1)]
void MainReduceGlobalCS(uint3 Id : SV_DispatchThreadID)
{
    const uint Layer = Id.x;

    if ((int) Layer >= SimGridSize.z)
    {
        return;
    }

    float Sum = 0.0f;

	[loop]
    for (int J = 0; J < SimGridSize.y; J++)
    {
        Sum += SimRowMeanSRV.Load(int3(J, Layer, 0));
    }

    SimGlobalMeanUAV[int2(0, Layer)] = Sum * SimInvGridSize.y;
}

// ---------------------------------------------------------------------------
// Forcing
// ---------------------------------------------------------------------------

/** Nudging strength toward the prescribed zonal profile, per unit time.
 *
 *  PRESCRIBED AND EMERGENT ARE NOT A FORK: both are a source term on omega
 *  differing only in what is added, so both are written here with independent
 *  coefficients rather than as two code paths. High here with
 *  SimForcingAmplitude at zero holds the profile still, which is what lets
 *  advection and the Poisson solve be checked separately against known answers.
 *
 *  Note what is nudged: the zonal MEAN, not the field. Nudging the field erases
 *  every eddy each step and makes the sim an expensive way to evaluate
 *  GG_ZonalRate. */
float SimNudgeRate;

/** Stochastic small-scale forcing. A tiling band-limited noise volume sampled at
 *  a drifting position is isotropic, band-limited at a chosen wavenumber, and
 *  temporally decorrelating for free. */
float SimForcingAmplitude;
float SimForcingScale;
float3 SimForcingDrift;

/** Linear drag on the EDDY part of the vorticity, per unit time. Two-dimensional
 *  turbulence needs a large-scale sink or energy accumulates at the domain scale
 *  and the field ends as one hemispheric vortex. Damping all vorticity scales
 *  equally is weighted as 1/k^2 in ENERGY, so it bites hardest at the largest
 *  scales, which is where the arrest is wanted. Eddy part only: the zonal mean
 *  has its own nudge, and dragging it too would fight that. */
float SimDragRate;

/** Relaxation between vertically adjacent layers, per unit time. Weak
 *  deliberately: Taylor-Proudman says columns move together, so strong coupling
 *  is the correct limit and also the one where the stack collapses to a single
 *  layer and buys nothing. The useful regime is weak enough that layers keep
 *  distinct jets and real vertical shear, but not zero, so a vortex in one layer
 *  leaves an impression in the next and the stack reads as one atmosphere rather
 *  than as separate transparencies.
 *
 *  A crude stand-in for the interface term of a two-layer quasi-geostrophic
 *  model, which would couple layers through the Poisson solve itself and give
 *  baroclinic instability as a genuine eddy source. */
float SimLayerCoupling;

/** Dispatch (N_lon, N_lat, LayerCount). */
[numthreads(GG_SIM_THREADS_2D, GG_SIM_THREADS_2D, 1)]
void MainForceCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    const int2 C = int2(Id.xy);
    const uint Layer = Id.z;

    const float Lon = SimColumnToLon((float) C.x);
    const float Mu = SimRowToMu((float) C.y);

    const float4 Profile = SimLayerProfile[min(Layer, 7u)];

    float Omega = SimVorticitySRV.Load(int4(C.x, C.y, Layer, 0));

    const float ZonalMean = SimRowMeanSRV.Load(int3(C.y, Layer, 0));
    const float Eddy = Omega - ZonalMean;

	// -- Zonal nudge --------------------------------------------------------

    float BandCount, JetStrength, Boost, Asymmetry;
    SimLayerJets(Layer, BandCount, JetStrength, Boost, Asymmetry);

    const float Target = GG_ZonalVorticity(Mu, BandCount, JetStrength, Boost, Asymmetry, SimWidthBias);

    Omega += SimNudgeRate * SimDeltaTime * (Target - ZonalMean);

	// -- Stochastic forcing -------------------------------------------------

    const float3 N = SimDirection(Lon, Mu);
    const float3 ForcingUVW = N * SimForcingScale
		+ SimForcingDrift * SimTime
		+ float3(0.13f, 0.29f, 0.71f) * (float) Layer;

	// FORCING AMPLITUDE IS AN EQUILIBRIUM, NOT A RATE. With forcing F and linear
	// drag, d(omega)/dt = F - Drag*omega settles at omega = F/Drag, so a raw
	// amplitude sets eddy strength only in combination with the drag -- and drag
	// is the primary handle for arresting the cascade, so touching it would
	// silently retune the eddies. Multiplying by the drag rate here makes the
	// parameter the equilibrium eddy vorticity directly.
	//
	// Consequence: at DragRate zero there is no forcing, because there is no
	// equilibrium to aim at. Unforced and undamped is a different model.
    const float ForcingRate = SimForcingAmplitude * SimDragRate * Profile.z;

    Omega += ForcingRate * SimDeltaTime * SimSampleForcing(ForcingUVW);

	// -- Vertical coupling --------------------------------------------------

    if (SimLayerCoupling > 0.0f && SimGridSize.z > 1)
    {
		// AVERAGE ONLY GENUINE NEIGHBOURS.
		//
		// Clamping the neighbour index at the ends makes an end layer average
		// with ITSELF, and the self term cancels half of (Neighbour - Omega).
		// So layer 0 and the deepest layer relax at half the authored rate
		// while the interior relaxes at the full rate -- a vertical asymmetry
		// that is invisible in the parameter and shows up as the top and bottom
		// of the stack behaving differently from the middle for no stated
		// reason. Layer 0 is the visible deck, so it is the one that is wrong.
        const int Last = SimGridSize.z - 1;
        const int Self = (int) Layer;

        float Sum = 0.0f;
        float Count = 0.0f;

        if (Self > 0)
        {
            Sum += SimVorticitySRV.Load(int4(C.x, C.y, Self - 1, 0));
            Count += 1.0f;
        }

        if (Self < Last)
        {
            Sum += SimVorticitySRV.Load(int4(C.x, C.y, Self + 1, 0));
            Count += 1.0f;
        }

		// Count is at least one, since the enclosing branch guarantees more
		// than one layer exists.
        const float Neighbour = Sum / Count;

        Omega += SimLayerCoupling * SimDeltaTime * (Neighbour - Omega);
    }

	// -- Drag ---------------------------------------------------------------

    Omega -= SimDragRate * Profile.w * SimDeltaTime * Eddy;

	// -- Solvability --------------------------------------------------------

	// The Poisson problem on a CLOSED surface is solvable only if the source
	// integrates to zero: the integral of a Laplacian over a closed manifold is
	// identically zero, so no psi can produce a source that is not.
	//
	// PITFALL: analytically the vorticity does integrate to zero, but numerically
	// it drifts, interpolation not being conservative and the forcing terms not
	// mean-free. A nonzero mean does not crash the solver, it makes it fail to
	// converge slowly, and the residual shows up as psi growing without bound
	// over minutes of runtime. Projecting the mean out costs one subtraction.
    Omega -= SimGlobalMeanSRV.Load(int3(0, Layer, 0));

    SimVorticityUAV[int3(C, Layer)] = Omega;
}

// ---------------------------------------------------------------------------
// Polar filter
// ---------------------------------------------------------------------------

float SimFilterLatitude;
int SimFilterMaxHalfWidth;


/** Longitudinal box filter on VORTICITY -- not on psi, which inherits the
 *  smoothing through the Poisson solve. Widens toward the poles; see
 *  SimFilterHalfWidth for why it exists. Dispatch (N_lon, N_lat, LayerCount).
 *
 *  A box rather than a Gaussian: the cutoff is crude in wavenumber, but what is
 *  being enforced is a resolution limit rather than a spectrum, and a box of
 *  width 1/cos(phi) restores uniform effective spacing exactly. Being a running
 *  mean it is exactly conservative in the row, so it cannot perturb the zonal
 *  mean the nudge just set. */
[numthreads(GG_SIM_THREADS_2D, GG_SIM_THREADS_2D, 1)]
void MainPolarFilterCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    const int2 C = int2(Id.xy);
    const uint Layer = Id.z;

    const float Mu = SimRowToMu((float) C.y);

    const int Half = SimFilterHalfWidth(Mu, SimFilterLatitude, SimFilterMaxHalfWidth);

    if (Half <= 0)
    {
		// Untouched, but still written: this pass ping-pongs, so a row that
		// skips the filter must still be copied or it reverts to whatever the
		// destination held two steps ago.
        SimVorticityUAV[int3(C, Layer)] = SimVorticitySRV.Load(int4(C.x, C.y, Layer, 0));
        return;
    }

    float Sum = 0.0f;

	[loop]
    for (int K = -Half; K <= Half; K++)
    {
        Sum += SimLoad(SimVorticitySRV, C + int2(K, 0), Layer);
    }

    SimVorticityUAV[int3(C, Layer)] = Sum / (float) (2 * Half + 1);
}

// POISSON SOLVE, RED-BLACK SOR. Multigrid or a Fourier transform in longitude
// are better in the worst case and the Fourier one is exact in a single pass,
// but this is not the worst case: the field changes very little in one step, so
// the PREVIOUS step's psi is an excellent initial guess and a warm-started
// iterative solver converges in a handful of sweeps. The one cold start is at
// init, off the frame budget, and can simply run more. If that stops holding --
// much higher resolution, or a much larger timestep -- the Fourier route is a
// drop-in replacement for this pass alone.
//
// RED-BLACK, so each sweep is two dispatches of opposite parity. Every thread
// reads only texels of the other colour, which no thread in that dispatch
// writes, so the update is in place with no ping-pong and no hazard.
// ---------------------------------------------------------------------------

/** Over-relaxation factor. 1 is plain Gauss-Seidel. The optimum for a Poisson
 *  problem of this size is somewhere near 1.8, and above 2 the iteration
 *  diverges -- not slowly, immediately. */
float SimRelaxation;

/** 0 updates texels where (i+j) is even, 1 where it is odd. */
int SimRedBlackParity;

/** Dispatch (N_lon, N_lat, LayerCount). */
[numthreads(GG_SIM_THREADS_2D, GG_SIM_THREADS_2D, 1)]
void MainPoissonCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    const int2 C = int2(Id.xy);
    const uint Layer = Id.z;

    if ((((C.x + C.y) & 1) != SimRedBlackParity))
    {
        return;
    }

	// Read back through the UAV rather than through a second view of the same
	// resource. Legal here precisely because of the red-black ordering: every
	// tap below is the opposite colour to this texel, so no thread in this
	// dispatch is writing any of them.
    const int2 W = SimWrapCoord(C + int2(-1, 0));
    const int2 E = SimWrapCoord(C + int2(1, 0));
    const int2 S = SimWrapCoord(C + int2(0, -1));
    const int2 N = SimWrapCoord(C + int2(0, 1));

    const float Centre = SimPsiUAV[int3(C, Layer)];

    float Diagonal;
    const float Applied = SimLaplacianFromTaps(
		C.y,
		Centre,
		SimPsiUAV[int3(W, Layer)],
		SimPsiUAV[int3(E, Layer)],
		SimPsiUAV[int3(S, Layer)],
		SimPsiUAV[int3(N, Layer)],
		Diagonal);

    const float Source = SimVorticitySRV.Load(int4(C.x, C.y, Layer, 0));

	// Residual correction. Diagonal is strictly negative, so no guard is needed
	// and none is written; a guard here would mask a grid or coefficient error
	// rather than fix one.
    SimPsiUAV[int3(C, Layer)] = Centre + SimRelaxation * (Source - Applied) / Diagonal;
}

// ---------------------------------------------------------------------------
// Snapshot capture and restore
//
// WHY THE STATE IS EXACTLY THESE TWO FIELDS.
//
// Everything else the sim holds is derived within a step: velocity comes from
// psi, the row means come from vorticity, the global mean from the row means.
// So vorticity and psi together are the complete state, and restoring them puts
// the sim precisely where it was rather than somewhere statistically similar.
//
// Psi is stored rather than recovered because recovering it means running the
// cold-start Poisson solve at load -- slow, and correct only to solver
// tolerance. Doubling three megabytes is the cheaper trade by a wide margin.
// ---------------------------------------------------------------------------

/** Flat index into the transfer buffer. Layer-major, then row, then column. */
int SimFlatIndex(uint3 Id)
{
    return (int) Id.z * SimGridSize.x * SimGridSize.y
		+ (int) Id.y * SimGridSize.x
		+ (int) Id.x;
}

/** Dispatch (N_lon, N_lat, LayerCount). */
[numthreads(GG_SIM_THREADS_2D, GG_SIM_THREADS_2D, 1)]
void MainCaptureCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    const int Index = SimFlatIndex(Id);
    const int Total = SimGridSize.x * SimGridSize.y * SimGridSize.z;

    SimCaptureBuffer[Index] = SimVorticitySRV.Load(int4(Id.x, Id.y, Id.z, 0));
    SimCaptureBuffer[Total + Index] = SimPsiSRV.Load(int4(Id.x, Id.y, Id.z, 0));
}

/** Dispatch (N_lon, N_lat, LayerCount).
 *
 *  Replaces the seeding passes entirely when a snapshot is bound. No Poisson
 *  solve follows it: psi arrives already consistent with the vorticity it was
 *  captured alongside, so solving would only move it. */
[numthreads(GG_SIM_THREADS_2D, GG_SIM_THREADS_2D, 1)]
void MainRestoreCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    const int Index = SimFlatIndex(Id);
    const int Total = SimGridSize.x * SimGridSize.y * SimGridSize.z;

    SimVorticityUAV[int3(Id)] = SimRestoreBuffer[Index];
    SimPsiUAV[int3(Id)] = SimRestoreBuffer[Total + Index];
}

// DEBUG VISUALISATION. Every field here is a signed scalar on a grid and every
// failure mode is a shape in one of them: a nudge fighting the drag is banded
// residual, a wrong Laplacian coefficient is a ring at fixed latitude, an
// under-converged solve is residual that never goes grey, an over-aggressive
// polar filter is a smeared cap. None of that is diagnosable through the
// finished material, where the field has been warped, composited, turned into
// cloud-top altitude and raymarched.
//
// POINT SAMPLED DELIBERATELY, at grid resolution: what is on screen is texels
// rather than a smoothed impression of them. Aliasing IS the signal -- a
// checkerboard in the residual is a red-black solver bug, and a filtered view
// would hide it.

RWTexture2D<float4> SimDebugUAV;

/** See GG_DEBUG_* below. */
int SimDebugMode;

/** Which layer of the stack to show. */
int SimDebugLayer;

/** Value mapped to full saturation. Everything is signed and O(JetStrength),
 *  so this usually wants to be a small multiple of it. */
float SimDebugScale;

int2 SimDebugSize;

#define GG_DEBUG_VORTICITY   0
#define GG_DEBUG_PSI         1
#define GG_DEBUG_SPEED       2
#define GG_DEBUG_EAST        3
#define GG_DEBUG_NORTH       4
#define GG_DEBUG_RESIDUAL    5
#define GG_DEBUG_ZONAL_ERROR 6

/** Diverging ramp. Blue negative, near-black zero, red positive.
 *
 *  Diverging rather than a heat ramp because every quantity here is SIGNED and
 *  the sign is the information -- cyclonic against anticyclonic, prograde
 *  against retrograde. A heat ramp puts zero at one end and makes the two
 *  circulation senses look like different magnitudes of the same thing.
 *
 *  Deliberately dark at zero, so that a field which has collapsed to nothing
 *  reads as an obviously empty frame rather than as a uniform mid-grey that
 *  could be mistaken for a working sim at low contrast. */
float3 SimSignedRamp(float V)
{
    const float T = clamp(V, -1.0f, 1.0f);

    const float3 Negative = float3(0.15f, 0.35f, 1.0f);
    const float3 Positive = float3(1.0f, 0.30f, 0.12f);

    return (T < 0.0f) ? Negative * (-T) : Positive * T;
}

/** Dispatch (DebugWidth, DebugHeight, 1). */
[numthreads(GG_SIM_THREADS_2D, GG_SIM_THREADS_2D, 1)]
void MainDebugVisCS(uint3 Id : SV_DispatchThreadID)
{
    if (any(int2(Id.xy) >= SimDebugSize))
    {
        return;
    }

    const uint Layer = (uint) clamp(SimDebugLayer, 0, SimGridSize.z - 1);

	// Nearest-neighbour into the grid. If the debug target is sized to the grid
	// this is exactly 1:1, which is the intended setup.
    const int2 C = int2(
		(int) ((float) Id.x / (float) SimDebugSize.x * SimGridSize.x),
		(int) ((float) Id.y / (float) SimDebugSize.y * SimGridSize.y));

    const float Mu = SimRowToMu((float) C.y);

    float Value = 0.0f;

    if (SimDebugMode == GG_DEBUG_VORTICITY)
    {
        Value = SimVorticitySRV.Load(int4(C.x, C.y, Layer, 0));
    }
    else if (SimDebugMode == GG_DEBUG_PSI)
    {
        Value = SimPsiSRV.Load(int4(C.x, C.y, Layer, 0));
    }
    else if (SimDebugMode == GG_DEBUG_SPEED)
    {
		// Unsigned, so it is shown on the positive half of the ramp only.
		// Components are already east and north, so the magnitude is a plain
		// length of the pair -- no basis reconstruction needed.
        Value = length(SimVelocitySRV.Load(int4(C.x, C.y, Layer, 0)).xy);
    }
    else if (SimDebugMode == GG_DEBUG_EAST)
    {
        Value = SimVelocitySRV.Load(int4(C.x, C.y, Layer, 0)).x;
    }
    else if (SimDebugMode == GG_DEBUG_NORTH)
    {
        Value = SimVelocitySRV.Load(int4(C.x, C.y, Layer, 0)).y;
    }
    else if (SimDebugMode == GG_DEBUG_RESIDUAL)
    {
		// THE CONVERGENCE DIAGNOSTIC. Laplacian(psi) - omega should be
		// featureless. Structure here means the solve has not converged, and
		// WHERE the structure is says why: concentrated at high latitude means
		// the operator is too stiff and the filter is not doing enough, spread
		// evenly means too few iterations, and a checkerboard means the
		// red-black parity is wrong.
        float Diagonal;
        const float Applied = SimLaplacian(SimPsiSRV, C, Layer, Diagonal);

        Value = Applied - SimVorticitySRV.Load(int4(C.x, C.y, Layer, 0));
    }
    else if (SimDebugMode == GG_DEBUG_ZONAL_ERROR)
    {
		// Is the nudge winning? This should sit near zero once spun up. A
		// persistent offset means NudgeRate is losing to DragRate, and a
		// pattern that alternates with the bands means the two are fighting at
		// the jet cores specifically -- which is the signature of the clamped
		// slope being wrong, so check GG_JetScaledSlope first.
        float BandCount, JetStrength, Boost, Asymmetry;
        SimLayerJets(Layer, BandCount, JetStrength, Boost, Asymmetry);

        const float Target = GG_ZonalVorticity(Mu, BandCount, JetStrength, Boost, Asymmetry, SimWidthBias);

        Value = SimRowMeanSRV.Load(int3(C.y, Layer, 0)) - Target;
    }

    const float3 Colour = SimSignedRamp(Value / max(SimDebugScale, 1e-6f));

    SimDebugUAV[int2(Id.xy)] = float4(Colour, 1.0f);
}
