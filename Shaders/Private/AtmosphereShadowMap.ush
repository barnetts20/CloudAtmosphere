#pragma once

// The shadow map's encoding, shared by the bake and the march. Model
// independent: a model supplies an AtmoShadowFrame (shell radius, depth unit,
// cascade half-widths) and both sides derive the basis, extents and depths from
// it here. PITFALL: a map read in a basis it was not written in gives smooth,
// plausible shadows in the wrong place, so nothing here is derived twice.
//
// INVERTED ENCODING: one slice per cascade holds the depths at which four fixed
// optical depths are crossed, so the nodes gather where the medium is dense.
// Depths are offsets from the analytic shell entry in thicknesses, for fp16;
// optical depth is on the fastest channel, the largest extinction tint the bake
// folds in, so the thresholds mean transmittance.

/** The four stored crossings, spaced by transmittance: 0.25 is a 22% loss, 1.0
 *  63%, 3.0 95%. The first is the silhouette, a threshold of the same subsampled
 *  accumulation, so it moves continuously as the medium advects; a geometric
 *  deck top would snap by whole texels. */
#ifndef ATMO_SHADOW_TAU_ENTRY
#define ATMO_SHADOW_TAU_ENTRY 0.02f
#endif

#ifndef ATMO_SHADOW_TAU0
#define ATMO_SHADOW_TAU0 0.25f
#endif

#ifndef ATMO_SHADOW_TAU1
#define ATMO_SHADOW_TAU1 1.0f
#endif

#ifndef ATMO_SHADOW_TAU2
#define ATMO_SHADOW_TAU2 3.0f
#endif

/** Optical depth at which the tail extrapolation stops, on the most
 *  transmissive term the caller exponentiates: a ceiling, not a cutoff (a hard
 *  threshold on a texel-interpolated field draws a staircase). PITFALL: slower
 *  channels and scattering octaves read the depth scaled down, so the caller
 *  divides this by the smallest such scale or they glow through saturated
 *  medium. */
#ifndef ATMO_SHADOW_SATURATION
#define ATMO_SHADOW_SATURATION 5.0f
#endif

/** Floor on that scale, which caps the ceiling for a barely attenuated term. */
#ifndef ATMO_SHADOW_MIN_TAU_SCALE
#define ATMO_SHADOW_MIN_TAU_SCALE 1e-3f
#endif

/** Written where a threshold is never reached or the ray misses the shell:
 *  past the longest chord down to a HeightScale of 1e-4, inside half float, so
 *  reconstruction reads zero without a validity test. */
#ifndef ATMO_SHADOW_NO_DECK
#define ATMO_SHADOW_NO_DECK 60000.0f
#endif

/** The map's reach past the cull radius, so the limb, where the depths vary
 *  fastest, has texels outside it to blend toward. Applied by the model. */
#ifndef ATMO_SHADOW_EXTENT_MARGIN
#define ATMO_SHADOW_EXTENT_MARGIN 1.02f
#endif

/** Per-sample lookup offset, in texels: a ray's samples average the texel
 *  neighbourhood, which matters where a view ray runs along the light and every
 *  sample lands in one texel. 0 disables. */
#ifndef ATMO_SHADOW_LOOKUP_JITTER
#define ATMO_SHADOW_LOOKUP_JITTER 1.0f
#endif

/** Angular warp of the map plane, a fraction of a quarter turn: 1 stores the
 *  disc against the angle from the sub-light point, 0 against the planar
 *  offset. Every cascade windows the one warped disc. At 1 the ground
 *  resolution is uniform over the lit hemisphere (7 times finer than planar at
 *  85 degrees), where planar texels near the terminator streak along the light;
 *  the cost is bake time on the grazing chords. */
#ifndef ATMO_SHADOW_DISC_WARP
#define ATMO_SHADOW_DISC_WARP 1.0f
#endif

/** Cascade count, fixed: level 0 covers the whole disc, and each inner level
 *  has its authored radius and its camera uniform. AtmoShadowBake::CascadeCount
 *  mirrors it. */
#define ATMO_SHADOW_CASCADES 3

/** Where a cascade starts handing over to the one outside it, a fraction of its
 *  half-width. PITFALL: the finer map band-limits finer and reads slightly
 *  denser, so a narrow band shows the seam as a ring. */
#ifndef ATMO_SHADOW_NEAR_BLEND
#define ATMO_SHADOW_NEAR_BLEND 0.75f
#endif

/** The map's geometry, the model's only contribution. */
struct AtmoShadowFrame
{
	/** Radius of the shell covered, before the extent margin: the depth axis's
	 *  anchor, the same on both sides. */
    float CullRadius;

	/** Depth unit. Stored and reconstructed depths are multiples of it. */
    float Thickness;

	/** Half-width per cascade, outermost first and non-increasing; zero
	 *  collapses a level. */
    float Extents[ATMO_SHADOW_CASCADES];
};

/** The smallest and largest channel of the two materials' extinction tints.
 *  The largest is folded into the stored depth and divided back out by the
 *  reader; the smallest sets the saturation ceiling. */
float2 AtmoShadow_ExtinctionTintRange(float3 CloudTint, float3 StormTint)
{
    const float3 Lo = min(CloudTint, StormTint);
    const float3 Hi = max(CloudTint, StormTint);

    return float2(min(Lo.x, min(Lo.y, Lo.z)), max(Hi.x, max(Hi.y, Hi.z)));
}

/** The map plane's axes for a normalized planet-local light: V toward the spin
 *  axis, so the lattice does not rotate (and shimmer) as the light moves.
 *  PITFALL: (U, V, L) is right-handed; the other order mirrors the map, which
 *  hides on a banded planet and puts shadows on the wrong side of lumps. */
void AtmoShadow_Basis(float3 L, out float3 OutU, out float3 OutV)
{
    float3 V = float3(0.0f, 0.0f, 1.0f) - L * L.z;

	// Light along the pole. Any perpendicular is as stable as any other there.
    if (dot(V, V) < 1e-6f)
    {
        V = float3(1.0f, 0.0f, 0.0f) - L * L.x;
    }

    OutV = normalize(V);
    OutU = cross(OutV, L);
}

/** The warp's angle: how far round the sphere the edge of the disc map sits. */
float AtmoShadow_WarpAngle()
{
    return saturate(ATMO_SHADOW_DISC_WARP) * (0.5f * PI);
}

/** Warped disc coordinate, [-1, 1] across cascade 0, to its plane offset over
 *  cascade 0's extent: radius sin(A S) / sin(A), held past S = 1. */
float2 AtmoShadow_DiscToPlane(float2 Q)
{
    const float A = AtmoShadow_WarpAngle();
    const float S = length(Q);

    if (A < 1e-3f)
    {
        return Q;
    }

    if (S < 1e-6f)
    {
        return Q * (A / sin(A));
    }

    return Q * (sin(A * min(S, 1.0f)) / (S * sin(A)));
}

/** The inverse: plane offset over cascade 0's extent to the disc coordinate. */
float2 AtmoShadow_PlaneToDisc(float2 P)
{
    const float A = AtmoShadow_WarpAngle();
    const float R = length(P);

    if (A < 1e-3f)
    {
        return P;
    }

    if (R < 1e-6f)
    {
        return P * (sin(A) / A);
    }

    return P * (asin(min(R * sin(A), 1.0f)) / (A * R));
}

/** The columns of AtmoShadow_DiscToPlane's Jacobian: a texel's footprint is an
 *  ellipse. */
void AtmoShadow_DiscJacobian(float2 Q, out float2 OutX, out float2 OutY)
{
    const float A = AtmoShadow_WarpAngle();
    const float S = length(Q);

    if (A < 1e-3f)
    {
        OutX = float2(1.0f, 0.0f);
        OutY = float2(0.0f, 1.0f);
        return;
    }

    const float InvSinA = 1.0f / sin(A);
    const float Clamped = min(S, 1.0f);

    const float Radial = A * cos(A * Clamped) * InvSinA;
    const float Tangential = (S < 1e-6f) ? A * InvSinA : sin(A * Clamped) / S * InvSinA;

    const float2 N = (S < 1e-6f) ? float2(1.0f, 0.0f) : Q / S;
    const float Cross = Radial - Tangential;

    OutX = float2(Tangential + Cross * N.x * N.x, Cross * N.x * N.y);
    OutY = float2(Cross * N.x * N.y, Tangential + Cross * N.y * N.y);
}

/** The camera each cascade was baked around, planet-local: levels bake on
 *  different frames, and a centre snapped from another camera can land a texel
 *  off. Level 0 is planet-centred. */
struct AtmoShadowCameras
{
    float3 Level[ATMO_SHADOW_CASCADES];
};

/** The cameras from the march's two uniforms. */
AtmoShadowCameras AtmoShadow_MakeCameras(float3 Camera1, float3 Camera2)
{
    AtmoShadowCameras Cameras;

    Cameras.Level[0] = float3(0.0f, 0.0f, 0.0f);
    Cameras.Level[1] = Camera1;
    Cameras.Level[2] = Camera2;

    return Cameras;
}

/** A cascade's half-width in disc coordinates, its planar Extent near the
 *  sub-light point. Level 0 spans the disc. */
float AtmoShadow_CascadeHalfWidth(int Level, float Extent, float Extent0)
{
    if (Level <= 0)
    {
        return 1.0f;
    }

    const float A = AtmoShadow_WarpAngle();
    const float Scale = (A < 1e-3f) ? 1.0f : sin(A) / A;

    return min(Extent / max(Extent0, 1e-6f) * Scale, 1.0f);
}

/** Centre of a cascade in disc coordinates, following the camera, snapped to
 *  its own texel grid. PITFALL: unsnapped, the lattice slides under the medium
 *  and every crossing depth crawls. */
float2 AtmoShadow_CascadeCentre(
	int Level, float3 CameraLocal, float3 U, float3 V, float HalfWidth, float Extent0, float2 MapSize)
{
    if (Level <= 0)
    {
        return float2(0.0f, 0.0f);
    }

    const float2 Disc = AtmoShadow_PlaneToDisc(
		float2(dot(CameraLocal, U), dot(CameraLocal, V)) / max(Extent0, 1e-6f));

    const float2 TexelSize = 2.0f * HalfWidth / max(MapSize, 1.0f);

    return floor(Disc / TexelSize) * TexelSize;
}

/** Optical depth from one texel's nodes at a depth: piecewise linear and
 *  monotone. Below the entry node the first rate runs back to zero (a clamp
 *  would step the entry threshold on at the silhouette); past the last node the
 *  final rate continues up to Ceiling. */
float AtmoShadow_TauFromNodes(float4 Node, float Depth, float Ceiling)
{
    const float EntrySpan = max(Node.y - Node.x, 1e-4f);

    if (Depth <= Node.x)
    {
        const float EntryRate = (ATMO_SHADOW_TAU0 - ATMO_SHADOW_TAU_ENTRY) / EntrySpan;

        return max(ATMO_SHADOW_TAU_ENTRY - (Node.x - Depth) * EntryRate, 0.0f);
    }

    if (Depth <= Node.y)
    {
        return lerp(ATMO_SHADOW_TAU_ENTRY, ATMO_SHADOW_TAU0,
			saturate((Depth - Node.x) / EntrySpan));
    }

    if (Depth <= Node.z)
    {
        return lerp(ATMO_SHADOW_TAU0, ATMO_SHADOW_TAU1,
			saturate((Depth - Node.y) / max(Node.z - Node.y, 1e-4f)));
    }

    if (Depth <= Node.w)
    {
        return lerp(ATMO_SHADOW_TAU1, ATMO_SHADOW_TAU2,
			saturate((Depth - Node.z) / max(Node.w - Node.z, 1e-4f)));
    }

    const float TailRate =
		(ATMO_SHADOW_TAU2 - ATMO_SHADOW_TAU1) / max(Node.w - Node.z, 1e-4f);

    return min(ATMO_SHADOW_TAU2 + (Depth - Node.w) * TailRate, Ceiling);
}

/** Optical depth from one cascade slice at a disc coordinate. The sampler must
 *  clamp: the taps land on texel centres, one past the map at its edges.
 *  PITFALL: four texels are reconstructed and then blended; blending the nodes
 *  first creases the result on the lattice wherever a segment boundary crosses
 *  a texel. PITFALL: the weights are linear; smoothstep weights draw the lattice
 *  as blocks along a long shadow. */
float AtmoShadow_TauSlice(
	Texture2DArray ShadowMap,
	SamplerState ShadowSampler,
	int Level,
	float2 Disc,
	float2 Centre,
	float HalfWidth,
	float Depth,
	float2 JitterTexels,
	float2 MapSize,
	float Ceiling)
{
    const float2 UV = (Disc - Centre) / HalfWidth * 0.5f + 0.5f;

    const float2 InvSize = 1.0f / MapSize;

    const float2 Sample = UV * MapSize - 0.5f + JitterTexels * ATMO_SHADOW_LOOKUP_JITTER;
    const float2 Base = floor(Sample);

    const float2 Frac = Sample - Base;

    const float3 UV00 = float3((Base + 0.5f) * InvSize, float(Level));

    const float4 N00 = ShadowMap.SampleLevel(ShadowSampler, UV00, 0.0f);
    const float4 N10 = ShadowMap.SampleLevel(ShadowSampler, UV00 + float3(InvSize.x, 0.0f, 0.0f), 0.0f);
    const float4 N01 = ShadowMap.SampleLevel(ShadowSampler, UV00 + float3(0.0f, InvSize.y, 0.0f), 0.0f);
    const float4 N11 = ShadowMap.SampleLevel(ShadowSampler, UV00 + float3(InvSize, 0.0f), 0.0f);

    const float T00 = AtmoShadow_TauFromNodes(N00, Depth, Ceiling);
    const float T10 = AtmoShadow_TauFromNodes(N10, Depth, Ceiling);
    const float T01 = AtmoShadow_TauFromNodes(N01, Depth, Ceiling);
    const float T11 = AtmoShadow_TauFromNodes(N11, Depth, Ceiling);

    return lerp(lerp(T00, T10, Frac.x), lerp(T01, T11, Frac.x), Frac.y);
}

/** What a lookup derives from the light, cameras and frame: built once per
 *  pixel. A zero half-width skips its level. */
struct AtmoShadowReader
{
    float3 L;
    float3 U;
    float3 V;
    float2 MapSize;
    float Extent0;
    float CullRadius;
    float Thickness;
    float2 Centre[ATMO_SHADOW_CASCADES];
    float HalfWidth[ATMO_SHADOW_CASCADES];
};

AtmoShadowReader AtmoShadow_MakeReader(
	Texture2DArray ShadowMap,
	float3 LightLocal,
	AtmoShadowCameras Cameras,
	AtmoShadowFrame Frame)
{
    AtmoShadowReader R;

    R.L = normalize(LightLocal);
    AtmoShadow_Basis(R.L, R.U, R.V);

    uint MapWidth, MapHeight, MapSlices;
    ShadowMap.GetDimensions(MapWidth, MapHeight, MapSlices);

    R.MapSize = float2(MapWidth, MapHeight);
    R.Extent0 = Frame.Extents[0];
    R.CullRadius = Frame.CullRadius;
    R.Thickness = Frame.Thickness;

    R.Centre[0] = float2(0.0f, 0.0f);
    R.HalfWidth[0] = 1.0f;

    UNROLL

    for (int Level = 1; Level < ATMO_SHADOW_CASCADES; Level++)
    {
        const float Extent = Frame.Extents[Level];

        R.HalfWidth[Level] = (Extent > 0.0f) ? AtmoShadow_CascadeHalfWidth(Level, Extent, R.Extent0) : 0.0f;

        R.Centre[Level] = (Extent > 0.0f)
			? AtmoShadow_CascadeCentre(Level, Cameras.Level[Level], R.U, R.V, R.HalfWidth[Level], R.Extent0, R.MapSize)
			: float2(0.0f, 0.0f);
    }

    return R;
}

/** Optical depth between a planet-local position and the light, on the fastest
 *  channel; Ceiling bounds the tail. Every cascade holds the whole field at its
 *  own extent from the same shell entry, walked outermost inward, a finer level
 *  replacing the result where it contains the point and blending at its edge.
 *  Valid anywhere inside the shell, so geometry below the deck reads its
 *  column the same way. */
float AtmoShadow_ReadTau(
	Texture2DArray ShadowMap,
	SamplerState ShadowSampler,
	AtmoShadowReader R,
	float3 LocalPos,
	float2 JitterTexels,
	float Ceiling)
{
	// Outside the shell and on its lit side, nothing lies toward the light.
    if (dot(LocalPos, LocalPos) >= R.CullRadius * R.CullRadius && dot(LocalPos, R.L) >= 0.0f)
    {
        return 0.0f;
    }

    const float2 Plane = float2(dot(LocalPos, R.U), dot(LocalPos, R.V));

	// The in-plane offset is the ray's closest approach to the centre.
    const float HalfChordSq = R.CullRadius * R.CullRadius - dot(Plane, Plane);

    if (HalfChordSq <= 0.0f)
    {
        return 0.0f;
    }

	// Depth from the shell entry, as the bake marched; shared by every cascade.
    const float Depth = (dot(LocalPos, -R.L) + sqrt(HalfChordSq)) / R.Thickness;

    const float2 Disc = AtmoShadow_PlaneToDisc(Plane / R.Extent0);

    float Tau = AtmoShadow_TauSlice(
		ShadowMap, ShadowSampler, 0, Disc, float2(0.0f, 0.0f), 1.0f,
		Depth, JitterTexels, R.MapSize, Ceiling);

    UNROLL

    for (int Level = 1; Level < ATMO_SHADOW_CASCADES; Level++)
    {
        const float HalfWidth = R.HalfWidth[Level];

        if (HalfWidth <= 0.0f)
        {
            continue;
        }

		// Square support, so the edge measure is the larger axis.
        const float2 Relative = (Disc - R.Centre[Level]) / HalfWidth;
        const float Edge = max(abs(Relative.x), abs(Relative.y));

        if (Edge >= 1.0f)
        {
            continue;
        }

        const float Finer = AtmoShadow_TauSlice(
			ShadowMap, ShadowSampler, Level, Disc, R.Centre[Level], HalfWidth, Depth,
			JitterTexels, R.MapSize, Ceiling);

        Tau = lerp(Finer, Tau, smoothstep(ATMO_SHADOW_NEAR_BLEND, 1.0f, Edge));
    }

    return Tau;
}

/** AtmoShadow_ReadTau for a single lookup, building its own reader. */
float AtmoShadow_Tau(
	Texture2DArray ShadowMap,
	SamplerState ShadowSampler,
	float3 LocalPos,
	float3 LightLocal,
	AtmoShadowCameras Cameras,
	float2 JitterTexels,
	float Ceiling,
	AtmoShadowFrame Frame)
{
    return AtmoShadow_ReadTau(ShadowMap, ShadowSampler,
		AtmoShadow_MakeReader(ShadowMap, LightLocal, Cameras, Frame), LocalPos, JitterTexels, Ceiling);
}

/** Material-weighted optical depth between a point on opaque geometry and the
 *  light, the fold constant divided back out; the caller applies the colour.
 *  PITFALL: the radial gate is needed, since the lookup admits any point inside
 *  the disc laterally, and one behind the planet reads the ceiling. Jitter is
 *  normally zero here: one tap per pixel has nothing to average it over. */
float AtmoShadow_SurfaceOptDepth(
	Texture2DArray ShadowMap,
	SamplerState ShadowSampler,
	float3 LocalPos,
	float3 LightLocal,
	AtmoShadowCameras Cameras,
	float2 JitterTexels,
	float Ceiling,
	AtmoShadowFrame Frame,
	float FoldConstant)
{
    if (dot(LocalPos, LocalPos) > Frame.CullRadius * Frame.CullRadius)
    {
        return 0.0f;
    }

    const float Tau = AtmoShadow_Tau(
		ShadowMap, ShadowSampler, LocalPos, LightLocal, Cameras, JitterTexels, Ceiling, Frame);

	// Per world unit, so no floor: zero means no cloud.
    return (FoldConstant > 0.0f) ? Tau / FoldConstant : 0.0f;
}
