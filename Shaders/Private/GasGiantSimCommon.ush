#pragma once

// Grid, topology and operators for the gas giant flow sim.
//
// THE GRID IS A CYLINDER, NOT A TORUS. Longitude wraps with period exactly
// 2 pi; latitude does not. The top and bottom rows are adjacent to the POLES,
// not to each other, and treating this as a torus joins the north pole to the
// south so material advected out of the arctic arrives in the antarctic. Every
// read here is an explicit Load through SimWrapCoord, because the pole is a
// topological fold no address mode expresses -- but the OUTPUT texture the
// material samples needs WRAP on U and CLAMP on V.
//
// THE LATITUDE COORDINATE IS MU = sin(latitude). The spherical Laplacian in
// (lambda, mu) has two closed-form coefficients and no cross terms; cells are
// equal AREA, so a zonal mean is a plain row mean and the global mean a plain
// mean of those, the most-used reductions in the model; and the material's V
// coordinate comes free as 0.5 + 0.5 * N.z with no asin.
//
// TEXEL CENTRES SIT BETWEEN THE POLES, NOT ON THEM. Cell-centred, so mu runs
// over [-1 + dmu/2, 1 - dmu/2] and the poles are cell FACES. The Laplacian's
// latitude coefficient is (1 - mu^2) at the face, EXACTLY ZERO at a pole face,
// so polar flux vanishes by construction and the operator needs no polar
// boundary condition -- no ghost rows, no reflection, no solver special case. A
// vertex-centred grid puts texels ON the poles, where 1/(1-mu^2) is infinite and
// a whole row represents one physical point, and then spends a boundary
// condition undoing the damage.
//
// The fold survives in one place: INTERPOLATION. A departure point can land past
// the pole, and crossing it means lambda -> lambda + pi. SimWrapCoord is the
// only function that knows this.

/** Grid dimensions. x = longitude columns, y = latitude rows, z = layer count.
 *  Longitude must be even: the polar fold offsets by N_lon/2 columns, and an odd
 *  width lands the reflection half a texel off. */
int3 SimGridSize;

/** float3(1/N_lon, 1/N_lat, unused). */
float3 SimInvGridSize;

// -- Coordinates ------------------------------------------------------------

/** Longitude of column i, in radians, at the texel CENTRE. */
float SimColumnToLon(float I)
{
    return (I + 0.5f) * SimInvGridSize.x * (2.0f * PI);
}

/** mu = sin(latitude) of row j, at the texel CENTRE. Never reaches +-1. */
float SimRowToMu(float J)
{
    return -1.0f + 2.0f * (J + 0.5f) * SimInvGridSize.y;
}

/** mu at the FACE between row J-1 and row J. Reaches exactly -1 at J = 0 and
 *  exactly +1 at J = N_lat, which is what zeroes the polar flux. */
float SimFaceToMu(float J)
{
    return -1.0f + 2.0f * J * SimInvGridSize.y;
}

/** Unit direction from grid coordinates. Right-handed, Z along the rotation
 *  axis, matching the material's planet-local space. */
float3 SimDirection(float Lon, float Mu)
{
	// cos(latitude), positive by construction since |mu| < 1 strictly on a
	// cell-centred grid. No guard: one here would hide a grid setup error rather
	// than fix one.
    const float C = sqrt(1.0f - Mu * Mu);

    float SinL, CosL;
    sincos(Lon, SinL, CosL);

    return float3(C * CosL, C * SinL, Mu);
}

/** Continuous grid coordinates from a unit direction. The inverse of
 *  SimDirection, in texel-index space so integer values land on centres. The
 *  sim's only atan2, run once per texel per advection step. */
float2 SimDirectionToGrid(float3 N)
{
    float Lon = atan2(N.y, N.x);

	// atan2 returns (-pi, pi]; the grid runs [0, 2 pi).
    Lon = (Lon < 0.0f) ? Lon + 2.0f * PI : Lon;

    const float I = Lon * (1.0f / (2.0f * PI)) * SimGridSize.x - 0.5f;
    const float J = (N.z + 1.0f) * 0.5f * SimGridSize.y - 0.5f;

    return float2(I, J);
}

// -- Topology ---------------------------------------------------------------

/** Fold an arbitrary integer texel coordinate onto the grid. THE ONE PLACE THE
 *  SPHERE'S TOPOLOGY LIVES.
 *
 *  Longitude is a plain periodic wrap, applied after the mirror since the mirror
 *  changes it. Latitude is a MIRROR with a half-turn in longitude, because
 *  stepping north past the pole comes back down the far side: row -1 is row 0 at
 *  longitude + pi. A clamp instead would duplicate the polar row and give the
 *  interpolator a flat spot exactly where the flow crosses the pole, reading as
 *  material piling up there and easy to mistake for a solver artifact. The
 *  half-turn is why N_lon must be even. */
int2 SimWrapCoord(int2 C)
{
    const int NLon = SimGridSize.x;
    const int NLat = SimGridSize.y;

	// Handles ONE crossing exactly. A departure point cannot travel more than a
	// fraction of the grid in a step, so a second crossing does not arise.
    if (C.y < 0)
    {
        C.y = -1 - C.y;
        C.x += NLon / 2;
    }
    else if (C.y >= NLat)
    {
        C.y = 2 * NLat - 1 - C.y;
        C.x += NLon / 2;
    }

	// Periodic longitude. Two-step modulo so negative inputs land correctly;
	// HLSL % keeps the sign of the dividend.
    C.x = ((C.x % NLon) + NLon) % NLon;

    return C;
}

// -- Sampling ---------------------------------------------------------------

/** Point read of a scalar field with full topology handling. */
float SimLoad(Texture2DArray<float> Field, int2 C, uint Layer)
{
    const int2 W = SimWrapCoord(C);

    return Field.Load(int4(W.x, W.y, Layer, 0));
}

/** Catmull-Rom weights for one axis. */
void SimCubicWeights(float F, out float W0, out float W1, out float W2, out float W3)
{
    const float F2 = F * F;
    const float F3 = F2 * F;

    W0 = 0.5f * (-F3 + 2.0f * F2 - F);
    W1 = 0.5f * (3.0f * F3 - 5.0f * F2 + 2.0f);
    W2 = 0.5f * (-3.0f * F3 + 4.0f * F2 + F);
    W3 = 0.5f * (F3 - F2);
}

/** Bicubic (Catmull-Rom) interpolation at continuous grid coordinates. Sixteen
 *  taps, all through SimWrapCoord, so it is correct across the longitude seam
 *  and across the poles; hardware bilinear cannot be used because no address
 *  mode expresses the polar fold.
 *
 *  PITFALL: BILINEAR HERE WOULD KILL THE INVERSE CASCADE, and would look like
 *  the physics failing rather than the interpolation. Semi-Lagrangian advection
 *  is not conservative, and its error is a numerical diffusion whose magnitude
 *  the interpolator sets. Bilinear diffuses at about the grid scale per step,
 *  and the inverse cascade is an inviscid property -- smear the small scales and
 *  it has nothing to feed on, so eddies vanish, the field relaxes to pure zonal
 *  flow within a couple hundred steps, and the planet has perfect bands and no
 *  weather. That reads as "the seeding didn't take" or "the forcing is too
 *  weak" and is neither.
 *
 *  Catmull-Rom overshoots at sharp gradients, which for vorticity is the
 *  anti-diffusion that keeps filaments sharp. It is NOT acceptable for a
 *  quantity that must stay positive; nothing advected here is. */
float SimSampleCubic(Texture2DArray<float> Field, float2 Grid, uint Layer)
{
	// INDEX SPACE, NOT UV SPACE: texel centres sit on INTEGERS here, because
	// that is what SimDirectionToGrid produces.
	//
	// PITFALL: the half-integer form floor(G - 0.5) + 0.5 is correct for UV*Size
	// coordinates, where centres sit at 0.5, 1.5, 2.5. Used on index-space input
	// it samples at G - 0.5 in BOTH axes, and a constant offset in the departure
	// point is indistinguishable from a constant velocity added to the flow. The
	// field drifts half a texel per step in +longitude and +mu regardless of what
	// the fluid is doing, which reads as a mysterious current rather than as an
	// interpolation bug.
    const float2 Base = floor(Grid);
    const float2 F = Grid - Base;

	// Catmull-Rom taps run from one before the containing texel to two after,
	// and the weights below put full weight on tap 1 when F is zero. So tap 1
	// must be floor(Grid), which makes the first tap floor(Grid) - 1.
    const int2 C0 = (int2) Base - int2(1, 1);

    float WX0, WX1, WX2, WX3;
    SimCubicWeights(F.x, WX0, WX1, WX2, WX3);

    float WY0, WY1, WY2, WY3;
    SimCubicWeights(F.y, WY0, WY1, WY2, WY3);

    const float WX[4] = { WX0, WX1, WX2, WX3 };
    const float WY[4] = { WY0, WY1, WY2, WY3 };

    float Sum = 0.0f;

	[unroll]
    for (int J = 0; J < 4; J++)
    {
		[unroll]
        for (int I = 0; I < 4; I++)
        {
            Sum += WX[I] * WY[J] * SimLoad(Field, C0 + int2(I, J), Layer);
        }
    }

    return Sum;
}

// -- Operators --------------------------------------------------------------

/** The five-point spherical Laplacian in (lambda, mu), FLUX FORM, which is why
 *  the polar boundary condition disappears. Writing
 *
 *      d/dmu[ (1-mu^2) dpsi/dmu ]  ~  [ A+ (psi_j+1 - psi_j) - A- (psi_j - psi_j-1) ] / dmu^2
 *
 *  with A+- at the cell FACES makes the coefficient at a polar face
 *  (1 - (+-1)^2) = 0 exactly in floating point, no epsilon, so polar flux is
 *  identically zero and no ghost row is consulted. The expanded form
 *  (1-mu^2) psi'' - 2 mu psi' evaluates its coefficients at cell centres, where
 *  they are not zero, and then needs a polar condition invented to compensate.
 *
 *  The longitude coefficient 1/(1-mu^2) still grows toward the poles, which the
 *  zonal filter bounds. That is a conditioning problem, not a correctness one.
 *
 *  Returns the operator and the DIAGONAL coefficient together: the solver needs
 *  both, and computing them separately is how the two drift apart. */
void SimLaplacianCoeffs(int Row, out float CLon, out float ALo, out float AHi)
{
    const float DLon = (2.0f * PI) * SimInvGridSize.x;
    const float DMu = 2.0f * SimInvGridSize.y;

    const float Mu = SimRowToMu((float) Row);

	// Faces bounding this row. At Row 0 the lower face is mu = -1 exactly and at
	// Row N_lat-1 the upper face is +1, so ALo or AHi is exactly zero there and
	// the mirrored neighbour is multiplied out.
    const float MuLo = SimFaceToMu((float) Row);
    const float MuHi = SimFaceToMu((float) (Row + 1));

    ALo = (1.0f - MuLo * MuLo) / (DMu * DMu);
    AHi = (1.0f - MuHi * MuHi) / (DMu * DMu);

	// 1/(1-mu^2) is finite on a cell-centred grid, mu coming no closer to +-1
	// than half a texel. The polar row's coefficient exceeds the equator's by
	// about N_lat/2 -- 128 at 256 rows -- which is stiff but bounded.
    CLon = 1.0f / ((1.0f - Mu * Mu) * DLon * DLon);
}

/** The operator, given its five taps. THE TAPS DIFFER BETWEEN CALL SITES, THE
 *  OPERATOR DOES NOT: the SOR sweep reads psi back through its own UAV rather
 *  than an SRV, since red-black ordering means no thread reads a texel another
 *  writes in the same dispatch. HLSL cannot write one function over both
 *  Texture2DArray and RWTexture2DArray, so the alternative was two copies of the
 *  coefficient math -- the kind of duplicate that gets edited once and stays
 *  wrong in the other copy. */
float SimLaplacianFromTaps(
	int Row,
	float Centre,
	float West,
	float East,
	float South,
	float North,
	out float OutDiagonal)
{
    float CLon, ALo, AHi;
    SimLaplacianCoeffs(Row, CLon, ALo, AHi);

    OutDiagonal = -(2.0f * CLon + ALo + AHi);

    return CLon * (West - 2.0f * Centre + East)
		+ AHi * (North - Centre)
		- ALo * (Centre - South);
}

float SimLaplacian(Texture2DArray<float> Field, int2 C, uint Layer, out float OutDiagonal)
{
    return SimLaplacianFromTaps(
		C.y,
		SimLoad(Field, C, Layer),
		SimLoad(Field, C + int2(-1, 0), Layer),
		SimLoad(Field, C + int2(1, 0), Layer),
		SimLoad(Field, C + int2(0, -1), Layer),
		SimLoad(Field, C + int2(0, 1), Layer),
		OutDiagonal);
}

/** Rebuilds the 3D tangent velocity from the stored east/north components. The
 *  velocity texture stores TWO, not three, a tangent vector on a sphere having
 *  two degrees of freedom and the freed channel being worth more elsewhere.
 *
 *  NO TRIG. With c = length(N.xy) the basis is east = (-N.y, N.x, 0)/c and
 *  north = (-N.z*N.x/c, -N.z*N.y/c, c), the vectors sincos(longitude) would
 *  give, obtained from N directly.
 *
 *  BYTE-IDENTICAL TO GasGiantFlow.ush's copy, under the same name: the sim
 *  advects along this and the material warps along it, so a mismatch would put
 *  the clouds on a different flow from the one that made them. The two files are
 *  never in one translation unit, so the shared name does not collide -- and if
 *  that ever changes, the redefinition error is the signal to merge them. */
float3 GG_TangentVelocity(float3 N, float2 Components)
{
    const float C = max(length(N.xy), 1e-5f);

    const float3 East = float3(-N.y, N.x, 0.0f) / C;
    const float3 North = float3(-N.z * N.x / C, -N.z * N.y / C, C);

    return East * Components.x + North * Components.y;
}

/** Half-width, in texels, of the longitudinal box filter at this latitude.
 *
 *  THE POLE PROBLEM. Physical longitudinal spacing is cos(phi) * dlambda, which
 *  goes to zero at the poles, and both consequences are fatal untreated: the
 *  advective CFL condition tightens without bound, so polar rows go unstable at
 *  a timestep the rest of the grid is comfortable with, and the Laplacian's
 *  1/(1-mu^2) coefficient makes the operator stiff enough that the solver stops
 *  converging there.
 *
 *  A running mean over 1/cos(phi) texels removes exactly the longitudinal
 *  wavenumbers the grid carries but the physical spacing cannot support,
 *  restoring uniform effective resolution without the bookkeeping of an actually
 *  reduced grid. A separate polar cap grid was the alternative: a second solver
 *  with a second metric and an overlap reconciled every step, whose error shows
 *  as a persistent ring at a fixed latitude -- a structural artifact that looks
 *  like a real atmospheric feature and is easy to ship by accident.
 *
 *  What it costs is polar detail. Jupiter's polar cyclone clusters are discrete
 *  and long-lived and would not emerge from a solve at this resolution anyway,
 *  so they belong on an authored-vortex path rather than being asked of the
 *  sim. */
int SimFilterHalfWidth(float Mu, float FilterLatitude, int MaxHalfWidth)
{
    const float CosPhi = sqrt(1.0f - Mu * Mu);

	// Above the threshold latitude nothing is filtered at all, so the tropics
	// and mid-latitudes -- where all the visible structure is -- are untouched.
    if (CosPhi >= FilterLatitude)
    {
        return 0;
    }

    const float Width = FilterLatitude / max(CosPhi, 1e-4f);

    return clamp((int) round((Width - 1.0f) * 0.5f), 0, MaxHalfWidth);
}
