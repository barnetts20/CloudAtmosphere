#pragma once

// Scene depth for the atmosphere passes, read from the view's depth buffer.
//
// PITFALL: NOT CalcSceneDepth. The engine's device-Z to depth conversion
// carries an epsilon that keeps a cleared sky from dividing by zero, and that
// epsilon is a saturation term: it returns z / (1 + 1e-8 z), so depth reads 1%
// short at 10 km, 50% short at 1,000 km, and never exceeds 1,000 km however far
// the geometry is. Reconstructing from the raw device Z and the projection has
// no such term and is exact to float32.

/** Ray distance returned where the depth buffer holds no geometry. Finite so it
 *  survives the segment math, which only takes minima against it. */
#ifndef ATMO_NO_OCCLUDER_DISTANCE
#define ATMO_NO_OCCLUDER_DISTANCE 1e30f
#endif

/** The view's scene depth, bound by each pass that reads it. */
Texture2D<float> AtmoSceneDepth;

/** Raw device Z at a depth buffer UV, at the texel a point sample would read,
 *  clamped to the view rect: the buffer is larger than the view under a screen
 *  percentage, texels outside it hold stale depth, and the last march cells
 *  can fall past its edge. */
float Atmo_LoadDeviceZ(float2 BufferUV)
{
    const float2 RectMin = View.ViewRectMin.xy;
    const float2 RectMax = RectMin + View.ViewSizeAndInvSize.xy - 1.0f;
    const int2 Texel = int2(clamp(BufferUV * View.BufferSizeAndInvSize.xy, RectMin, RectMax));

    return AtmoSceneDepth.Load(int3(Texel, 0));
}

/** View-axis depth from a raw device Z, inverting the projection in place.
 *  Perspective is deviceZ = A + B / z; orthographic is deviceZ = z * A + B.
 *  Reverse Z with an infinite far plane has A = 0 and clears the sky to 0, which
 *  the perspective branch reports as no occluder. */
float Atmo_DeviceZToDepth(float deviceZ)
{
    const float A = View.ViewToClip[2][2];
    const float B = View.ViewToClip[3][2];

    if (View.ViewToClip[3][3] >= 1.0f)
    {
        return (deviceZ - B) / A;
    }

    const float denom = deviceZ - A;

    return denom > 0.0f ? B / denom : ATMO_NO_OCCLUDER_DISTANCE;
}

/** Exact view-axis scene depth at a buffer UV. */
float Atmo_SceneDepthAt(float2 bufferUV)
{
    return Atmo_DeviceZToDepth(Atmo_LoadDeviceZ(bufferUV));
}

/** A view-axis scene depth as a TRUE RAY DISTANCE, the form the march spends
 *  as a bound on its ray parameter: the depth over the ray's cosine to the view
 *  axis. rayDir is the world direction through the pixel the depth was read at,
 *  so the depth and the ray it bounds come from one pixel by construction. */
float Atmo_SceneRayDistance(float depth, float3 rayDir)
{
    return depth / max(dot(rayDir, View.ViewForward), 1e-3f);
}
