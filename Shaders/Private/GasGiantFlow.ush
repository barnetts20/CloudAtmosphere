#pragma once

// Gas giant cloud deck: the field the march samples.
//
// A COLUMNAR HEIGHTFIELD WITH A DENSITY RAMP HANGING OFF IT. Every column has a
// top set by the simulated flow and carved by two noise volumes; below it the
// density ramps 0 to 1 over an authored thickness and stays at 1. Coverage is
// 100%, so every feature is relief in the top surface rather than opacity
// variation, and Band drives ALTITUDE: a zone is a raised deck of fresh ammonia
// ice, a belt is where the line of sight reaches warmer material. Band itself
// reaches the march untouched, to be spent on extinction and scattering colour.
//
// UNITS. Three absolutes, all atmosphere fractions: DeckTop, DeckBackstop and
// GradientThickness. Every relief amount, both carves, ErosionDepth and
// DeckSlope are fractions of GradientThickness. Thickness is the only
// world-space length. Space is planet-local, spin axis on Z, positions unit
// directions except in GG_Density.

/** Warp loop length. Each iteration past the first costs a flow fetch. */
#ifndef GG_WARP_ITERATIONS
#define GG_WARP_ITERATIONS 4
#endif

/** Which sim slice the deck reads. The coarse warp and the band signal come
 *  from GG_FLOW_LAYER, the fine shear from GG_DEEP_FLOW_LAYER, and the two being
 *  different is what produces vertical wind shear rather than one sheet dragged
 *  around.
 *
 *  Pitfall: both must be under GasGiantSimConfig::LayerCount. A slice past the
 *  end reads clamped rather than failing, so the shear quietly vanishes. */
#ifndef GG_FLOW_LAYER
#define GG_FLOW_LAYER 0
#endif

#ifndef GG_DEEP_FLOW_LAYER
#define GG_DEEP_FLOW_LAYER 1
#endif

/** How far a crossfade phase runs its advection ramp, as a multiple of the
 *  authored warp displacement. 2 so the mean over a cycle is the authored
 *  amount: each phase ramps from nothing to this and resets. At 1 the deck would
 *  read as half as advected with the crossfade on as with it off, so enabling
 *  the feature would change the look rather than only the motion. */
#ifndef GG_CROSSFADE_SPAN
#define GG_CROSSFADE_SPAN 2.0f
#endif

/** Whether the detail layer moves the deck top symmetrically about the noise
 *  median, as the structure layer does, or only downward. One-sided moves the
 *  mean deck with the fade, since the carve is scaled by DetailFade: the surface
 *  sinks on approach while thin features dissolve into it. Either amount may
 *  still be negative, mirroring the layer. GG_CarveReach follows this switch,
 *  and every bound goes through it. */
#ifndef GG_DETAIL_RELIEF_CENTRED
#define GG_DETAIL_RELIEF_CENTRED 1
#endif

/** Fraction of the cone-trace advance actually taken. Under 1 because DeckSlope
 *  is authored, and an under-declared slope is the one way the entry search
 *  steps over the surface. */
#ifndef GG_CONE_RELAXATION
#define GG_CONE_RELAXATION 0.9f
#endif

/** Cone-trace iteration cap. Reached only on rays that graze for their whole
 *  length, which return T1 and are treated as missing the deck. */
#ifndef GG_DECK_ENTRY_PROBES
#define GG_DECK_ENTRY_PROBES 24
#endif

/** Everything the field, density and deck-top functions read.
 *
 *  NAMES MATCH THE STACK: every authored member carries the name of its C++
 *  property, material parameter and Custom node pin, layer members taking their
 *  layer's prefix. Derived members are named for what they are, never reusing an
 *  authored name. The two fades are set per sample by the march. */
struct GGFieldParams
{
	// -- Authored ------------------------------------------------------------

    float PlanetRadius;

	/** Where an unrelieved column's top sits, an atmosphere fraction. Relief
	 *  shapes the deck around it and never moves it as a whole. */
    float DeckTop;

	/** Width of the band below the shell top across which density fades to
	 *  zero, an atmosphere fraction. Floored above zero. */
    float CeilingFalloff;

	/** How far the density ramp reaches below a column's own top, and the unit
	 *  every relief amount is a fraction of. Floored against division. */
    float GradientThickness;
    float DeckBackstop;
    float DensityCurve;

    float BandSharpness;
    float BandBias;
    float BandRelief;
    float PressureRelief;
    float VortexThreshold;
    float StormTowerRelief;
    float ReliefThinning;

    float WarpTime;
    float TurbulenceFloor;

    float EdgeBias;
    float ErosionDepth;

	/** Worley rung weights in xyz, the layer's amount in w. */
    float4 StructureNoiseWeights;
    float StructureScale;
    float StructureRelief;
    float StructureErosion;
    float StructureFlowInherit;
    float StructureShearInherit;
    float StructureFadeNear;
    float StructureBandMix;
    float StructureCrossfade;

    float4 DetailNoiseWeights;
    float DetailScale;
    float DetailRelief;
    float DetailErosion;
    float DetailFlowInherit;
    float DetailShearInherit;
    float DetailFadeNear;
    float DetailBandMix;
    float DetailCrossfade;

	/** Bound on the deck's slope, gradient depths per radian. Read only by the
	 *  entry search's cone angle. */
    float DeckSlope;

	// -- Derived -------------------------------------------------------------

	/** Atmosphere thickness in world units: the one absolute length here. */
    float Thickness;

	/** The deep flow layer's step length: WarpTime * DeepShearRatio. */
    float DeepShearTime;

	/** tanh argument per unit sin(latitude): the reciprocal of HemisphereBlend's
	 *  sine, so the blend reaches about three quarters of full strength at that
	 *  latitude. */
    float HemisphereSharpness;

    float SpinAngle;

	/** Elapsed time in crossfade periods. Only its fraction is read, so the two
	 *  phases sit half a period apart whatever the whole part is. */
    float CrossfadeTime;

	/** Noise units the shell spans vertically, per layer: Scale * Aspect *
	 *  HeightScale, which is what makes the aspect a ratio -- heights are
	 *  fractions of shell thickness while the horizontal scale is against planet
	 *  radius. */
    float StructureVertical;
    float DetailVertical;

	/** FadeNear + FadeSpan, held above FadeNear. */
    float StructureFadeFar;
    float DetailFadeFar;

	// -- Per sample ----------------------------------------------------------

	/** Per-layer level of detail, 1 at full strength and 0 faded out. Each
	 *  scales its layer's carve and erosion and gates the fetches feeding it. */
    float StructureFade;
    float DetailFade;
};

/** Fills GGFieldParams from the authored values, in panel order, and derives the
 *  rest. The bake calls it with the same values, so every derivation here is
 *  shared by the deck the eye sees and the deck the light sees. RotationWeight
 *  is the planet's own rotation; the sim runs in the rotating frame, so it
 *  applies to the sampling position rather than the flow, negated because
 *  rotating the sample point backwards carries the field forwards. */
GGFieldParams GG_BuildField(
	float PlanetRadius,
	float HeightScale,
	float Time,
	float DeckTop,
	float CeilingFalloff,
	float GradientThickness,
	float DeckBackstop,
	float DensityCurve,
	float BandSharpness,
	float BandBias,
	float HemisphereBlend,
	float BandRelief,
	float PressureRelief,
	float VortexThreshold,
	float StormTowerRelief,
	float ReliefThinning,
	float RotationWeight,
	float WarpTime,
	float DeepShearRatio,
	float TurbulenceFloor,
	float CrossfadePeriod,
	float EdgeBias,
	float ErosionDepth,
	float4 StructureNoiseWeights,
	float StructureScale,
	float StructureAspect,
	float StructureRelief,
	float StructureErosion,
	float StructureFlowInherit,
	float StructureShearInherit,
	float StructureFadeNear,
	float StructureFadeSpan,
	float StructureBandMix,
	float StructureCrossfade,
	float4 DetailNoiseWeights,
	float DetailScale,
	float DetailAspect,
	float DetailRelief,
	float DetailErosion,
	float DetailFlowInherit,
	float DetailShearInherit,
	float DetailFadeNear,
	float DetailFadeSpan,
	float DetailBandMix,
	float DetailCrossfade,
	float DeckSlope)
{
    GGFieldParams F;

    F.PlanetRadius = PlanetRadius;

    F.GradientThickness = max(GradientThickness, 1e-4f);
    F.DeckBackstop = DeckBackstop;
    F.DensityCurve = DensityCurve;

    F.BandSharpness = BandSharpness;
    F.BandBias = BandBias;
    F.BandRelief = BandRelief;
    F.PressureRelief = PressureRelief;
    F.VortexThreshold = VortexThreshold;
    F.StormTowerRelief = StormTowerRelief;
    F.ReliefThinning = ReliefThinning;

    F.WarpTime = WarpTime;
    F.TurbulenceFloor = TurbulenceFloor;

    F.EdgeBias = EdgeBias;
    F.ErosionDepth = ErosionDepth;

    F.StructureNoiseWeights = StructureNoiseWeights;
    F.StructureScale = StructureScale;
    F.StructureRelief = StructureRelief;
    F.StructureErosion = StructureErosion;
    F.StructureFlowInherit = StructureFlowInherit;
    F.StructureShearInherit = StructureShearInherit;
    F.StructureFadeNear = StructureFadeNear;
    F.StructureBandMix = StructureBandMix;
    F.StructureCrossfade = StructureCrossfade;

    F.DetailNoiseWeights = DetailNoiseWeights;
    F.DetailScale = DetailScale;
    F.DetailRelief = DetailRelief;
    F.DetailErosion = DetailErosion;
    F.DetailFlowInherit = DetailFlowInherit;
    F.DetailShearInherit = DetailShearInherit;
    F.DetailFadeNear = DetailFadeNear;
    F.DetailBandMix = DetailBandMix;
    F.DetailCrossfade = DetailCrossfade;

    F.DeckSlope = DeckSlope;

    F.Thickness = max(PlanetRadius * HeightScale, 1e-4f);

    F.DeckTop = DeckTop;
    F.CeilingFalloff = max(CeilingFalloff, 1e-3f);

    F.DeepShearTime = WarpTime * DeepShearRatio;
    F.SpinAngle = -RotationWeight * Time;

	// Floored against a zero width, which would make GG_Hemisphere a sign() and
	// seam along the equator.
    F.HemisphereSharpness = 1.0f / max(sin(radians(HemisphereBlend)), 1e-4f);

	// Time and period are both simulated seconds: Time is the sim's clock, which
	// already runs TimeScale times faster than real time, so the crossfade keeps
	// pace with the flow at any sim speed. PITFALL: scaling the period by
	// TimeScale too counts the speed twice. Floored so a zero period is a stopped
	// clock rather than a divide.
    F.CrossfadeTime = Time / max(CrossfadePeriod, 1e-3f);

    F.StructureVertical = StructureScale * StructureAspect * HeightScale;
    F.DetailVertical = DetailScale * DetailAspect * HeightScale;

	// Each far edge held above its own near one: equal endpoints make smoothstep
	// a step, and a step here is a ring across the disc at a fixed distance.
    F.StructureFadeFar = StructureFadeNear + max(StructureFadeSpan, 1e-4f);
    F.DetailFadeFar = DetailFadeNear + max(DetailFadeSpan, 1e-4f);

    F.StructureFade = 1.0f;
    F.DetailFade = 1.0f;

    return F;
}

/** What GG_Field returns. Two shapes rather than one, because the layers carve
 *  and erode by different amounts and fade on different schedules. Each is 1
 *  where its layer contributes nothing.
 *
 *  BandShift is the shapes' signed offset to Band, 0 where neither layer
 *  contributes. GG_Density applies it, weighted by depth into the gradient. */
struct GGFieldSample
{
    float Top;
    float Pressure;
    float Band;
    float BandShift;
    float ShapeDetail;
    float ShapeStructure;
};

float3 GG_RotateZ(float3 P, float Angle)
{
    float SinA, CosA;
    sincos(Angle, SinA, CosA);

    return float3(
		P.x * CosA - P.y * SinA,
		P.x * SinA + P.y * CosA,
		P.z);
}

/** Flow field reconstruction: 0 hardware bilinear, one tap, C0; 1 cubic
 *  B-spline, four taps, C2. A performance handle, three taps wide. Nothing
 *  between them is worth carrying, and neither adds information: if blocks
 *  survive at 1 the band edge is a genuine step in the sim data, and the answer
 *  is sim resolution or a softer BandSharpness. */
#ifndef GG_FLOW_FILTER
#define GG_FLOW_FILTER 1
#endif

/** Collapses the Worley rungs to one value about the median. NORMALIZED BY THE
 *  WEIGHTS' LENGTH, NOT THEIR SUM: the rungs are independent fields, so their
 *  variances add rather than their amplitudes. Dividing by the sum leaves three
 *  equal rungs at 0.58 of one rung's contrast, flattening toward grey as more is
 *  switched on; length holds contrast constant however the balance is set. */
float GG_WorleyLadder(float3 Octaves, float3 Weights)
{
    const float Norm = max(length(Weights), 1e-4f);

    return saturate(0.5f + dot(Octaves - 0.5f, Weights) / Norm);
}

/** Remaps the Perlin base against the Worley floor: the Perlin says where
 *  material is, the cells erode it. */
float GG_PerlinWorley(float Perlin, float WorleyF1)
{
    const float Low = -WorleyF1;

    return saturate((Perlin - Low) / max(1.0f - Low, 1e-3f));
}

/** Samples the simulated flow field by direction. The grid is longitude by
 *  sin(latitude), so both coordinates are cheap from a unit vector. Sampler
 *  state must be wrap on U and clamp on V.
 *
 *  Returns (u_east, u_north, psi_eddy, band):
 *    xy  Tangent velocity, radians per unit time; rebuild the 3D vector with
 *        GG_FlowVelocity.
 *    z   The eddy streamfunction, psi with its zonal mean removed: zero in
 *        undisturbed flow, positive for clockwise rotation seen from outside.
 *    w   Normalized vorticity, near [-1,1], positive counterclockwise. The band
 *        signal, arriving already meandering and wrapped around vortices, since
 *        the sim transports vorticity.
 *
 *  PITFALL: z and w are rotation senses, not cyclone or anticyclone -- which one
 *  a sense is flips at the equator. Read them through GG_PressureFromFlow and
 *  GG_BandFromFlow, never raw. */
float4 GG_SampleFlow(Texture2DArray FlowField, SamplerState FlowSampler, float3 N, float Layer)
{
    const float U = frac(atan2(N.y, N.x) * (0.5f / PI));
    const float V = 0.5f + 0.5f * N.z;

#if GG_FLOW_FILTER == 0

    return FlowField.SampleLevel(FlowSampler, float3(U, V, Layer), 0.0f);

#else

	// Bilinear is continuous in value but not in gradient, and the deck top is a
	// direct function of this field while shading responds to its slope, so the
	// slope jumps surface as faceting along the lat/lon grid. The cubic is
	// approximating rather than interpolating: it does not pass through the
	// texel values, so a one-texel step in the field stops being one in the
	// surface. Four bilinear taps, each placed at the offset that reproduces a
	// pair's weights.
    uint Width, Height, Slices, Levels;
    FlowField.GetDimensions(0, Width, Height, Slices, Levels);

    const float2 Size = float2(Width, Height);
    const float2 InvSize = 1.0f / Size;

    const float2 Texel = float2(U, V) * Size - 0.5f;
    const float2 Corner = floor(Texel);
    const float2 Frac = Texel - Corner;

    const float2 F2 = Frac * Frac;
    const float2 F3 = F2 * Frac;

    const float2 W0 = (-F3 + 3.0f * F2 - 3.0f * Frac + 1.0f) / 6.0f;
    const float2 W1 = (3.0f * F3 - 6.0f * F2 + 4.0f) / 6.0f;
    const float2 W2 = (-3.0f * F3 + 3.0f * F2 + 3.0f * Frac + 1.0f) / 6.0f;
    const float2 W3 = F3 / 6.0f;

    const float2 S0 = W0 + W1;
    const float2 S1 = W2 + W3;

    const float2 UV0 = (Corner + 0.5f + (W1 / S0 - 1.0f)) * InvSize;
    const float2 UV1 = (Corner + 0.5f + (W3 / S1 + 1.0f)) * InvSize;

    return
		  S0.x * S0.y * FlowField.SampleLevel(FlowSampler, float3(UV0.x, UV0.y, Layer), 0.0f)
		+ S1.x * S0.y * FlowField.SampleLevel(FlowSampler, float3(UV1.x, UV0.y, Layer), 0.0f)
		+ S0.x * S1.y * FlowField.SampleLevel(FlowSampler, float3(UV0.x, UV1.y, Layer), 0.0f)
		+ S1.x * S1.y * FlowField.SampleLevel(FlowSampler, float3(UV1.x, UV1.y, Layer), 0.0f);

#endif
}

/** +1 in the northern hemisphere, -1 in the southern, smoothly through zero at
 *  the equator. N is a unit direction in the field's frame. The sim's channels
 *  are rotation senses, and the Coriolis parameter that turns one into cyclone
 *  or anticyclone changes sign at the equator. Smooth rather than sign(): a hard
 *  switch seams there, and within a few degrees rotation stops organizing the
 *  weather anyway. HemisphereBlend sets how wide that band is. */
float GG_Hemisphere(float3 N, GGFieldParams F)
{
    return tanh(F.HemisphereSharpness * N.z);
}

/** Pressure from a flow sample: the eddy streamfunction times the hemisphere.
 *  Positive in anticyclones (high pressure) in both hemispheres. */
float GG_PressureFromFlow(float4 Flow, float3 N, GGFieldParams F)
{
    return Flow.z * GG_Hemisphere(N, F);
}

/** The band value from a flow sample: vorticity made anticyclonic-positive in
 *  both hemispheres, biased and sharpened. Positive is a zone, negative a belt,
 *  zero a boundary -- the same in the north as in the south. */
float GG_BandFromFlow(float4 Flow, float3 N, GGFieldParams F)
{
    return (-Flow.w * GG_Hemisphere(N, F) + F.BandBias) * F.BandSharpness;
}

/** Arc length of one flow texel at a given radius, in world units: the finest
 *  thing the deck top can vary over. A ray stepping further than this in one go
 *  samples one column out of the several it crossed, and the jitter picks which
 *  -- not an estimate with noise on it but a choice. It is why a shadow ray
 *  needs a step bounded by a length rather than a budget divided into a span.
 *  Longitude is the tighter axis, so the width alone bounds it. */
float GG_FlowTexelArc(Texture2DArray FlowField, float Radius)
{
    uint Width, Height, Slices, Levels;
    FlowField.GetDimensions(0, Width, Height, Slices, Levels);

    return (2.0f * PI * Radius) / float(max(Width, 1u));
}

/** Rebuilds the 3D tangent velocity from the stored components. No trig: with
 *  c = length(N.xy) the basis is east = (-N.y, N.x, 0)/c and north =
 *  (-N.z*N.x/c, -N.z*N.y/c, c). Guarded at the poles, where c goes to zero and
 *  east is undefined -- no texel sits on a pole, but a shading point can. */
float3 GG_FlowVelocity(float3 N, float4 Flow)
{
    const float C = max(length(N.xy), 1e-5f);

    const float3 East = float3(-N.y, N.x, 0.0f) / C;
    const float3 North = float3(-N.z * N.x / C, -N.z * N.y / C, C);

    return East * Flow.x + North * Flow.y;
}

/** The shell's ceiling: 1 below the falloff band, 0 at the atmosphere top,
 *  smoothstep between. Multiplies every density the deck returns, so a tower
 *  that would cross it softens into a flattened cap instead of being cut and the
 *  deck never has to sit lower to clear its tallest outlier. Smoothstep, not
 *  linear: a slope break at the band's lower edge draws a line at one altitude
 *  across every tower reaching it.
 *
 *  PITFALL: DeckTop belongs below the band. A typical top inside it thins the
 *  whole deck, and DeckOpticalDepth stops being exact. */
float GG_CeilingFade(float Height, GGFieldParams F)
{
    return 1.0f - smoothstep(1.0f - F.CeilingFalloff, 1.0f, Height);
}

/** Density at a height, given the column's top and floor. Peaks at exactly 1
 *  with zero derivative at both ends, so neither the onset nor the join to the
 *  saturated region draws a line. No peak-density term: Cloud Beta is solved
 *  from the optical depth wanted, so a peak here would divide back out.
 *
 *  PITFALL: the onset stays C1 only while Curve is above 0.5. At 0.5 the slope
 *  at the deck top goes finite, creasing along the whole top; below it the top
 *  hardens into an edge. Both are legitimate looks, so this is not clamped --
 *  the floor only keeps the exponent positive, since pow(t, 0) returns 1. */
float GG_DeckDensity(float Height, float Top, float Bottom, float Curve)
{
    const float Span = max(Top - Bottom, 1e-4f);

    const float T = saturate((Top - Height) / Span);

    return smoothstep(0.0f, 1.0f, pow(T, max(Curve, 1e-4f)));
}

/** Where a column's gradient bottoms out: the authored thickness below its own
 *  top, backstopped by DeckBackstop. THE ONE PLACE THE FLOOR IS DERIVED -- the
 *  profile, the erosion normalization and the solid-region skip must agree or
 *  the skip fills in cloud the profile left transparent. The backstop keeps the
 *  marched band thin.
 *
 *  PITFALL: never above the top. A column pushed below the backstop would
 *  otherwise get a floor above its own top, inverting the profile so empty air
 *  reads as solid. Clamped, the result is monotone in Top, which is what lets
 *  the skip test a lower bound. */
float GG_DeckFloor(float Top, GGFieldParams F)
{
    return min(max(Top - F.GradientThickness, F.DeckBackstop), Top);
}

/** The deck's extinction coefficient per atmosphere thickness, solved so a ray
 *  down an unrelieved column accumulates DeckOpticalDepth at core density.
 *  Multiply by a band's extinction for colour and divide by Thickness for world
 *  units. Solved rather than authored, so retuning the shell leaves the deck's
 *  opacity where it was put, and shared by the march and the bake, which keeps
 *  the depth where the map goes opaque the depth where the eye sees it. */
float GG_DeckBeta(GGFieldParams F, float DeckOpticalDepth)
{
    const float Floor = GG_DeckFloor(F.DeckTop, F);

	// The gradient's mean density: the integral of smoothstep(T^c) over [0,1] is
	// 3/(2c+1) - 2/(3c+1), a half at c = 1. Using it rather than a fixed half
	// keeps DeckOpticalDepth exact at any curve, so DensityCurve redistributes
	// mass inside the gradient without changing how much light the deck removes.
    const float C = max(F.DensityCurve, 1e-4f);
    const float MeanDensity = 3.0f / (2.0f * C + 1.0f) - 2.0f / (3.0f * C + 1.0f);

    return DeckOpticalDepth / max(Floor + MeanDensity * (F.DeckTop - Floor), 1e-4f);
}

/** How far the two carves can move a column top, in atmosphere fractions, at the
 *  given fades. THE ONE DERIVATION OF THE CARVE REACH: the entry search's upper
 *  bound, the saturation skip's lower bound and the deck-wide bounds all read
 *  it, and a second expression would let them disagree about a surface they each
 *  have to be conservative against. Structure is signed about the noise median,
 *  so half its amount lands each way; detail follows GG_DETAIL_RELIEF_CENTRED.
 *
 *  Pass 1 for a fade to get the unconditional reach. Any fade passed must be at
 *  least the fade at every sample the bound covers, or the bound is not one. */
void GG_CarveReach(GGFieldParams F, float DetailFade, float StructureFade, out float Down, out float Up)
{
    const float D = F.GradientThickness;

    const float StructureHalf = D * 0.5f * abs(F.StructureRelief) * saturate(StructureFade);

    const float DetailCarve = D * abs(F.DetailRelief) * saturate(DetailFade);

#if GG_DETAIL_RELIEF_CENTRED
    const float DetailDown = 0.5f * DetailCarve;
    const float DetailUp = 0.5f * DetailCarve;
#else
    const float DetailDown = (F.DetailRelief > 0.0f) ? DetailCarve : 0.0f;
    const float DetailUp = (F.DetailRelief < 0.0f) ? DetailCarve : 0.0f;
#endif

    Down = StructureHalf + DetailDown;
    Up = StructureHalf + DetailUp;
}

/** The band at a planet-local position from one bilinear tap of the top flow
 *  layer, without the shapes' BandShift. For what varies over a band's width
 *  rather than a feature's: the colour of extinction a light ray crossed. */
float GG_BandCoarse(Texture2DArray FlowField, SamplerState FlowSampler, float3 LocalPos, GGFieldParams F)
{
    const float3 N = normalize(GG_RotateZ(normalize(LocalPos), F.SpinAngle));

    const float U = frac(atan2(N.y, N.x) * (0.5f / PI));
    const float V = 0.5f + 0.5f * N.z;

    return GG_BandFromFlow(FlowField.SampleLevel(FlowSampler, float3(U, V, GG_FLOW_LAYER), 0.0f), N, F);
}

/** Signed band height from the band value: zones (positive, anticyclonic) toward
 *  +1, belts (negative, cyclonic) toward -1, zero on the boundaries. Smooth
 *  through zero -- the magnitude is 1 - exp(-Band^2), which starts quadratically
 *  -- because a plain clamp kinks where it pins, creasing along every band
 *  contour. BandSharpness is already folded into Band. */
float GG_BandHeight(float Band)
{
    return sign(Band) * (1.0f - exp(-Band * Band));
}

/** Which way a storm moves the deck: up over anticyclones (positive pressure),
 *  down into cyclones. A plain sign is safe because every use is multiplied by
 *  the vortex gate, which is zero around zero pressure. */
float GG_StormSign(float Pressure)
{
    return (Pressure >= 0.0f) ? 1.0f : -1.0f;
}

/** Cloud top altitude, an atmosphere fraction. Flow first -- band height,
 *  pressure lift, storm towers -- then the two carves. With both layers neutral
 *  (carves 0, StormCells 1, ReliefScale 1) this is the flow's own top, which is
 *  what GG_ProbeFromFlow reports below the deck floor.
 *
 *  EVERY TERM IS CENTRED ON ZERO, so none moves the deck as a body and DeckTop
 *  stays the typical top however they are tuned. Zones sit high and belts low by
 *  the sign of the band, their boundaries meeting at DeckTop. The pressure sign
 *  is not arbitrary: anticyclones are high pressure, rising, condensing fresh
 *  ammonia above the haze, so they must sit high -- backwards, the field reads
 *  as plausible until you notice every storm is a pit.
 *
 *  ReliefScale collapses band relief under strain and deliberately does not
 *  touch the lift or the towers, which are vertical motion rather than stretched
 *  material. The storm term is gated on vortex strength -- ungated, Worley F1 is
 *  polka dots -- and StormCells is inverted because F1 is minimal at cell
 *  centres, where a storm belongs. */
float GG_CloudTop(
	float BandHeight,
	float CarveDetail,
	float ReliefStructure,
	float Pressure,
	float StormCells,
	float ReliefScale,
	GGFieldParams F)
{
    const float D = F.GradientThickness;

	// Half each way, so zones sit BandRelief above belts.
    float Top = F.DeckTop + D * ReliefScale * 0.5f * F.BandRelief * BandHeight;

    Top -= D * F.DetailRelief * CarveDetail;
    Top += D * F.StructureRelief * ReliefStructure;

    Top += D * F.PressureRelief * Pressure;

    const float Vortex = smoothstep(F.VortexThreshold, 1.0f, abs(Pressure));

    Top += D * F.StormTowerRelief * GG_StormSign(Pressure) * (1.0f - StormCells) * Vortex;

    return Top;
}

/** One flow fetch: the band, the pressure, and the cloud top in three forms. */
struct GGFlowProbe
{
    float Band;
    float Pressure;

	/** The flow's own top, both volumes neutral. Not a bound -- the value. */
    float TopFlow;

	/** Upper bound on the flow terms, carves excluded. */
    float Top;

	/** Lower bound on the top, every term at its most negative. */
    float TopLower;
};

/** The cloud top from a flow sample, without the volumes.
 *
 *  Top BOUNDS THE FLOW TERMS FROM ABOVE, with the carves at their median: a
 *  search that overestimates takes another iteration, one that underestimates
 *  steps over the surface. So the band contributes max(BandTerm, 0), ReliefScale
 *  being in [0,1] against a term that changes sign, and the storm term likewise.
 *  NO CARVE MARGIN IN IT -- the shadow ray reads Top as the deck's actual height
 *  and pays in optical depth. The search's margin is GG_CloudTopUpper's.
 *
 *  TopLower TAKES EVERY TERM AT ITS MOST NEGATIVE, both carves included, so a
 *  floor derived from it is at or below the column's real floor. Band and
 *  Pressure must match GG_Field's unshifted values, or the saturated region
 *  tints differently from the gradient above it. */
GGFlowProbe GG_ProbeFromFlow(float4 Flow, float3 N, GGFieldParams F)
{
    GGFlowProbe Probe;

    Probe.Band = GG_BandFromFlow(Flow, N, F);
    Probe.Pressure = GG_PressureFromFlow(Flow, N, F);

    const float D = F.GradientThickness;

    const float BandHeight = GG_BandHeight(Probe.Band);

    Probe.TopFlow = GG_CloudTop(BandHeight, 0.0f, 0.0f, Probe.Pressure, 1.0f, 1.0f, F);

    const float Base = F.DeckTop + D * F.PressureRelief * Probe.Pressure;

    const float BandTerm = 0.5f * F.BandRelief * BandHeight;

    const float Vortex = smoothstep(F.VortexThreshold, 1.0f, abs(Probe.Pressure));

	// At full height wherever the gate is open: the storm cells only scale it
	// toward zero, so this brackets it from both sides.
    const float StormTerm = F.StormTowerRelief * GG_StormSign(Probe.Pressure) * Vortex;

    Probe.Top = Base + D * (max(BandTerm, 0.0f) + max(StormTerm, 0.0f));

    float CarveDown, CarveUp;
    GG_CarveReach(F, F.DetailFade, F.StructureFade, CarveDown, CarveUp);

    Probe.TopLower = Base
		+ D * (min(BandTerm, 0.0f) + min(StormTerm, 0.0f)) - CarveDown;

    return Probe;
}

/** The cheap read, for the jobs that do not need the volumes: finding where a
 *  ray enters the deck, and shading below a column's floor where the volumes
 *  cannot change the density. */
GGFlowProbe GG_FlowProbe(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	float3 P,
	GGFieldParams F)
{
    const float3 N = normalize(GG_RotateZ(P, F.SpinAngle));

    return GG_ProbeFromFlow(GG_SampleFlow(FlowField, FlowSampler, N, GG_FLOW_LAYER), N, F);
}

/** Conservative upper bound on the deck top, for the entry search: the probe's
 *  top plus the carves' upward reach, taken unfaded since the search runs ahead
 *  of the samples it is finding. */
float GG_CloudTopUpper(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	float3 P,
	GGFieldParams F)
{
    const float Top = GG_FlowProbe(FlowField, FlowSampler, P, F).Top;

    float CarveDown, CarveUp;
    GG_CarveReach(F, 1.0f, 1.0f, CarveDown, CarveUp);

    return min(Top + CarveUp, 1.0f);
}

/** Distance along a ray at which it first reaches the deck. Returns T1 when the
 *  ray never reaches it between T0 and T1. LocalOrigin and LocalDir are in the
 *  field's frame, LocalDir normalized, which an orthonormal WorldToLocal
 *  preserves.
 *
 *  A CONE TRACE, AND NOT AN OPTIMIZATION -- it is what keeps the limb from
 *  breaking. A grazing chord from the cull radius to the surface is enormous,
 *  and stepped at the deck's own step size it exhausts the iteration cap in
 *  empty space, leaving the ray transparent at exactly the angles where its
 *  neighbours a fraction of a degree steeper go opaque: a sharp geometric
 *  threshold, drawing a hard silhouette where the limb should be softest. */
float GG_DeckEntry(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	float3 LocalOrigin,
	float3 LocalDir,
	float T0,
	float T1,
	float TopMax,
	GGFieldParams F)
{
    float TSearch = T0;

    LOOP

    for (int Probe = 0; Probe < GG_DECK_ENTRY_PROBES; Probe++)
    {
        const float3 ProbePos = LocalOrigin + LocalDir * TSearch;
        const float ProbeRadius = length(ProbePos);
        const float ProbeHeight = (ProbeRadius - F.PlanetRadius) / F.Thickness;

        const float3 ProbeDir = ProbePos / max(ProbeRadius, 1e-4f);
        const float ProbeRate = dot(LocalDir, ProbeDir);

        const float TopUpper = GG_CloudTopUpper(FlowField, FlowSampler, ProbeDir, F);

        if (ProbeHeight <= TopUpper)
        {
            return TSearch;
        }

		// Climbing and clear of the highest the deck can reach. Both conditions
		// matter: a climbing ray still inside the deck's range can meet a taller
		// column ahead.
        if (ProbeRate >= 0.0f && ProbeHeight > TopMax)
        {
            return T1;
        }

		// The deck rises to meet the ray, so the closing rate is the sum of the
		// ray's descent and the deck's rise across the ground it covers.
		// Dividing by the descent alone overshoots without bound at tangent.
		// DeckSlope is in gradient depths per radian, matching the relief that
		// produces the slope.
        const float Horizontal = sqrt(max(1.0f - ProbeRate * ProbeRate, 0.0f));

        const float ClosingRate = -ProbeRate
			+ Horizontal * max(F.DeckSlope, 0.1f) * F.GradientThickness * F.Thickness
				/ max(ProbeRadius, 1e-4f);

        const float Advance = (ProbeHeight - TopUpper) * F.Thickness / max(ClosingRate, 1e-5f);

        TSearch += max(Advance * GG_CONE_RELAXATION, 1e-4f);

        if (TSearch >= T1)
        {
            return T1;
        }
    }

    return TSearch;
}

/** Evaluates the cloud field at a direction on the sphere. Height is the shading
 *  point's atmosphere fraction and only affects the 3D volume lookups. Up to six
 *  fetches, depending on which layers survive their fade.
 *
 *  N IS ALREADY SPUN, Flow0 IS ITS FLOW SAMPLE AND Probe IS ITS READING, all
 *  from the caller: the saturation test needs that fetch before it can decide
 *  whether to call this at all, so taking them as arguments keeps the test free
 *  and stops band and pressure being derived twice. Flow0 is also the warp
 *  loop's first iteration, UNWARPED deliberately -- the sim transports
 *  vorticity, so warping the lookup would double-count.
 *
 *  VOLUME SAMPLER STATE: wrap on all three axes, Linear Color. These are scalar
 *  fields and an sRGB decode curves them without erroring. */
GGFieldSample GG_Field(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	Texture3D DetailVolume,
	SamplerState DetailSampler,
	Texture3D StructureVolume,
	SamplerState StructureSampler,
	float3 N,
	float4 Flow0,
	GGFlowProbe Probe,
	float Height,
	GGFieldParams F)
{
    const float Pressure = Probe.Pressure;

    const float Zeta = Probe.Band;

	// One on a band boundary, falling to zero in a band's interior: where the
	// jets and their shear live. Weights the turbulence and the carves' edge
	// bias. The same curve GG_BandHeight takes its magnitude from, so heights
	// and weights agree about where the boundaries are.
    const float Boundary = exp(-Zeta * Zeta);

	// Turbulence follows the shear and the shear lives at the boundaries, so
	// zone interiors go nearly laminar. Without it the bands read as one
	// scalloped curve repeated all the way round.
    const float Turbulence = lerp(F.TurbulenceFloor, 1.0f, Boundary);

    const float StepTime = (F.WarpTime * Turbulence) / (float) GG_WARP_ITERATIONS;

    float3 Pos = N;

    float3 FirstVelocity = 0.0f;
    float3 LastVelocity = 0.0f;

    UNROLL

    for (int It = 0; It < GG_WARP_ITERATIONS; It++)
    {
        const float4 Flow = (It == 0) ? Flow0
			: GG_SampleFlow(FlowField, FlowSampler, Pos, GG_FLOW_LAYER);

        const float3 Velocity = GG_FlowVelocity(Pos, Flow);

        if (It == 0)
        {
            FirstVelocity = Velocity;
        }

        LastVelocity = Velocity;

		// Renormalized every step because the displacement leaves the sphere.
		// Only .z is read downstream, so a chord move biases latitude and
		// compounds over several steps.
        Pos = normalize(Pos + Velocity * StepTime);
    }

    const float3 Warped = Pos;

	// A difference rather than a running sum: each step renormalizes, so the sum
	// of the steps is not the distance travelled.
    const float3 FlowWarp = Warped - N;

    float Ridge = 0.5f;
    float3 DeepShear = 0.0f;

	// ADVECTION HAS NOWHERE TO ACCUMULATE. The volumes are resampled from
	// scratch every frame, so a warp anchored to a fixed direction can only
	// wobble. Two phases half a period apart, each ramping its displacement from
	// nothing to GG_CROSSFADE_SPAN and resetting, give features somewhere to
	// travel to; the weight is zero where a phase resets, so the discontinuity
	// happens while that layer contributes nothing. It is a dissolve between two
	// differently sheared copies, so the blend ghosts under shear.
    const float PhaseA = frac(F.CrossfadeTime);
    const float PhaseB = frac(F.CrossfadeTime + 0.5f);

    const float WeightA = 1.0f - abs(2.0f * PhaseA - 1.0f);

    const float WarpMulA = GG_CROSSFADE_SPAN * PhaseA;
    const float WarpMulB = GG_CROSSFADE_SPAN * PhaseB;

	// A FADED LAYER IS SKIPPED, NOT JUST SCALED. Exactly zero, not an epsilon: a
	// skip at a small positive fade is a discontinuity at a fixed fade value,
	// which is a fixed distance from the camera, which is a ring on screen.
	// smoothstep returns exactly 1 past its far edge, so the branch still fires
	// over the whole faded region.
    const bool bWantDetail = (F.DetailFade > 0.0f);
    const bool bWantStructure = (F.StructureFade > 0.0f);

    BRANCH

	// DEEP SHEAR, ONE STEP THROUGH THE DEEP FLOW LAYER: a different sim slice
	// from the coarse warp, which is what makes the shear vertical. Outside
	// either layer's branch because this is geometry rather than noise --
	// computed only where one layer survives, the other would warp differently
	// either side of that layer's fade, a discontinuity in motion.
    if (bWantDetail || bWantStructure)
    {
        const float3 PShear = normalize(N + FlowWarp * F.DetailFlowInherit);

        const float4 DeepFlow = GG_SampleFlow(FlowField, FlowSampler, PShear, GG_DEEP_FLOW_LAYER);

        DeepShear = GG_FlowVelocity(PShear, DeepFlow) * (F.DeepShearTime * Turbulence);
    }

	// Each layer's displacement: its FlowInherit of the coarse warp plus its
	// ShearInherit of the deep shear. A displacement field with a large gradient
	// IS strain, so inheriting one whole imposes an order-one strain on a layer
	// regardless of its own flow.
    const float3 DetailWarp = FlowWarp * F.DetailFlowInherit + DeepShear * F.DetailShearInherit;
    const float3 StructureWarp = FlowWarp * F.StructureFlowInherit + DeepShear * F.StructureShearInherit;

    BRANCH

    if (bWantDetail)
    {
		// SAMPLED IN TRUE 3D: the position is a unit direction, so Scale alone
		// would trace a sphere through the volume and discard the vertical
		// structure the bake put there. No independent drift -- a clock
		// scrolling the volume through its own domain makes the detail change
		// whether or not anything is happening to it. If it looks pinned, raise
		// WarpTime.
        const float UVWScale = F.DetailScale + Height * F.DetailVertical;

		// MIP 0, ALWAYS. A footprint-derived mip blurs along the shell and
		// erases the vertical structure a high aspect ratio builds. Undersampled
		// instead: the high frequencies fold down rather than resolve, and the
		// fades remove a layer once that stops being affordable.
        float4 DetailSample;

        BRANCH

        if (F.DetailCrossfade > 0.0f)
        {
			// The two phases differ only in how far along the same displacement
			// they sit, so one flow loop serves both. The deep-flow fetch stays
			// on the unphased position: it decides how the layer is sheared, not
			// where it is.
            const float3 PA = normalize(N + DetailWarp * WarpMulA);
            const float3 PB = normalize(N + DetailWarp * WarpMulB);

            DetailSample = lerp(
				DetailVolume.SampleLevel(DetailSampler, PB * UVWScale, 0.0f),
				DetailVolume.SampleLevel(DetailSampler, PA * UVWScale, 0.0f),
				WeightA);
        }
        else
        {
            DetailSample = DetailVolume.SampleLevel(
				DetailSampler, normalize(N + DetailWarp) * UVWScale, 0.0f);
        }

        Ridge = GG_PerlinWorley(
			DetailSample.r,
			GG_WorleyLadder(DetailSample.gba, F.DetailNoiseWeights.xyz));
    }

	// Green is the storm-tower gate and 1 is its neutral value, since the tower
	// term reads (1 - StormCells). The fade lerps toward the same 1, so the
	// skipped case and the fully faded case agree.
    float4 Structure = float4(0.5f, 1.0f, 1.0f, 1.0f);

    BRANCH

    if (bWantStructure)
    {
        const float UVWScale = F.StructureScale + Height * F.StructureVertical;

        BRANCH

        if (F.StructureCrossfade > 0.0f)
        {
            const float3 PA = normalize(N + StructureWarp * WarpMulA);
            const float3 PB = normalize(N + StructureWarp * WarpMulB);

            Structure = lerp(
				StructureVolume.SampleLevel(StructureSampler, PB * UVWScale, 0.0f),
				StructureVolume.SampleLevel(StructureSampler, PA * UVWScale, 0.0f),
				WeightA);
        }
        else
        {
			// Zero inheritance is legitimate rather than degenerate: this layer
			// breaks the flow into rounded shapes, and a shape dragged through
			// the flow field is no longer round.
            const float3 PStructure = normalize(N + StructureWarp);

            Structure = StructureVolume.SampleLevel(
				StructureSampler, PStructure * UVWScale, 0.0f);
        }
    }

	// RELIEF THINNING, MEASURED FROM THE FLOW RATHER THAN PRESCRIBED. An
	// incompressible parcel stretched by g must thin vertically by 1/g; without
	// it, filament width shrinks with strain while height does not and the march
	// reads them as spikes. The velocity difference over the distance travelled
	// is a strain rate, from two samples the loop already took -- a prescribed
	// zonal profile reports zero inside a vortex straining material hard.
    const float Travelled = length(FlowWarp);

    const float StrainRate = length(LastVelocity - FirstVelocity) / max(Travelled, 1e-5f);

    const float Winding = StrainRate * F.WarpTime;

    const float ReliefScale = 1.0f / (1.0f + F.ReliefThinning * Winding);

	// EDGE WEIGHTING. Detail applied uniformly is by definition grain: it has no
	// relationship to the structure it sits on. Concentrated on the transitions
	// it ravels the band edges, where a real gas giant's billows live.
    const float Edge = lerp(F.EdgeBias, 1.0f, Boundary);

    const float StructureMix = GG_PerlinWorley(
		Structure.r,
		GG_WorleyLadder(Structure.gba, F.StructureNoiseWeights.xyz));

	// Fade enters here rather than at the consumption sites, so it scales the
	// noise's effect and leaves its scale alone -- structure stays the same size
	// as it dims rather than growing.
    const float DetailWeight = saturate(Edge * F.DetailNoiseWeights.w * F.DetailFade);
    const float StructureWeight = saturate(Edge * F.StructureNoiseWeights.w * F.StructureFade);

	// EROSION KEEPS ITS NEUTRAL AT 1, since it multiplies density and may only
	// remove material. RELIEF is signed about the median, since it moves a
	// surface and has no reason to prefer a direction.
    const float ShapeDetail = lerp(1.0f, Ridge, DetailWeight);
    const float ShapeStructure = lerp(1.0f, StructureMix, StructureWeight);

#if GG_DETAIL_RELIEF_CENTRED
	// About the median, so turning the layer up or fading it in changes the
	// deck's texture without changing its altitude.
    const float CarveDetail = DetailWeight * (0.5f - Ridge);
#else
    const float CarveDetail = DetailWeight * (1.0f - Ridge);
#endif

    const float ReliefStructure = StructureWeight * (StructureMix - 0.5f);

	// MATERIAL FOLLOWS SHAPE. The band boundary becomes the zero contour of Band
	// plus the signed shapes that move the surface, so a billow near a boundary
	// is made of whichever family its sign points at. Doubled so each term spans
	// +-1 at full weight. PITFALL: keep it additive -- any form depending on
	// sign(Band) flips on the zero contour and redraws the clean line as a
	// discontinuity. The detail term is median-centred regardless of
	// GG_DETAIL_RELIEF_CENTRED, which would push boundaries toward one family.
    const float BandShift = 2.0f * (F.StructureBandMix * ReliefStructure
		+ F.DetailBandMix * DetailWeight * (0.5f - Ridge));

	// THE TOWER GATE RIDES THE SAME FADE. Left raw it holds full height to the
	// skip threshold then vanishes in one step, the tallest feature on the deck
	// popping out at a fixed distance. Not edge-weighted, unlike the shapes: a
	// tower's placement already comes from the vortex gate.
    const float StormGate = lerp(1.0f, Structure.g, saturate(F.StructureFade));

    GGFieldSample Out;

    Out.Top = GG_CloudTop(
		GG_BandHeight(Zeta), CarveDetail, ReliefStructure, Pressure, StormGate, ReliefScale, F);
    Out.Pressure = Pressure;
    Out.Band = Zeta;
    Out.BandShift = BandShift;
    Out.ShapeDetail = ShapeDetail;
    Out.ShapeStructure = ShapeStructure;

    return Out;
}

/** The band colour ramp, for the debug material. Colour from the sign of
 *  vorticity scaled by the magnitude, so zero lands on EdgeColour and cores come
 *  out saturated, and the dark line between bands separates the two families
 *  instead of blending them through a muddy midpoint. Scale is the sim debug
 *  view's DebugScale inverted. */
float3 GG_BandColour(float Band, float3 ColourA, float3 ColourB, float3 EdgeColour, float Scale)
{
    const float T = clamp(Band * Scale, -1.0f, 1.0f);

    const float3 Hue = (T < 0.0f) ? ColourB : ColourA;

    return lerp(EdgeColour, Hue, abs(T));
}

/** Density at a point in the shell. LocalPos carries its true radius, unlike
 *  elsewhere in this file; the columnar field is still evaluated at the
 *  normalized direction, the shell being thin enough that the true radius shifts
 *  UVW by less than one lattice cell. StepHalfLength is half the march step in
 *  atmosphere fractions along the radius, so a step straddling the cloud top is
 *  weighted by how much of it lies inside.
 *
 *  Returns:
 *    x  Density in [0,1]. Multiply by an extinction coefficient in the march.
 *    y  BAND, signed and unclamped -- what the material is, not a density term,
 *       shifted by the shapes near the surface.
 *    z  Pressure, for tinting vortices. Negative is cyclonic.
 *    w  The deck top at this column. Below the deck floor the volumes are
 *       skipped, so it is the flow's own top: what GG_CloudTop returns with both
 *       layers neutral, the value the full path reaches as the fades hit zero. */
float4 GG_Density(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	Texture3D DetailVolume,
	SamplerState DetailSampler,
	Texture3D StructureVolume,
	SamplerState StructureSampler,
	float3 LocalPos,
	float StepHalfLength,
	GGFieldParams F)
{
    const float Radius = length(LocalPos);
    const float3 Direction = LocalPos / max(Radius, 1e-4f);

    const float Height = (Radius - F.PlanetRadius) / F.Thickness;

    const float HalfStep = max(StepHalfLength, 0.0f);

    const float3 N = normalize(GG_RotateZ(Direction, F.SpinAngle));

    const float4 Flow0 = GG_SampleFlow(FlowField, FlowSampler, N, GG_FLOW_LAYER);

    const GGFlowProbe Probe = GG_ProbeFromFlow(Flow0, N, F);

    BRANCH

	// ONE FETCH BELOW THE COLUMN'S FLOOR RATHER THAN SEVEN: density there is
	// exactly 1 and the volumes cannot change it, so the probe's fetch supplies
	// the band and pressure that are all that is left to want. The test uses the
	// step's far edge, keeping the boundary a half step clear of the lattice,
	// and runs AGAINST A LOWER BOUND ON THE FLOOR since the real one costs the
	// volumes. GG_DeckFloor is monotone in Top, so the test can only be
	// conservative; the upper bound would fill carved troughs back in.
    if (Height + HalfStep <= GG_DeckFloor(Probe.TopLower, F))
    {
		// A tall column's saturated region can reach the ceiling band, so the
		// fade applies here too, integrated across the step as below.
        const float Ceiling = (GG_CeilingFade(Height - HalfStep, F)
			+ 4.0f * GG_CeilingFade(Height, F) + GG_CeilingFade(Height + HalfStep, F)) / 6.0f;

        return float4(Ceiling, Probe.Band, Probe.Pressure, Probe.TopFlow);
    }

    const GGFieldSample Field = GG_Field(
		FlowField, FlowSampler, DetailVolume, DetailSampler,
		StructureVolume, StructureSampler,
		N, Flow0, Probe, Height, F);

    const float Top = Field.Top;

    const float Bottom = GG_DeckFloor(Top, F);

	// THE PROFILE IS INTEGRATED ACROSS THE STEP, NOT SAMPLED AT ITS MIDPOINT.
	// One midpoint sample makes the deck a near-binary decision per step, and as
	// the surface drifts against the lattice that decision flips along a line on
	// screen. The top varies slowly across a step, so it is evaluated once at
	// the centre and only the profile is integrated -- three closed-form
	// evaluations, no extra fetches. The ceiling fade rides the same points.
    const float RampNear = GG_DeckDensity(Height - HalfStep, Top, Bottom, F.DensityCurve)
		* GG_CeilingFade(Height - HalfStep, F);
    const float RampMid = GG_DeckDensity(Height, Top, Bottom, F.DensityCurve)
		* GG_CeilingFade(Height, F);
    const float RampFar = GG_DeckDensity(Height + HalfStep, Top, Bottom, F.DensityCurve)
		* GG_CeilingFade(Height + HalfStep, F);

    const float Gradient = (RampNear + 4.0f * RampMid + RampFar) / 6.0f;

    const float DepthFraction =
		saturate((Top - Height) / max(Top - Bottom, 1e-4f));

	// Full erosion at the surface, none below ErosionDepth, or the deck is
	// uniformly pitted rather than solid material with a worked surface.
	// Smoothstep rather than linear: a linear falloff leaves the end of erosion
	// C0, a faint shelf edge-on at a constant altitude.
    const float CarveWeight =
		1.0f - smoothstep(0.0f, max(F.ErosionDepth, 1e-4f), DepthFraction);

	// THE CARVE MODULATES THE GRADIENT AND NOTHING ELSE. Multiplicative, and the
	// gradient is exactly zero above Top, so nothing the noise does can put
	// density outside the bound GG_TopBounds computed. Each lerp floors its
	// layer at (1 - erosion) rather than zero: there is no lower cloud shell, so
	// a transparent column would let a ray run to the far side of the planet.
    const float CarveDetail = lerp(1.0f, Field.ShapeDetail,
		saturate(F.DetailErosion) * CarveWeight);

    const float CarveStructure = lerp(1.0f, Field.ShapeStructure,
		saturate(F.StructureErosion) * CarveWeight);

    const float Density = Gradient * CarveDetail * CarveStructure;

	// Mixing lives in the worked surface and is gone by the floor, where the
	// saturated early-out reports the probe's unshifted band. Smoothstep so the
	// weight is C1 at both ends and the handoff draws no contour in colour.
    const float MixWeight = 1.0f - smoothstep(0.0f, 1.0f, DepthFraction);

    return float4(Density, Field.Band + Field.BandShift * MixWeight, Field.Pressure, Top);
}

/** Closed-form bounds on the cloud top, in atmosphere fractions.
 *
 *  EVERY TERM IN GG_CloudTop HAS TO APPEAR HERE. An underestimate is not
 *  conservative, it is a clipping error: the cull radius comes from OutMax, so a
 *  term left out slices the tops off the features it belongs to. GG_BandHeight
 *  is in [-1,1] scaled by a half, pressure is soft-saturated sim-side so it
 *  contributes the whole of PressureRelief, and the storm term reaches the whole
 *  of StormTowerRelief either way. ReliefScale never exceeds one, so ignoring it
 *  errs safe. The carves come from GG_CarveReach, scaled by the fades: a bound
 *  reserving room for a layer a faded ray never sees coarsens the march wherever
 *  that layer is absent, since OutMax over cloudSteps is the step size.
 *
 *  OutMin is the lowest a column top can be, hence the altitude below which
 *  every column is saturated -- the anchor the opaque clip counts down from. It
 *  does not bound the marched band: that ends at the backstop. */
void GG_TopBounds(
	GGFieldParams F,
	float DetailFade,
	float StructureFade,
	out float OutMin,
	out float OutMax)
{
    const float D = F.GradientThickness;

    const float Span = D * (0.5f * abs(F.BandRelief) + abs(F.PressureRelief)
		+ abs(F.StormTowerRelief));

    float CarveDown, CarveUp;
    GG_CarveReach(F, DetailFade, StructureFade, CarveDown, CarveUp);

    OutMin = F.DeckTop - Span - CarveDown;

	// CLAMPED AT THE SHELL: the ceiling fade leaves no density above it.
	// Unclamped, a tall rare feature would widen the marched band and coarsen
	// every step for the sake of a few columns.
    OutMax = min(F.DeckTop + Span + CarveUp, 1.0f);
}
