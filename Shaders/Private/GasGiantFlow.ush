#pragma once

#include "/Plugin/CloudAtmosphere/Private/GasGiantConstants.ush"

// ---------------------------------------------------------------------------
// Gas giant cloud deck: the field the march samples.
//
// A COLUMNAR HEIGHTFIELD WITH A DENSITY RAMP HANGING OFF IT. Every column has a
// top, set by the simulated flow and carved by two noise volumes; below it the
// density ramps 0 to 1 over an authored thickness and stays at 1. Coverage is
// 100% -- no cloud/no-cloud decision anywhere, and every visible feature is
// relief in the top surface rather than opacity variation.
//
// WHICH IS WHY BAND DRIVES ALTITUDE, NOT OPACITY. A zone is a raised deck of
// fresh ammonia ice; a belt is where the deck sits low and the line of sight
// reaches warmer material underneath. Fed into density instead, Band models the
// symptom and looks flat under any lighting model, because there is no geometry
// for light to interact with. It passes through to the march untouched, to be
// spent on extinction and scattering colour.
//
// UNITS. Three absolutes, all atmosphere fractions: DeckBase, DeckBackstop and
// GradientThickness. Every relief amount, both carves, ErosionDepth and
// DeckSlope are fractions of GradientThickness. Thickness is the only
// world-space length. Space is planet-local, spin axis on
// Z; positions arrive as unit directions except in GG_Density.
// ---------------------------------------------------------------------------

/** Warp loop length. Each iteration past the first costs a flow fetch. */
#ifndef GG_WARP_ITERATIONS
#define GG_WARP_ITERATIONS 4
#endif


/** Transmittance below which a ray is opaque and stops. WHEREVER A MARCH ENDS
 *  ON THIS IT MUST ALSO SNAP TO ZERO: the threshold asserts opacity, so
 *  returning the residual that tripped it leaves a leak carried only by rays
 *  that stopped early -- and since it fires on one channel while the others are
 *  still short, that leak is coloured. */
#ifndef GG_OPAQUE_TRANSMITTANCE
#define GG_OPAQUE_TRANSMITTANCE 0.001f
#endif


/** Which sim slice the deck reads. The coarse warp and the band signal come
 *  from GG_FLOW_LAYER; the fine shear comes from GG_DEEP_FLOW_LAYER, and the two
 *  being DIFFERENT is what produces vertical wind shear rather than a single
 *  sheet dragged around.
 *
 *  Both must be under GasGiantSimConfig::LayerCount, which is authored. A slice
 *  index past the end reads clamped rather than failing, so the shear quietly
 *  vanishes instead of erroring. */
#ifndef GG_FLOW_LAYER
#define GG_FLOW_LAYER 0
#endif

#ifndef GG_DEEP_FLOW_LAYER
#define GG_DEEP_FLOW_LAYER 1
#endif

/** How far a crossfade phase runs its advection ramp, as a multiple of the
 *  authored warp displacement.
 *
 *  2 SO THE MEAN IS THE AUTHORED AMOUNT. Each phase ramps from nothing to this
 *  and resets, so the average over a cycle is half of it. At 1 the deck would
 *  read as half as advected with the crossfade on as with it off, and enabling
 *  the feature would change the look rather than only the motion. */
#ifndef GG_CROSSFADE_SPAN
#define GG_CROSSFADE_SPAN 2.0f
#endif

/** Whether the detail layer moves the deck top SYMMETRICALLY about the noise
 *  median, the way the structure layer does, or only downward.
 *
 *  ONE-SIDED MOVES THE MEAN DECK WITH THE FADE. The carve is scaled by
 *  DetailFade, so a layer that only subtracts lowers the deck as it fades IN --
 *  the surface sinks on approach and thin features dissolve into it. That is the
 *  same coupling the structure layer is signed to avoid, arriving through the
 *  fade rather than through the amount.
 *
 *  ONE-SIDED IS ALSO WHAT BREAKING A SURFACE UP LOOKS LIKE. Centred, fine noise
 *  reads as material pushing out of the deck rather than being cut from it, so
 *  this is a look decision and not only a correctness one.
 *
 *  Either amount may still be negative, which mirrors the layer. The bounds in
 *  GG_TopBounds follow this switch, so both sides stay reserved when it is on. */
#ifndef GG_DETAIL_RELIEF_CENTRED
#define GG_DETAIL_RELIEF_CENTRED 1
#endif

/** Fraction of the cone-trace advance actually taken. Under 1 because the deck
 *  slope bound is authored, and an under-declared slope is the one way the
 *  entry search steps over the surface. */
#ifndef GG_CONE_RELAXATION
#define GG_CONE_RELAXATION 0.9f
#endif


/** Everything the field, density and deck-top functions read.
 *
 *  NAMES MATCH THE STACK. Every authored member carries the name of its C++
 *  property, material parameter and Custom node pin; the layer members take
 *  their layer's prefix. Members below the authored ones are DERIVED in
 *  GG_BuildField and are named for what they are, never reusing an authored
 *  name for a different quantity. The two fades are set per sample by the
 *  march. */
struct GGFieldParams
{
	// -- Authored ------------------------------------------------------------

    float PlanetRadius;
    float HeightScale;

	/** How far the density ramp reaches below a column's own top, and the unit
	 *  every relief amount is a fraction of. Floored against division. */
    float GradientThickness;
    float DeckBackstop;
    float DensityCurve;

    float BandSharpness;
    float BandBias;
    float BandRelief;
    float PressureRelief;
    float VortexThreshold;
    float StormTowerRelief;
    float ReliefThinning;

    float WarpTime;
    float TurbulenceFloor;

    float EdgeBias;
    float ErosionDepth;

	/** Worley rung weights in xyz, the layer's amount in w. */
    float4 StructureNoiseWeights;
    float StructureScale;
    float StructureRelief;
    float StructureErosion;
    float StructureFlowInherit;
    float StructureShearInherit;
    float StructureFadeNear;
    float StructureBandMix;
    float StructureCrossfade;

    float4 DetailNoiseWeights;
    float DetailScale;
    float DetailRelief;
    float DetailErosion;
    float DetailFlowInherit;
    float DetailShearInherit;
    float DetailFadeNear;
    float DetailBandMix;
    float DetailCrossfade;

	/** Bound on the deck's slope, GRADIENT DEPTHS per radian. Read only by the
	 *  entry search's cone angle: under-declaring it is the one way that search
	 *  steps over the surface. */
    float DeckSlope;

	// -- Derived -------------------------------------------------------------

	/** Atmosphere thickness in world units: the one absolute length the field
	 *  reads. */
    float Thickness;

	/** The unrelieved altitude every column is built from, solved from DeckTop
	 *  so CeilingReserve of the upward reach lands on it. */
    float DeckBase;

	/** The deep flow layer's step length: WarpTime * DeepShearRatio. */
    float DeepShearTime;

    float SpinAngle;

	/** Elapsed time in crossfade PERIODS. Only its fraction is read, so the two
	 *  phases sit half a period apart whatever the whole part is. */
    float CrossfadeTime;

	/** Noise units the shell spans vertically, per layer. Scale * Aspect *
	 *  HeightScale, which is what makes the aspect a ratio: heights reaching
	 *  the field are fractions of shell thickness while the horizontal scale is
	 *  against planet radius. */
    float StructureVertical;
    float DetailVertical;

	/** FadeNear + FadeSpan, held above FadeNear. */
    float StructureFadeFar;
    float DetailFadeFar;

	// -- Per sample ----------------------------------------------------------

	/** Per-layer level of detail, 1 at full strength and 0 faded out. Each scales
	 *  its layer's carve and erosion and gates the fetches feeding it. */
    float StructureFade;
    float DetailFade;
};


/** Fills GGFieldParams from the authored values, in panel order, and derives
 *  the rest. The bake calls it with the same values, so every derivation here
 *  is shared by the deck the eye sees and the deck the light sees.
 *
 *  RotationWeight is the planet's own rotation; the sim runs in the rotating
 *  frame, so it applies to the SAMPLING POSITION rather than to the flow,
 *  negated because rotating the sample point backwards carries the field
 *  forwards. */
GGFieldParams GG_BuildField(
	float PlanetRadius,
	float HeightScale,
	float Time,
	float SimTimeScale,
	float DeckTop,
	float CeilingReserve,
	float GradientThickness,
	float DeckBackstop,
	float DensityCurve,
	float BandSharpness,
	float BandBias,
	float BandRelief,
	float PressureRelief,
	float VortexThreshold,
	float StormTowerRelief,
	float ReliefThinning,
	float RotationWeight,
	float WarpTime,
	float DeepShearRatio,
	float TurbulenceFloor,
	float CrossfadePeriod,
	float EdgeBias,
	float ErosionDepth,
	float4 StructureNoiseWeights,
	float StructureScale,
	float StructureAspect,
	float StructureRelief,
	float StructureErosion,
	float StructureFlowInherit,
	float StructureShearInherit,
	float StructureFadeNear,
	float StructureFadeSpan,
	float StructureBandMix,
	float StructureCrossfade,
	float4 DetailNoiseWeights,
	float DetailScale,
	float DetailAspect,
	float DetailRelief,
	float DetailErosion,
	float DetailFlowInherit,
	float DetailShearInherit,
	float DetailFadeNear,
	float DetailFadeSpan,
	float DetailBandMix,
	float DetailCrossfade,
	float DeckSlope)
{
    GGFieldParams F;

    F.PlanetRadius = PlanetRadius;
    F.HeightScale = HeightScale;

    F.GradientThickness = max(GradientThickness, 1e-4f);
    F.DeckBackstop = DeckBackstop;
    F.DensityCurve = DensityCurve;

    F.BandSharpness = BandSharpness;
    F.BandBias = BandBias;
    F.BandRelief = BandRelief;
    F.PressureRelief = PressureRelief;
    F.VortexThreshold = VortexThreshold;
    F.StormTowerRelief = StormTowerRelief;
    F.ReliefThinning = ReliefThinning;

    F.WarpTime = WarpTime;
    F.TurbulenceFloor = TurbulenceFloor;

    F.EdgeBias = EdgeBias;
    F.ErosionDepth = ErosionDepth;

    F.StructureNoiseWeights = StructureNoiseWeights;
    F.StructureScale = StructureScale;
    F.StructureRelief = StructureRelief;
    F.StructureErosion = StructureErosion;
    F.StructureFlowInherit = StructureFlowInherit;
    F.StructureShearInherit = StructureShearInherit;
    F.StructureFadeNear = StructureFadeNear;
    F.StructureBandMix = StructureBandMix;
    F.StructureCrossfade = StructureCrossfade;

    F.DetailNoiseWeights = DetailNoiseWeights;
    F.DetailScale = DetailScale;
    F.DetailRelief = DetailRelief;
    F.DetailErosion = DetailErosion;
    F.DetailFlowInherit = DetailFlowInherit;
    F.DetailShearInherit = DetailShearInherit;
    F.DetailFadeNear = DetailFadeNear;
    F.DetailBandMix = DetailBandMix;
    F.DetailCrossfade = DetailCrossfade;

    F.DeckSlope = DeckSlope;

    F.Thickness = max(PlanetRadius * HeightScale, 1e-4f);

	// THE BASE HANGS FROM THE CEILING. Every upward term at its most generous:
	// Elevation is in [0,1] so the band gives half its relief either side of the
	// base; pressure is soft-saturated to [-1,1]; the structure carve is signed,
	// half each way; the detail carve follows GG_DETAIL_RELIEF_CENTRED. The
	// same terms GG_TopBounds sums, so its OutMax lands CeilingReserve of the
	// way above DeckTop.
#if GG_DETAIL_RELIEF_CENTRED
    const float DetailUp = 0.5f * abs(DetailRelief);
#else
    const float DetailUp = max(-DetailRelief, 0.0f);
#endif
    const float UpBudget = 0.5f * abs(BandRelief) + abs(PressureRelief)
		+ 0.5f * abs(StructureRelief) + DetailUp + max(StormTowerRelief, 0.0f);

    F.DeckBase = DeckTop - GradientThickness * UpBudget * CeilingReserve;

    F.DeepShearTime = WarpTime * DeepShearRatio;
    F.SpinAngle = -RotationWeight * Time;

	// CrossfadePeriod is authored in simulated seconds and converted to real
	// ones here. Both floors keep a zero from becoming a divide: a zero period
	// is a stopped clock.
    const float CrossfadePeriodReal = CrossfadePeriod / max(SimTimeScale, 1e-4f);
    F.CrossfadeTime = Time / max(CrossfadePeriodReal, 1e-3f);

    F.StructureVertical = StructureScale * StructureAspect * HeightScale;
    F.DetailVertical = DetailScale * DetailAspect * HeightScale;

	// Each far edge held above its own near one: equal endpoints make smoothstep
	// a step, and a step here is a ring across the disc at a fixed distance.
    F.StructureFadeFar = StructureFadeNear + max(StructureFadeSpan, 1e-4f);
    F.DetailFadeFar = DetailFadeNear + max(DetailFadeSpan, 1e-4f);

    F.StructureFade = 1.0f;
    F.DetailFade = 1.0f;

    return F;
}


/** What GG_Field returns. Two shapes rather than one, because the layers carve
 *  and erode by different amounts and fade on different schedules. Each is 1
 *  where its layer contributes nothing.
 *
 *  BandShift is the shapes' signed offset to Band, 0 where neither layer
 *  contributes. GG_Density applies it, weighted by depth into the gradient. */
struct GGFieldSample
{
    float Top;
    float Pressure;
    float Band;
    float BandShift;
    float ShapeDetail;
    float ShapeStructure;
};

float3 GG_RotateZ(float3 P, float Angle)
{
    float SinA, CosA;
    sincos(Angle, SinA, CosA);

    return float3(
		P.x * CosA - P.y * SinA,
		P.x * SinA + P.y * CosA,
		P.z);
}


/** Flow field reconstruction: 0 hardware bilinear, one tap, C0; 1 cubic
 *  B-spline, four taps, C2.
 *
 *  A PERFORMANCE HANDLE, three taps wide. Nothing between them is worth
 *  carrying: a one-tap C1 form exists -- warp the coordinate by a quintic fade
 *  before the hardware filter -- but its weight is flat at both ends, so each
 *  texel plateaus and a sharp band edge reads as blocks instead of facets.
 *  Neither adds information: if blocks survive at 1 the band edge is a genuine
 *  step in the sim data, and the answer is sim resolution or a softer
 *  BandSharpness. */
#ifndef GG_FLOW_FILTER
#define GG_FLOW_FILTER 1
#endif


/** Collapses the Worley rungs to one value about the median. NORMALIZED BY THE
 *  WEIGHTS' LENGTH, NOT THEIR SUM: the rungs are independent fields, so their
 *  variances add rather than their amplitudes. Dividing by the sum leaves three
 *  equal rungs at 0.58 of one rung's contrast, flattening toward grey exactly
 *  as more is switched on; length holds contrast constant however the balance
 *  is set, which makes the weights a look control instead of a fader. */
float GG_WorleyLadder(float3 Octaves, float3 Weights)
{
    const float Norm = max(length(Weights), 1e-4f);

    return saturate(0.5f + dot(Octaves - 0.5f, Weights) / Norm);
}


/** Remaps the Perlin base against the Worley floor: the Perlin says where
 *  material is, the cells erode it. */
float GG_PerlinWorley(float Perlin, float WorleyF1)
{
    const float Low = -WorleyF1;

    return saturate((Perlin - Low) / max(1.0f - Low, 1e-3f));
}


/** Samples the simulated flow field by DIRECTION. The grid is longitude by
 *  sin(latitude), so both coordinates are cheap from a unit vector. SAMPLER
 *  STATE MUST BE WRAP ON U AND CLAMP ON V.
 *
 *  Returns (u_east, u_north, psi_eddy, band):
 *    xy  Tangent velocity, radians per unit time; rebuild the 3D vector with
 *        GG_FlowVelocity. Two components because a tangent vector has two
 *        degrees of freedom and the third channel is worth more elsewhere.
 *    z   The EDDY streamfunction, psi with its zonal mean removed: zero in
 *        undisturbed flow, positive in anticyclones, negative in cyclones. Raw
 *        psi is dominated by its latitude ramp, so every use would land on
 *        bands rather than storms.
 *    w   Normalized vorticity, near [-1,1]. THE BAND SIGNAL, arriving already
 *        meandering and wrapped around vortices, since the sim transports
 *        vorticity. */
float4 GG_SampleFlow(Texture2DArray FlowField, SamplerState FlowSampler, float3 N, float Layer)
{
    const float U = frac(atan2(N.y, N.x) * (0.5f / PI));
    const float V = 0.5f + 0.5f * N.z;

#if GG_FLOW_FILTER == 0

    return FlowField.SampleLevel(FlowSampler, float3(U, V, Layer), 0.0f);

#else


	// RECONSTRUCTION MATTERS HERE. Bilinear is continuous in VALUE but not in
	// gradient, and the deck top is a direct function of this field while
	// shading responds to its slope -- so the slope jumps surface as faceting
	// along the lat/lon grid. The cubic is APPROXIMATING rather than
	// interpolating, which is the point: it does not pass through the texel
	// values, so a one-texel step in the field stops being one in the surface.
	// Four bilinear taps rather than sixteen point taps, each placed at the
	// offset that reproduces a pair's weights.
    uint Width, Height, Slices, Levels;
    FlowField.GetDimensions(0, Width, Height, Slices, Levels);

    const float2 Size = float2(Width, Height);
    const float2 InvSize = 1.0f / Size;

    const float2 Texel = float2(U, V) * Size - 0.5f;
    const float2 Corner = floor(Texel);
    const float2 Frac = Texel - Corner;

    const float2 F2 = Frac * Frac;
    const float2 F3 = F2 * Frac;

    const float2 W0 = (-F3 + 3.0f * F2 - 3.0f * Frac + 1.0f) / 6.0f;
    const float2 W1 = (3.0f * F3 - 6.0f * F2 + 4.0f) / 6.0f;
    const float2 W2 = (-3.0f * F3 + 3.0f * F2 + 3.0f * Frac + 1.0f) / 6.0f;
    const float2 W3 = F3 / 6.0f;

    const float2 S0 = W0 + W1;
    const float2 S1 = W2 + W3;

    const float2 UV0 = (Corner + 0.5f + (W1 / S0 - 1.0f)) * InvSize;
    const float2 UV1 = (Corner + 0.5f + (W3 / S1 + 1.0f)) * InvSize;

    return
		  S0.x * S0.y * FlowField.SampleLevel(FlowSampler, float3(UV0.x, UV0.y, Layer), 0.0f)
		+ S1.x * S0.y * FlowField.SampleLevel(FlowSampler, float3(UV1.x, UV0.y, Layer), 0.0f)
		+ S0.x * S1.y * FlowField.SampleLevel(FlowSampler, float3(UV0.x, UV1.y, Layer), 0.0f)
		+ S1.x * S1.y * FlowField.SampleLevel(FlowSampler, float3(UV1.x, UV1.y, Layer), 0.0f);

#endif
}


/** Arc length of one flow texel at a given radius, in world units.
 *
 *  THE FINEST THING THE DECK TOP CAN VARY OVER. GG_FlowProbe reads nothing but
 *  the flow field, so the smallest lateral feature in its column top is one
 *  texel of it.
 *
 *  A ray that steps further than this in one go samples one column out of the
 *  several it crossed, and the jitter picks which. That is not an estimate with
 *  noise on it, it is a choice, and it is why a shadow ray needs a step bounded
 *  by a LENGTH rather than a budget divided into a span: how much deck a light
 *  ray crosses depends on where the sun is, so a fixed count resolves an
 *  overhead ray far past the point of usefulness and a grazing one not at all.
 *
 *  Longitude is the tighter axis -- the grid is wider than it is tall -- so the
 *  width alone bounds it. */
float GG_FlowTexelArc(Texture2DArray FlowField, float Radius)
{
    uint Width, Height, Slices, Levels;
    FlowField.GetDimensions(0, Width, Height, Slices, Levels);

    return (2.0f * PI * Radius) / float(max(Width, 1u));
}

/** Rebuilds the 3D tangent velocity from the stored components. NO TRIG: with
 *  c = length(N.xy) the basis is east = (-N.y, N.x, 0)/c and north =
 *  (-N.z*N.x/c, -N.z*N.y/c, c). Guarded at the poles, where c goes to zero and
 *  east is undefined -- the grid is cell-centred so no texel sits on a pole,
 *  but a shading point can. */
float3 GG_FlowVelocity(float3 N, float4 Flow)
{
    const float C = max(length(N.xy), 1e-5f);

    const float3 East = float3(-N.y, N.x, 0.0f) / C;
    const float3 North = float3(-N.z * N.x / C, -N.z * N.y / C, C);

    return East * Flow.x + North * Flow.y;
}


/** Density at a height, given the column's top and floor. Peaks at exactly 1
 *  with zero derivative at both ends, so neither the onset nor the join to the
 *  saturated region draws a line. No peak-density term: only density times an
 *  extinction coefficient reaches the image, and Cloud Beta is solved from the
 *  optical depth wanted, so a peak authored here would divide straight back out.
 *
 *  PITFALL: the onset stays C1 only while Curve is above 0.5. At 0.5 the slope
 *  at the deck top goes finite instead of zero, creasing along the whole top;
 *  below it the top hardens into an edge. Both are legitimate looks, so this is
 *  not clamped -- the floor only keeps the exponent positive, since pow(t, 0)
 *  returns 1 and would put full density above the deck. */
float GG_DeckDensity(float Height, float Top, float Bottom, float Curve)
{
    const float Span = max(Top - Bottom, 1e-4f);

    const float T = saturate((Top - Height) / Span);

    return smoothstep(0.0f, 1.0f, pow(T, max(Curve, 1e-4f)));
}


/** Where a column's gradient bottoms out: the authored thickness below its own
 *  top, backstopped by DeckBackstop. THE ONE PLACE THE FLOOR IS DERIVED -- the
 *  profile, the erosion normalization and the solid-region skip all have to
 *  agree about it or the skip fills in cloud the profile left transparent.
 *
 *  The backstop keeps the marched band thin: a freely following floor drags the
 *  fine segment's lower edge to the deepest top minus the thickness, spending
 *  the same step budget over nearly twice the span. NEVER ABOVE THE TOP -- a
 *  column pushed below the backstop would otherwise get a floor above its own
 *  top, inverting the profile so empty air reads as solid. Clamped, such a
 *  column is a step at its top, and the result is monotone in Top, which is
 *  what lets the skip test a lower bound. */
float GG_DeckFloor(float Top, GGFieldParams F)
{
    return min(max(Top - F.GradientThickness, F.DeckBackstop), Top);
}


/** The deck's extinction coefficient per atmosphere thickness, solved so a ray
 *  down an unrelieved column accumulates DeckOpticalDepth at core density: the
 *  gradient integrates to half its span, plus the saturated region below the
 *  floor. Multiply by a tint for colour and divide by Thickness for world
 *  units.
 *
 *  SOLVED RATHER THAN AUTHORED, so retuning the shell or the anchors leaves the
 *  deck's opacity where it was put. Shared by the march and the bake, which is
 *  what keeps the depth at which the map goes opaque the depth at which the eye
 *  sees it go opaque. */
float GG_DeckBeta(GGFieldParams F, float DeckOpticalDepth)
{
    const float Floor = GG_DeckFloor(F.DeckBase, F);

    return DeckOpticalDepth / max(0.5f * (F.DeckBase + Floor), 1e-4f);
}


/** Cloud top altitude, an atmosphere fraction. Flow first -- band elevation,
 *  pressure lift, storm towers -- then the two carves.
 *
 *  THE PRESSURE SIGN IS NOT ARBITRARY. Anticyclones are high pressure, rising,
 *  condensing fresh ammonia above the haze, so they must sit HIGH. Backwards,
 *  the field reads as plausible until you notice every storm is a pit.
 *
 *  THE CARVES ENTER DIFFERENTLY. Structure is signed about the noise median:
 *  its features are large enough that a one-sided carve lowers the mean deck as
 *  it is turned up, so texture amount and deck altitude stop being separate
 *  controls. Detail subtracts: it never moves the deck as a body, and centred it
 *  reads as material pushing UP out of the surface. Either amount may be
 *  negative, mirroring its layer.
 *
 *  ReliefScale collapses band relief under strain and deliberately does NOT
 *  touch the lift or the towers -- those are vertical motion rather than
 *  stretched material, so thinning them flattens storms exactly where the flow
 *  is most active. The tower term is gated on vortex strength: ungated, Worley
 *  F1 is polka dots. StormCells is inverted because F1 is minimal at cell
 *  CENTRES, which is where a tower belongs. */
float GG_CloudTop(
	float Elevation,
	float CarveDetail,
	float ReliefStructure,
	float Pressure,
	float StormCells,
	float ReliefScale,
	GGFieldParams F)
{
    const float D = F.GradientThickness;

    float Top = F.DeckBase + D * ReliefScale * F.BandRelief * (Elevation - 0.5f);

    Top -= D * F.DetailRelief * CarveDetail;
    Top += D * F.StructureRelief * ReliefStructure;

    Top += D * F.PressureRelief * Pressure;

    const float Vortex = smoothstep(F.VortexThreshold, 1.0f, abs(Pressure));

    Top += D * F.StormTowerRelief * (1.0f - StormCells) * Vortex;

    return Top;
}


/** One flow fetch: the band, the pressure, and the cloud top bracketed from
 *  above and below. */
struct GGFlowProbe
{
    float Band;
    float Pressure;

    float Top;

    float TopLower;
};


/** The cloud top from a flow sample, without the volumes.
 *
 *  Top BOUNDS THE FLOW TERMS FROM ABOVE, with the carves at their median. A
 *  search that overestimates stops short and takes another iteration; one that
 *  underestimates steps over the surface and misses cloud entirely. So the band
 *  contributes max(BandTerm, 0) -- ReliefScale is in [0,1] and multiplies a term
 *  that changes sign -- and the tower is at full height wherever its gate is
 *  open. NO CARVE MARGIN IN IT: the entry search pays an extra iteration for a
 *  loose bound, but the shadow ray reads Top as the deck's ACTUAL height and
 *  pays in optical depth, where half a gradient darkens the deck to nothing.
 *  The search's margin lives in GG_CloudTopUpper instead.
 *
 *  TopLower TAKES EVERY TERM AT ITS MOST NEGATIVE, both carves included, so a
 *  floor derived from it is at or below the column's real floor. Its carve terms
 *  MATCH GG_TopBounds, which bounds the same quantity deck-wide; two
 *  expressions for how far a layer can cut would drift, and the skip would then
 *  disagree with the marched band. Band and Pressure likewise MUST MATCH
 *  GG_Field's unshifted values, or the saturated region tints differently from
 *  the gradient above it. GG_Density takes BandShift to zero at the floor so
 *  the two meet there. */
GGFlowProbe GG_ProbeFromFlow(float4 Flow, GGFieldParams F)
{
    GGFlowProbe Probe;

    Probe.Band = (Flow.w + F.BandBias) * F.BandSharpness;
    Probe.Pressure = Flow.z;

    const float Elevation = 1.0f - exp(-Probe.Band * Probe.Band);

    const float D = F.GradientThickness;

    const float Base = F.DeckBase + D * F.PressureRelief * Probe.Pressure;

    const float BandTerm = F.BandRelief * (Elevation - 0.5f);

    const float Vortex = smoothstep(F.VortexThreshold, 1.0f, abs(Probe.Pressure));

    Probe.Top = Base + D * (max(BandTerm, 0.0f) + max(F.StormTowerRelief, 0.0f) * Vortex);

    const float CarveDown = max(F.DetailRelief, 0.0f) * saturate(F.DetailFade)
		+ 0.5f * abs(F.StructureRelief) * saturate(F.StructureFade);

    Probe.TopLower = Base
		+ D * (min(BandTerm, 0.0f) + min(F.StormTowerRelief, 0.0f) * Vortex - CarveDown);

    return Probe;
}


/** The cheap read, for the jobs that do not need the volumes: finding where a
 *  ray enters the deck, and shading below a column's floor where the volumes
 *  cannot change the density. */
GGFlowProbe GG_FlowProbe(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	float3 P,
	GGFieldParams F)
{
    const float3 N = normalize(GG_RotateZ(P, F.SpinAngle));

    return GG_ProbeFromFlow(GG_SampleFlow(FlowField, FlowSampler, N, GG_FLOW_LAYER), F);
}


/** Conservative UPPER BOUND on the deck top, for the entry search: the probe's
 *  top plus whatever the carves can RAISE it by. The structure layer's upward
 *  half always, since it is signed; the detail layer's only when its amount is
 *  negative and it therefore builds. */
float GG_CloudTopUpper(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	float3 P,
	GGFieldParams F)
{
    const float Top = GG_FlowProbe(FlowField, FlowSampler, P, F).Top;

    return Top + F.GradientThickness * (max(-F.DetailRelief, 0.0f)
		+ 0.5f * abs(F.StructureRelief));
}


/** Distance along a ray at which it first reaches the deck. Returns T1 when the
 *  ray never reaches it between T0 and T1.
 *
 *  A CONE TRACE, AND NOT AN OPTIMIZATION -- it is what keeps the limb from
 *  breaking. A grazing chord from the cull radius to the surface is enormous,
 *  and stepped at the deck's own step size it exhausts the iteration cap in
 *  empty space, leaving the ray transparent at exactly the angles where its
 *  neighbours a fraction of a degree steeper reach density and go opaque. That
 *  threshold is geometric and sharp, and it draws a hard silhouette where the
 *  limb should be softest.
 *
 *  LocalOrigin and LocalDir are in the field's frame, LocalDir normalized --
 *  which an orthonormal WorldToLocal preserves. */
float GG_DeckEntry(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	float3 LocalOrigin,
	float3 LocalDir,
	float T0,
	float T1,
	float TopMax,
	GGFieldParams F)
{
    float TSearch = T0;

	[loop]
    for (int Probe = 0; Probe < 24; Probe++)
    {
        const float3 ProbePos = LocalOrigin + LocalDir * TSearch;
        const float ProbeRadius = length(ProbePos);
        const float ProbeHeight = (ProbeRadius - F.PlanetRadius) / F.Thickness;

        const float3 ProbeDir = ProbePos / max(ProbeRadius, 1e-4f);
        const float ProbeRate = dot(LocalDir, ProbeDir);

        const float TopUpper = GG_CloudTopUpper(FlowField, FlowSampler, ProbeDir, F);

        if (ProbeHeight <= TopUpper)
        {
            return TSearch;
        }

		// Climbing and clear of the highest the deck can reach. Both conditions
		// matter: a climbing ray still inside the deck's range can meet a
		// taller column ahead.
        if (ProbeRate >= 0.0f && ProbeHeight > TopMax)
        {
            return T1;
        }

		// The deck rises to meet the ray, so the closing rate is the sum of the
		// ray's descent and the deck's rise across the ground it covers.
		// Dividing by the descent alone overshoots without bound at tangent.
		// DeckSlope is in gradient depths per radian, matching the relief that
		// produces the slope.
        const float Horizontal = sqrt(max(1.0f - ProbeRate * ProbeRate, 0.0f));

        const float ClosingRate = -ProbeRate
			+ Horizontal * max(F.DeckSlope, 0.1f) * F.GradientThickness * F.Thickness
				/ max(ProbeRadius, 1e-4f);

        const float Advance = (ProbeHeight - TopUpper) * F.Thickness / max(ClosingRate, 1e-5f);

        TSearch += max(Advance * GG_CONE_RELAXATION, 1e-4f);

        if (TSearch >= T1)
        {
            return T1;
        }
    }

    return TSearch;
}


/** Evaluates the cloud field at a direction on the sphere. Height is the
 *  shading point's atmosphere fraction and only affects the 3D volume lookups.
 *
 *  N IS ALREADY SPUN AND Flow0 IS ITS FLOW SAMPLE, both from the caller: the
 *  saturation test needs that fetch before it can decide whether to call this at
 *  all, so taking them as arguments is what keeps the test free. Flow0 is also
 *  the warp loop's first iteration. UNWARPED deliberately -- the sim transports
 *  vorticity, so the band pattern arrives already advected and warping the
 *  lookup would double-count.
 *
 *  VOLUME SAMPLER STATE: wrap on all three axes, Linear Color. These are scalar
 *  fields and an sRGB decode curves them without erroring.
 *
 *  Up to six further fetches, depending on which layers survive their fade. */
GGFieldSample GG_Field(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	Texture3D DetailVolume,
	SamplerState DetailSampler,
	Texture3D StructureVolume,
	SamplerState StructureSampler,
	float3 N,
	float4 Flow0,
	float Height,
	GGFieldParams F)
{
    const float Pressure = Flow0.z;

    const float Zeta = (Flow0.w + F.BandBias) * F.BandSharpness;

    const float BandSigned = Zeta;


	// Zero at a band boundary, one at a core, so boundaries sit LOW and
	// interiors pile UP -- right physically, since boundaries are the jets and
	// material thins where it is strained. SMOOTH, NOT saturate(abs()): that
	// form kinks where it pins at one and again at the zero crossing, which is
	// a C1 break in the cloud top reading as creases along band contours.
    const float Elevation = 1.0f - exp(-Zeta * Zeta);

    const float Boundary = 1.0f - Elevation;


	// Turbulence follows the shear and the shear lives at the boundaries, so
	// zone interiors go nearly laminar. Without it the bands read as one
	// scalloped curve repeated all the way round.
    const float Turbulence = lerp(F.TurbulenceFloor, 1.0f, Boundary);

    const float StepTime = (F.WarpTime * Turbulence) / (float) GG_WARP_ITERATIONS;

    float3 Pos = N;

    float3 FirstVelocity = 0.0f;
    float3 LastVelocity = 0.0f;

	[unroll]
    for (int It = 0; It < GG_WARP_ITERATIONS; It++)
    {
        const float4 Flow = (It == 0) ? Flow0
			: GG_SampleFlow(FlowField, FlowSampler, Pos, GG_FLOW_LAYER);

        const float3 Velocity = GG_FlowVelocity(Pos, Flow);

        if (It == 0)
        {
            FirstVelocity = Velocity;
        }

        LastVelocity = Velocity;


		// Renormalized every step because the displacement leaves the sphere.
		// Only .z is read downstream, so a chord move biases latitude and
		// compounds over several steps.
        Pos = normalize(Pos + Velocity * StepTime);
    }

    const float3 Warped = Pos;


	// A difference rather than a running sum: each step renormalizes, so the sum
	// of the steps is not the distance travelled.
    const float3 FlowWarp = Warped - N;

    float Ridge = 0.5f;
    float3 DeepShear = 0.0f;

	// -- Crossfade ----------------------------------------------------------
	//
	// ADVECTION HAS NOWHERE TO ACCUMULATE. The sim carries its own history, but
	// the volumes are resampled from scratch every frame, so a warp anchored to
	// a fixed direction can only wobble -- it cannot travel. Two phases half a
	// period apart, each ramping its displacement from nothing to
	// GG_CROSSFADE_SPAN and resetting, give features somewhere to travel to.
	//
	// THE WEIGHT IS ZERO WHERE THE PHASE RESETS, which is the whole trick: the
	// discontinuity happens while the layer contributes nothing.
	//
	// IT IS A DISSOLVE BETWEEN TWO DIFFERENTLY SHEARED COPIES, not a crossfade
	// between two positions. Uniform flow would blend invisibly; this flow is
	// shear-dominated, so the two phases are stretched by different amounts and
	// the blend ghosts. A shorter period narrows the gap and shows the dissolve
	// more often. That trade is what the period is for.
    const float PhaseA = frac(F.CrossfadeTime);
    const float PhaseB = frac(F.CrossfadeTime + 0.5f);

    const float WeightA = 1.0f - abs(2.0f * PhaseA - 1.0f);

    const float WarpMulA = GG_CROSSFADE_SPAN * PhaseA;
    const float WarpMulB = GG_CROSSFADE_SPAN * PhaseB;


	// A FADED LAYER IS SKIPPED, NOT JUST SCALED. EXACTLY ZERO, NOT AN EPSILON: a
	// skip at a small positive fade is a discontinuity at a fixed fade value,
	// which is a fixed distance from the camera, which is a ring on screen.
	// smoothstep returns exactly 1 past its far edge, so the branch still fires
	// over the whole faded region.
    const bool bWantDetail = (F.DetailFade > 0.0f);
    const bool bWantStructure = (F.StructureFade > 0.0f);

    BRANCH

	// DEEP SHEAR, ONE STEP THROUGH THE DEEP FLOW LAYER. A different sim slice
	// from the coarse warp, which is what produces genuine vertical wind shear.
	// Sampled at the detail layer's flow-only position. OUTSIDE EITHER LAYER'S
	// BRANCH, BECAUSE THIS IS GEOMETRY RATHER THAN NOISE: computed only where
	// one layer survives, the other would warp differently either side of that
	// layer's fade -- a discontinuity in MOTION, which softening cannot hide.
    if (bWantDetail || bWantStructure)
    {
        const float3 PShear = normalize(N + FlowWarp * F.DetailFlowInherit);

        const float4 DeepFlow = GG_SampleFlow(FlowField, FlowSampler, PShear, GG_DEEP_FLOW_LAYER);

        DeepShear = GG_FlowVelocity(PShear, DeepFlow) * (F.DeepShearTime * Turbulence);
    }

	// Each layer's displacement: its FlowInherit of the coarse warp plus its
	// ShearInherit of the deep shear. A displacement field with a large gradient
	// IS strain, so inheriting one whole imposes an order-one strain on a layer
	// regardless of its own flow.
    const float3 DetailWarp = FlowWarp * F.DetailFlowInherit + DeepShear * F.DetailShearInherit;
    const float3 StructureWarp = FlowWarp * F.StructureFlowInherit + DeepShear * F.StructureShearInherit;

    BRANCH

    if (bWantDetail)
    {
		// SAMPLED IN TRUE 3D. The position is a unit direction, so it times Scale
		// alone traces a sphere through the volume -- a 2D slice discarding the
		// vertical structure the bake put there. NO INDEPENDENT DRIFT: a clock
		// scrolling the volume through its own domain makes the detail change
		// whether or not anything is happening to it, which is grain by
		// definition. If it looks pinned, raise WarpTime.
        const float UVWScale = F.DetailScale + Height * F.DetailVertical;

		// MIP 0, ALWAYS. A footprint-derived mip blurs along the shell and
		// erases the vertical structure a high aspect ratio builds, flattening a
		// layered deck back to one shell. Undersampled instead: the high
		// frequencies fold down rather than resolve, and the fades remove a
		// layer once that stops being affordable.
        float4 DetailSample;

        BRANCH

        if (F.DetailCrossfade > 0.0f)
        {
			// The two phases differ only in how far along the SAME displacement
			// they sit, so one flow loop serves both. The deep-flow fetch stays
			// on the unphased position: it decides how the layer is sheared, not
			// where it is, and a second fetch of it would double the loop's cost
			// to move a displacement the crossfade is already blending across.
            const float3 PA = normalize(N + DetailWarp * WarpMulA);
            const float3 PB = normalize(N + DetailWarp * WarpMulB);

            DetailSample = lerp(
				DetailVolume.SampleLevel(DetailSampler, PB * UVWScale, 0.0f),
				DetailVolume.SampleLevel(DetailSampler, PA * UVWScale, 0.0f),
				WeightA);
        }
        else
        {
            DetailSample = DetailVolume.SampleLevel(
				DetailSampler, normalize(N + DetailWarp) * UVWScale, 0.0f);
        }

        Ridge = GG_PerlinWorley(
			DetailSample.r,
			GG_WorleyLadder(DetailSample.gba, F.DetailNoiseWeights.xyz));
    }


	// Alpha is the storm-tower gate and 1 is its NEUTRAL value, since the tower
	// term reads (1 - StormCells). The fade lerps toward the same 1, so the
	// skipped case and the fully faded case agree.
    float4 Structure = float4(0.5f, 1.0f, 1.0f, 1.0f);

    BRANCH

    if (bWantStructure)
    {
        const float UVWScale = F.StructureScale + Height * F.StructureVertical;

        BRANCH

        if (F.StructureCrossfade > 0.0f)
        {
            const float3 PA = normalize(N + StructureWarp * WarpMulA);
            const float3 PB = normalize(N + StructureWarp * WarpMulB);

            Structure = lerp(
				StructureVolume.SampleLevel(StructureSampler, PB * UVWScale, 0.0f),
				StructureVolume.SampleLevel(StructureSampler, PA * UVWScale, 0.0f),
				WeightA);
        }
        else
        {
			// Zero inheritance is legitimate rather than degenerate: this layer
			// breaks the flow into rounded shapes, and a shape dragged through the
			// flow field is no longer round.
            const float3 PStructure = normalize(N + StructureWarp);

            Structure = StructureVolume.SampleLevel(
				StructureSampler, PStructure * UVWScale, 0.0f);
        }
    }


	// RELIEF THINNING, MEASURED FROM THE FLOW RATHER THAN PRESCRIBED. An
	// incompressible parcel stretched by g must thin VERTICALLY by 1/g; without
	// it, filament width shrinks with strain while height does not and the march
	// reads them as spikes. The velocity difference over the distance travelled
	// is a strain rate in the right units, from two samples the loop already
	// took -- a prescribed zonal profile reports zero inside a vortex straining
	// material hard.
    const float Travelled = length(FlowWarp);

    const float StrainRate = length(LastVelocity - FirstVelocity) / max(Travelled, 1e-5f);

    const float Winding = StrainRate * F.WarpTime;

    const float ReliefScale = 1.0f / (1.0f + F.ReliefThinning * Winding);


	// EDGE WEIGHTING. Detail applied uniformly is by definition grain: it has no
	// relationship to the structure it sits on. Concentrated on the transitions
	// it ravels the band EDGES, where a real gas giant's billows live.
    const float Edge = lerp(F.EdgeBias, 1.0f, Boundary);

    const float StructureMix = GG_PerlinWorley(
		Structure.r,
		GG_WorleyLadder(Structure.gba, F.StructureNoiseWeights.xyz));


	// Fade enters HERE rather than at the consumption sites, so it scales the
	// noise's EFFECT and leaves its scale alone -- structure stays the same size
	// as it dims rather than growing.
    const float DetailWeight = saturate(Edge * F.DetailNoiseWeights.w * F.DetailFade);
    const float StructureWeight = saturate(Edge * F.StructureNoiseWeights.w * F.StructureFade);


	// EROSION KEEPS ITS NEUTRAL AT 1, since it multiplies density and may only
	// remove material. RELIEF is signed about the median, since it moves a
	// surface and has no reason to prefer a direction.
    const float ShapeDetail = lerp(1.0f, Ridge, DetailWeight);
    const float ShapeStructure = lerp(1.0f, StructureMix, StructureWeight);

#if GG_DETAIL_RELIEF_CENTRED
	// About the median, so turning the layer up or fading it in changes the
	// deck's texture without changing its altitude.
    const float CarveDetail = DetailWeight * (0.5f - Ridge);
#else
    const float CarveDetail = DetailWeight * (1.0f - Ridge);
#endif

    const float ReliefStructure = StructureWeight * (StructureMix - 0.5f);


	// MATERIAL FOLLOWS SHAPE. The band boundary becomes the zero contour of Band
	// plus the signed shapes that move the surface, so a billow near a boundary
	// is made of whichever family its sign points at. Doubled so each term spans
	// +-1 at full weight.
	//
	// PITFALL: keep it additive. Any form that depends on sign(Band) flips on the
	// zero contour and redraws the clean line as a discontinuity. The detail
	// term is median-centred regardless of GG_DETAIL_RELIEF_CENTRED; the
	// one-sided carve would push every boundary toward one family.
    const float BandShift = 2.0f * (F.StructureBandMix * ReliefStructure
		+ F.DetailBandMix * DetailWeight * (0.5f - Ridge));


	// THE TOWER GATE RIDES THE SAME FADE. Left raw it holds full height to the
	// skip threshold then vanishes in one step -- the tallest feature on the deck
	// popping out at a fixed distance. Not edge-weighted, unlike the shapes: a
	// tower's placement already comes from the vortex gate.
    const float StormGate = lerp(1.0f, Structure.g, saturate(F.StructureFade));

    GGFieldSample Out;

    Out.Top = GG_CloudTop(
		Elevation, CarveDetail, ReliefStructure, Pressure, StormGate, ReliefScale, F);
    Out.Pressure = Pressure;
    Out.Band = BandSigned;
    Out.BandShift = BandShift;
    Out.ShapeDetail = ShapeDetail;
    Out.ShapeStructure = ShapeStructure;

    return Out;
}


/** The band colour ramp, for the debug material. Colour from the SIGN of
 *  vorticity scaled by the MAGNITUDE, so zero lands on EdgeColour and cores come
 *  out saturated, and the dark line between bands separates the two families
 *  instead of blending them through a muddy midpoint. Scale is the sim debug
 *  view's DebugScale inverted. */
float3 GG_BandColour(float Band, float3 ColourA, float3 ColourB, float3 EdgeColour, float Scale)
{
    const float T = clamp(Band * Scale, -1.0f, 1.0f);

    const float3 Hue = (T < 0.0f) ? ColourB : ColourA;

    return lerp(EdgeColour, Hue, abs(T));
}


/** Density at a point in the shell. LocalPos carries its true radius, unlike
 *  elsewhere in this file; the columnar field is still evaluated at the
 *  normalized direction, since the shell is thin enough that the true radius
 *  shifts UVW by far less than one lattice cell. StepHalfLength is half the
 *  march step in ATMOSPHERE FRACTIONS along the radius, so a step straddling the
 *  cloud top is weighted by how much of it lies inside.
 *
 *  Returns:
 *    x  Density in [0,1]. Multiply by an extinction coefficient in the march.
 *    y  BAND, signed and unclamped. What the material IS, not a density term;
 *       shifted by the shapes near the surface.
 *    z  Pressure, for tinting vortices. Negative is cyclonic.
 *    w  The deck top at this column, which the march cannot compute itself. */
float4 GG_Density(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	Texture3D DetailVolume,
	SamplerState DetailSampler,
	Texture3D StructureVolume,
	SamplerState StructureSampler,
	float3 LocalPos,
	float StepHalfLength,
	GGFieldParams F)
{
    const float Radius = length(LocalPos);
    const float3 Direction = LocalPos / max(Radius, 1e-4f);

    const float Height = (Radius - F.PlanetRadius) / F.Thickness;

    const float HalfStep = max(StepHalfLength, 0.0f);

    const float3 N = normalize(GG_RotateZ(Direction, F.SpinAngle));

    const float4 Flow0 = GG_SampleFlow(FlowField, FlowSampler, N, GG_FLOW_LAYER);

    const GGFlowProbe Probe = GG_ProbeFromFlow(Flow0, F);

    BRANCH


	// ONE FETCH BELOW THE COLUMN'S FLOOR RATHER THAN SEVEN. Density there is
	// exactly 1 and the volumes cannot change it, so only band and pressure are
	// wanted and the probe's fetch supplies both. The test uses the step's far
	// edge, so the boundary sits a half step clear of the sampling lattice.
	//
	// AGAINST A LOWER BOUND ON THE FLOOR, NOT THE FLOOR. Knowing the real floor
	// costs the volumes; the probe brackets it for free, and GG_DeckFloor is
	// monotone in Top so the test can only be conservative. Testing the upper
	// bound instead would claim saturation early and fill carved troughs back in
	// with solid deck.
    if (Height + HalfStep <= GG_DeckFloor(Probe.TopLower, F))
    {
        return float4(1.0f, Probe.Band, Probe.Pressure, Probe.Top);
    }

    const GGFieldSample Field = GG_Field(
		FlowField, FlowSampler, DetailVolume, DetailSampler,
		StructureVolume, StructureSampler,
		N, Flow0, Height, F);

    const float Top = Field.Top;

    const float Bottom = GG_DeckFloor(Top, F);


	// THE PROFILE IS INTEGRATED ACROSS THE STEP, NOT SAMPLED AT ITS MIDPOINT.
	// One midpoint sample makes the deck a near-binary decision per step, and as
	// the surface drifts against the step lattice that decision flips along a
	// locus that is a line on screen. The top varies slowly across one step, so
	// it is evaluated once at the centre and only the profile is integrated:
	// three closed-form evaluations, no extra fetches.
    const float RampNear = GG_DeckDensity(Height - HalfStep, Top, Bottom, F.DensityCurve);
    const float RampMid = GG_DeckDensity(Height, Top, Bottom, F.DensityCurve);
    const float RampFar = GG_DeckDensity(Height + HalfStep, Top, Bottom, F.DensityCurve);

    const float Gradient = (RampNear + 4.0f * RampMid + RampFar) / 6.0f;

    const float DepthFraction =
		saturate((Top - Height) / max(Top - Bottom, 1e-4f));


	// Full erosion at the surface, none below ErosionDepth, or the deck is
	// uniformly pitted rather than solid material with a worked surface.
	// Smoothstep rather than linear: where erosion stops is a density
	// discontinuity in the depth direction, and a linear falloff leaves it C0 --
	// a faint shelf, edge-on, at a constant altitude.
    const float CarveWeight =
		1.0f - smoothstep(0.0f, max(F.ErosionDepth, 1e-4f), DepthFraction);


	// THE CARVE MODULATES THE GRADIENT AND NOTHING ELSE. Multiplicative, and the
	// gradient is exactly zero above Top, so nothing the noise does can put
	// density outside the bound GG_TopBounds computed. Each lerp floors its layer
	// at (1 - erosion) rather than reaching zero: there is no lower cloud shell,
	// so a fully transparent column would let a ray run to the far side of the
	// planet. Applied in series, so the two compose as independent extinctions.
    const float CarveDetail = lerp(1.0f, Field.ShapeDetail,
		saturate(F.DetailErosion) * CarveWeight);

    const float CarveStructure = lerp(1.0f, Field.ShapeStructure,
		saturate(F.StructureErosion) * CarveWeight);

    const float Density = Gradient * CarveDetail * CarveStructure;


	// Mixing lives in the worked surface and is gone by the floor, where the
	// saturated early-out reports the probe's unshifted band. Smoothstep so the
	// weight is C1 at both ends and the handoff draws no contour in colour.
    const float MixWeight = 1.0f - smoothstep(0.0f, 1.0f, DepthFraction);

    return float4(Density, Field.Band + Field.BandShift * MixWeight, Field.Pressure, Top);
}

// ---------------------------------------------------------------------------
// Bounds
// ---------------------------------------------------------------------------

/** Closed-form bounds on the cloud top, in atmosphere fractions.
 *
 *  EVERY TERM IN GG_CloudTop HAS TO APPEAR HERE, and in the upward budget
 *  GG_BuildField solves DeckBase from. An underestimate is not conservative, it
 *  is a clipping error: the cull radius comes from OutMax, so a term left out
 *  slices the tops off exactly the features it belongs to. Elevation is in
 *  [0,1] so the band contributes half of BandRelief either side of the base;
 *  pressure is soft-saturated sim-side so it contributes the whole of
 *  PressureRelief; ReliefScale never exceeds one, so ignoring it errs safe.
 *
 *  THE CARVES ARE SCALED BY THE FADES, because a bound reserving room for a
 *  layer a faded ray never sees coarsens the march wherever that layer is
 *  absent -- OutMax divided by cloudSteps is the step size, so a shape control
 *  would end up moving the lighting. Pass 1 for both to get the unconditional
 *  bound; any fade passed must be at least the fade at every sample covered.
 *
 *  OutMin is the lowest a column top can be, hence the altitude below which
 *  EVERY column is saturated -- the anchor the opaque clip counts down from. It
 *  does not bound the marched band: that ends at the backstop, so a trough
 *  below it is stepped coarsely rather than finely. */
void GG_TopBounds(
	GGFieldParams F,
	float DetailFade,
	float StructureFade,
	out float OutMin,
	out float OutMax)
{
    const float D = F.GradientThickness;

    const float Span = D * (0.5f * abs(F.BandRelief) + abs(F.PressureRelief));


	// Structure is signed about the median, so half of its reach lands in each
	// bound. Detail follows GG_DETAIL_RELIEF_CENTRED: centred it is the same
	// half-and-half, one-sided it lands entirely in whichever bound the sign of
	// its amount points at.
	//
	// A SYMMETRIC TERM COSTS SOMETHING. It pushes OutMax up, which lengthens the
	// chord every grazing ray crosses and coarsens the step -- so a one-sided
	// carve reserving only the side it uses is cheaper, and that is worth
	// knowing when reading the two settings against each other.
    const float StructureHalf =
		D * 0.5f * abs(F.StructureRelief) * saturate(StructureFade);

    const float DetailCarve = D * saturate(DetailFade) * abs(F.DetailRelief);

#if GG_DETAIL_RELIEF_CENTRED
    const float DetailDown = 0.5f * DetailCarve;
    const float DetailUp = 0.5f * DetailCarve;
#else
    const float DetailDown = (F.DetailRelief > 0.0f) ? DetailCarve : 0.0f;
    const float DetailUp = (F.DetailRelief < 0.0f) ? DetailCarve : 0.0f;
#endif

    OutMin = F.DeckBase - Span - StructureHalf - DetailDown;

    OutMax = F.DeckBase + Span + StructureHalf + DetailUp
		+ D * max(F.StormTowerRelief, 0.0f);
}
