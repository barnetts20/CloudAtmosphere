#pragma once

#include "/Plugin/CloudAtmosphere/Private/AtmosphereTypes.ush"
#include "/Plugin/CloudAtmosphere/Private/AtmosphereTransmittance.ush"

// Setup: everything between the material's pin values and a filled
// CompositeParams.
//
// SEPARATE FROM THE MARCH BECAUSE IT IS THE PART THAT KNOWS ABOUT THE MATERIAL.
// A march takes the struct and does not care where it came from; this file does
// the unit conversions, the ray reconstruction and the depth blending that only
// make sense inside a post process material. Nothing here is march-specific, so
// both models build their params through it.

/** The size the march is actually being written at, for a DOWNSAMPLED target.
 *
 *  The march occupies the top-left region of the screen at rtSize, so a pixel
 *  coordinate cannot be divided by the view size: it has to be divided by the
 *  region being written, or the ray fans out over the whole screen while only
 *  part of it is filled. Falls back to the view size below two pixels, which is
 *  what rtSize reads where the pass producing it has not run -- the material
 *  editor's preview -- giving a full-resolution ray. */
float2 Atmo_MarchSize(float2 rtSize)
{
    return all(rtSize >= 2.0f) ? rtSize : View.ViewSizeAndInvSize.xy;
}

/** World ray direction through a pixel. The 0.5 clip depth is arbitrary: any
 *  depth on the ray works, since the result is normalized. */
float3 Atmo_RayDirection(float2 svPosition, float2 rtSize)
{
    float2 screenUV = svPosition / Atmo_MarchSize(rtSize);

    float2 ClipXY = screenUV * float2(2, -2) + float2(-1, 1);

    float4 WorldDir = mul(float4(ClipXY, 0.5, 1.0), View.ClipToTranslatedWorld);

    return normalize(WorldDir.xyz / WorldDir.w);
}

/** Blends between ignoring scene depth and using it. Scene depth loses
 *  precision badly at planetary distances, so from outside the atmosphere it is
 *  unusable, but from inside it is what stops the march running through terrain.
 *  Blended on altitude: fully trusted at the cloud deck, fully ignored at the
 *  atmosphere's outer edge. The ignored case is camDist * 2 rather than a huge
 *  number, so the lerp does not lose its near end to precision as it starts. */
float Atmo_CorrectedDepth(float camDist, float sceneDepth, float atmoRadius, float cloudOuterRadius)
{
    float outerBlend = saturate((atmoRadius - camDist) / (atmoRadius - cloudOuterRadius));

    return lerp(camDist * 2, sceneDepth, outerBlend);
}

/** Fills CompositeParams from the material's pin values. The gas giant path
 *  passes zero for every terrestrial cloud-shape argument, which it never reads.
 *
 *  SCALED BY ATMOSPHERE THICKNESS ON THE WAY IN. Every coefficient and scale
 *  height arrives as a fraction of the atmosphere's depth rather than in world
 *  units, so a planet can be resized without retuning its air. The betas divide
 *  because an extinction coefficient is a reciprocal length: a thicker
 *  atmosphere at the same total opacity has a smaller coefficient.
 *
 *  CAMERA AT THE ORIGIN. The march runs camera-relative, which raises the
 *  precision floor enormously at planetary scale -- planet-relative positions
 *  are millions of units and float32 has about seven digits. The original camera
 *  position is carried separately for the one thing that needs world space,
 *  which is sampling the cloud noise. */
CompositeParams Atmo_BuildParams(
	float2 svPosition,
	float3 rayDir,
	float3 cameraPos,
	float3 atmoPos,
	float planetRadius,
	float atmoRadius,
	float cloudOuterRadius,
	float cloudInnerRadius,
	float sceneDepth,
	float3 lightDirection,
	float3 lightColor,
	float4 rayleighBeta,
	float4 mieBeta,
	float4 absorptionBeta,
	float absorptionFalloff,
	float4 atmoAmbient,
	float mieG,
	float3 cloudScatterBeta,
	float3 cloudAbsorptionBeta,
	float4 cloudAmbient,
	float4 cloudPhaseParams,
	float cloudScale,
	float2 cloudHeightCurve,
	float cloudCoverage,
	float cloudDensityMult,
	float4 cloudNoiseWeights,
	float4 cloudNoiseInvert,
	float4 detailNoiseWeights,
	float4 detailNoiseInvert,
	float detailNoiseScale,
	float detailNoiseErode,
	float4 animationWeights,
	int mainAtmoSteps,
	int mainCloudSteps,
	float stepScaleFactor)
{
    const float atmoThickness = atmoRadius - planetRadius;

    const float3 crPlanetPos = atmoPos - cameraPos;
    const float camDist = length(crPlanetPos);

    const float cosTheta = dot(rayDir, lightDirection);

    CompositeParams params;

    params.planetParams.planetPos = crPlanetPos;
    params.planetParams.planetRadius = planetRadius;
    params.planetParams.atmoRadius = atmoRadius;
    params.planetParams.cloudOuterRadius = cloudOuterRadius;
    params.planetParams.cloudInnerRadius = cloudInnerRadius;
    params.planetParams.cloudOuterRadiusSq = cloudOuterRadius * cloudOuterRadius;
    params.planetParams.cloudInnerRadiusSq = cloudInnerRadius * cloudInnerRadius;

    params.scatteringParams.cosTheta = cosTheta;

	// EACH BETA CARRIES ITS OWN SCALE HEIGHT IN a: the two are only authored
	// together and mean nothing apart, since a coefficient without the profile it
	// applies to is not a quantity. AtmoT_Profile derives it, as it does for the
	// transmittance bake.
    params.scatteringParams.rayBeta = rayleighBeta.rgb / atmoThickness;
    params.scatteringParams.mieBeta = mieBeta.rgb / atmoThickness;
    params.scatteringParams.absBeta = absorptionBeta.rgb / atmoThickness;
    params.scatteringParams.atmoAmbient = atmoAmbient;

    const float4 airProfile = AtmoT_Profile(
		rayleighBeta.a, mieBeta.a, absorptionBeta.a, absorptionFalloff) * atmoThickness;

    params.scatteringParams.rayScaleH = airProfile.x;
    params.scatteringParams.mieScaleH = airProfile.y;
    params.scatteringParams.absHeight = airProfile.z;
    params.scatteringParams.absFalloff = airProfile.w;
    params.scatteringParams.phaseR = Atmo_PhaseRayleigh(cosTheta);
    params.scatteringParams.phaseM = Atmo_PhaseHG(cosTheta, mieG);

    params.cloudParams.cloudScatBeta = cloudScatterBeta / atmoThickness;
    params.cloudParams.cloudAbsBeta = cloudAbsorptionBeta / atmoThickness;
    params.cloudParams.cloudAmb = cloudAmbient;
    params.cloudParams.cloudPhaseParams = cloudPhaseParams;
    params.cloudParams.cloudScale = cloudScale;
    params.cloudParams.cloudHeightCurve = cloudHeightCurve;
    params.cloudParams.cloudCoverage = cloudCoverage;
    params.cloudParams.cloudDensityMult = cloudDensityMult;
    params.cloudParams.cloudNoiseWeights = cloudNoiseWeights;
    params.cloudParams.cloudNoiseInvert = cloudNoiseInvert;
    params.cloudParams.detailNoiseWeights = detailNoiseWeights;
    params.cloudParams.detailNoiseInvert = detailNoiseInvert;
    params.cloudParams.detailNoiseScale = detailNoiseScale;
    params.cloudParams.detailNoiseErode = detailNoiseErode;
    params.cloudParams.animationWeights = animationWeights;

    params.mainRayParams.svxy = svPosition;
    params.mainRayParams.cameraPos = float3(0, 0, 0);
    params.mainRayParams.originalCameraPos = cameraPos;
    params.mainRayParams.cameraDir = rayDir;
    params.mainRayParams.lightCol = lightColor;
    params.mainRayParams.sceneDepth = Atmo_CorrectedDepth(camDist, sceneDepth, atmoRadius, cloudOuterRadius);
    params.mainRayParams.atmoSteps = mainAtmoSteps;
    params.mainRayParams.cloudSteps = mainCloudSteps;
    params.mainRayParams.stepScaleFactor = stepScaleFactor;

    params.lightRayParams.lightDir = lightDirection;

	// Filled per step by the main march. Initialised so the struct is complete
	// before it is passed, since HLSL will not warn about a member that is only
	// written on some paths.
    params.lightRayParams.samplePos = float3(0, 0, 0);
    params.lightRayParams.stepSizeMult = 1.0;
    params.lightRayParams.parentStepIndex = 0;

    return params;
}
