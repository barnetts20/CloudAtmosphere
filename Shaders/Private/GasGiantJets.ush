#pragma once

// The zonal jet profile and everything derived from it. READ ONLY BY
// GasGiantSim.usf: the sim evaluates the rate for its nudging target and the
// DERIVATIVE for the initial vorticity field. The material draws its bands from
// the vorticity channel the sim transports, not from this profile, so nothing
// here reaches the material path.
//
// EVERYTHING HERE IS A FUNCTION OF S = sin(latitude), NOT LATITUDE. Jets come
// out equal AREA rather than equal angle, so they stop crowding into the poles,
// and S is already the sim's grid coordinate -- no transcendental to get here.
//
// RATES ARE ANGULAR, IN RADIANS PER UNIT TIME, ON A UNIT SPHERE. No planet
// radius appears here or in the sim: linear speed would have to be divided by
// cos(latitude) to become an angle, singular at the poles for no benefit, and a
// radius carried through the sim is a units mismatch waiting to happen.

/** The raw alternating shape, roughly [-1.45, 1.45]. EVEN in S, so mirrored
 *  latitudes rotate the same way -- an odd form counter-rotates the hemispheres
 *  and puts a shear seam along the equator. The second cosine sits at an
 *  incommensurate frequency so jet spacing stops looking regular, and both terms
 *  are pure cosines with no phase offset, which keeps the sum even and smooth
 *  across the equator. PITFALL: a phase offset or an abs() puts a kink at S = 0.
 *
 *  Asymmetry adds a small ODD term back, because perfect mirror symmetry is its
 *  own artifact and reads as a decal rather than a planet. */
float GG_JetRaw(float S, float BandCount, float Asymmetry)
{
    const float K = BandCount * PI;

    float Shape = cos(K * S);
    Shape += 0.45f * cos(K * 1.7f * S);
    Shape += Asymmetry * sin(K * 0.6f * S);

    return Shape;
}

/** d(GG_JetRaw)/dS in closed form. Term-for-term the derivative of GG_JetRaw,
 *  scaled the same way, so the two cannot drift apart silently. */
float GG_JetRawSlope(float S, float BandCount, float Asymmetry)
{
    const float K = BandCount * PI;

    float D = -K * sin(K * S);
    D += -0.45f * K * 1.7f * sin(K * 1.7f * S);
    D += Asymmetry * K * 0.6f * cos(K * 0.6f * S);

    return D;
}

/** 1/1.45, normalizing the raw range to roughly [-1,1] so WidthBias means the
 *  same thing regardless of Asymmetry. Named rather than inline, so the shape
 *  and its slope cannot carry different constants. */
#define GG_JET_NORM 0.6897f

/** The normalized, offset raw shape: what the saturation is applied to, and the
 *  quantity whose derivative is GG_JetScaledSlope. WidthBias offsets it so zones
 *  and belts need not be the same width. */
float GG_JetScaled(float S, float BandCount, float Asymmetry, float WidthBias)
{
    return GG_JetRaw(S, BandCount, Asymmetry) * GG_JET_NORM - WidthBias;
}

/** Knee of the rate saturation, and the width of the transition above it.
 *  Width is 2*(1-Knee) so that the curve reaches exactly 1 at Knee+Width. */
#define GG_JET_SAT_KNEE  0.5f
#define GG_JET_SAT_WIDTH 1.0f

/** Smooth saturation of the jet rate. Below the knee it is exactly the identity,
 *  so the profile is untouched wherever saturation is not biting.
 *
 *  PITFALL: A HARD CLAMP HERE IS A VORTEX SHEET, AND VORTEX SHEETS ARE
 *  UNCONDITIONALLY UNSTABLE. A clamp is continuous but has a CORNER; a corner in
 *  R is a step in R'; and
 *
 *      zeta(S) = 2 S R(S) - (1 - S^2) R'(S)
 *
 *  so a step in R' is a STEP IN VORTICITY. Kelvin-Helmholtz makes a vortex sheet
 *  unstable at every wavenumber with a growth rate rising with wavenumber, so no
 *  rotation rate stabilises one -- the Rayleigh-Kuo requirement at the corner is
 *  unbounded, d(zeta)/dS being a delta function rather than a large number.
 *  Measured on a representative profile a hard clamp is active on about 3% of
 *  latitudes and raises the required PlanetaryVorticity from 28 to over 1400: the
 *  profile looks stable everywhere you would think to check and is catastrophic
 *  on a few rows, showing as bands that hold, perturb at the jet cores, roll up
 *  and merge.
 *
 *  C2 IS THE REQUIREMENT, NOT MERELY C1. zeta depends on R', so continuous R'
 *  removes the sheet, but Rayleigh-Kuo tests d(zeta)/dS, which depends on R'' --
 *  a C1 saturation leaves a finite jump there and still needs beta near 100. The
 *  quintic below is continuous in value, slope AND curvature. */
float GG_JetSaturate(float X)
{
    const float A = abs(X);

    if (A <= GG_JET_SAT_KNEE)
    {
        return X;
    }

    const float U = saturate((A - GG_JET_SAT_KNEE) / GG_JET_SAT_WIDTH);

    const float U2 = U * U;
    const float U3 = U2 * U;
    const float U4 = U3 * U;
    const float U5 = U4 * U;
    const float U6 = U5 * U;

	// Integral of the quintic smoothstep 6u^5 - 15u^4 + 10u^3, which ramps the
	// slope from 1 down to 0 with zero curvature at both ends.
    const float S = GG_JET_SAT_KNEE + GG_JET_SAT_WIDTH * (U - (U6 - 3.0f * U5 + 2.5f * U4));

    return (X < 0.0f) ? -S : S;
}

/** d(GG_JetSaturate)/dX. Even in X, since the saturation is odd. */
float GG_JetSaturateSlope(float X)
{
    const float A = abs(X);

    if (A <= GG_JET_SAT_KNEE)
    {
        return 1.0f;
    }

    const float U = (A - GG_JET_SAT_KNEE) / GG_JET_SAT_WIDTH;

    if (U >= 1.0f)
    {
        return 0.0f;
    }

    const float U2 = U * U;
    const float U3 = U2 * U;

    return 1.0f - (6.0f * U3 * U2 - 15.0f * U3 * U + 10.0f * U3);
}

/** d(GG_JetScaled)/dS, THROUGH THE SATURATION. The saturation does bite --
 *  Asymmetry and WidthBias both push the sum past unity at ordinary settings --
 *  so the unsaturated derivative is wrong in exactly those regions, which are
 *  the jet peaks.
 *
 *  PITFALL: this IS the zonal vorticity. A nonzero slope where the rate is
 *  constant tells the sim there is shear where there is none, so the initial
 *  condition carries vorticity sheets along every jet core that the flow does
 *  not support. The sim spends its spin-up dismantling them, which reads as the
 *  seeding not having taken. */
float GG_JetScaledSlope(float S, float BandCount, float Asymmetry, float WidthBias)
{
    const float Scaled = GG_JetScaled(S, BandCount, Asymmetry, WidthBias);

	// Chain rule through the saturation, evaluated at the same expression
	// GG_ZonalRate saturates, so the two cannot disagree about where the knee
	// is.
    return GG_JetSaturateSlope(Scaled) * GG_JetRawSlope(S, BandCount, Asymmetry) * GG_JET_NORM;
}

/** The equatorial jet enhancement, and its derivative. Added AFTER the
 *  saturation, so the one profile feature that is genuinely a peak keeps its
 *  peak. The base shape already puts a prograde jet at S = 0, cos(0) being 1, so
 *  this sharpens an existing jet rather than inventing one. */
float GG_EquatorialBoost(float S, float EquatorialBoost)
{
    return EquatorialBoost * exp(-S * S * 12.0f);
}

float GG_EquatorialBoostSlope(float S, float EquatorialBoost)
{
    return -24.0f * S * EquatorialBoost * exp(-S * S * 12.0f);
}

/** Angular rate. Radians per unit time, positive prograde (eastward). What makes
 *  STRUCTURE is dRate/dS, not Rate: a constant added to every latitude is a rigid
 *  spin producing no shear, and only the differences between latitudes wind
 *  anything. */
float GG_ZonalRate(
	float S,
	float BandCount,
	float JetStrength,
	float EquatorialBoost,
	float Asymmetry,
	float WidthBias)
{
    const float Raw = GG_JetSaturate(GG_JetScaled(S, BandCount, Asymmetry, WidthBias));

    return JetStrength * (Raw + GG_EquatorialBoost(S, EquatorialBoost));
}

/** d(GG_ZonalRate)/dS, term for term including the saturation, which is why
 *  GG_JetScaledSlope exists. The local shear rate, and what the zonal vorticity
 *  below is built from. */
float GG_ZonalRateSlope(
	float S,
	float BandCount,
	float JetStrength,
	float EquatorialBoost,
	float Asymmetry,
	float WidthBias)
{
    const float RawSlope = GG_JetScaledSlope(S, BandCount, Asymmetry, WidthBias);

    return JetStrength * (RawSlope + GG_EquatorialBoostSlope(S, EquatorialBoost));
}

/** RELATIVE VORTICITY OF THE PRESCRIBED ZONAL FLOW, as a function of S. THE
 *  INITIAL CONDITION AND THE NUDGING TARGET: everything the sim does to maintain
 *  jets comes through this one function.
 *
 *  The general form for a zonal flow is
 *
 *      zeta = -(1 / (a cos(phi))) d(u cos(phi)) / d(phi)
 *
 *  which is where a radius, two cosines and a pole singularity appear. None of
 *  that survives the change of variable: on a unit sphere with an ANGULAR rate
 *  R(S) the eastward speed is u = R cos(phi), so u cos(phi) = R (1 - S^2), and
 *  since d/d(phi) = cos(phi) d/dS the cosines cancel against the prefactor:
 *
 *      zeta(S) = -d/dS[ (1 - S^2) R(S) ] = 2 S R(S) - (1 - S^2) R'(S)
 *
 *  No radius, no division, no singularity, and finite at S = +-1 where it
 *  reduces to 2 R(+-1) -- solid-body rotation about the pole, which is what a
 *  smooth field must do there. The same collapse that makes the Laplacian clean
 *  in this coordinate, and the main reason the grid is in sin(latitude). */
float GG_ZonalVorticity(
	float S,
	float BandCount,
	float JetStrength,
	float EquatorialBoost,
	float Asymmetry,
	float WidthBias)
{
    const float R = GG_ZonalRate(S, BandCount, JetStrength, EquatorialBoost, Asymmetry, WidthBias);
    const float RSlope = GG_ZonalRateSlope(S, BandCount, JetStrength, EquatorialBoost, Asymmetry, WidthBias);

    return 2.0f * S * R - (1.0f - S * S) * RSlope;
}
