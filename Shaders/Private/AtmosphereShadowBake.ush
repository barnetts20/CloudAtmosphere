#pragma once

#include "/Plugin/CloudAtmosphere/Private/AtmosphereShadowMap.ush"

// Field-independent parts of a shadow bake: step sizing, the threshold crossing
// within a step, and the history blend. The march loop, shared by every model,
// is AtmosphereShadowBakeLoop.ush's; the field enters it only through the
// BakeField_ hooks. The output is declared here because the map format owns it;
// a model declares only its own field uniforms.

#ifndef ATMO_BAKE_THREADS
#define ATMO_BAKE_THREADS 8
#endif

/** Radial advances per gradient depth. Combined in quadrature with half a flow
 *  texel of arc; min() would kink at a fixed obliquity, which on a sphere is a ring. */
#ifndef ATMO_BAKE_STEPS_PER_GRADIENT
#define ATMO_BAKE_STEPS_PER_GRADIENT 16.0f
#endif

/** Most optical depth one step may accumulate at zero accumulated depth, on the
 *  last step's extinction. Never halves a step below the budget, which outranks it.
 *  PITFALL: gradient-sized steps alone let a dense deck put every threshold in one
 *  step, giving blockiness that grows with density rather than distance. */
#ifndef ATMO_BAKE_MAX_DTAU
#define ATMO_BAKE_MAX_DTAU 0.15f
#endif

/** Rate the Delta-tau allowance grows with accumulated depth; 0 is flat. With
 *  thresholds spaced roughly 4x apart, this keeps each node's relative accuracy
 *  about equal. It only selects how far a fixed lattice cell is halved. */
#ifndef ATMO_BAKE_DTAU_GROWTH
#define ATMO_BAKE_DTAU_GROWTH 1.0f
#endif

/** How far a lattice cell may be halved. Six gives 64x refinement. */
#ifndef ATMO_BAKE_MAX_HALVINGS
#define ATMO_BAKE_MAX_HALVINGS 6
#endif

/** Iteration cap. Grazing chords are long and ATMO_BAKE_MAX_DTAU shortens steps
 *  in dense deck; a column that runs out before the last threshold extrapolates
 *  its remaining nodes and reads too dark. */
#ifndef ATMO_BAKE_MAX_STEPS
#define ATMO_BAKE_MAX_STEPS 256
#endif

/** Lateral samples per march step, 1 or 4. Averages extinction over the texel
 *  footprint so a texel represents its area, not its centre. Blurring stored
 *  nodes is no substitute: reconstruction is nonlinear in them and
 *  ATMO_SHADOW_NO_DECK shares their channels. */
#ifndef ATMO_BAKE_SUBSAMPLES
#define ATMO_BAKE_SUBSAMPLES 4
#endif

/** Entry back-off in texel footprints. The cone trace uses only the centre ray,
 *  so neighbouring columns inside the texel may stand higher. */
#ifndef ATMO_BAKE_ENTRY_BACKOFF
#define ATMO_BAKE_ENTRY_BACKOFF 1.5f
#endif

/** Rotated grid: one subsample per row and per column of the texel. */
static const float2 AtmoBake_SubOffsets[4] =
{
    float2(-0.375f, -0.125f),
    float2(-0.125f, 0.375f),
    float2(0.125f, -0.375f),
    float2(0.375f, 0.125f),
};

RWTexture2DArray<float4> ShadowMapUAV;

int2 ShadowMapSize;
float2 ShadowInvMapSize;

/** Planet-local, pointing toward the light, as lightRayParams.lightDir. Basis and
 *  extent derive from it and the field: see TerrestrialShadow.ush. */
float3 ShadowLightDir;

/** Camera position, planet-local: the inner cascades' centre. The detail fade is
 *  per cascade (TRShadow_Field); all viewports of a planet share the cascades. */
float3 ShadowCameraLocal;

/** Cascade written by this dispatch's first Z slice. */
int ShadowFirstLevel;

/** The level's previous bake (a one-slice copy), the light and camera it was
 *  baked with, and the share of it kept. A weight of 0 skips history. */
Texture2DArray<float4> ShadowHistory;
float3 ShadowHistoryLightDir;
float3 ShadowHistoryCameraLocal;
float ShadowHistoryWeight;

/** Fraction of the step at which optical depth reaches Target. Sigma is linear
 *  across the step, so tau is quadratic and the crossing is its root, in the
 *  rationalised form that stays conditioned as the ends agree. A constant-density
 *  crossing leaves concentric rings where the subdivision level changes.
 *  PITFALL: solve in optical depth per step; any absolute curvature threshold in
 *  world units picks the wrong form everywhere. */
float AtmoBake_Crossing(float Target, float Tau, float SigmaA, float SigmaB, float Step)
{
	// tau(x) = A x + (B - A) x^2 / 2 over the step fraction x.
    const float A = SigmaA * Step;
    const float B = SigmaB * Step;
    const float Remaining = max(Target - Tau, 0.0f);

    const float Disc = A * A + 2.0f * (B - A) * Remaining;

    return saturate(2.0f * Remaining / max(A + sqrt(max(Disc, 0.0f)), 1e-8f));
}

/** Blends fresh crossing depths (in thicknesses) with the level's previous bake,
 *  found by reprojecting the ray into that bake's map and interpolating its four
 *  surrounding texels. Offset is the ray's closest approach to the planet centre;
 *  ChordEnd is its exit depth. Nodes blend only if crossed inside the chord in the
 *  new bake and every weighted tap; a node past the exit (extrapolation or
 *  sentinel) would slide a crossing across the chord. Output is re-sorted. */
float4 AtmoBake_History(
	float4 Nodes, int Level, float3 Offset, float ChordEnd, float HalfWidth, float Extent0)
{
    BRANCH

    if (ShadowHistoryWeight <= 0.0f)
    {
        return Nodes;
    }

    float3 U, V;
    AtmoShadow_Basis(ShadowHistoryLightDir, U, V);

    const float2 MapSize = float2(ShadowMapSize);

    const float2 Centre = AtmoShadow_CascadeCentre(
		Level, ShadowHistoryCameraLocal, U, V, HalfWidth, Extent0, MapSize);

    const float2 Disc = AtmoShadow_PlaneToDisc(
		float2(dot(Offset, U), dot(Offset, V)) / max(Extent0, 1e-6f));

    const float2 Sample = ((Disc - Centre) / HalfWidth * 0.5f + 0.5f) * MapSize - 0.5f;

	// Outside the previous window: that bake never saw this ray.
    if (any(Sample < 0.0f) || any(Sample > MapSize - 1.0f))
    {
        return Nodes;
    }

    const int2 Base = int2(floor(Sample));
    const float2 Frac = Sample - float2(Base);
    const int2 Last = ShadowMapSize - 1;

    const float4 H00 = ShadowHistory.Load(int4(Base, 0, 0));
    const float4 H10 = ShadowHistory.Load(int4(min(Base + int2(1, 0), Last), 0, 0));
    const float4 H01 = ShadowHistory.Load(int4(min(Base + int2(0, 1), Last), 0, 0));
    const float4 H11 = ShadowHistory.Load(int4(min(Base + int2(1, 1), Last), 0, 0));

    const float4 W = float4(
		(1.0f - Frac.x) * (1.0f - Frac.y), Frac.x * (1.0f - Frac.y),
		(1.0f - Frac.x) * Frac.y, Frac.x * Frac.y);

    const float4 Previous = H00 * W.x + H10 * W.y + H01 * W.z + H11 * W.w;

    float4 Deepest = Nodes;
    Deepest = max(Deepest, H00 * step(1e-4f, W.x));
    Deepest = max(Deepest, H10 * step(1e-4f, W.y));
    Deepest = max(Deepest, H01 * step(1e-4f, W.z));
    Deepest = max(Deepest, H11 * step(1e-4f, W.w));

    float4 Out = lerp(Nodes, Previous, ShadowHistoryWeight * step(Deepest, ChordEnd));

    Out.y = max(Out.y, Out.x);
    Out.z = max(Out.z, Out.y);
    Out.w = max(Out.w, Out.z);

    return Out;
}
