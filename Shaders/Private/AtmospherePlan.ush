#pragma once

#include "/Plugin/CloudAtmosphere/Private/AtmosphereTypes.ush"

// Ray planning: the segment list a march walks and the step plan over it.
// Model-independent: it cuts a ray at the shell boundaries and sizes each piece.

/** Slots in the segment array: six boundaries (atmo, cloud outer, cloud inner,
 *  each near and far) give at most five spans. */
#ifndef ATMO_MAX_SEGMENTS
#define ATMO_MAX_SEGMENTS 5
#endif

/** Iteration cap for the distance-driven march loops; stops a degenerate step
 *  size hanging the shader. A grazing ray dense enough to keep stepping but too
 *  thin to reach the transmittance early-out stops here: a hard edge at the limb. */
#ifndef ATMO_MAX_ITER
#define ATMO_MAX_ITER 256
#endif

/** Geometric step distribution over a class's total chord: step(x) = First +
 *  Growth*x, x the chord already consumed (sum of d0*r^k collapses to d0 + (r-1)x),
 *  so one accumulator per class carries it continuously across that class's
 *  segments without a step index. Spread is the last step over the first: 1 is
 *  uniform, higher front-loads the budget. */
void Atmo_ChordSteps(float Length, float Count, float Spread, out float First, out float Growth)
{
    const float N = max(Count, 2.0f);

    if (Spread <= 1.0f + 1e-4f)
    {
        First = Length / N;
        Growth = 0.0f;

        return;
    }

    const float R = pow(Spread, 1.0f / (N - 1.0f));

    First = Length * (R - 1.0f) / max(pow(R, N) - 1.0f, 1e-6f);
    Growth = R - 1.0f;
}

// The step plan: cloud steps on a lattice of camera-centred shells, phase-shifted
// per pixel and refined at each cloud entry; air steps spread over each ray's air
// chord by Atmo_ChordSteps.
//
// Lattice: step length is a function of distance alone, so rays agree wherever
// they overlap. Growth counts from the origin shell: the camera inside the
// atmosphere, else the shell through the atmosphere's nearest point, so a far
// camera crosses the planet with the steps of one at the atmosphere top. A cloud
// segment widens to the lattice points either side of it.
// After air, the widened span ahead of the shell crossing holds no cloud and is
// one step of air alone ending at the crossing; cloud steps run from there, and
// only the terminus trims one.
// Phase: each pixel's lattice starts a fraction of a step in, so neighbours do not
// share boundaries; a shared lattice turns jitter noise into rings about the view.
// Entry refine: ATMO_ENTRY_SPAN lattice steps from the start of the step where a
// ray first meets cloud, that step and the next (again on re-entry after a clear
// sample), are re-marched with ATMO_ENTRY_SUBSTEPS substeps on the divided
// lattice. This divides the bias from where the surface falls in a step without
// moving any step boundary.
//
// PITFALL: a step cut at a shell is a sawtooth across the screen; its biases show
// as rings about the camera.
// PITFALL: a per-chord budget jumps at the limb (planet on one side, far shell on
// the other), showing the limb through opaque deck.
// PITFALL: steps placed by the field move with the weather, and a split at a
// cone-traced entry skips features narrower than the probe spacing.

/** Camera lattice step growth (actor's Sampling group): past the knee each step is
 *  this fraction of its distance from the origin shell. Costs about
 *  (1 + ln(Distance * x / Floor)) / x steps, up to ATMO_MAX_ITER, mostly in grazing
 *  views. One value per frame, blended geometrically by
 *  camera altitude from LatticeGrowth (in or below the deck) to LatticeGrowthFar
 *  (FAR_ALTITUDE shell depths above it). Equal values disable the blend. */
float LatticeGrowth;
float LatticeGrowthFar;

#ifndef ATMO_ENTRY_SUBSTEPS
#define ATMO_ENTRY_SUBSTEPS 4.0f
#endif

#ifndef ATMO_ENTRY_SPAN
#define ATMO_ENTRY_SPAN 2.0f
#endif

#ifndef ATMO_CAMERA_LATTICE_FAR_ALTITUDE
#define ATMO_CAMERA_LATTICE_FAR_ALTITUDE 4.0f
#endif

/** Lattice growth for a camera Altitude shell depths above the cloud shell top. */
float Atmo_LatticeGrowth(float Altitude)
{
    const float Blend = smoothstep(0.0f, ATMO_CAMERA_LATTICE_FAR_ALTITUDE, Altitude);

    return exp(lerp(log(max(LatticeGrowth, 1e-3f)),
		log(max(LatticeGrowthFar, 1e-3f)), Blend));
}

/** Camera lattice: from Origin (distance to the origin shell), Floor-length steps
 *  (shell depth / CloudSteps) up to Knee = Floor / Growth past it, then growing in
 *  proportion to distance past it. Cap bounds a step's rise through the shell to
 *  ChordSpread floors, so a long step still crosses the deck in several; the step
 *  applies it by slope. U counts steps.
 *  PITFALL: where the cap binds, the entry span covers a whole descent through the
 *  band, which then costs CloudSteps * ATMO_ENTRY_SUBSTEPS / ChordSpread
 *  substeps; past ATMO_MAX_ITER the loop drops the deck's base. Cap is raised to
 *  keep one descent 16 under, room for the clear step and a slope that eases
 *  inside the band. A ray that dips into the band and out again within one
 *  segment travels up to twice the depth radially and is not covered. */
struct AtmoCameraLattice
{
    float Origin;
    float Floor;
    float Cap;
    float LogRatio;
    float Knee;
    float UKnee;
};

AtmoCameraLattice Atmo_CameraLattice(float ShellDepth, float Count, float Spread, float Growth, float Origin)
{
    AtmoCameraLattice L;
    const float Steps = max(Count, 1.0f);

    L.Origin = Origin;
    L.Floor = max(ShellDepth, 1e-4f) / Steps;
    L.Cap = L.Floor * max(max(Spread, 1.0f),
		Steps * ATMO_ENTRY_SUBSTEPS / float(ATMO_MAX_ITER - 16));
    L.LogRatio = log(1.0f + Growth);

    L.Knee = L.Floor / Growth;
    L.UKnee = L.Knee / L.Floor;

    return L;
}

float Atmo_LatticeCoord(AtmoCameraLattice L, float T)
{
    const float D = T - L.Origin;

    return (D < L.Knee) ? D / L.Floor : L.UKnee + log(D / L.Knee) / L.LogRatio;
}

float Atmo_LatticeDistance(AtmoCameraLattice L, float U)
{
    return L.Origin + ((U < L.UKnee) ? U * L.Floor : L.Knee * exp((U - L.UKnee) * L.LogRatio));
}

/** Lattice point at or before T, shifted by Phase steps; never before the origin. */
float Atmo_LatticeFloor(AtmoCameraLattice L, float T, float Phase)
{
    return max(Atmo_LatticeDistance(L, floor(Atmo_LatticeCoord(L, T) - Phase + 1e-3f) + Phase), L.Origin);
}

/** Distance from T to the next point of the lattice divided Division times and
 *  shifted by Phase, capped at Cap / RadialRate (divided alike). A point under half
 *  a step away is skipped for the one beyond, so the cap leaves no slivers. */
float Atmo_LatticeStep(AtmoCameraLattice L, float T, float Phase, float RadialRate, float Division)
{
    const float Unit = 1.0f / Division;
    const float U = (floor((Atmo_LatticeCoord(L, T) - Phase) * Division + 1e-3f) + 1.0f) * Unit + Phase;
    const float Next = Atmo_LatticeDistance(L, U);

    const float End = (Next - T < 0.5f * (Next - Atmo_LatticeDistance(L, U - Unit)))
		? Atmo_LatticeDistance(L, U + Unit)
		: Next;

    return min(End - T, L.Cap * Unit / max(RadialRate, 1e-3f));
}

/** First step of a lattice started Phase in (0, 1] of a step in: the
 *  distribution's chord to fractional step Phase. */
float Atmo_LeadStep(float First, float Growth, float Phase)
{
    return (Growth > 1e-6f)
		? First * (pow(1.0f + Growth, Phase) - 1.0f) / Growth
		: First * Phase;
}

/** Builds the segment list for a ray, cut at the atmosphere and cloud shells.
 *  Returns the count; each segment is (start, end, 1 inside the cloud band).
 *  Boundaries are admitted in order by guards, so no sort is needed.
 *  PITFALL: the outer-shell crossing decides whether there is cloud at all; any
 *  extra test on it suppresses the cloud, showing as a thin bright line at the
 *  limb where a tangential chord looks degenerate. */
int Atmo_Plan(
	float3 origin,
	float3 dir,
	float maxDist,
	PlanetParams planet,
	out float3 segments[ATMO_MAX_SEGMENTS])
{
    int segmentCount = 0;

    UNROLL

    for (int Clear = 0; Clear < ATMO_MAX_SEGMENTS; Clear++)
    {
        segments[Clear] = 0.0;
    }

    float2 atmoHit = Atmo_RaySphere(origin, dir, planet.planetPos, planet.atmoRadius);
    if (atmoHit.y < 0.0)
    {
        return 0;
    }

    float atmoStart = max(atmoHit.x, 0.0);
    float atmoEnd = min(atmoHit.y, maxDist);
    if (atmoStart >= atmoEnd)
    {
        return 0;
    }

    float2 cloudOHit = Atmo_RaySphere(origin, dir, planet.planetPos, planet.cloudOuterRadius);
    float2 cloudIHit = Atmo_RaySphere(origin, dir, planet.planetPos, planet.cloudInnerRadius);

    bool hasCloudOuter = cloudOHit.y > 0.0 && cloudOHit.x < maxDist;
    bool hasCloudInner = cloudIHit.y > 0.0 && cloudIHit.x < maxDist;

	// No cloud band on this ray: one air segment, the whole atmosphere.
    if (!hasCloudOuter)
    {
        segments[0] = float3(atmoStart, atmoEnd, 0.0);
        return 1;
    }

    float co_near = max(cloudOHit.x, 0.0);
    float co_far = min(cloudOHit.y, maxDist);
    float ci_near = hasCloudInner ? max(cloudIHit.x, 0.0) : -1.0;
    float ci_far = hasCloudInner ? min(cloudIHit.y, maxDist) : -1.0;

    float boundaries[6];
    int bCount = 0;

    boundaries[bCount++] = atmoStart;
    if (co_near > atmoStart && co_near < atmoEnd)
        boundaries[bCount++] = co_near;
    if (hasCloudInner && ci_near > atmoStart && ci_near < atmoEnd && ci_near > co_near)
        boundaries[bCount++] = ci_near;
    if (hasCloudInner && ci_far > atmoStart && ci_far < atmoEnd && ci_far > ci_near)
        boundaries[bCount++] = ci_far;
    if (co_far > atmoStart && co_far < atmoEnd)
        boundaries[bCount++] = co_far;
    boundaries[bCount++] = atmoEnd;

	// In the band if the midpoint is; exact, since band crossings are boundaries.
    for (int j = 0; j < bCount - 1; j++)
    {
        float segStart = boundaries[j];
        float segEnd = boundaries[j + 1];
        if (segEnd <= segStart)
            continue;

        float midDist = (segStart + segEnd) * 0.5;
        float3 midPos = origin + dir * midDist;
        float midRadius = length(midPos - planet.planetPos);

        bool inCloudBand = (midRadius >= planet.cloudInnerRadius && midRadius <= planet.cloudOuterRadius);

        segments[segmentCount] = float3(segStart, segEnd, inCloudBand ? 1.0 : 0.0);
        segmentCount++;

        if (segmentCount >= ATMO_MAX_SEGMENTS)
            break;
    }

    return segmentCount;
}
