#pragma once

#include "/Plugin/CloudAtmosphere/Private/AtmosphereTypes.ush"

// Ray planning: the segment list a march walks, and the bounds on it.
//
// MODEL-INDEPENDENT. It cuts a ray at the shell boundaries and sizes each piece;
// nothing here knows what fills them.

/** Slots in the segment array. Six boundaries give at most five spans: atmo
 *  entry, cloud outer near, cloud inner near, cloud inner far, cloud outer far,
 *  atmo exit. */
#ifndef ATMO_MAX_SEGMENTS
#define ATMO_MAX_SEGMENTS 5
#endif

/** Safety bound on a march loop. The loops are while() on distance, so this is
 *  what stops a degenerate step size from hanging the shader. It is also what
 *  catches a grazing ray that is dense enough to keep stepping and thin enough
 *  never to reach the transmittance early-out: such a ray stops with whatever
 *  transmittance it had, which reads as a hard edge at the limb. */
#ifndef ATMO_MAX_ITER
#define ATMO_MAX_ITER 256
#endif

/** Geometric step distribution over a class's total chord: the first step and
 *  the growth per unit of chord already consumed, so step(x) = First + Growth*x.
 *
 *  AFFINE IN CONSUMED LENGTH, WHICH IS WHY THERE IS NO STEP INDEX. Step k is
 *  d0*r^k and the sum to k is x, so r^k = 1 + x(r-1)/d0 and the size collapses
 *  to d0 + (r-1)x. One accumulator per class then carries the distribution
 *  across every segment of that class on the ray, continuous over the
 *  boundaries between them.
 *
 *  Spread is the LAST step over the FIRST, which is the authored handle: 1 is
 *  uniform, and raising it front-loads the budget. */
void Atmo_ChordSteps(float Length, float Count, float Spread, out float First, out float Growth)
{
    const float N = max(Count, 2.0f);

    if (Spread <= 1.0f + 1e-4f)
    {
        First = Length / N;
        Growth = 0.0f;

        return;
    }

    const float R = pow(Spread, 1.0f / (N - 1.0f));

    First = Length * (R - 1.0f) / max(pow(R, N) - 1.0f, 1e-6f);
    Growth = R - 1.0f;
}

/** The step plan: cloud steps on a lattice anchored at the camera, each
 *  pixel's lattice phase-shifted and each cloud entry refined; air steps spread
 *  over each ray's air chord by Atmo_ChordSteps.
 *
 *  THE LATTICE. Step length is a function of distance alone, so every ray's
 *  steps agree wherever the rays agree, whatever their chords. A cloud segment
 *  widens to the lattice points either side of it, so no cloud step is cut
 *  short by a shell; only the terminus trims one.
 *
 *  THE PHASE. Each pixel's lattice starts a fraction of a step into its first
 *  step, so neighbouring pixels do not share step boundaries: the noise the
 *  sample jitter leaves follows where features fall inside a step, and forms
 *  rings about the view centre wherever the lattice is shared.
 *
 *  THE ENTRY REFINE. The step in which a ray first meets cloud, and the
 *  ATMO_ENTRY_SPAN steps after it, are re-marched at ATMO_ENTRY_SUBSTEPS
 *  substeps each, again at every re-entry after a clear sample. A step's
 *  single sample decides its whole transmittance, and near the cloud's surface
 *  that decision carries a bias that follows where the surface falls in the
 *  step: rings about the camera. Substeps divide the bias, and they lie on the
 *  divided lattice, so the entry moves no step boundary.
 *
 *  PITFALL:
 *  A STEP CUT AT A SHELL IS A SAWTOOTH ACROSS THE SCREEN. Its length runs
 *  from zero to a full step each time the shell crossing passes a lattice
 *  point, every step-length bias follows it, and the lattice's spheres show
 *  as rings about the camera.
 *  PITFALL: A CHORD BUDGET STEPS DIFFERENTLY WHEREVER THE CHORD JUMPS. The
 *  chord ends at the planet on one side of the limb and runs on to the far
 *  shell on the other, so neighbouring rays through the same cloud step at
 *  different lengths and the limb shows through opaque deck. */
/** Camera lattice step growth, the model's Sampling group: each step past the
 *  knee is this fraction of its distance from the camera. Smaller is finer
 *  and costs about 1/x steps per e-fold of distance, so the cost is in grazing
 *  views from in or near the deck, where a ray starts close and runs far:
 *  about (1 + ln(Distance * x / Floor)) / x steps, ending at ATMO_MAX_ITER.
 *
 *  ONE VALUE PER FRAME, FROM THE CAMERA'S ALTITUDE: LatticeGrowth in or below
 *  the deck, LatticeGrowthFar from FAR_ALTITUDE cloud shell depths above it,
 *  blended geometrically between. A camera above the deck starts its rays far
 *  from it and pays little for fine steps. Equal values disable the blend. */
float LatticeGrowth;
float LatticeGrowthFar;

#ifndef ATMO_CAMERA_LATTICE_FAR_ALTITUDE
#define ATMO_CAMERA_LATTICE_FAR_ALTITUDE 4.0f
#endif

/** The lattice growth for a camera Altitude shell depths above the cloud
 *  shell's top. */
float Atmo_LatticeGrowth(float Altitude)
{
    const float Blend = smoothstep(0.0f, ATMO_CAMERA_LATTICE_FAR_ALTITUDE, Altitude);

    return exp(lerp(log(max(LatticeGrowth, 1e-3f)),
		log(max(LatticeGrowthFar, 1e-3f)), Blend));
}

/** The camera lattice: Floor-length steps near the camera, then steps
 *  growing in proportion to distance from Knee = Floor / Growth. Floor is the
 *  shell depth over CloudSteps. Cap bounds a step's rise through the shell to
 *  ChordSpread floors, so a far camera still crosses the deck in several
 *  steps; it depends on the ray's slope, so the step applies it. U counts
 *  steps from the camera. */
struct AtmoCameraLattice
{
    float Floor;
    float Cap;
    float LogRatio;
    float Knee;
    float UKnee;
};

AtmoCameraLattice Atmo_CameraLattice(float ShellDepth, float Count, float Spread, float Growth)
{
    AtmoCameraLattice L;
    L.Floor = max(ShellDepth, 1e-4f) / max(Count, 1.0f);
    L.Cap = L.Floor * max(Spread, 1.0f);
    L.LogRatio = log(1.0f + Growth);

    L.Knee = L.Floor / Growth;
    L.UKnee = L.Knee / L.Floor;

    return L;
}

float Atmo_LatticeCoord(AtmoCameraLattice L, float T)
{
    return (T < L.Knee) ? T / L.Floor : L.UKnee + log(T / L.Knee) / L.LogRatio;
}

float Atmo_LatticeDistance(AtmoCameraLattice L, float U)
{
    return (U < L.UKnee) ? U * L.Floor : L.Knee * exp((U - L.UKnee) * L.LogRatio);
}

/** The lattice point at or before distance T, the lattice shifted by Phase
 *  steps; never behind the camera. */
float Atmo_LatticeFloor(AtmoCameraLattice L, float T, float Phase)
{
    return max(Atmo_LatticeDistance(L, floor(Atmo_LatticeCoord(L, T) - Phase + 1e-3f) + Phase), 0.0f);
}

/** From distance T to the next point of the lattice divided Division times,
 *  shifted by Phase steps, no longer than Cap over RadialRate, divided alike.
 *  A point closer than half a step, as after a capped step, is passed for the
 *  one beyond it, so the cap leaves no slivers. */
float Atmo_LatticeStep(AtmoCameraLattice L, float T, float Phase, float RadialRate, float Division)
{
    const float Unit = 1.0f / Division;
    const float U = (floor((Atmo_LatticeCoord(L, T) - Phase) * Division + 1e-3f) + 1.0f) * Unit + Phase;
    const float Next = Atmo_LatticeDistance(L, U);

    const float End = (Next - T < 0.5f * (Next - Atmo_LatticeDistance(L, U - Unit)))
		? Atmo_LatticeDistance(L, U + Unit)
		: Next;

    return min(End - T, L.Cap * Unit / max(RadialRate, 1e-3f));
}

#ifndef ATMO_ENTRY_SUBSTEPS
#define ATMO_ENTRY_SUBSTEPS 4.0f
#endif

#ifndef ATMO_ENTRY_SPAN
#define ATMO_ENTRY_SPAN 2.0f
#endif

/** The first step of a lattice started Phase of a step in, Phase in (0, 1]: the
 *  distribution's chord to fractional step Phase, after which the steps run as
 *  Atmo_ChordSteps sizes them from the chord consumed. */
float Atmo_LeadStep(float First, float Growth, float Phase)
{
    return (Growth > 1e-6f)
		? First * (pow(1.0f + Growth, Phase) - 1.0f) / Growth
		: First * Phase;
}

/** Builds the segment list for a ray. Returns the count; each segment is
 *  (start, end, stepSize, isCloudBand).
 *
 *  STEP SIZES COME FROM THE SHELLS, NOT FROM THIS RAY'S CHORD. cloudSteps means
 *  samples across the band's radial depth for every ray, so a grazing ray takes
 *  more steps because it genuinely traverses more cloud rather than being handed
 *  coarser ones to compensate. Sized from the chord instead, a limb ray through
 *  a thin band gets steps longer by 2*sqrt(2*R*d)/d -- two orders of magnitude
 *  at planetary scale -- at exactly the angle where its path through cloud is
 *  longest and the integral hardest. The march does not read the step size a
 *  segment carries: cloud steps sit on the camera lattice, and air divides its
 *  own chord.
 *
 *  The boundary list is built in ORDER and never sorted, which works only
 *  because the guards enforce the ordering as they go: each candidate is
 *  admitted only if it lies beyond the previous one. A sort would be more
 *  obviously correct and would cost more than the guards do.
 *
 *  PITFALL: THE OUTER SHELL DECIDES WHETHER THERE IS CLOUD AT ALL. Failing to
 *  find it returns one coarse segment for the whole ray, so any test added to
 *  that crossing suppresses the cloud rather than a boundary -- a thin bright
 *  line at the limb, where a tangential chord is most easily mistaken for a
 *  degenerate one. */
int Atmo_Plan(
	float3 origin,
	float3 dir,
	float maxDist,
	PlanetParams planet,
	int atmoSteps,
	int cloudSteps,
	out float4 segments[ATMO_MAX_SEGMENTS])
{
    int segmentCount = 0;

    UNROLL

    for (int Clear = 0; Clear < ATMO_MAX_SEGMENTS; Clear++)
    {
        segments[Clear] = 0.0;
    }

    float2 atmoHit = Atmo_RaySphere(origin, dir, planet.planetPos, planet.atmoRadius);
    if (atmoHit.y < 0.0)
    {
        return 0;
    }

    float atmoStart = max(atmoHit.x, 0.0);
    float atmoEnd = min(atmoHit.y, maxDist);
    if (atmoStart >= atmoEnd)
    {
        return 0;
    }

	// Floored at one: the counts arrive as uniforms, and a zero divisor
	// makes an infinite step that covers the segment in a single sample.
    const float coarseStep =
		max(planet.atmoRadius - planet.planetRadius, 1e-4f) / float(max(atmoSteps, 1));

    const float bandThickness = max(planet.cloudOuterRadius - planet.cloudInnerRadius, 1e-4f);

    const float fineStep = bandThickness / float(max(cloudSteps, 1));

    float2 cloudOHit = Atmo_RaySphere(origin, dir, planet.planetPos, planet.cloudOuterRadius);
    float2 cloudIHit = Atmo_RaySphere(origin, dir, planet.planetPos, planet.cloudInnerRadius);

    bool hasCloudOuter = cloudOHit.y > 0.0 && cloudOHit.x < maxDist;
    bool hasCloudInner = cloudIHit.y > 0.0 && cloudIHit.x < maxDist;

	// No cloud band on this ray: one segment, whole atmosphere, coarse.
    if (!hasCloudOuter)
    {
        segments[0] = float4(atmoStart, atmoEnd, coarseStep, 0.0);
        return 1;
    }

    float co_near = max(cloudOHit.x, 0.0);
    float co_far = min(cloudOHit.y, maxDist);
    float ci_near = hasCloudInner ? max(cloudIHit.x, 0.0) : -1.0;
    float ci_far = hasCloudInner ? min(cloudIHit.y, maxDist) : -1.0;

    float boundaries[6];
    int bCount = 0;

    boundaries[bCount++] = atmoStart;
    if (co_near > atmoStart && co_near < atmoEnd)
        boundaries[bCount++] = co_near;
    if (hasCloudInner && ci_near > atmoStart && ci_near < atmoEnd && ci_near > co_near)
        boundaries[bCount++] = ci_near;
    if (hasCloudInner && ci_far > atmoStart && ci_far < atmoEnd && ci_far > ci_near)
        boundaries[bCount++] = ci_far;
    if (co_far > atmoStart && co_far < atmoEnd)
        boundaries[bCount++] = co_far;
    boundaries[bCount++] = atmoEnd;

	// Emit the segments with their step sizes. A segment is fine if its MIDPOINT
	// lies in the band, which the boundaries above make exact: the band's
	// crossings are themselves boundaries, so no segment straddles one.
    for (int j = 0; j < bCount - 1; j++)
    {
        float segStart = boundaries[j];
        float segEnd = boundaries[j + 1];
        if (segEnd <= segStart)
            continue;

        float midDist = (segStart + segEnd) * 0.5;
        float3 midPos = origin + dir * midDist;
        float midRadius = length(midPos - planet.planetPos);

        bool inCloudBand = (midRadius >= planet.cloudInnerRadius && midRadius <= planet.cloudOuterRadius);

        segments[segmentCount] = float4(segStart, segEnd, inCloudBand ? fineStep : coarseStep, inCloudBand ? 1.0 : 0.0);
        segmentCount++;

        if (segmentCount >= ATMO_MAX_SEGMENTS)
            break;
    }

    return segmentCount;
}
