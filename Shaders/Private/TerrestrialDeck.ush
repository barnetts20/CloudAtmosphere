#pragma once

#include "/Plugin/CloudAtmosphere/Private/AtmosphereTypes.ush"
#include "/Plugin/CloudAtmosphere/Private/AtmosphereNoise.ush"
#include "/Plugin/CloudAtmosphere/Private/FlowField.ush"

// Terrestrial clouds: the field the march samples.
//
// THE SIM IS THE WEATHER MAP, THE NOISE IS THE CLOUD. Each column reads the
// sim once and gets five things: COVERAGE (the sim's cloud field), TYPE (from
// vertical motion and latitude: 0 stratiform, 1 towering), PRESSURE (the lid
// and the base), ALTITUDE (the ascent the cloud formed at, which floats
// stratiform cloud up) and W (vertical motion, which stretches and lifts the
// noise).
// Inside the column a shape noise is multiplied by a height profile, and
// coverage decides how much of it survives: at low coverage only the densest
// noise cores remain as scattered cloud, near 1 the column fills. A detail
// noise then erodes the edges, wispy toward the base and billowy toward the
// top. The noise draws every cloud; the sim decides where, how much and what
// kind.
//
// THE SIM CARRIES THE NOISE. It advects two displacement fields with the flow,
// reset half a period apart, and the noise is sampled through both and
// crossfaded, so it follows the flow's own trajectories, turning inside
// vortices, on top of a solid-body drift about the axis.
//
// A SLAB BETWEEN TWO SURFACES BOUNDS IT. The base is the condensation level
// and the top is the column's type-dependent depth under the pressure lid;
// both are exact per column, which the entry search and the empty-air early-out
// spend. Outside the slab density is exactly zero.
//
// THE DETAIL LAYER FADES WITH DISTANCE, TO ITS MEAN. It erodes, so dropping it
// would thicken distant cloud; settling on the noise's mean value keeps the
// average erosion and removes only the grain. The structure layer draws the
// cloud shapes and applies at every range. The shadow bake keeps full detail,
// band-limited by its subsamples, so its mean matches either way.
//
// UNITS. CloudBase and CloudThickness are atmosphere fractions; every other
// height is a multiple of CloudThickness. Space is planet-local, spin axis on
// Z, positions unit directions except in TR_Density.

/** Which sim layer the field reads. Must be under the sim's LayerCount: a
 *  slice past the end reads clamped rather than failing. */
#ifndef TR_FLOW_LAYER
#define TR_FLOW_LAYER 0
#endif

/** How much of the density the detail layer can erode at full DetailErosion.
 *  Above about a half it eats whole thin clouds rather than their edges. */
#ifndef TR_DETAIL_EROSION_SCALE
#define TR_DETAIL_EROSION_SCALE 0.35f
#endif

/** Height fraction over which detail erosion turns from wispy (base) to
 *  billowy (top). */
#ifndef TR_BILLOW_HEIGHT
#define TR_BILLOW_HEIGHT 0.25f
#endif

/** Coverage over which a column grows from no slab to its full depth. Sparse
 *  cloud is shallow cloud, and clear sky has no slab for the entry search to
 *  stop on. PITFALL: narrower makes the top a cliff at every coverage edge,
 *  steeper than CloudSlope bounds, and the entry search steps over cloud. */
#ifndef TR_COVERAGE_DEPTH_RAMP
#define TR_COVERAGE_DEPTH_RAMP 0.25f
#endif

/** Fraction of the cone-trace advance actually taken. Under 1 because CloudSlope
 *  is authored, and an under-declared slope is the one way the entry search
 *  steps over a surface. */
#ifndef TR_CONE_RELAXATION
#define TR_CONE_RELAXATION 0.9f
#endif

/** Cone-trace iteration cap. Reached only on rays that graze for their whole
 *  length, which return T1 and are treated as missing the slab. */
#ifndef TR_SLAB_ENTRY_PROBES
#define TR_SLAB_ENTRY_PROBES 24
#endif

/** Everything the field reads. Authored members carry their C++ property
 *  names; they arrive packed on a handful of vector pins (see TR_BuildField)
 *  and are unpacked here once. */
struct TRFieldParams
{
	// -- Authored ------------------------------------------------------------

    float PlanetRadius;

	/** Condensation level of an unlifted column, an atmosphere fraction. */
    float CloudBase;

	/** Depth of a fully towering column before the lid, an atmosphere fraction,
	 *  and the unit every other height is a multiple of. */
    float CloudThickness;

	/** Share of CloudThickness each end of the height profile ramps over, and
	 *  each ramp's shape. Above 1 flattens that end; below 0.5 it loses its C1
	 *  join. */
    float SurfaceSoftness;
    float TopCurve;
    float BottomCurve;

	/** Width of the band under the shell top across which density fades to
	 *  zero, an atmosphere fraction. */
    float CeilingFalloff;

	/** Global coverage, 0.5 neutral, and how strongly the sim's cloud field
	 *  maps to coverage. */
    float CloudCover;
    float CoverageGain;
    float CoverageSoftness;

	/** Depth of a stratiform column as a fraction of a towering one. */
    float StratusDepth;

	/** Type = TypeBias + TypeAscent * W + TypeTropical * tropicality. */
    float TypeBias;
    float TypeAscent;
    float TypeTropical;

	/** Column erosion = StructureErosion * ErosionGain * (1 - ErosionAscent * W). */
    float ErosionGain;
    float ErosionAscent;

	/** The geopotential anomaly that reads as a full low or high. */
    float PressureScale;

	/** Headroom as a multiple of CloudThickness, and how far pressure moves it:
	 *  positive gives lows more room than highs. */
    float CeilingDepth;
    float CeilingPressure;

	/** How far tropicality and pressure move the base, multiples of
	 *  CloudThickness. */
    float BaseTropical;
    float BasePressure;

	/** Altitude = saturate(AltitudeGain * formation ascent); it lifts the base
	 *  of a stratiform column by up to AltitudeLift cloud thicknesses. */
    float AltitudeGain;
    float AltitudeLift;

	/** How far rising air stretches the noise vertically, and lifts it, the
	 *  latter a multiple of CloudThickness. */
    float WarpStretch;
    float WarpShift;

	/** Bound on either surface's slope, cloud depths per radian. Read only by
	 *  the entry search's cone angle. */
    float CloudSlope;

    float RotationWeight;

	/** The noise's solid-body drift about the spin axis, radians, wrapped, and
	 *  noise phase A's position in its reset cycle, [0, 1). */
    float DriftAngle;
    float NoisePhase;

	/** Worley rung weights in xyz, the layer's amount in w. FlowInherit is the
	 *  share of the sim's noise displacement the layer follows. */
    float4 StructureNoiseWeights;
    float StructureScale;
    float StructureErosion;
    float StructureFlowInherit;

    float4 DetailNoiseWeights;
    float DetailScale;
    float DetailErosion;
    float DetailFlowInherit;

	/** The detail noise's mean value, which it settles to as it fades. */
    float DetailFadeMean;

	// -- Derived -------------------------------------------------------------

	/** Atmosphere thickness in world units: the one absolute length here. */
    float Thickness;

	/** The ramp depth each end of the profile gets, an atmosphere fraction. Half
	 *  CloudThickness at most, so a full column's two ramps never overlap and
	 *  TR_CloudBeta is exact. */
    float SpanTop;
    float SpanBase;

    float SpinAngle;

	/** Noise units the shell spans vertically, per layer: Scale * Aspect *
	 *  HeightScale, which is what makes the aspect a ratio. */
    float StructureVertical;
    float DetailVertical;

	/** Per-layer fade range, in planet radii from the camera. The march reads
	 *  both edges to set the per-sample fades; the far edges are also the shadow
	 *  map's cascade half-widths. */
    float StructureFadeNear;
    float StructureFadeFar;
    float DetailFadeNear;
    float DetailFadeFar;

	// -- Per sample ----------------------------------------------------------

	/** Per-layer level of detail, 1 near and 0 far, written per sample by the
	 *  march; left at 1 by TR_BuildField, which is what the bake reads. Only
	 *  DetailFade is read here. */
    float StructureFade;
    float DetailFade;
};

/** Fills TRFieldParams from the packed pins and derives the rest. The bake calls
 *  it with the same values, so the field the eye sees and the field the light
 *  sees share every derivation. Packing, member by member:
 *
 *    CloudProfile      CloudBase, CloudThickness, SurfaceSoftness, CeilingFalloff
 *    CloudCurves       TopCurve, BottomCurve, CloudSlope, WarpStretch
 *    CloudCoverage     CloudCover, CoverageGain, CoverageSoftness, ErosionGain
 *    CloudType         TypeBias, TypeAscent, TypeTropical, ErosionAscent
 *    CloudLid          PressureScale, CeilingDepth, CeilingPressure, StratusDepth
 *    CloudLift         BaseTropical, BasePressure, AltitudeGain, AltitudeLift
 *    CloudMotion       DriftAngle, NoisePhase, WarpShift, RotationWeight
 *    <Layer>NoiseWeights  Worley rung weights, layer amount
 *    <Layer>Sampling   Scale, Aspect, Erosion, FadeMean
 *    <Layer>Warp       FlowInherit, -, FadeNear, FadeSpan
 *
 *  RotationWeight is the planet's own rotation; the sim runs in the rotating
 *  frame, so it applies to the sampling position, negated because rotating the
 *  sample point backwards carries the field forwards. */
TRFieldParams TR_BuildField(
	float PlanetRadius,
	float HeightScale,
	float Time,
	float4 CloudProfile,
	float4 CloudCurves,
	float4 CloudCoverage,
	float4 CloudType,
	float4 CloudLid,
	float4 CloudLift,
	float4 CloudMotion,
	float4 StructureNoiseWeights,
	float4 StructureSampling,
	float4 StructureWarp,
	float4 DetailNoiseWeights,
	float4 DetailSampling,
	float4 DetailWarp)
{
    TRFieldParams F;

    F.PlanetRadius = PlanetRadius;

    F.CloudBase = CloudProfile.x;
    F.CloudThickness = max(CloudProfile.y, 1e-4f);
    F.SurfaceSoftness = CloudProfile.z;
    F.CeilingFalloff = max(CloudProfile.w, 1e-3f);

    F.TopCurve = CloudCurves.x;
    F.BottomCurve = CloudCurves.y;
    F.CloudSlope = CloudCurves.z;
    F.WarpStretch = CloudCurves.w;

    F.CloudCover = CloudCoverage.x;
    F.CoverageGain = CloudCoverage.y;
    F.CoverageSoftness = max(CloudCoverage.z, 1e-3f);
    F.ErosionGain = max(CloudCoverage.w, 0.0f);

    F.TypeBias = CloudType.x;
    F.TypeAscent = CloudType.y;
    F.TypeTropical = CloudType.z;
    F.ErosionAscent = CloudType.w;

    F.PressureScale = max(CloudLid.x, 1e-6f);
    F.CeilingDepth = max(CloudLid.y, 1e-3f);
    F.CeilingPressure = clamp(CloudLid.z, -0.99f, 0.99f);
    F.StratusDepth = saturate(CloudLid.w);

    F.BaseTropical = CloudLift.x;
    F.BasePressure = CloudLift.y;
    F.AltitudeGain = max(CloudLift.z, 0.0f);
    F.AltitudeLift = CloudLift.w;

    F.DriftAngle = CloudMotion.x;
    F.NoisePhase = CloudMotion.y;
    F.WarpShift = CloudMotion.z;
    F.RotationWeight = CloudMotion.w;

    F.StructureNoiseWeights = StructureNoiseWeights;
    F.StructureScale = StructureSampling.x;
    F.StructureErosion = max(StructureSampling.z, 0.0f);
    F.StructureFlowInherit = StructureWarp.x;

    F.DetailNoiseWeights = DetailNoiseWeights;
    F.DetailScale = DetailSampling.x;
    F.DetailErosion = saturate(DetailSampling.z);
    F.DetailFadeMean = saturate(DetailSampling.w);
    F.DetailFlowInherit = DetailWarp.x;

    F.Thickness = max(PlanetRadius * HeightScale, 1e-4f);

	// One share for both ends, capped at half so a full column's ramps meet at
	// most in the middle. The curves carry any asymmetry.
    F.SpanTop = clamp(F.SurfaceSoftness, 1e-4f, 0.5f) * F.CloudThickness;
    F.SpanBase = F.SpanTop;

    F.SpinAngle = -F.RotationWeight * Time;

    F.StructureVertical = StructureSampling.x * StructureSampling.y * HeightScale;
    F.DetailVertical = DetailSampling.x * DetailSampling.y * HeightScale;

	// Each far edge held above its own near one, so a zero span cannot collapse
	// a cascade onto the one inside it.
    F.StructureFadeNear = max(StructureWarp.z, 0.0f);
    F.StructureFadeFar = F.StructureFadeNear + max(StructureWarp.w, 1e-4f);
    F.DetailFadeNear = max(DetailWarp.z, 0.0f);
    F.DetailFadeFar = F.DetailFadeNear + max(DetailWarp.w, 1e-4f);

    F.StructureFade = 1.0f;
    F.DetailFade = 1.0f;

    return F;
}

/** The call both consumers make, expanded from one definition beside the
 *  signature it has to match. Requires a variable of each name in scope: the
 *  material Custom node's pins and TerrestrialShadowMap.usf's uniforms carry
 *  exactly these names. A missing one is an undeclared identifier naming it. */
#define TR_BUILD_FIELD() TR_BuildField( \
	PlanetRadius, HeightScale, Time, \
	CloudProfile, CloudCurves, CloudCoverage, CloudType, \
	CloudLid, CloudLift, CloudMotion, \
	StructureNoiseWeights, StructureSampling, StructureWarp, \
	DetailNoiseWeights, DetailSampling, DetailWarp)

/** The shell's ceiling: 1 below the falloff band, 0 at the atmosphere top,
 *  smoothstep between, so a tower that would cross it softens into a cap. */
float TR_CeilingFade(float Height, TRFieldParams F)
{
    return 1.0f - smoothstep(1.0f - F.CeilingFalloff, 1.0f, Height);
}

/** The height profile inside a column: a ramp down from the top times a ramp up
 *  from the base, each peaking at exactly 1 with zero derivative at both ends.
 *  Zero outside the slab.
 *
 *  THE SPANS ARE CUT AGAINST THIS COLUMN'S OWN DEPTH, so a shallow column peaks
 *  below 1 instead of holding core density over no distance. */
float TR_SlabDensity(float Height, float Top, float Base, TRFieldParams F)
{
    const float Depth = max(Top - Base, 1e-4f);

    const float FromTop = saturate((Top - Height) / min(F.SpanTop, Depth));
    const float FromBase = saturate((Height - Base) / min(F.SpanBase, Depth));

    return smoothstep(0.0f, 1.0f, pow(FromTop, max(F.TopCurve, 1e-4f)))
		* smoothstep(0.0f, 1.0f, pow(FromBase, max(F.BottomCurve, 1e-4f)));
}

/** Extinction per atmosphere thickness, solved so a ray down a full-depth
 *  column at density 1 accumulates CloudOpticalDepth. Solved rather than
 *  authored, so reshaping the profile leaves the opacity where it was put, and
 *  shared by the march and the bake. */
float TR_CloudBeta(TRFieldParams F, float CloudOpticalDepth)
{
	// Each ramp's mean density: the integral of smoothstep(T^c) over [0,1].
    const float Ct = max(F.TopCurve, 1e-4f);
    const float Cb = max(F.BottomCurve, 1e-4f);

    const float MeanTop = 3.0f / (2.0f * Ct + 1.0f) - 2.0f / (3.0f * Ct + 1.0f);
    const float MeanBase = 3.0f / (2.0f * Cb + 1.0f) - 2.0f / (3.0f * Cb + 1.0f);

    const float Plateau = F.CloudThickness - F.SpanTop - F.SpanBase;

    return CloudOpticalDepth
		/ max(MeanTop * F.SpanTop + MeanBase * F.SpanBase + Plateau, 1e-4f);
}

/** The column's weather, from one flow tap and one weather tap. */
struct TRColumn
{
	/** How much of the shape noise survives, [0, 1]. */
    float Coverage;

	/** 0 stratiform to 1 towering. Also the material coordinate. */
    float Type;

	/** Lows positive, bounded to (-1, 1). */
    float Pressure;

	/** Vertical motion, rising positive, (-1, 1). */
    float Ascent;

	/** How high the cloud formed, [0, 1], from the sim's formation ascent. */
    float Altitude;

	/** How deeply the structure noise erodes the profile. Above 1 it cuts holes
	 *  through a fully covered column. */
    float Erosion;

	/** The slab, atmosphere fractions. Exact: nothing outside moves them. */
    float Base;
    float Top;
};

/** The column at a spun direction N from its flow sample.
 *
 *  COVERAGE IS THE SIM'S CLOUD FIELD, THRESHOLDED. CoverageGain maps the
 *  field's typical range onto [0, 1]; CloudCover sets the threshold, at 1 -
 *  CloudCover, and CoverageSoftness the width either side. A threshold rather
 *  than an offset: clear sky stays clear at any CloudCover, and a system keeps
 *  a defined edge whatever the global amount. Inside it coverage reaches 1 and
 *  erosion breaks it up.
 *
 *  PITFALL: an additive CloudCover lifts every column by the same amount, so
 *  raising it to recover cloud flattens the sim's contrast until the noise,
 *  not the weather, decides where the gaps are.
 *
 *  TYPE IS HOW HARD THE AIR IS RISING, plus the tropics. A towering column is
 *  CloudThickness deep, a stratiform one StratusDepth of that; the pressure lid
 *  then scales both, so highs flatten into sheets and lows build.
 *
 *  EROSION IS BREAKUP. Sinking air erodes harder than rising air when
 *  ErosionAscent is positive, so subsidence breaks into patches and large-scale
 *  ascent fills into sheets.
 *
 *  THE BASE is the condensation level: tropicality and pressure, plus the
 *  altitude the cloud formed at for all but towering columns. A tower stays
 *  rooted; what drifts off it as W falls turns stratiform at the altitude it
 *  formed at, so outflow becomes high layered cloud and cloud grown under weak
 *  lift stays low. No noise, which keeps the base exact.
 *
 *  SPARSE COLUMNS ARE SHALLOW. Depth ramps in over TR_COVERAGE_DEPTH_RAMP of
 *  coverage, so clear sky has no slab for the entry search to stop on. */
TRColumn TR_ColumnFromFlow(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	float4 Flow,
	float3 N,
	TRFieldParams F)
{
    TRColumn Col;

    const float4 Weather = Flow_SampleWeather(FlowField, FlowSampler, N, TR_FLOW_LAYER);

    const float Tropical = 1.0f - abs(N.z);

    const float Low = -Flow.z / F.PressureScale;

    Col.Pressure = Low * rsqrt(1.0f + Low * Low);
    Col.Ascent = Weather.x;
    Col.Altitude = saturate(F.AltitudeGain * Weather.z);

    const float Threshold = 1.0f - F.CloudCover;

    Col.Coverage = smoothstep(
		Threshold - F.CoverageSoftness, Threshold + F.CoverageSoftness, F.CoverageGain * Weather.y);

    Col.Type = saturate(F.TypeBias + F.TypeAscent * Weather.x + F.TypeTropical * Tropical);

    Col.Erosion = F.StructureErosion * F.ErosionGain * max(1.0f - F.ErosionAscent * Weather.x, 0.0f)
		* saturate(F.StructureNoiseWeights.w);

    const float D = F.CloudThickness;

    Col.Base = F.CloudBase + D * (F.BaseTropical * Tropical + F.BasePressure * Col.Pressure
		+ F.AltitudeLift * Col.Altitude * (1.0f - Col.Type));

    const float Lid = F.CeilingDepth * (1.0f + F.CeilingPressure * Col.Pressure);

    const float Depth = D * lerp(F.StratusDepth, 1.0f, Col.Type) * Lid
		* smoothstep(0.0f, TR_COVERAGE_DEPTH_RAMP, Col.Coverage);

	// Capped at the shell, where the ceiling fade has already taken density to
	// zero.
    Col.Top = min(Col.Base + Depth, 1.0f);

    return Col;
}

TRColumn TR_Column(Texture2DArray FlowField, SamplerState FlowSampler, float3 N, TRFieldParams F)
{
    return TR_ColumnFromFlow(
		FlowField, FlowSampler, Flow_Sample(FlowField, FlowSampler, N, TR_FLOW_LAYER), N, F);
}

/** The column at a planet-local position, spun. For what varies over a system's
 *  width rather than a feature's: the tint of extinction a light ray crossed. */
float TR_TypeCoarse(Texture2DArray FlowField, SamplerState FlowSampler, float3 LocalPos, TRFieldParams F)
{
    const float3 N = normalize(Atmo_RotateZ(normalize(LocalPos), F.SpinAngle));

    return TR_Column(FlowField, FlowSampler, N, F).Type;
}

/** Distance along a ray at which it first reaches a slab, from either side.
 *  Returns T1 when it does not reach one between T0 and T1, and sets OutMissed
 *  only when that is PROVED rather than merely not found.
 *
 *  THE TWO ARE NOT THE SAME ANSWER. The proofs are geometry: radius is monotone
 *  either side of the closest approach, so a ray climbing clear of TopMax, or
 *  below the base and still descending with its perigee outside the span, is
 *  ruled out whatever the field does. Running out of segment rests on CloudSlope
 *  bounding the surface, and an under-declared slope overshoots -- so it costs a
 *  full fine march, never missing cloud.
 *
 *  A CONE TRACE, AND NOT AN OPTIMIZATION: a grazing chord stepped at the
 *  field's own step size exhausts the iteration cap in empty space and leaves a
 *  hard silhouette at the limb. LocalDir is normalized. */
float TR_SlabEntry(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	float3 LocalOrigin,
	float3 LocalDir,
	float T0,
	float T1,
	float TopMax,
	TRFieldParams F,
	out bool OutMissed)
{
    OutMissed = false;

    float TSearch = T0;

    LOOP

    for (int Iter = 0; Iter < TR_SLAB_ENTRY_PROBES; Iter++)
    {
        const float3 ProbePos = LocalOrigin + LocalDir * TSearch;
        const float ProbeRadius = length(ProbePos);
        const float ProbeHeight = (ProbeRadius - F.PlanetRadius) / F.Thickness;

        const float3 ProbeDir = ProbePos / max(ProbeRadius, 1e-4f);
        const float ProbeRate = dot(LocalDir, ProbeDir);

        const TRColumn Col = TR_Column(
			FlowField, FlowSampler, normalize(Atmo_RotateZ(ProbeDir, F.SpinAngle)), F);

        if (ProbeHeight <= Col.Top && ProbeHeight >= Col.Base && Col.Top > Col.Base)
        {
            return TSearch;
        }

        const bool bAbove = ProbeHeight > Col.Base;

		// A clear column has no top to close on; its base stands in, which is a
		// lower surface than any cloud nearby and so never overshoots one.
        const float Gap = bAbove
			? ProbeHeight - max(Col.Top, Col.Base)
			: Col.Base - ProbeHeight;

        const float Approach = bAbove ? -ProbeRate : ProbeRate;

		// Climbing and clear of the highest the field can reach.
        if (bAbove && ProbeRate >= 0.0f && ProbeHeight > TopMax)
        {
            OutMissed = true;
            return T1;
        }

		// BELOW THE BASE AND STILL DESCENDING: resume at the perigee rather than
		// give up, or a limb ray that skims under the cloud and climbs back into
		// it reports the whole segment as missing the slab.
		//
		// PITFALL: THE RATE IS ZERO TO WITHIN NOISE AT THE PERIGEE ITSELF, and its
		// sign there is arbitrary. The epsilon keeps the branch to rays genuinely
		// still descending; a perigee that is not ahead means nothing to skip.
        if (!bAbove && ProbeRate < -1e-4f)
        {
            const float TPerigee = -dot(LocalOrigin, LocalDir);

            if (TPerigee >= T1)
            {
                OutMissed = true;
                return T1;
            }

            if (TPerigee > TSearch)
            {
                TSearch = TPerigee;
                continue;
            }
        }

		// The surface moves to meet the ray, so the closing rate is the ray's
		// own approach plus the surface's slope across the ground it covers.
		// PITFALL: CloudSlope has to bound the steeper surface, which at a
		// coverage edge is the top collapsing onto the base.
        const float Horizontal = sqrt(max(1.0f - ProbeRate * ProbeRate, 0.0f));

        const float ClosingRate = Approach
			+ Horizontal * max(F.CloudSlope, 0.1f) * F.CloudThickness * F.Thickness
				/ max(ProbeRadius, 1e-4f);

        const float Advance = Gap * F.Thickness / max(ClosingRate, 1e-5f);

        TSearch += max(Advance * TR_CONE_RELAXATION, 1e-4f);

        if (TSearch >= T1)
        {
            return T1;
        }
    }

    return TSearch;
}

/** Samples one noise layer as a Perlin-Worley value in [0, 1], in true 3D so
 *  the vertical structure the bake put in the volume survives. MIP 0 always: a
 *  footprint mip ties the field to camera distance.
 *
 *  THROUGH BOTH NOISE PHASES, crossfaded. Each is N plus Inherit times its
 *  displacement, turned about the axis by the drift, backwards so the noise
 *  moves forwards. Each phase resets where its weight is zero. */
float TR_SampleLayer(
	Texture3D Volume,
	SamplerState Sampler,
	float3 N,
	float3 DisplacementA,
	float3 DisplacementB,
	float Inherit,
	float UVWScale,
	float4 NoiseWeights,
	TRFieldParams F)
{
    const float3 PA = Atmo_RotateZ(normalize(N + DisplacementA * Inherit), -F.DriftAngle);
    const float3 PB = Atmo_RotateZ(normalize(N + DisplacementB * Inherit), -F.DriftAngle);

    const float4 S = lerp(
		Volume.SampleLevel(Sampler, PB * UVWScale, 0.0f),
		Volume.SampleLevel(Sampler, PA * UVWScale, 0.0f),
		Flow_NoiseWeightA(F.NoisePhase));

    return AtmoNoise_PerlinWorley(S.r, AtmoNoise_WorleyLadder(S.gba, NoiseWeights.xyz));
}

/** Density at a point in the shell. LocalPos carries its true radius; the
 *  column is evaluated at the normalized direction. StepHalfLength is half the
 *  march step in atmosphere fractions along the radius.
 *
 *  THE PROFILE IS INTEGRATED ACROSS THE STEP, not sampled at its midpoint: one
 *  midpoint sample makes the slab a near-binary decision per step, and as a
 *  surface drifts against the lattice that decision flips along a line on
 *  screen.
 *
 *  Returns:
 *    x  Density in [0, 1]. Multiply by an extinction coefficient in the march.
 *    y  Cloud type, [0, 1]: the material coordinate.
 *    z  Pressure, lows positive.
 *    w  The column's top. */
float4 TR_Density(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	Texture3D DetailVolume,
	SamplerState DetailSampler,
	Texture3D StructureVolume,
	SamplerState StructureSampler,
	float3 LocalPos,
	float StepHalfLength,
	TRFieldParams F)
{
    const float Radius = length(LocalPos);
    const float3 Direction = LocalPos / max(Radius, 1e-4f);

    const float Height = (Radius - F.PlanetRadius) / F.Thickness;
    const float HalfStep = max(StepHalfLength, 0.0f);

    const float3 N = normalize(Atmo_RotateZ(Direction, F.SpinAngle));

    const float4 Flow0 = Flow_Sample(FlowField, FlowSampler, N, TR_FLOW_LAYER);

    const TRColumn Col = TR_ColumnFromFlow(FlowField, FlowSampler, Flow0, N, F);

    BRANCH

	// ONE FETCH PAIR OUTSIDE THE SLAB RATHER THAN SEVEN: density there is
	// exactly zero. The test uses the step's near edge on each side.
    if (Col.Top <= Col.Base || Height + HalfStep <= Col.Base || Height - HalfStep >= Col.Top)
    {
        return float4(0.0f, Col.Type, Col.Pressure, Col.Top);
    }

	// -- Height profile, integrated across the step ----------------------------

    const float Profile =
		(TR_SlabDensity(Height - HalfStep, Col.Top, Col.Base, F) * TR_CeilingFade(Height - HalfStep, F)
		+ 4.0f * TR_SlabDensity(Height, Col.Top, Col.Base, F) * TR_CeilingFade(Height, F)
		+ TR_SlabDensity(Height + HalfStep, Col.Top, Col.Base, F) * TR_CeilingFade(Height + HalfStep, F))
		/ 6.0f;

    const float HeightFraction = saturate((Height - Col.Base) / max(Col.Top - Col.Base, 1e-4f));

	// -- Lateral: the sim's noise displacements -------------------------------

    float3 DisplacementA, DisplacementB;
    Flow_SampleNoise(FlowField, FlowSampler, N, TR_FLOW_LAYER, DisplacementA, DisplacementB);

	// -- Vertical warp: rising air stretches and lifts the noise ---------------
	//
	// STRETCH divides the vertical frequency, so rising air draws a feature out
	// taller; SHIFT reads the volume from a different altitude. Both touch only
	// the noise, so they cost the bounds nothing.

    const float Stretch = max(1.0f + F.WarpStretch * Col.Ascent, 0.1f);
    const float Shift = F.WarpShift * F.CloudThickness * Col.Ascent;

	// -- Shape: the noise coverage erodes --------------------------------------

    float Shape = Profile;

    BRANCH

    if (F.StructureNoiseWeights.w > 0.0f)
    {
        const float Noise = TR_SampleLayer(
			StructureVolume, StructureSampler, N,
			DisplacementA, DisplacementB, F.StructureFlowInherit,
			F.StructureScale + (Height - Shift) * F.StructureVertical / Stretch,
			F.StructureNoiseWeights, F);

		// Extrapolated past 1, the factor goes negative wherever the noise sits
		// below 1 - 1/Erosion, and those holes survive any coverage.
        Shape *= saturate(1.0f + Col.Erosion * (Noise - 1.0f));
    }

	// COVERAGE AS A THRESHOLD ON THE SHAPE, then as a scale. At low coverage
	// only the shape's densest cores survive -- and since the profile falls off
	// toward the top, the tops go first, leaving low scattered cloud. Near 1 the
	// whole column survives.
    const float Coverage = Col.Coverage;

    float Density = saturate((Shape - (1.0f - Coverage)) / max(Coverage, 1e-3f)) * Coverage;

	// -- Detail: erosion of the edges ------------------------------------------

    BRANCH

    if (F.DetailNoiseWeights.w > 0.0f && Density > 0.0f)
    {
		// Faded toward the mean rather than off: see the header. Past the far
		// edge the fetch is skipped.
        float Detail = F.DetailFadeMean;

        BRANCH

        if (F.DetailFade > 0.0f)
        {
            Detail = lerp(F.DetailFadeMean, TR_SampleLayer(
				DetailVolume, DetailSampler, N,
				DisplacementA, DisplacementB, F.DetailFlowInherit,
				F.DetailScale + (Height - Shift) * F.DetailVertical / Stretch,
				F.DetailNoiseWeights, F), F.DetailFade);
        }

		// Wispy at the base, where the noise itself erodes; billowy toward the
		// top, where its inverse does and rounded lobes remain.
        const float Modifier = lerp(Detail, 1.0f - Detail, saturate(HeightFraction / TR_BILLOW_HEIGHT));

        const float Erode = Modifier * F.DetailErosion * saturate(F.DetailNoiseWeights.w)
			* TR_DETAIL_EROSION_SCALE;

        Density = saturate((Density - Erode) / max(1.0f - Erode, 1e-3f));
    }

    return float4(Density, Col.Type, Col.Pressure, Col.Top);
}

/** The field-wide reach, in atmosphere fractions: how far the BASE can move
 *  each way, and how deep a column can get above it. THE ONE DERIVATION read by
 *  both bounds below. Every term in TR_ColumnFromFlow has to appear here: an
 *  underestimate slices the tops off the features it belongs to. */
void TR_FieldReach(
	TRFieldParams F,
	out float BaseUp,
	out float BaseDown,
	out float Depth)
{
    const float D = F.CloudThickness;

    BaseUp = D * (max(F.BaseTropical, 0.0f) + abs(F.BasePressure) + max(F.AltitudeLift, 0.0f));
    BaseDown = D * (-min(F.BaseTropical, 0.0f) + abs(F.BasePressure) - min(F.AltitudeLift, 0.0f));

    Depth = D * max(F.CeilingDepth * (1.0f + abs(F.CeilingPressure)), 1e-3f);
}

/** The highest any column top can reach, an atmosphere fraction, clamped at the
 *  shell. Planet-wide, so the marched band does not narrow when the sky is
 *  quiet. */
float TR_TopMax(TRFieldParams F)
{
    float BaseUp, BaseDown, Depth;
    TR_FieldReach(F, BaseUp, BaseDown, Depth);

    return min(F.CloudBase + BaseUp + Depth, 1.0f);
}

/** The lowest any column base can fall: where the marched band ends. */
float TR_BaseMin(TRFieldParams F)
{
    float BaseUp, BaseDown, Depth;
    TR_FieldReach(F, BaseUp, BaseDown, Depth);

    return F.CloudBase - BaseDown;
}
