#pragma once

#include "/Plugin/CloudAtmosphere/Private/AtmosphereTypes.ush"
#include "/Plugin/CloudAtmosphere/Private/FlowField.ush"

// The cloud field the march samples, both models'.
//
// THE SIM IS THE WEATHER MAP, THE NOISE IS THE CLOUD. Each column reads the
// sim once and gets five things: COVERAGE (the sim's cloud field), TYPE (from
// vertical motion, latitude and storms: 0 stratiform, 1 towering), PRESSURE
// (the lid and the base), ALTITUDE (how high in the sim's stack the cloud
// formed, which floats stratiform cloud up) and W (vertical motion, which
// stretches and lifts the noise).
// Inside the column a shape noise is multiplied by a height profile, and
// coverage decides how much of it survives: at low coverage only the densest
// noise cores remain as scattered cloud, near 1 the column fills. A detail
// noise then erodes the edges, wispy toward the base and billowy toward the
// top. The noise draws every cloud; the sim decides where, how much and what
// kind.
//
// THE SIM CARRIES THE NOISE. It advects two displacement fields with the flow,
// reset half a period apart, and the noise is sampled through both and
// crossfaded, so it follows the flow's own trajectories, turning inside
// vortices, on top of a solid-body drift about the axis.
//
// A SLAB BETWEEN TWO SURFACES BOUNDS IT. The base is the condensation level
// and the top is the column's type-dependent depth under the pressure lid;
// both are exact per column, which the entry search and the empty-air early-out
// spend. Outside the slab density is exactly zero.
//
// THE NOISE IS CHOSEN BY GENUS. Both volumes share one layout of noise TYPES,
// octaves summed in the bake: R Perlin, G Worley F1, B Worley F2 - F1, A ridged
// Perlin. The structure layer reads them as smooth, billow (1 - F1), cellular
// and fibrous; a column's type and altitude blend four genera -- stratus,
// stratocumulus, cumulus, cirrus -- into weights over them. The detail layer
// erodes by them: wispy (Perlin), billow (F1) and fibrous (1 - ridged).
//
// THE DETAIL LAYER FADES WITH DISTANCE, TO ITS MEAN. It erodes, so dropping it
// would thicken distant cloud; settling on the noise's mean value keeps the
// average erosion and removes only the grain. The structure layer draws the
// cloud shapes and applies at every range. The shadow bake keeps full detail,
// band-limited by its subsamples, so its mean matches either way.
//
// THE DEEP DECK (TR_DEEP_DECK), a gas giant's, has no base: under each
// column's top the profile runs on down, and below the base the deck fills in
// to full density over DeepFill, on down through the core. Under the cloud,
// the floor rises into the fill as full-density mounds shaped by the structure
// noise; it only adds density, so the cloud above it is untouched. Everything
// above the base is the slab's.
//
// UNITS. CloudBase and CloudThickness are atmosphere fractions; every other
// height is a multiple of CloudThickness. Space is planet-local, spin axis on
// Z, positions unit directions except in TR_Density.

/** How much of the density the detail layer can erode at full DetailErosion.
 *  Above about a half it eats whole thin clouds rather than their edges. */
#ifndef TR_DETAIL_EROSION_SCALE
#define TR_DETAIL_EROSION_SCALE 0.35f
#endif

/** Height fraction over which detail erosion turns from wispy (base) to
 *  billowy (top). */
#ifndef TR_BILLOW_HEIGHT
#define TR_BILLOW_HEIGHT 0.25f
#endif

/** How many mips below the top of its chain the detail volume stops being
 *  fetched and reads as its mean. At that mip a tile is a few texels and the
 *  detail's cells average out, so the fetch returns the mean anyway; the last
 *  mip before it fades across. Matters for the shadow bake's coarse cascade,
 *  whose texels span dozens of detail texels. */
#ifndef TR_DETAIL_MEAN_MIPS
#define TR_DETAIL_MEAN_MIPS 3
#endif

/** Share of the noise's range full structure erosion cuts away at full
 *  coverage: the hole fraction a thick system breaks up into. Half leaves
 *  about half of it clear, the survivors ramping from their edges to full. */
#define TR_EROSION_CUT 0.5f

/** The least StratusDepth the stretch measures depth against. */
#ifndef TR_STRETCH_MIN_STRATUS
#define TR_STRETCH_MIN_STRATUS 0.1f
#endif

/** Coverage over which a column grows from no slab to its full depth. Sparse
 *  cloud is shallow cloud, and clear sky has no slab for the entry search to
 *  stop on. PITFALL: narrower makes the top a cliff at every coverage edge,
 *  steeper than CloudSlope bounds, and the entry search steps over cloud. */
#ifndef TR_COVERAGE_DEPTH_RAMP
#define TR_COVERAGE_DEPTH_RAMP 0.25f
#endif

/** The sim cloud at which a column's cloud amount, which ranks coverage and
 *  drives type and relief, is 95% of the way to full: the amount is
 *  1 - exp(-3 cloud / TR_CLOUD_FULL), a presence ease with no slope break.
 *  Small, so CloudCover and CoverageSoftness decide where cloud shows.
 *  PITFALL: a linear ramp here draws its end as an edge; a large value grades
 *  coverage by the cloud and competes with those two. */
#ifndef TR_CLOUD_FULL
#define TR_CLOUD_FULL 1e-3f
#endif

/** Fraction of the cone-trace advance actually taken. Under 1 because CloudSlope
 *  is authored, and an under-declared slope is the one way the entry search
 *  steps over a surface. */
#ifndef TR_CONE_RELAXATION
#define TR_CONE_RELAXATION 0.9f
#endif

/** Cone-trace iteration cap. Reached only on rays that graze for their whole
 *  length, which return where the search stopped for the march to go on
 *  from. */
#ifndef TR_SLAB_ENTRY_PROBES
#define TR_SLAB_ENTRY_PROBES 24
#endif

/** Power on the sim's depth factor that a column's density scales by (see
 *  TR_DensityInColumn): above 1 keeps more of an eyewall and clears the floor
 *  sooner. */
#ifndef TR_EYE_OPEN_POWER
#define TR_EYE_OPEN_POWER 1.0f
#endif

/** 1 grows a layer's frequency through the column as Scale times
 *  exp(Aspect * HeightScale * Rise), so the vertical to horizontal frequency
 *  ratio is Aspect at every height and the frequency stays positive; 0 adds
 *  Rise * Vertical to Scale, which equals Aspect only at Rise 0 and crosses
 *  zero below Rise = -1 / (Aspect * HeightScale). Under comparison. */
#ifndef TR_NOISE_EXP_FREQUENCY
#define TR_NOISE_EXP_FREQUENCY 1
#endif

/** 1 for the deep deck, a gas giant's; 0 for the slab. Set per pass by the
 *  model's shader permutation. */
#ifndef TR_DEEP_DECK
#define TR_DEEP_DECK 0
#endif

/** Depth of the deep floor's edge ramp, in fills. */
#ifndef TR_DEEP_FLOOR_SOFTNESS
#define TR_DEEP_FLOOR_SOFTNESS 0.25f
#endif

/** The sim layer every column read comes from: CloudLayer, negative for the
 *  bottom of the stack, clamped to the stack. */
float TR_FlowLayer(Texture2DArray FlowField, float CloudLayer)
{
    const float Lowest = Flow_LowestLayer(FlowField);

    return (CloudLayer < 0.0f) ? Lowest : min(floor(CloudLayer), Lowest);
}

/** Everything the field reads. Authored members carry their C++ property
 *  names; they arrive packed on a handful of vector pins (see TR_BuildField)
 *  and are unpacked here once. */
struct TRFieldParams
{
	// -- Authored ------------------------------------------------------------

    float PlanetRadius;

	/** Condensation level of an unlifted column, an atmosphere fraction. */
    float CloudBase;

	/** Depth of a fully towering column before the lid, an atmosphere fraction,
	 *  and the unit every other height is a multiple of. */
    float CloudThickness;

	/** Share of CloudThickness each end of the height profile ramps over, and
	 *  each ramp's shape. Above 1 flattens that end; below 0.5 it loses its C1
	 *  join. */
    float SurfaceSoftness;
    float TopCurve;
    float BottomCurve;

	/** Width of the band under the shell top across which density fades to
	 *  zero, an atmosphere fraction. */
    float CeilingFalloff;

	/** How far down the columns' priority coverage reaches: 0 none, 1 all
	 *  cloud. StormPriority is how far storm raises a column's priority over
	 *  plain cloud, CoverageSoftness the threshold's half-width in priority.
	 *  CoverageFray is how far low coverage raises the erosion threshold,
	 *  fraying system edges, against fading them. */
    float CloudCover;
    float StormPriority;
    float CoverageSoftness;
    float CoverageFray;

	/** The deep deck's fill: how far below a column's base, in atmosphere
	 *  fractions, it reaches full density; and how many fills the floor's
	 *  mounds rise above that. */
    float DeepFill;
    float FloorRelief;

	/** The exponent type builds with: above 1 only the densest and stormiest
	 *  columns approach full towering storm cloud. */
    float TypeCurve;

	/** Where the storm threshold sits in the storm index, 0 none to 1 all
	 *  cloud, and the half-width of its blend. */
    float StormBalance;
    float StormBlend;

	/** Depth of a stratiform column as a fraction of a towering one. */
    float StratusDepth;

	/** The sim layer the columns read, negative for the bottom. A layer's
	 *  weather slice combines its cloud with every layer's above it, so the
	 *  bottom's is the whole sky. Cloud, vertical motion, pressure and the noise
	 *  displacement all come from it, so the cloud and the noise that breaks it
	 *  up move with one flow. */
    float CloudLayer;

	/** Type = TypeBias + TypeTropical * tropicality + TypeStorm * storm. */
    float TypeBias;
    float TypeTropical;
    float TypeStorm;

	/** The geopotential anomaly that reads as a full low or high. */
    float PressureScale;

	/** How far pressure moves a column's depth, as a share of CloudThickness:
	 *  positive gives lows more room than highs. */
    float CeilingPressure;

	/** How far tropicality and pressure move the base, multiples of
	 *  CloudThickness. */
    float BaseTropical;
    float BasePressure;

	/** Altitude = saturate(AltitudeGain * formation altitude); it lifts the
	 *  base of a stratiform column by up to AltitudeLift cloud thicknesses. */
    float AltitudeGain;
    float AltitudeLift;

	/** How far rising air stretches the noise vertically, and lifts it, the
	 *  latter a multiple of CloudThickness. */
    float WarpStretch;
    float WarpShift;

	/** Bound on either surface's slope, cloud depths per radian. Read only by
	 *  the entry search's cone angle. */
    float CloudSlope;


	/** The noise's solid-body drift about the spin axis, radians, wrapped, and
	 *  noise phase A's position in its reset cycle, [0, 1). */
    float DriftAngle;
    float NoisePhase;

	/** Mips added to the layer's footprint mip, and whether the layer is read:
	 *  a bound volume and erosion above zero. FlowInherit is the share of the
	 *  sim's noise displacement the layer follows. */
    float StructureMipBias;
    bool StructureActive;
    float StructureScale;
    float StructureErosion;
    float StructureFlowInherit;

    float DetailMipBias;
    bool DetailActive;
    float DetailScale;
    float DetailErosion;
    float DetailFlowInherit;

	/** The detail noise's mean value, which it settles to as it fades. */
    float DetailFadeMean;

	/** Structure channel weights per genus, and how fast sinking air turns
	 *  stratus into stratocumulus. */
    float4 GenusStratus;
    float4 GenusStratocumulus;
    float4 GenusCumulus;
    float4 GenusCirrus;
    float GenusSubsidence;

	// -- Derived -------------------------------------------------------------

	/** Atmosphere thickness in world units: the one absolute length here. */
    float Thickness;

	/** The ramp depth each end of the profile gets, an atmosphere fraction. Half
	 *  CloudThickness at most, so a full column's two ramps never overlap and
	 *  TR_CloudBeta is exact. */
    float SpanTop;
    float SpanBase;

    float SpinAngle;

	/** Per layer, Scale * Aspect * HeightScale: the frequency's growth per
	 *  atmosphere fraction of height at Rise 0 (TR_NoiseFrequency). */
    float StructureVertical;
    float DetailVertical;

	/** The detail layer's fade range, in planet radii from the camera, which the
	 *  march reads to set DetailFade per sample. */
    float DetailFadeNear;
    float DetailFadeFar;

	/** Half-widths of the shadow map's two inner cascades, in planet radii. */
    float ShadowCascade1;
    float ShadowCascade2;

	// -- Per sample ----------------------------------------------------------

	/** The detail layer's level of detail, 1 near and 0 far, written per sample
	 *  by the march and per cascade by the bake; 1 from TR_BuildField. */
    float DetailFade;

	/** One march pixel's width at the sample, in radians of arc on the unit
	 *  sphere: what the noise mip is chosen from. Written per sample by the
	 *  march, and per texel by the bake from its subsample spacing; 0 from
	 *  TR_BuildField, which is mip 0. */
    float PixelFootprint;
};

/** Fills TRFieldParams from the packed pins and derives the rest. The bake calls
 *  it with the same values, so the field the eye sees and the field the light
 *  sees share every derivation. Packing, member by member:
 *
 *    CloudProfile      CloudBase, CloudThickness, SurfaceSoftness, CeilingFalloff
 *    CloudCurves       TopCurve, BottomCurve, CloudSlope, WarpStretch
 *    CloudCoverage     CloudCover, StormPriority, CoverageSoftness, DeepFill
 *    CloudType         TypeBias, (unused), TypeTropical, (unused)
 *    CloudLid          PressureScale, (unused), CeilingPressure, StratusDepth
 *    CloudLift         BaseTropical, BasePressure, AltitudeGain, AltitudeLift
 *    CloudMotion       DriftAngle, NoisePhase, WarpShift, SpinAngle
 *    NoiseLevels       StructureMipBias, structure volume bound, DetailMipBias,
 *                      detail volume bound
 *    StructureSampling Scale, Aspect, Erosion, TypeStorm
 *    StructureWarp     FlowInherit, GenusSubsidence, FloorRelief, (unused)
 *    DetailSampling    Scale, Aspect, Erosion, FadeMean
 *    DetailWarp        FlowInherit, (unused), FadeNear, FadeSpan
 *    ShadowCascades    Cascade 1 half-width, cascade 2 half-width, CloudLayer,
 *                      CoverageFray
 *    CloudGenus<Name>  structure channel weights for that genus
 *    CloudResponse     (unused), TypeCurve, StormBalance, StormBlend
 *
 *  SpinAngle is the planet's own rotation, -SpinRate * time wrapped in double
 *  on the CPU; the sim runs in the rotating frame, so it turns the sampling
 *  position. Every clock arrives wrapped. */
TRFieldParams TR_BuildField(
	float PlanetRadius,
	float HeightScale,
	float4 CloudProfile,
	float4 CloudCurves,
	float4 CloudCoverage,
	float4 CloudType,
	float4 CloudLid,
	float4 CloudLift,
	float4 CloudMotion,
	float4 NoiseLevels,
	float4 StructureSampling,
	float4 StructureWarp,
	float4 DetailSampling,
	float4 DetailWarp,
	float4 CloudGenusStratus,
	float4 CloudGenusStratocumulus,
	float4 CloudGenusCumulus,
	float4 CloudGenusCirrus,
	float4 ShadowCascades,
	float4 CloudResponse)
{
    TRFieldParams F;

    F.PlanetRadius = PlanetRadius;

    F.CloudBase = CloudProfile.x;
    F.CloudThickness = max(CloudProfile.y, 1e-4f);
    F.SurfaceSoftness = CloudProfile.z;
    F.CeilingFalloff = max(CloudProfile.w, 1e-3f);

    F.TopCurve = CloudCurves.x;
    F.BottomCurve = CloudCurves.y;
    F.CloudSlope = CloudCurves.z;
    F.WarpStretch = CloudCurves.w;

    F.CloudCover = CloudCoverage.x;
    F.StormPriority = max(CloudCoverage.y, 0.0f);
    F.CoverageSoftness = max(CloudCoverage.z, 1e-3f);
    F.DeepFill = max(CloudCoverage.w, 1e-4f);

    F.TypeBias = CloudType.x;
    F.TypeTropical = CloudType.z;

    F.PressureScale = max(CloudLid.x, 1e-6f);
    F.CeilingPressure = clamp(CloudLid.z, -0.99f, 0.99f);
    F.StratusDepth = saturate(CloudLid.w);

    F.BaseTropical = CloudLift.x;
    F.BasePressure = CloudLift.y;
    F.AltitudeGain = max(CloudLift.z, 0.0f);
    F.AltitudeLift = CloudLift.w;

    F.DriftAngle = CloudMotion.x;
    F.NoisePhase = CloudMotion.y;
    F.WarpShift = CloudMotion.z;
    F.SpinAngle = CloudMotion.w;

    F.StructureMipBias = NoiseLevels.x;
    F.StructureScale = StructureSampling.x;
    F.StructureErosion = max(StructureSampling.z, 0.0f);
    F.StructureActive = NoiseLevels.y > 0.5f && F.StructureErosion > 0.0f;
    F.TypeStorm = max(StructureSampling.w, 0.0f);
    F.StructureFlowInherit = StructureWarp.x;
    F.GenusSubsidence = max(StructureWarp.y, 0.0f);
    F.FloorRelief = saturate(StructureWarp.z);

    F.GenusStratus = CloudGenusStratus;
    F.GenusStratocumulus = CloudGenusStratocumulus;
    F.GenusCumulus = CloudGenusCumulus;
    F.GenusCirrus = CloudGenusCirrus;

    F.DetailMipBias = NoiseLevels.z;
    F.DetailScale = DetailSampling.x;
    F.DetailErosion = saturate(DetailSampling.z);
    F.DetailActive = NoiseLevels.w > 0.5f && F.DetailErosion > 0.0f;
    F.DetailFadeMean = saturate(DetailSampling.w);
    F.DetailFlowInherit = DetailWarp.x;

    F.Thickness = max(PlanetRadius * HeightScale, 1e-4f);

	// One share for both ends, capped at half so a full column's ramps meet at
	// most in the middle. The curves carry any asymmetry.
    F.SpanTop = clamp(F.SurfaceSoftness, 1e-4f, 0.5f) * F.CloudThickness;
    F.SpanBase = F.SpanTop;

    F.StructureVertical = StructureSampling.x * StructureSampling.y * HeightScale;
    F.DetailVertical = DetailSampling.x * DetailSampling.y * HeightScale;

	// The far edge held above the near one, so a zero span cannot collapse a
	// cascade onto the one inside it.
    F.DetailFadeNear = max(DetailWarp.z, 0.0f);
    F.DetailFadeFar = F.DetailFadeNear + max(DetailWarp.w, 1e-4f);

    F.ShadowCascade1 = max(ShadowCascades.x, 0.0f);
    F.ShadowCascade2 = max(ShadowCascades.y, 0.0f);

    F.CloudLayer = ShadowCascades.z;
    F.CoverageFray = saturate(ShadowCascades.w);

    F.TypeCurve = max(CloudResponse.y, 0.1f);
    F.StormBalance = saturate(CloudResponse.z);
    F.StormBlend = max(CloudResponse.w, 1e-3f);

    F.DetailFade = 1.0f;
    F.PixelFootprint = 0.0f;

    return F;
}

/** The call both consumers make, expanded from one definition beside the
 *  signature it has to match. Requires a variable of each name in scope:
 *  AtmosphereMarchPass.usf's and TerrestrialShadowMap.usf's uniforms carry
 *  exactly these names. A missing one is an undeclared identifier naming it. */
#define TR_BUILD_FIELD() TR_BuildField( \
	PlanetRadius, HeightScale, \
	CloudProfile, CloudCurves, CloudCoverage, CloudType, \
	CloudLid, CloudLift, CloudMotion, \
	NoiseLevels, StructureSampling, StructureWarp, \
	DetailSampling, DetailWarp, \
	CloudGenusStratus, CloudGenusStratocumulus, CloudGenusCumulus, CloudGenusCirrus, \
	ShadowCascades, CloudResponse)

/** The shell's ceiling: 1 below the falloff band, 0 at the atmosphere top,
 *  smoothstep between, so a tower that would cross it softens into a cap. */
float TR_CeilingFade(float Height, TRFieldParams F)
{
    return 1.0f - smoothstep(1.0f - F.CeilingFalloff, 1.0f, Height);
}

/** The height profile inside a column: a ramp down from the top times a ramp up
 *  from the base, each peaking at exactly 1 with zero derivative at both ends.
 *  Zero outside the slab. TR_SlabRamps gives the ramps' lengths, top then base.
 *
 *  A SHALLOW COLUMN SCALES BOTH RAMPS DOWN until they meet, so it still peaks
 *  at 1 and is thin rather than faint. PITFALL: cutting each ramp against the
 *  depth instead leaves a shallow column peaking near 0.15, which coverage and
 *  erosion then remove entirely while deep columns barely change. */
float2 TR_SlabRamps(float Top, float Base, TRFieldParams F)
{
#if TR_DEEP_DECK
	// A deep column always has room for its top ramp.
    return float2(F.SpanTop, F.SpanBase);
#endif

    const float Depth = max(Top - Base, 1e-4f);
    const float Ratio = Depth / max(F.SpanTop + F.SpanBase, 1e-4f);

	// min(Ratio, 1) as a p-norm, p = 4: never above it, so the ramps still fit.
	// PITFALL: a hard minimum's slope break kinks the column's optical depth at
	// depth 2 * SurfaceSoftness * CloudThickness, and a depth sweeping through it
	// draws a lighting ring, as on an eye wall.
    const float Fit = Ratio * rsqrt(sqrt(1.0f + Ratio * Ratio * Ratio * Ratio));

    return float2(max(F.SpanTop * Fit, 1e-5f), max(F.SpanBase * Fit, 1e-5f));
}

float TR_SlabDensity(float Height, float Top, float Base, TRFieldParams F)
{
    const float2 Ramps = TR_SlabRamps(Top, Base, F);

    const float FromTop = saturate((Top - Height) / Ramps.x);
    const float FromBase = TR_DEEP_DECK ? 1.0f : saturate((Height - Base) / Ramps.y);

    return smoothstep(0.0f, 1.0f, pow(FromTop, max(F.TopCurve, 1e-4f)))
		* smoothstep(0.0f, 1.0f, pow(FromBase, max(F.BottomCurve, 1e-4f)));
}

/** smoothstep(0, 1, U^C) integrated from 0 to U in [0, 1]:
 *  3 U^(2C+1) / (2C+1) - 2 U^(3C+1) / (3C+1). */
float TR_RampIntegral(float U, float C)
{
    const float P = pow(U, C);

    return U * P * P * (3.0f / (2.0f * C + 1.0f) - 2.0f * P / (3.0f * C + 1.0f));
}

/** max(smoothstep(0, 1, U^C) - P0, 0) integrated from 0 to U, U0 being where
 *  the ramp reaches P0. */
float TR_RampExcess(float U, float U0, float C, float P0)
{
    const float X = max(U, U0);

    return TR_RampIntegral(X, C) - TR_RampIntegral(U0, C) - P0 * (X - U0);
}

/** Where smoothstep(0, 1, U^C) reaches P, P in [0, 1]. */
float TR_RampInverse(float P, float C)
{
    const float X = 0.5f - sin(asin(1.0f - 2.0f * P) / 3.0f);

    return pow(saturate(X), 1.0f / C);
}

/** max(TR_SlabDensity - P0, 0), the profile's excess over a level, integrated
 *  from below the base up to Height, Ramps being TR_SlabRamps. The ramps fit
 *  inside the depth, so they never overlap and the profile is the base ramp,
 *  a plateau at 1 and the top ramp in turn. The deep deck has no base ramp and
 *  integrates from Base, which the caller sets at the bottom of its span. */
float TR_SlabExcessCumulative(float Height, float Top, float Base, float2 Ramps, float P0, TRFieldParams F)
{
    const float Ct = max(F.TopCurve, 1e-4f);
    const float Cb = max(F.BottomCurve, 1e-4f);

    const float U0t = TR_RampInverse(P0, Ct);
    const float U0b = TR_RampInverse(P0, Cb);

#if !TR_DEEP_DECK
    const float FromBase = saturate((Height - Base) / Ramps.y);
#endif
    const float FromTop = saturate((Top - Height) / Ramps.x);

#if TR_DEEP_DECK
	// No base ramp: the plateau runs down to Base.
    const float Plateau = max(min(Height, Top - Ramps.x) - Base, 0.0f);
    const float BaseExcess = 0.0f;
#else
    const float Plateau = max(min(Height, Top - Ramps.x) - (Base + Ramps.y), 0.0f);
    const float BaseExcess = Ramps.y * TR_RampExcess(FromBase, U0b, Cb, P0);
#endif

    return BaseExcess + Plateau * (1.0f - P0)
		+ Ramps.x * (TR_RampExcess(1.0f, U0t, Ct, P0) - TR_RampExcess(FromTop, U0t, Ct, P0));
}

/** Extinction per atmosphere thickness, solved so a ray down a full-depth
 *  column at density 1 accumulates CloudOpticalDepth. Solved rather than
 *  authored, so reshaping the profile leaves the opacity where it was put, and
 *  shared by the march and the bake. */
float TR_CloudBeta(TRFieldParams F, float CloudOpticalDepth)
{
	// Each ramp's mean density: the integral of smoothstep(T^c) over [0,1].
    const float Ct = max(F.TopCurve, 1e-4f);
    const float Cb = max(F.BottomCurve, 1e-4f);

    const float MeanTop = 3.0f / (2.0f * Ct + 1.0f) - 2.0f / (3.0f * Ct + 1.0f);
    const float MeanBase = 3.0f / (2.0f * Cb + 1.0f) - 2.0f / (3.0f * Cb + 1.0f);

    const float Plateau = F.CloudThickness - F.SpanTop - F.SpanBase;

    return CloudOpticalDepth
		/ max(MeanTop * F.SpanTop + MeanBase * F.SpanBase + Plateau, 1e-4f);
}

/** The column's weather, from one flow tap and one weather tap. */
struct TRColumn
{
	/** How much of the shape noise survives, [0, 1]. */
    float Coverage;

	/** 0 stratiform to 1 towering: depth and genus. */
    float Type;

	/** 0 fair-weather to 1 storm material, from the storm index: the larger of
	 *  the raw column cloud and the storm, thresholded by StormBalance. */
    float Material;

	/** Lows positive, bounded to (-1, 1). */
    float Pressure;

	/** Vertical motion, rising positive, (-1, 1). */
    float Ascent;

	/** How high the cloud formed, [0, 1], from the sim's formation altitude. */
    float Altitude;

	/** Structure channel weights, blended from the genera; and the cirrus share,
	 *  which also turns the detail fibrous. */
    float4 Genus;
    float Cirrus;

	/** How deeply the structure noise erodes the profile, and from about half
	 *  of it up, how much of a fully covered column it cuts clear. */
    float Erosion;

	/** The slab, atmosphere fractions. Exact: nothing outside moves them. */
    float Base;
    float Top;

	/** The sim's depth factor: 1 away from storm cells, falling across an eye.
	 *  Scales the depth and the density. */
    float Thinning;
};

/** What a column is built from: the sim read at one spun direction. Only the
 *  flow slice's pressure is used, so it is read raw rather than through
 *  a rotation out of the face basis. Weather is (W, cloud, altitude, storm);
 *  Depth the sim's depth factor, which thins storm cells' eyes. */
struct TRColumnInputs
{
    float Pressure;
    float4 Weather;
    float Depth;
};

TRColumnInputs TR_InputsFromSample(FlowColumnSample S)
{
    TRColumnInputs In;

    In.Pressure = S.Flow.z;
    In.Weather = S.Weather;
    In.Depth = saturate(S.NoiseB.w);

    return In;
}

TRColumnInputs TR_ReadColumn(Texture2DArray FlowField, SamplerState FlowSampler, float3 N, TRFieldParams F)
{
    return TR_InputsFromSample(Flow_SampleColumn(
		FlowField, FlowSampler, N, TR_FlowLayer(FlowField, F.CloudLayer), false));
}

/** The column's material, from its weather alone: fair-weather 0 to storm 1.
 *
 *  A STORM INDEX: the raw column cloud, which grades from a system's edge to
 *  its core, or the storm where larger, which puts storm cells at the top.
 *  StormBalance sweeps a threshold down through it, from none at 0 to all
 *  cloud at 1, and StormBlend is the ramp's half-width. Nothing that shapes
 *  the density reads it.
 *
 *  PITFALL: an index built from the cloud amount saturates wherever the deck is
 *  dense, so the threshold stops moving anything and only the density
 *  settings change the balance. Taken from Type, the tropics term paints
 *  every tropical cloud storm-coloured, fading uniformly with latitude. */
float TR_MaterialFromWeather(float4 Weather, TRFieldParams F)
{
    const float StormIndex = max(saturate(Weather.y), saturate(Weather.w));
    const float Blend = F.StormBlend;
    const float StormThreshold = lerp(1.0f + Blend, -Blend, F.StormBalance);

    return smoothstep(StormThreshold - Blend, StormThreshold + Blend, StormIndex);
}

/** The column at a spun direction N from its inputs.
 *
 *  COVERAGE IS A THRESHOLD ON PRIORITY. A column's priority is its cloud
 *  amount raised by its storm: amount * (1 + StormPriority * storm) /
 *  (1 + StormPriority). Hurricanes, which hold the densest cloud and full
 *  storm, rank highest, then storms, then plain cloud, which tops out at
 *  1 / (1 + StormPriority). CloudCover sweeps the threshold down through that
 *  ranking: at 0 nothing is covered, low values keep only hurricanes and large
 *  storms, and the rest comes in toward 1. Storm raises only cloud that
 *  exists, so clear sky stays clear at any setting, and a system keeps a
 *  defined edge. Inside it coverage reaches 1 and erosion breaks it up.
 *
 *  PITFALL: an additive CloudCover lifts every column by the same amount, so
 *  raising it to recover cloud flattens the sim's contrast until the noise,
 *  not the weather, decides where the gaps are.
 *
 *  TYPE IS HOW MUCH CLOUD THERE IS, plus the tropics and the sim's storm
 *  intensity: dense cloud builds towering, thin cloud stays layered, and storm
 *  deepens cloud in proportion. The MATERIAL, fair-weather to storm, follows a
 *  storm index of raw cloud and storm, set by StormBalance and StormBlend
 *  alone. A towering column is
 *  CloudThickness deep, a stratiform one StratusDepth of that; the pressure lid
 *  then scales both, so highs flatten into sheets and lows build. PITFALL: type
 *  from the local W draws the sim's vertical-motion waves, which travel through
 *  the cloud rather than with it, as bands of towering cloud sliding across
 *  the flow's own structure. Storm taken as a floor on type rather than a term
 *  turns every stormy column into a full tower of storm material, a deck
 *  erosion barely touches beside the cloud around it.
 *
 *  EROSION IS BREAKUP: the structure layer's, or none where the layer is not
 *  read.
 *
 *  THE BASE is the condensation level: tropicality and pressure, plus the
 *  altitude the cloud formed at for all but towering columns. A tower stays
 *  rooted; cloud that formed high in the sim's stack, or drifted off an
 *  updraught, turns stratiform at that altitude, so outflow becomes high
 *  layered cloud and cloud grown under weak lift stays low. No noise, which
 *  keeps the base exact.
 *
 *  DEPTH is the type's, StratusDepth to full, under the lid. Relief comes from
 *  type, coverage's depth ramp and the sim's depth factor. PITFALL: relief
 *  steepens the top wherever those do; if cloud goes missing on grazing rays,
 *  raise CloudSlope.
 *
 *  SPARSE COLUMNS ARE SHALLOW. Depth ramps in over TR_COVERAGE_DEPTH_RAMP of
 *  coverage, so clear sky has no slab for the entry search to stop on.
 *
 *  THE SIM'S DEPTH FACTOR SCALES THE REST, so a storm cell's eye is a bowl
 *  sloping from the eyewall to its floor, whatever the cloud amount does. */
TRColumn TR_ColumnFromInputs(TRColumnInputs In, float3 N, TRFieldParams F)
{
    TRColumn Col;

    const float4 Weather = In.Weather;

    const float Tropical = 1.0f - abs(N.z);

    const float Low = -In.Pressure / F.PressureScale;

    Col.Pressure = Low * rsqrt(1.0f + Low * Low);
    Col.Ascent = Weather.x;
    Col.Altitude = saturate(F.AltitudeGain * Weather.z);

    const float Amount = 1.0f - exp(-3.0f * max(Weather.y, 0.0f) / TR_CLOUD_FULL);
    const float Storm = saturate(Weather.w);

    const float Priority = Amount * (1.0f + F.StormPriority * Storm) / (1.0f + F.StormPriority);

	// From above the highest priority at CloudCover 0 to just above none at 1,
	// so both ends are exact: nothing, then every column holding cloud.
    const float Soft = F.CoverageSoftness;
    const float Threshold = lerp(1.0f + Soft, Soft, saturate(F.CloudCover));

    Col.Coverage = smoothstep(Threshold - Soft, Threshold + Soft, Priority);

    Col.Type = saturate(F.TypeBias + F.TypeTropical * Tropical
		+ F.TypeStorm * pow(Storm, F.TypeCurve));

    Col.Material = TR_MaterialFromWeather(Weather, F);

	// Layered cloud is stratus, cellular where the air sinks, and cirrus as it
	// rises; towering cloud is cumulus at any height.
    const float Breakup = saturate(-Weather.x * F.GenusSubsidence);

    const float4 Layered = lerp(
		lerp(F.GenusStratus, F.GenusStratocumulus, Breakup), F.GenusCirrus, Col.Altitude);

    Col.Genus = lerp(Layered, F.GenusCumulus, Col.Type);
    Col.Cirrus = Col.Altitude * (1.0f - Col.Type);

    Col.Erosion = F.StructureActive ? F.StructureErosion : 0.0f;

    const float D = F.CloudThickness;

    Col.Base = F.CloudBase + D * (F.BaseTropical * Tropical + F.BasePressure * Col.Pressure
		+ F.AltitudeLift * Col.Altitude * (1.0f - Col.Type));

    const float Lid = 1.0f + F.CeilingPressure * Col.Pressure;

    const float Depth = D * lerp(F.StratusDepth, 1.0f, Col.Type) * Lid
		* smoothstep(0.0f, TR_COVERAGE_DEPTH_RAMP, Col.Coverage)
		* In.Depth;

	// Capped at the shell, where the ceiling fade has already taken density to
	// zero.
    Col.Top = min(Col.Base + Depth, 1.0f);
    Col.Thinning = In.Depth;

    return Col;
}

TRColumn TR_Column(Texture2DArray FlowField, SamplerState FlowSampler, float3 N, TRFieldParams F)
{
    return TR_ColumnFromInputs(TR_ReadColumn(FlowField, FlowSampler, N, F), N, F);
}

/** The column's material coordinate at a planet-local position, spun, from
 *  the weather slice alone. For what varies over a system's width rather than
 *  a feature's: the tint of extinction a light ray crossed. */
float TR_TypeCoarse(Texture2DArray FlowField, SamplerState FlowSampler, float3 LocalPos, TRFieldParams F)
{
    const float3 N = normalize(Atmo_RotateZ(normalize(LocalPos), F.SpinAngle));

    return TR_MaterialFromWeather(
		Flow_SampleWeather(FlowField, FlowSampler, N, TR_FlowLayer(FlowField, F.CloudLayer)), F);
}

/** The field-wide reach, in atmosphere fractions: how far the BASE can move
 *  each way, and how deep a column can get above it. THE ONE DERIVATION read by
 *  both bounds below. Every term in TR_ColumnFromInputs has to appear here: an
 *  underestimate slices the tops off the features it belongs to. */
void TR_FieldReach(
	TRFieldParams F,
	out float BaseUp,
	out float BaseDown,
	out float Depth)
{
    const float D = F.CloudThickness;

    BaseUp = D * (max(F.BaseTropical, 0.0f) + abs(F.BasePressure) + max(F.AltitudeLift, 0.0f));
    BaseDown = D * (-min(F.BaseTropical, 0.0f) + abs(F.BasePressure) - min(F.AltitudeLift, 0.0f));

    Depth = D * (1.0f + abs(F.CeilingPressure));
}

/** The highest any column top can reach, an atmosphere fraction, clamped at the
 *  shell. Planet-wide, so the marched band does not narrow when the sky is
 *  quiet. */
float TR_TopMax(TRFieldParams F)
{
    float BaseUp, BaseDown, Depth;
    TR_FieldReach(F, BaseUp, BaseDown, Depth);

    return min(F.CloudBase + BaseUp + Depth, 1.0f);
}

/** The lowest any column base can fall: where the marched band ends. */
float TR_BaseMin(TRFieldParams F)
{
    float BaseUp, BaseDown, Depth;
    TR_FieldReach(F, BaseUp, BaseDown, Depth);

    return F.CloudBase - BaseDown;
}

/** The deep deck's height below which every column is at full density: the
 *  lowest base less the fill or the top ramp, whichever reaches further, since
 *  a clear column's top sits on its base and its ramp runs down from there.
 *  May lie below the planet radius: the core is deck like the rest. */
float TR_DeckFull(TRFieldParams F)
{
    return TR_BaseMin(F) - max(F.DeepFill, F.SpanTop);
}

/** Optical depths below the deep deck's full height at which a ray is opaque:
 *  past ATMO_OPAQUE_TRANSMITTANCE's 6.9 and the bake's last threshold, with a
 *  margin. Erring shallow blacks out deck that should still show, at a fixed
 *  radius. */
#ifndef TR_DEEP_OPAQUE_DEPTH
#define TR_DEEP_OPAQUE_DEPTH 8.0f
#endif

/** The deep deck's terminus: the radius TR_DEEP_OPAQUE_DEPTH optical depths
 *  below TR_DeckFull, given the least extinction per thickness the ray can
 *  meet. At or below zero there is none. */
float TR_DeepTerminusRadius(TRFieldParams F, float BetaMin)
{
    return F.PlanetRadius
		+ F.Thickness * (TR_DeckFull(F) - TR_DEEP_OPAQUE_DEPTH / max(BetaMin, 1e-6f));
}

/** The deep deck's fill at Height in a column: 0 at and above its base, 1 from
 *  DeepFill below it. */
float TR_DeepFill(float Height, TRColumn Col, TRFieldParams F)
{
    return smoothstep(0.0f, F.DeepFill, Col.Base - Height);
}

/** The fill integrated from Height up to the column's base, in thicknesses:
 *  how much full-density deck lies above a sample buried in it. Exact on the
 *  smoothstep, whose integral over [0, T] is T^3 - T^4 / 2. */
float TR_DeepBuried(float Height, TRColumn Col, TRFieldParams F)
{
    const float Depth = max(Col.Base - Height, 0.0f);
    const float T = saturate(Depth / F.DeepFill);

    return F.DeepFill * (T * T * T - 0.5f * T * T * T * T) + max(Depth - F.DeepFill, 0.0f);
}

/** Integral of saturate over [0, U]. */
float TR_DeepFloorRamp(float U)
{
    const float C = saturate(U);

    return 0.5f * C * C + max(U - 1.0f, 0.0f);
}

/** The deep deck's floor, as the step's mean density: full under a surface
 *  that rises FloorRelief fills above where the fill completes at the highest
 *  structure noise and sits there at the lowest, over a ramp
 *  TR_DEEP_FLOOR_SOFTNESS fills deep. Exact on the ramp, like the profile.
 *
 *  THE FLOOR ONLY ADDS DENSITY: the caller takes the larger of it and the
 *  cloud's. PITFALL: a floor that moves the fill instead changes the cloud
 *  above it, whose erosion and coverage the fill drives. */
float TR_DeepFloor(float Height, float HalfStep, TRColumn Col, float Noise, TRFieldParams F)
{
    const float Top = Col.Base - F.DeepFill * (1.0f - F.FloorRelief * Noise);
    const float Soft = F.DeepFill * TR_DEEP_FLOOR_SOFTNESS;

    if (HalfStep <= 1e-5f)
    {
        return saturate((Top - Height) / Soft);
    }

    return Soft * (TR_DeepFloorRamp((Top - Height + HalfStep) / Soft)
		- TR_DeepFloorRamp((Top - Height - HalfStep) / Soft)) / (2.0f * HalfStep);
}

/** Distance along a ray at which it first reaches a slab, from either side,
 *  or T1 when it reaches none before T1. The shadow bake's entry.
 *
 *  TWO SKIPS ARE GEOMETRY: radius is monotone either side of the closest
 *  approach, so a ray climbing clear of TopMax has nothing ahead, and one below
 *  the lowest base any column has (TR_BaseMin) and still descending has nothing
 *  before its perigee. The rest is a cone trace on CloudSlope. PITFALL: an
 *  under-declared slope steps over cloud, and the map shows shadow holes.
 *
 *  A CONE TRACE, AND NOT AN OPTIMIZATION: a grazing chord stepped at the
 *  field's own step size exhausts the iteration cap in empty space. LocalDir is
 *  normalized. */
float TR_SlabEntry(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	float3 LocalOrigin,
	float3 LocalDir,
	float T0,
	float T1,
	float TopMax,
	TRFieldParams F)
{

    const float BaseMin = TR_BaseMin(F);

    float TSearch = T0;

    LOOP

    for (int Iter = 0; Iter < TR_SLAB_ENTRY_PROBES; Iter++)
    {
        const float3 ProbePos = LocalOrigin + LocalDir * TSearch;
        const float ProbeRadius = length(ProbePos);
        const float ProbeHeight = (ProbeRadius - F.PlanetRadius) / F.Thickness;

        const float3 ProbeDir = ProbePos / max(ProbeRadius, 1e-4f);
        const float ProbeRate = dot(LocalDir, ProbeDir);

        const TRColumn Col = TR_Column(
			FlowField, FlowSampler, normalize(Atmo_RotateZ(ProbeDir, F.SpinAngle)), F);

#if TR_DEEP_DECK
		// Under a top is deck, and under a clear column's base the fill.
        if (ProbeHeight <= max(Col.Top, Col.Base))
#else
        if (ProbeHeight <= Col.Top && ProbeHeight >= Col.Base && Col.Top > Col.Base)
#endif
        {
            return TSearch;
        }

        const bool bAbove = ProbeHeight > Col.Base;

		// A clear column has no top to close on; its base stands in, which is a
		// lower surface than any cloud nearby and so never overshoots one.
        const float Gap = bAbove
			? ProbeHeight - max(Col.Top, Col.Base)
			: Col.Base - ProbeHeight;

        const float Approach = bAbove ? -ProbeRate : ProbeRate;

		// Climbing and clear of the highest the field can reach.
        if (bAbove && ProbeRate >= 0.0f && ProbeHeight > TopMax)
        {
            return T1;
        }

		// BELOW EVERY BASE AND STILL DESCENDING: nothing lies ahead until the
		// perigee, so resume there rather than give up, or a limb ray that skims
		// under the cloud and climbs back into it misses the cloud it shadows.
		//
		// PITFALL: BELOW THIS COLUMN'S BASE IS NOT ENOUGH. Neighbouring bases sit
		// lower where lift, pressure and latitude move them, and a jump from under
		// a high base skips the cloud beneath it.
		// PITFALL: THE RATE IS ZERO TO WITHIN NOISE AT THE PERIGEE ITSELF, and its
		// sign there is arbitrary. The epsilon keeps the branch to rays genuinely
		// still descending; a perigee that is not ahead means nothing to skip.
        if (!bAbove && ProbeRate < -1e-4f && ProbeHeight < BaseMin)
        {
            const float TPerigee = -dot(LocalOrigin, LocalDir);

            if (TPerigee >= T1)
            {
                return T1;
            }

            if (TPerigee > TSearch)
            {
                TSearch = TPerigee;
                continue;
            }
        }

		// The surface moves to meet the ray, so the closing rate is the ray's
		// own approach plus the surface's slope across the ground it covers. A
		// ray moving away counts as still: the surface can outrun it, so its
		// recession earns no longer step.
		// PITFALL: CloudSlope has to bound the steeper surface, which at a
		// coverage edge is the top collapsing onto the base.
        const float Horizontal = sqrt(max(1.0f - ProbeRate * ProbeRate, 0.0f));

        const float ClosingRate = max(Approach, 0.0f)
			+ Horizontal * max(F.CloudSlope, 0.1f) * F.CloudThickness * F.Thickness
				/ max(ProbeRadius, 1e-4f);

        const float Advance = Gap * F.Thickness / max(ClosingRate, 1e-5f);

        TSearch += max(Advance * TR_CONE_RELAXATION, 1e-4f);

        if (TSearch >= T1)
        {
            return T1;
        }
    }

    return TSearch;
}

/** A layer's frequency at Rise, an atmosphere fraction: noise units per radian
 *  across the shell, which the sample's direction is scaled by. Vertical is
 *  Scale * Aspect * HeightScale. See TR_NOISE_EXP_FREQUENCY. */
float TR_NoiseFrequency(float Scale, float Vertical, float Rise)
{
#if TR_NOISE_EXP_FREQUENCY
    return Scale * exp(Vertical / max(Scale, 1e-4f) * Rise);
#else
    return Scale + Rise * Vertical;
#endif
}

/** The mip a layer reads at: the texels one march pixel spans, as a power of
 *  two, plus the layer's bias. UVWScale is noise units per radian, and a noise
 *  unit is the volume's width in texels.
 *
 *  PREFILTERED, NOT UNDERSAMPLED. Past a few radii every octave above the pixel
 *  folds down into shimmer as the camera moves; the mip averages it away and
 *  keeps the octaves the pixel can show. The channels are fBm, so the octaves
 *  removed first carry little of the variance and the coverage holds.
 *
 *  PITFALL: the average is taken before erosion and coverage cut the noise,
 *  and filtered noise has less contrast, so cloud can thin with distance --
 *  most at low cover and where erosion extrapolates past 1. It shows only once
 *  the mip reaches a volume's base octaves; lower the bias if it does. */
float TR_NoiseLod(Texture3D Volume, float UVWScale, float MipBias, TRFieldParams F)
{
    uint Width, Height, Depth, Levels;
    Volume.GetDimensions(0, Width, Height, Depth, Levels);

    const float Texels = F.PixelFootprint * UVWScale * (float) Width;

    return max(log2(max(Texels, 1e-6f)) + MipBias, 0.0f);
}

/** One noise layer's four channels, in true 3D so the vertical structure the
 *  bake put in the volume survives, at mip Lod.
 *
 *  THROUGH BOTH NOISE PHASES, crossfaded. Each is N plus Inherit times its
 *  displacement, turned about the axis by the drift, backwards so the noise
 *  moves forwards. Each phase resets where its weight is zero. */
float4 TR_SampleLayer(
	Texture3D Volume,
	SamplerState Sampler,
	float3 N,
	float3 DisplacementA,
	float3 DisplacementB,
	float Inherit,
	float UVWScale,
	float Lod,
	TRFieldParams F)
{
    const float3 PA = Atmo_RotateZ(normalize(N + DisplacementA * Inherit), -F.DriftAngle);
    const float3 PB = Atmo_RotateZ(normalize(N + DisplacementB * Inherit), -F.DriftAngle);

    return lerp(
		Volume.SampleLevel(Sampler, PB * UVWScale, Lod),
		Volume.SampleLevel(Sampler, PA * UVWScale, Lod),
		Flow_NoiseWeightA(F.NoisePhase));
}

/** The shared layout as the structure layer reads it: every channel high where
 *  there is cloud. */
float4 TR_StructureChannels(float4 S)
{
    return float4(S.r, 1.0f - S.g, S.b, S.a);
}

/** The shared layout as the detail layer reads it: every channel high where
 *  the edge is eaten away. x wispy, y billow, z fibrous; w unused. */
float4 TR_DetailChannels(float4 S)
{
    return float4(S.r, S.g, 1.0f - S.a, 0.0f);
}

/** Weighted blend of equalized channels, in [0, 1] about 0.5. Divided by the
 *  weights' length rather than their sum, which keeps the contrast of
 *  independent channels: a plain average of two pulls toward the middle and
 *  softens every blend. */
float TR_BlendNoise(float4 Channels, float4 Weights)
{
    return saturate(0.5f + dot(Channels - 0.5f, Weights) / max(length(Weights), 1e-3f));
}

/** Whether a step misses its column's slab: density is exactly zero there.
 *  The test uses the step's near edge on each side. The deep deck is missed
 *  only above. */
bool TR_SlabMissed(TRColumn Col, float Height, float HalfStep)
{
#if TR_DEEP_DECK
    return Height - HalfStep >= max(Col.Top, Col.Base);
#else
    return Col.Top <= Col.Base || Height + HalfStep <= Col.Base || Height - HalfStep >= Col.Top;
#endif
}

/** Density inside a column's slab, given the column and its noise
 *  displacements. N is the spun direction, Height the atmosphere fraction and
 *  HalfStep the step's half-extent along the radius; the caller has already
 *  tested TR_SlabMissed.
 *
 *  THE PROFILE IS INTEGRATED ACROSS THE STEP, not sampled at its midpoint: one
 *  midpoint sample makes the slab a near-binary decision per step, and as a
 *  surface drifts against the lattice that decision flips along a line on
 *  screen.
 *
 *  Returns:
 *    x  Density in [0, 1]. Multiply by an extinction coefficient in the march.
 *    y  Material coordinate, [0, 1]: fair-weather to storm.
 *    z  Pressure, lows positive.
 *    w  The column's top. */
float4 TR_DensityInColumn(
	Texture3D DetailVolume,
	SamplerState DetailSampler,
	Texture3D StructureVolume,
	SamplerState StructureSampler,
	float3 N,
	float Height,
	float HalfStep,
	TRColumn Col,
	float3 DisplacementA,
	float3 DisplacementB,
	TRFieldParams F)
{
#if TR_DEEP_DECK
	// BELOW THE BASE THE DECK FILLS IN: coverage to full, erosion, detail and
	// the eye's thinning away, so the deck is uniform at full density from the
	// fill's depth down. Taken at the sample, like the ceiling fade: it varies
	// over the fill, not over a step.
    const float Fill = TR_DeepFill(Height, Col, F);

    Col.Coverage = lerp(Col.Coverage, 1.0f, Fill);
    Col.Erosion *= 1.0f - Fill;
    Col.Thinning = lerp(Col.Thinning, 1.0f, Fill);
#else
    const float Fill = 0.0f;
#endif

	// -- Height profile, integrated across the step ----------------------------
	//
	// EXACTLY, from the profile's closed form, after coverage and erosion (see
	// below); the ceiling fade, which varies slowly, by Simpson's rule.
	// PITFALL: SAMPLED, a slab thinner than the step falls between the samples,
	// and thin columns flicker as their surfaces drift across them.

    const float Fade = (TR_CeilingFade(Height - HalfStep, F) + 4.0f * TR_CeilingFade(Height, F)
		+ TR_CeilingFade(Height + HalfStep, F)) / 6.0f;

    const float2 Ramps = TR_SlabRamps(Col.Top, Col.Base, F);

	// The profile's peak within the step, the plateau clamped into the span,
	// which gates the noise fetches.
#if TR_DEEP_DECK
    const float PeakHeight = clamp(min(Height, Col.Top - Ramps.x), Height - HalfStep, Height + HalfStep);
#else
    const float PeakHeight = clamp(clamp(Height, Col.Base + Ramps.y, Col.Top - Ramps.x),
		Height - HalfStep, Height + HalfStep);
#endif

    const float PeakSlab = TR_SlabDensity(PeakHeight, Col.Top, Col.Base, F);
    const float Profile = PeakSlab * Fade;

    const float HeightFraction = saturate((Height - Col.Base) / max(Col.Top - Col.Base, 1e-4f));

	// -- Vertical warp: rising air stretches and lifts the noise ---------------
	//
	// STRETCH divides the vertical frequency, so rising air draws a feature out
	// taller, and so does depth past a stratiform column's, so a column of any
	// depth spans as many noise features as a stratiform one; SHIFT reads the
	// volume from a different altitude. Both touch only the noise, so they cost
	// the bounds nothing. PITFALL: without the depth stretch a tower stacks
	// several independent features, a view ray down it almost always meets one,
	// and it reads solid at any erosion while thin cloud breaks up.

	// Against a stratiform depth floored at a tenth of the thickness, so a
	// StratusDepth near zero cannot stretch a tower's noise flat.
    const float StretchRatio = (Col.Top - Col.Base)
		/ (F.CloudThickness * max(F.StratusDepth, TR_STRETCH_MIN_STRATUS));

	// max(StretchRatio, 1) as a p-norm, p = 4. PITFALL: a hard maximum's slope
	// break re-scales the noise abruptly where depth crosses StratusDepth.
    const float DepthFit = sqrt(sqrt(1.0f + StretchRatio * StretchRatio * StretchRatio * StretchRatio));

    const float Stretch = max(1.0f + F.WarpStretch * Col.Ascent, 0.1f) * DepthFit;
    const float Shift = F.WarpShift * F.CloudThickness * Col.Ascent;

	// ANCHORED AT THE COLUMN'S BASE: the stretch scales height from there, so a
	// change in depth leaves the base's phase alone. PITFALL: anchored at the
	// ground, every sample re-phases by its height above it, and the noise swims
	// as columns deepen and shears into rings across an eye wall.
    const float Rise = Col.Base + (Height - Col.Base - Shift) / Stretch;

	// -- Shape: the noise coverage erodes --------------------------------------

    float Shape = Profile;

#if TR_DEEP_DECK
	// The floor reads the same noise; 0 where it is unread leaves the floor at
	// the fill's completion, where the deck is already full.
    float StructureNoise = 0.0f;
#endif

    BRANCH

    if (F.StructureActive && Fill < 1.0f)
    {
        const float UVWScale = TR_NoiseFrequency(F.StructureScale, F.StructureVertical, Rise);

        const float Noise = TR_BlendNoise(TR_StructureChannels(TR_SampleLayer(
			StructureVolume, StructureSampler, N,
			DisplacementA, DisplacementB, F.StructureFlowInherit, UVWScale,
			TR_NoiseLod(StructureVolume, UVWScale, F.StructureMipBias, F), F)),
			Col.Genus);

#if TR_DEEP_DECK
        StructureNoise = Noise;
#endif

		// Extrapolated past 1, the factor goes negative wherever the noise sits
		// below 1 - 1/Erosion, and those holes survive any coverage.
        Shape *= saturate(1.0f + Col.Erosion * (Noise - 1.0f));
    }

	// A THRESHOLD ON THE SHAPE, then coverage as a scale. Erosion sets the
	// threshold everywhere, so a thick system breaks up as much as a thin one;
	// CoverageFray raises it as coverage falls, so edges fray into scattered
	// cores rather than fading. PITFALL: a threshold driven by coverage alone
	// never cuts a fully covered column and wipes out partly covered ones, and
	// since thick cloud stays opaque at a fraction of its density, erosion then
	// reads as erasing thin cloud and leaving thick cloud untouched.
    const float Coverage = Col.Coverage;
    const float Cut = TR_EROSION_CUT * saturate(Col.Erosion);
    const float Threshold = Cut + (1.0f - Cut) * (1.0f - Coverage) * F.CoverageFray;

    float Density = saturate((Shape - Threshold) / max(1.0f - Threshold, 1e-3f)) * Coverage;

	// Density and erosion at the step's peak profile, which gate the detail
	// fetch; the step's mean replaces them below.
    float DetailErode = 0.0f;

	// -- Detail: erosion of the edges ------------------------------------------

    BRANCH

    if (F.DetailActive && Density > 0.0f && Fill < 1.0f)
    {
		// Faded toward the mean rather than off: see the header. Past the far
		// edge, or once the mip has averaged the detail away, the fetch is
		// skipped.
        const float UVWScale = TR_NoiseFrequency(F.DetailScale, F.DetailVertical, Rise);
        const float Lod = TR_NoiseLod(DetailVolume, UVWScale, F.DetailMipBias, F);

        uint Width, VolumeHeight, Depth, Levels;
        DetailVolume.GetDimensions(0, Width, VolumeHeight, Depth, Levels);

		// Floored at one mip, so a volume with few or no mips fades by footprint
		// rather than reading its mean everywhere.
        const float Strength = F.DetailFade
			* saturate(max(float(Levels) - 1.0f - float(TR_DETAIL_MEAN_MIPS), 1.0f) - Lod);

        float Modifier = F.DetailFadeMean;

        BRANCH

        if (Strength > 0.0f)
        {
			// Wispy at the base, billowy toward the top, fibrous in cirrus.
            const float Billow = saturate(HeightFraction / TR_BILLOW_HEIGHT);

            const float4 Weights =
				float4(1.0f - Billow, Billow, 0.0f, 0.0f) * (1.0f - Col.Cirrus)
				+ float4(0.0f, 0.0f, Col.Cirrus, 0.0f);

            Modifier = lerp(F.DetailFadeMean, TR_BlendNoise(TR_DetailChannels(TR_SampleLayer(
				DetailVolume, DetailSampler, N,
				DisplacementA, DisplacementB, F.DetailFlowInherit, UVWScale, Lod, F)),
				Weights), Strength);
        }

        DetailErode = Modifier * F.DetailErosion * TR_DETAIL_EROSION_SCALE * (1.0f - Fill);
    }

	// THE MEAN OF THE DENSITY, NOT THE DENSITY OF THE MEAN. Density is zero
	// below a profile level P0 and linear above it, so its mean over the step
	// is Gain times the profile's mean excess over P0. PITFALL: coverage and
	// erosion applied to the step-averaged profile cut away any step that
	// spans more height than the slab, so cloud clears as steps lengthen:
	// grazing views see through the deck the camera finds opaque from inside,
	// and density slides with the step lattice.
    if (Density > 0.0f)
    {
		// Shape is the profile times ShapeScale; density starts where Shape
		// clears the threshold plus what detail erodes, in coverage units.
        const float ShapeScale = Shape / max(PeakSlab, 1e-6f);
        const float ShapeRange = max(1.0f - Threshold, 1e-3f);
        const float Level = Threshold + ShapeRange * DetailErode / max(Coverage, 1e-6f);
        const float P0 = min(Level / max(ShapeScale, 1e-6f), 1.0f);

        const float Gain = ShapeScale * Coverage / (ShapeRange * max(1.0f - DetailErode, 1e-3f));

		// The deep deck integrates from the step's own bottom.
        const float Lower = TR_DEEP_DECK ? Height - HalfStep : Col.Base;

        const float Excess = (HalfStep > 1e-5f)
			? (TR_SlabExcessCumulative(Height + HalfStep, Col.Top, Lower, Ramps, P0, F)
				- TR_SlabExcessCumulative(Height - HalfStep, Col.Top, Lower, Ramps, P0, F)) / (2.0f * HalfStep)
			: max(TR_SlabDensity(Height, Col.Top, Col.Base, F) - P0, 0.0f);

        Density = (P0 < 1.0f) ? saturate(Gain * Excess) : 0.0f;
    }

	// THINNED IS FAINT: the eye's floor fades as it thins rather than holding
	// its peak density. After erosion and coverage, as a plain scale, so the
	// eyewall keeps its shape. PITFALL: A SLAB KEEPS ITS PEAK HOWEVER THIN, so
	// at a high CloudOpticalDepth a thinned floor left at full density holds
	// as an opaque sheet; scaled before erosion, the threshold cuts it away
	// abruptly instead.
    Density *= pow(saturate(Col.Thinning), TR_EYE_OPEN_POWER);

#if TR_DEEP_DECK
    Density = max(Density, TR_DeepFloor(Height, HalfStep, Col, StructureNoise, F));

    return float4(Density, Col.Material, TR_DeepBuried(Height, Col, F), Col.Top);
#else
    return float4(Density, Col.Material, Col.Pressure, Col.Top);
#endif
}

/** Density and material at a planet-local point, as (density, material,
 *  pressure, top), the column read where the sample stands; the deep deck
 *  returns TR_DeepBuried in place of pressure. HalfStep is the sample's own
 *  half-extent along the radius.
 *
 *  PITFALL: COLUMN KEYFRAMES ON A PER-RAY LATTICE DRAW THE LATTICE. Read at
 *  keyframes along each ray and interpolated between, the blending error
 *  follows the angle from the ray's closest approach to the sample, set by the
 *  ray's distance from the planet centre: lines concentric with the planet's
 *  disc, sliding as the camera moves, and a pinwheel at the nadir. Linear
 *  blending also creases at every keyframe, which the thresholds turn into
 *  rings through thin cloud. */
float4 TR_Density(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	Texture3D DetailVolume,
	SamplerState DetailSampler,
	Texture3D StructureVolume,
	SamplerState StructureSampler,
	float3 LocalPos,
	float StepHalfLength,
	TRFieldParams F)
{
    const float Radius = length(LocalPos);
    const float Height = (Radius - F.PlanetRadius) / F.Thickness;
    const float HalfStep = max(StepHalfLength, 0.0f);

    const float3 N = normalize(Atmo_RotateZ(LocalPos / max(Radius, 1e-4f), F.SpinAngle));

    const FlowColumnSample S = Flow_SampleColumn(
		FlowField, FlowSampler, N, TR_FlowLayer(FlowField, F.CloudLayer), true);

    const TRColumn Col = TR_ColumnFromInputs(TR_InputsFromSample(S), N, F);

    BRANCH

    if (TR_SlabMissed(Col, Height, HalfStep))
    {
        return float4(0.0f, Col.Material, TR_DEEP_DECK ? 0.0f : Col.Pressure, Col.Top);
    }

    return TR_DensityInColumn(
		DetailVolume, DetailSampler, StructureVolume, StructureSampler,
		N, Height, HalfStep, Col, S.NoiseA.xyz, S.NoiseB.xyz, F);
}
