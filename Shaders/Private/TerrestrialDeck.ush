#pragma once

#include "/Plugin/CloudAtmosphere/Private/AtmosphereTypes.ush"
#include "/Plugin/CloudAtmosphere/Private/AtmosphereNoise.ush"
#include "/Plugin/CloudAtmosphere/Private/FlowField.ush"

// Terrestrial cloud band: the field the march samples.
//
// A SLAB BETWEEN TWO SURFACES. Every column has a top and a base, both set by
// the simulated flow and moved by two noise volumes; density ramps up from the
// base, ramps down to the top and sits at 1 between them. OUTSIDE THE SLAB
// THERE IS NOTHING -- above the top and below the base density is exactly zero,
// which is what lets a ray pass under the cloud and a camera stand beneath it.
//
// THE BASE FOLLOWS THE TOP, SCALED. Both surfaces read the same two shape
// values, the base at BaseRelief of the top's displacement, so a base costs no
// extra fetch and a tall column is a thick one. The two are decorrelated only by
// BaseStormDrop, which sinks the base under a vortex while the tower lifts the
// top. A base with structure of its own would need a third noise layer.
//
// COVERAGE IS 100%: every feature is relief in a surface rather than opacity
// variation, and Band drives ALTITUDE. Band itself reaches the march untouched,
// to be spent on extinction and scattering colour.
//
// HOW THE FLOW IS READ IS NOT HERE. FlowField.ush owns the sample and what its
// channels mean; this file owns what the field makes of them.
//
// UNITS. TWO ABSOLUTES, both atmosphere fractions: CloudBase and
// CloudThickness. EVERYTHING ELSE IS A FRACTION OF ONE OF THEM -- the two
// softnesses are shares of the thickness, every relief amount and BaseStormDrop
// are multiples of it, BaseRelief is a share of the band's own displacement, and
// ErosionDepth is a share of depth into the column. Thickness is the only
// world-space length. Space is planet-local, spin axis on Z, positions unit
// directions except in TR_Density.

/** Warp loop length. Each iteration past the first costs a flow fetch. */
#ifndef TR_WARP_ITERATIONS
#define TR_WARP_ITERATIONS 4
#endif

/** Which sim slice the deck reads. The coarse warp and the band signal come
 *  from TR_FLOW_LAYER, the fine shear from TR_DEEP_FLOW_LAYER, and the two being
 *  different is what produces vertical wind shear rather than one sheet dragged
 *  around.
 *
 *  Pitfall: both must be under GasGiantSimConfig::LayerCount. A slice past the
 *  end reads clamped rather than failing, so the shear quietly vanishes. */
#ifndef TR_FLOW_LAYER
#define TR_FLOW_LAYER 0
#endif

#ifndef TR_DEEP_FLOW_LAYER
#define TR_DEEP_FLOW_LAYER 1
#endif

/** How far a crossfade phase runs its advection ramp, as a multiple of the
 *  authored warp displacement. 2 so the mean over a cycle is the authored
 *  amount: each phase ramps from nothing to this and resets. At 1 the deck would
 *  read as half as advected with the crossfade on as with it off, so enabling
 *  the feature would change the look rather than only the motion. */
#ifndef TR_CROSSFADE_SPAN
#define TR_CROSSFADE_SPAN 2.0f
#endif

/** Whether the detail layer moves the deck top symmetrically about the noise
 *  median, as the structure layer does, or only downward. One-sided moves the
 *  mean deck with the fade, since the carve is scaled by DetailFade: the surface
 *  sinks on approach while thin features dissolve into it. Either amount may
 *  still be negative, mirroring the layer. TR_CarveReach follows this switch,
 *  and every bound goes through it. */
#ifndef TR_DETAIL_RELIEF_CENTRED
#define TR_DETAIL_RELIEF_CENTRED 1
#endif

/** Fraction of the cone-trace advance actually taken. Under 1 because CloudSlope
 *  is authored, and an under-declared slope is the one way the entry search
 *  steps over a surface. */
#ifndef TR_CONE_RELAXATION
#define TR_CONE_RELAXATION 0.9f
#endif

/** Cone-trace iteration cap. Reached only on rays that graze for their whole
 *  length, which return T1 and are treated as missing the slab. A ray climbing
 *  toward the base from below grazes over a longer run than one descending onto
 *  the top, so this binds there first. */
#ifndef TR_SLAB_ENTRY_PROBES
#define TR_SLAB_ENTRY_PROBES 24
#endif

/** Everything the field, density and deck-top functions read.
 *
 *  NAMES MATCH THE STACK: every authored member carries the name of its C++
 *  property, material parameter and Custom node pin, layer members taking their
 *  layer's prefix. Derived members are named for what they are, never reusing an
 *  authored name. The two fades are set per sample by the march. */
struct TRFieldParams
{
	// -- Authored ------------------------------------------------------------

    float PlanetRadius;

	/** Where an unrelieved column's underside sits, an atmosphere fraction. */
    float CloudBase;

	/** How deep an unrelieved column is, an atmosphere fraction, and the unit
	 *  every relief amount is a multiple of. Floored against division. */
    float CloudThickness;

	/** Width of the band below the shell top across which density fades to
	 *  zero, an atmosphere fraction. Floored above zero. */
    float CeilingFalloff;

	/** Shape of each ramp. Above 1 flattens the surface and hardens it; below
	 *  0.5 the onset loses its C1 join. */
    float TopCurve;
    float BottomCurve;

	/** How much of the band's displacement the base takes, signed: 0 holds the
	 *  base flat while the top moves and the depth carries the relief, 1
	 *  translates the band rigidly, negative opens it where the top rises. */
    float BaseRelief;

	/** How far a vortex sinks the base, a multiple of CloudThickness, on the
	 *  same gate that lifts a storm tower. The one term that moves the base
	 *  without moving the top. */
    float BaseStormDrop;

	/** What FlowField.ush's interpreters read: the hemisphere width and the
	 *  band's offset and gain. Held as the shared struct rather than as loose
	 *  members, so a second field feeding those functions cannot describe the
	 *  same four values differently, and a derived half-width has one home. */
    FlowReadParams FlowRead;

    float BandRelief;
    float PressureRelief;
    float VortexThreshold;
    float StormTowerRelief;
    float ReliefThinning;

    float WarpTime;
    float TurbulenceFloor;

    float EdgeBias;
    float ErosionDepth;

	/** Worley rung weights in xyz, the layer's amount in w. */
    float4 StructureNoiseWeights;
    float StructureScale;
    float StructureRelief;
    float StructureErosion;
    float StructureFlowInherit;
    float StructureShearInherit;
    float StructureFadeNear;
    float StructureBandMix;
    float StructureCrossfade;

    float4 DetailNoiseWeights;
    float DetailScale;
    float DetailRelief;
    float DetailErosion;
    float DetailFlowInherit;
    float DetailShearInherit;
    float DetailFadeNear;
    float DetailBandMix;
    float DetailCrossfade;

	/** Bound on either surface's slope, cloud depths per radian. Read only by
	 *  the entry search's cone angle. */
    float CloudSlope;

	// -- Derived -------------------------------------------------------------

	/** Atmosphere thickness in world units: the one absolute length here. */
    float Thickness;

	/** The two ramp depths, atmosphere fractions, ALREADY FITTED TO THE BAND.
	 *  The softnesses are shares of CloudThickness and are scaled down together
	 *  if they sum past one, so the ramps cannot overlap: peak density reaches
	 *  exactly 1 and TR_CloudBeta is exact at any pair of curves. */
    float SpanTop;
    float SpanBase;

	/** The deep flow layer's step length: WarpTime * DeepShearRatio. */
    float DeepShearTime;

	/** HemisphereBlend as a half-width in sin(latitude). The blend reaches about
	 *  three quarters of full strength at that distance from the equator. */

    float SpinAngle;

	/** Elapsed time in crossfade periods. Only its fraction is read, so the two
	 *  phases sit half a period apart whatever the whole part is. */
    float CrossfadeTime;

	/** Noise units the shell spans vertically, per layer: Scale * Aspect *
	 *  HeightScale, which is what makes the aspect a ratio -- heights are
	 *  fractions of shell thickness while the horizontal scale is against planet
	 *  radius. */
    float StructureVertical;
    float DetailVertical;

	/** FadeNear + FadeSpan, held above FadeNear. */
    float StructureFadeFar;
    float DetailFadeFar;

	// -- Per sample ----------------------------------------------------------

	/** Per-layer level of detail, 1 at full strength and 0 faded out. Each
	 *  scales its layer's carve and erosion and gates the fetches feeding it. */
    float StructureFade;
    float DetailFade;
};

/** Fills TRFieldParams from the authored values, in panel order, and derives the
 *  rest. The bake calls it with the same values, so every derivation here is
 *  shared by the deck the eye sees and the deck the light sees. RotationWeight
 *  is the planet's own rotation; the sim runs in the rotating frame, so it
 *  applies to the sampling position rather than the flow, negated because
 *  rotating the sample point backwards carries the field forwards. */
TRFieldParams TR_BuildField(
	float PlanetRadius,
	float HeightScale,
	float Time,
	float CloudBase,
	float CloudThickness,
	float CeilingFalloff,
	float TopSoftness,
	float BottomSoftness,
	float TopCurve,
	float BottomCurve,
	float BaseRelief,
	float BaseStormDrop,
	float BandSharpness,
	float BandBias,
	float HemisphereBlend,
	float HemisphereVariance,
	float BandRelief,
	float PressureRelief,
	float VortexThreshold,
	float StormTowerRelief,
	float ReliefThinning,
	float RotationWeight,
	float WarpTime,
	float DeepShearRatio,
	float TurbulenceFloor,
	float CrossfadePeriod,
	float EdgeBias,
	float ErosionDepth,
	float4 StructureNoiseWeights,
	float StructureScale,
	float StructureAspect,
	float StructureRelief,
	float StructureErosion,
	float StructureFlowInherit,
	float StructureShearInherit,
	float StructureFadeNear,
	float StructureFadeSpan,
	float StructureBandMix,
	float StructureCrossfade,
	float4 DetailNoiseWeights,
	float DetailScale,
	float DetailAspect,
	float DetailRelief,
	float DetailErosion,
	float DetailFlowInherit,
	float DetailShearInherit,
	float DetailFadeNear,
	float DetailFadeSpan,
	float DetailBandMix,
	float DetailCrossfade,
	float CloudSlope)
{
    TRFieldParams F;

    F.PlanetRadius = PlanetRadius;

    F.CloudBase = CloudBase;
    F.CloudThickness = max(CloudThickness, 1e-4f);

    F.TopCurve = TopCurve;
    F.BottomCurve = BottomCurve;
    F.BaseRelief = BaseRelief;
    F.BaseStormDrop = BaseStormDrop;

    F.FlowRead.BandSharpness = BandSharpness;
    F.FlowRead.BandBias = BandBias;
    F.BandRelief = BandRelief;
    F.PressureRelief = PressureRelief;
    F.VortexThreshold = VortexThreshold;
    F.StormTowerRelief = StormTowerRelief;
    F.ReliefThinning = ReliefThinning;

    F.WarpTime = WarpTime;
    F.TurbulenceFloor = TurbulenceFloor;

    F.EdgeBias = EdgeBias;
    F.ErosionDepth = ErosionDepth;

    F.StructureNoiseWeights = StructureNoiseWeights;
    F.StructureScale = StructureScale;
    F.StructureRelief = StructureRelief;
    F.StructureErosion = StructureErosion;
    F.StructureFlowInherit = StructureFlowInherit;
    F.StructureShearInherit = StructureShearInherit;
    F.StructureFadeNear = StructureFadeNear;
    F.StructureBandMix = StructureBandMix;
    F.StructureCrossfade = StructureCrossfade;

    F.DetailNoiseWeights = DetailNoiseWeights;
    F.DetailScale = DetailScale;
    F.DetailRelief = DetailRelief;
    F.DetailErosion = DetailErosion;
    F.DetailFlowInherit = DetailFlowInherit;
    F.DetailShearInherit = DetailShearInherit;
    F.DetailFadeNear = DetailFadeNear;
    F.DetailBandMix = DetailBandMix;
    F.DetailCrossfade = DetailCrossfade;

    F.CloudSlope = CloudSlope;

    F.Thickness = max(PlanetRadius * HeightScale, 1e-4f);

    F.CeilingFalloff = max(CeilingFalloff, 1e-3f);

	// FITTED, NOT FLOORED. The two shares are scaled down together when they ask
	// for more than the band has, which keeps their RATIO -- clamping each on
	// its own would quietly turn a soft top and a sharp base into two
	// half-bands. Floored above zero only against the divisions below; a share
	// of zero is a hard surface, which is a legitimate look.
    const float SoftTop = max(TopSoftness, 0.0f);
    const float SoftBase = max(BottomSoftness, 0.0f);
    const float SoftSum = SoftTop + SoftBase;
    const float SoftFit = (SoftSum > 1.0f) ? 1.0f / SoftSum : 1.0f;

    F.SpanTop = max(SoftTop * SoftFit, 1e-4f) * F.CloudThickness;
    F.SpanBase = max(SoftBase * SoftFit, 1e-4f) * F.CloudThickness;

    F.DeepShearTime = WarpTime * DeepShearRatio;
    F.SpinAngle = -RotationWeight * Time;

	// Floored against a zero width, which would make Flow_Hemisphere a sign()
	// and seam along the equator.
    F.FlowRead.HemisphereHalfWidth = max(sin(radians(HemisphereBlend)), 1e-4f);
    F.FlowRead.HemisphereVariance = max(HemisphereVariance, 0.0f);

	// Time and period are both simulated seconds: Time is the sim's clock, which
	// already runs TimeScale times faster than real time, so the crossfade keeps
	// pace with the flow at any sim speed. PITFALL: scaling the period by
	// TimeScale too counts the speed twice. Floored so a zero period is a stopped
	// clock rather than a divide.
    F.CrossfadeTime = Time / max(CrossfadePeriod, 1e-3f);

    F.StructureVertical = StructureScale * StructureAspect * HeightScale;
    F.DetailVertical = DetailScale * DetailAspect * HeightScale;

	// Each far edge held above its own near one: equal endpoints make smoothstep
	// a step, and a step here is a ring across the disc at a fixed distance.
    F.StructureFadeFar = StructureFadeNear + max(StructureFadeSpan, 1e-4f);
    F.DetailFadeFar = DetailFadeNear + max(DetailFadeSpan, 1e-4f);

    F.StructureFade = 1.0f;
    F.DetailFade = 1.0f;

    return F;
}

/** The call both consumers make, expanded from one definition beside the
 *  signature it has to match.
 *
 *  PITFALL: 51 POSITIONAL FLOAT ARGUMENTS. A parameter inserted above but missed
 *  at a call site still compiles, silently shifting every argument after it --
 *  VortexThreshold arriving as StormTowerRelief and so on, with nothing to catch
 *  it. Expanding from here makes that impossible: every name resolves in the
 *  caller's own scope, so a missing material pin or bake uniform is an
 *  undeclared identifier naming the symbol.
 *
 *  Requires a variable of each name in scope. The material Custom node's pins
 *  and GasGiantShadowMap.usf's uniforms both carry exactly these names, which is
 *  what lets one expansion serve both. */
#define TR_BUILD_FIELD() TR_BuildField( \
	PlanetRadius, HeightScale, Time, \
	CloudBase, CloudThickness, CeilingFalloff, TopSoftness, \
	BottomSoftness, TopCurve, BottomCurve, BaseRelief, BaseStormDrop, \
	BandSharpness, BandBias, HemisphereBlend, HemisphereVariance, \
	BandRelief, PressureRelief, VortexThreshold, StormTowerRelief, \
	ReliefThinning, RotationWeight, WarpTime, DeepShearRatio, \
	TurbulenceFloor, CrossfadePeriod, EdgeBias, ErosionDepth, \
	StructureNoiseWeights, StructureScale, StructureAspect, StructureRelief, \
	StructureErosion, StructureFlowInherit, StructureShearInherit, StructureFadeNear, \
	StructureFadeSpan, StructureBandMix, StructureCrossfade, DetailNoiseWeights, \
	DetailScale, DetailAspect, DetailRelief, DetailErosion, \
	DetailFlowInherit, DetailShearInherit, DetailFadeNear, DetailFadeSpan, \
	DetailBandMix, DetailCrossfade, CloudSlope)

/** What TR_Field returns. Two shapes rather than one, because the layers carve
 *  and erode by different amounts and fade on different schedules. Each is 1
 *  where its layer contributes nothing.
 *
 *  BandShift is the shapes' signed offset to Band, 0 where neither layer
 *  contributes. TR_Density applies it, weighted by depth into the gradient. */
struct TRFieldSample
{
    float Top;
    float Base;
    float Pressure;
    float Band;
    float BandShift;
    float ShapeDetail;
    float ShapeStructure;
};








/** The shell's ceiling: 1 below the falloff band, 0 at the atmosphere top,
 *  smoothstep between. Multiplies every density the deck returns, so a tower
 *  that would cross it softens into a flattened cap instead of being cut and the
 *  deck never has to sit lower to clear its tallest outlier. Smoothstep, not
 *  linear: a slope break at the band's lower edge draws a line at one altitude
 *  across every tower reaching it.
 *
 *  PITFALL: the band's top belongs below it. A typical top inside the falloff
 *  thins the whole column, and CloudOpticalDepth stops being exact. */
float TR_CeilingFade(float Height, TRFieldParams F)
{
    return 1.0f - smoothstep(1.0f - F.CeilingFalloff, 1.0f, Height);
}

/** Density at a height inside a column, from its two surfaces: a ramp down from
 *  the top times a ramp up from the base, each peaking at exactly 1 with zero
 *  derivative at both ends so neither onset nor plateau draws a line. Zero
 *  outside the slab, which is what the empty-air early-out relies on. No peak
 *  density term: Cloud Beta is solved from the optical depth wanted, so a peak
 *  here would divide back out.
 *
 *  PITFALL: an onset stays C1 only while its curve is above 0.5. At 0.5 the
 *  slope at that surface goes finite, creasing along the whole of it; below it
 *  the surface hardens into an edge. Both are legitimate looks, so this is not
 *  clamped -- the floor only keeps the exponent positive, since pow(t, 0)
 *  returns 1. */
float TR_SlabDensity(float Height, float Top, float Base, TRFieldParams F)
{
	// THE FITTED SPANS, CUT AGAIN AGAINST THIS COLUMN'S OWN DEPTH. They already
	// fit the unrelieved band, but relief varies the depth wherever BaseRelief
	// is not 1, so a column can be thinner than the band it came from. Cut
	// rather than shared, so such a column peaks below 1 -- which is what a
	// thinned cloud should do -- instead of holding core density over no
	// distance and putting a hard sheet where the band pinches out.
    const float Depth = max(Top - Base, 1e-4f);

    const float FromTop = saturate((Top - Height) / min(F.SpanTop, Depth));
    const float FromBase = saturate((Height - Base) / min(F.SpanBase, Depth));

    return smoothstep(0.0f, 1.0f, pow(FromTop, max(F.TopCurve, 1e-4f)))
		* smoothstep(0.0f, 1.0f, pow(FromBase, max(F.BottomCurve, 1e-4f)));
}

/** The field's extinction coefficient per atmosphere thickness, solved so a ray
 *  down an UNRELIEVED column accumulates CloudOpticalDepth at core density.
 *  Multiply by a band's extinction for colour and divide by Thickness for world
 *  units. Solved rather than authored, so retuning the shell leaves the cloud's
 *  opacity where it was put, and shared by the march and the bake, which keeps
 *  the depth where the map goes opaque the depth where the eye sees it.
 *
 *  EXACT, because the spans are fitted. The two ramps cannot overlap and cannot
 *  exceed the band, so the plateau between them is never negative and the mass
 *  below is the profile's own integral rather than an estimate of it. Retuning
 *  either softness or either curve redistributes mass without changing how much
 *  light the column removes. */
float TR_CloudBeta(TRFieldParams F, float CloudOpticalDepth)
{
	// Each ramp's mean density: the integral of smoothstep(T^c) over [0,1] is
	// 3/(2c+1) - 2/(3c+1), a half at c = 1.
    const float Ct = max(F.TopCurve, 1e-4f);
    const float Cb = max(F.BottomCurve, 1e-4f);

    const float MeanTop = 3.0f / (2.0f * Ct + 1.0f) - 2.0f / (3.0f * Ct + 1.0f);
    const float MeanBase = 3.0f / (2.0f * Cb + 1.0f) - 2.0f / (3.0f * Cb + 1.0f);

    const float Plateau = F.CloudThickness - F.SpanTop - F.SpanBase;

    return CloudOpticalDepth
		/ max(MeanTop * F.SpanTop + MeanBase * F.SpanBase + Plateau, 1e-4f);
}

/** How far the two carves can move a column top, in atmosphere fractions, at the
 *  given fades. THE ONE DERIVATION OF THE CARVE REACH: the entry search's upper
 *  bound, the saturation skip's lower bound and the deck-wide bounds all read
 *  it, and a second expression would let them disagree about a surface they each
 *  have to be conservative against. Structure is signed about the noise median,
 *  so half its amount lands each way; detail follows TR_DETAIL_RELIEF_CENTRED.
 *
 *  Pass 1 for a fade to get the unconditional reach. Any fade passed must be at
 *  least the fade at every sample the bound covers, or the bound is not one. */
void TR_CarveReach(TRFieldParams F, float DetailFade, float StructureFade, out float Down, out float Up)
{
    const float D = F.CloudThickness;

    const float StructureHalf = D * 0.5f * abs(F.StructureRelief) * saturate(StructureFade);

    const float DetailCarve = D * abs(F.DetailRelief) * saturate(DetailFade);

#if TR_DETAIL_RELIEF_CENTRED
    const float DetailDown = 0.5f * DetailCarve;
    const float DetailUp = 0.5f * DetailCarve;
#else
    const float DetailDown = (F.DetailRelief > 0.0f) ? DetailCarve : 0.0f;
    const float DetailUp = (F.DetailRelief < 0.0f) ? DetailCarve : 0.0f;
#endif

    Down = StructureHalf + DetailDown;
    Up = StructureHalf + DetailUp;
}

/** The band at a planet-local position from one bilinear tap of the top flow
 *  layer, without the shapes' BandShift. For what varies over a band's width
 *  rather than a feature's: the colour of extinction a light ray crossed. */
float TR_BandCoarse(Texture2DArray FlowField, SamplerState FlowSampler, float3 LocalPos, TRFieldParams F)
{
    const float3 N = normalize(Atmo_RotateZ(normalize(LocalPos), F.SpinAngle));

    const float U = frac(atan2(N.y, N.x) * (0.5f / PI));
    const float V = 0.5f + 0.5f * N.z;

    return Flow_Band(
		FlowField.SampleLevel(FlowSampler, float3(U, V, TR_FLOW_LAYER), 0.0f), N, F.FlowRead);
}

/** Signed band height from the band value: zones (positive, anticyclonic) toward
 *  +1, belts (negative, cyclonic) toward -1, zero on the boundaries. Smooth
 *  through zero -- the magnitude is 1 - exp(-Band^2), which starts quadratically
 *  -- because a plain clamp kinks where it pins, creasing along every band
 *  contour. BandSharpness is already folded into Band. */
float TR_BandHeight(float Band)
{
    return sign(Band) * (1.0f - exp(-Band * Band));
}

/** Which way a storm moves the deck: up over anticyclones (positive pressure),
 *  down into cyclones. A plain sign is safe because every use is multiplied by
 *  the vortex gate, which is zero around zero pressure. */
float TR_StormSign(float Pressure)
{
    return (Pressure >= 0.0f) ? 1.0f : -1.0f;
}

/** Both of a column's surfaces, in atmosphere fractions. Flow first -- band
 *  height, pressure lift, storm towers -- then the two carves, all accumulated
 *  as ONE SIGNED DISPLACEMENT so the base can take a share of it. With both
 *  layers neutral (carves 0, StormCells 1, ReliefScale 1) these are the flow's
 *  own surfaces, which is what TR_ProbeFromFlow reports.
 *
 *  EVERY DISPLACEMENT TERM IS CENTRED ON ZERO, so none moves the field as a body
 *  and CloudBase and its derived top stay the typical surfaces however they are
 *  tuned.
 *  Zones sit high and belts low by the sign of the band, their boundaries
 *  meeting at the unrelieved top. The pressure sign is not arbitrary: anticyclones are high
 *  pressure and rising, so they must sit high -- backwards, the field reads as
 *  plausible until you notice every storm is a pit.
 *
 *  ReliefScale collapses band relief under strain and deliberately does not
 *  touch the lift or the towers, which are vertical motion rather than stretched
 *  material. The storm term is gated on vortex strength -- ungated, Worley F1 is
 *  polka dots -- and StormCells is inverted because F1 is minimal at cell
 *  centres, where a storm belongs. That same gate drops the base, so a vortex
 *  reads as a tall column standing on a low floor rather than as a raised deck.
 *
 *  PITFALL: the base is held at or below the top. Uncrossed it would invert the
 *  profile, and the bounds below assume the slab is a span rather than a
 *  reversed one. */
void TR_CloudSurfaces(
	float BandHeight,
	float CarveDetail,
	float ReliefStructure,
	float Pressure,
	float StormCells,
	float ReliefScale,
	TRFieldParams F,
	out float OutTop,
	out float OutBase)
{
    const float D = F.CloudThickness;

	// Half each way, so zones sit BandRelief above belts.
    float Shift = D * ReliefScale * 0.5f * F.BandRelief * BandHeight;

    Shift -= D * F.DetailRelief * CarveDetail;
    Shift += D * F.StructureRelief * ReliefStructure;

    Shift += D * F.PressureRelief * Pressure;

    const float Vortex = smoothstep(F.VortexThreshold, 1.0f, abs(Pressure));

    const float Cell = (1.0f - StormCells) * Vortex;

    Shift += D * F.StormTowerRelief * TR_StormSign(Pressure) * Cell;

	// THE TOP IS DERIVED, NOT AUTHORED: the band hangs its full depth above its
	// own base, and relief moves that base and the top by their own shares.
    OutTop = F.CloudBase + D + Shift;

    OutBase = min(
		F.CloudBase + Shift * F.BaseRelief - D * F.BaseStormDrop * Cell, OutTop);
}

/** One flow fetch: the band, the pressure, and the slab's two surfaces as values
 *  and as bounds. */
struct TRFlowProbe
{
    float Band;
    float Pressure;

	/** The flow's own surfaces, both volumes neutral. Not bounds -- the
	 *  values. */
    float TopFlow;
    float BaseFlow;

	/** Highest the top can reach and lowest the base can fall at this column,
	 *  carves included at the params' own fades. */
    float TopUpper;
    float BaseLower;
};

/** The slab's surfaces at a column from a flow sample, without the volumes.
 *
 *  THE BOUNDS BRACKET THE SHARED DISPLACEMENT, then each surface takes its own
 *  share of it. ReliefScale is in [0,1] against the band term and the storm
 *  cells scale the tower term the same way, so max() and min() bracket both. A
 *  bound that overestimates costs the search an iteration; one that
 *  underestimates steps over a surface and lets the early-out skip real cloud.
 *
 *  THE CARVE REACH ARRIVES AT THE PARAMS' OWN FADES, which makes the bounds
 *  right for a sample and too tight for a search running ahead of one.
 *  TR_SlabEntry raises both fades on its copy before probing.
 *
 *  Band and Pressure must match TR_Field's unshifted values, or a sample taken
 *  through the early-out tints differently from one taken the long way. */
TRFlowProbe TR_ProbeFromFlow(float4 Flow, float3 N, TRFieldParams F)
{
    TRFlowProbe Probe;

    Probe.Band = Flow_Band(Flow, N, F.FlowRead);
    Probe.Pressure = Flow_Pressure(Flow, N, F.FlowRead);

    const float D = F.CloudThickness;

    const float BandHeight = TR_BandHeight(Probe.Band);

    TR_CloudSurfaces(
		BandHeight, 0.0f, 0.0f, Probe.Pressure, 1.0f, 1.0f, F,
		Probe.TopFlow, Probe.BaseFlow);

    const float Vortex = smoothstep(F.VortexThreshold, 1.0f, abs(Probe.Pressure));

    const float PressureTerm = D * F.PressureRelief * Probe.Pressure;
    const float BandTerm = D * 0.5f * F.BandRelief * BandHeight;
    const float StormTerm = D * F.StormTowerRelief * TR_StormSign(Probe.Pressure) * Vortex;

    float CarveDown, CarveUp;
    TR_CarveReach(F, F.DetailFade, F.StructureFade, CarveDown, CarveUp);

    const float ShiftMax = PressureTerm + max(BandTerm, 0.0f) + max(StormTerm, 0.0f);
    const float ShiftMin = PressureTerm + min(BandTerm, 0.0f) + min(StormTerm, 0.0f);

	// CAPPED AT THE SHELL, where the ceiling fade has already taken density to
	// zero. Uncapped, a rare tall column would widen every bound derived from
	// this for the sake of air that cannot scatter.
    Probe.TopUpper = min(F.CloudBase + D + ShiftMax + CarveUp, 1.0f);

	// The base's share of a signed displacement, so whichever extreme BaseRelief
	// turns downward is the one that bounds it. The carve reach is taken at its
	// larger side for the same reason, which costs a little tightness and no
	// correctness.
    Probe.BaseLower = F.CloudBase
		+ min(ShiftMin * F.BaseRelief, ShiftMax * F.BaseRelief)
		- abs(F.BaseRelief) * max(CarveDown, CarveUp)
		- D * max(F.BaseStormDrop, 0.0f) * Vortex;

    return Probe;
}

/** The cheap read, for the jobs that do not need the volumes: finding where a
 *  ray enters the slab, and answering outside it, where the volumes cannot put
 *  density back. */
TRFlowProbe TR_FlowProbe(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	float3 P,
	TRFieldParams F)
{
    const float3 N = normalize(Atmo_RotateZ(P, F.SpinAngle));

    return TR_ProbeFromFlow(Flow_Sample(FlowField, FlowSampler, N, TR_FLOW_LAYER), N, F);
}

/** Distance along a ray at which it first reaches the slab, from either side.
 *  Returns T1 when it does not reach the slab between T0 and T1, and sets
 *  OutMissed only when that is PROVED rather than merely not found.
 *
 *  THE TWO ARE NOT THE SAME ANSWER AND THE CALLER MUST NOT CONFLATE THEM. The
 *  proofs are geometry: radius is monotone either side of the closest approach,
 *  so a ray climbing clear of TopMax, or below the base and still descending
 *  with its perigee outside the span, can be ruled out whatever the field does.
 *  Running out of segment is different -- the advances rest on CloudSlope
 *  bounding the surface, and an under-declared slope makes the cone overshoot
 *  and report a miss on a ray that crosses cloud. Treating that as proof drops
 *  the cloud entirely on those rays; treating it as "not found" costs them a
 *  full fine march and nothing else. Errors here have to land on cost.
 *
 *  LocalOrigin and
 *  LocalDir are in the field's frame, LocalDir normalized, which an orthonormal
 *  WorldToLocal preserves. TopMax is the field-wide upper bound, which is what
 *  lets a ray climbing clear of the slab give up.
 *
 *  A CONE TRACE, AND NOT AN OPTIMIZATION -- it is what keeps the limb from
 *  breaking. A grazing chord across the shell is enormous, and stepped at the
 *  field's own step size it exhausts the iteration cap in empty space, leaving
 *  the ray transparent at exactly the angles where its neighbours a fraction of
 *  a degree steeper go opaque: a sharp geometric threshold, drawing a hard
 *  silhouette where the limb should be softest.
 *
 *  ONE TRACE FOR BOTH SURFACES, chosen per probe rather than once: a ray
 *  descending from outside closes on the top, a camera on the ground produces
 *  nothing but the other kind, and a long grazing ray does both in turn. */
float TR_SlabEntry(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	float3 LocalOrigin,
	float3 LocalDir,
	float T0,
	float T1,
	float TopMax,
	TRFieldParams F,
	out bool OutMissed)
{
    OutMissed = false;

	// UNFADED, ON A LOCAL COPY. The search runs ahead of the samples it is
	// finding, so a bound narrowed by this pixel's fades is not a bound on the
	// column it eventually lands in.
    F.DetailFade = 1.0f;
    F.StructureFade = 1.0f;

    float TSearch = T0;

    LOOP

    for (int Iter = 0; Iter < TR_SLAB_ENTRY_PROBES; Iter++)
    {
        const float3 ProbePos = LocalOrigin + LocalDir * TSearch;
        const float ProbeRadius = length(ProbePos);
        const float ProbeHeight = (ProbeRadius - F.PlanetRadius) / F.Thickness;

        const float3 ProbeDir = ProbePos / max(ProbeRadius, 1e-4f);
        const float ProbeRate = dot(LocalDir, ProbeDir);

        const TRFlowProbe Probe = TR_FlowProbe(FlowField, FlowSampler, ProbeDir, F);

        if (ProbeHeight <= Probe.TopUpper && ProbeHeight >= Probe.BaseLower)
        {
            return TSearch;
        }

        const bool bAbove = ProbeHeight > Probe.TopUpper;

		// How far the surface is and how fast the ray alone closes on it.
        const float Gap = bAbove
			? ProbeHeight - Probe.TopUpper
			: Probe.BaseLower - ProbeHeight;

        const float Approach = bAbove ? -ProbeRate : ProbeRate;

		// Climbing and clear of the highest the field can reach. Both conditions
		// matter: a climbing ray still inside that range can meet a taller
		// column ahead.
        if (bAbove && ProbeRate >= 0.0f && ProbeHeight > TopMax)
        {
            OutMissed = true;
            return T1;
        }

		// BELOW THE BASE AND STILL DESCENDING, so the ray is moving away from
		// the surface it needs and the cone has nothing to close on. Radius is
		// monotone either side of the closest approach, so the search resumes
		// there rather than giving up: a limb ray that skims under the cloud and
		// climbs back into it would otherwise report the whole segment as
		// missing the slab, which drops that cloud from the image entirely.
		//
		// PITFALL: THE RATE IS ZERO TO WITHIN NOISE AT THE CLOSEST APPROACH
		// ITSELF, and its sign there is arbitrary. Tested against a bare zero, a
		// ray sitting on its own perigee enters this branch, finds the perigee
		// already behind it, and reports a miss it has not proved -- which drops
		// the cloud on every ray whose perigee lands inside the segment, dithered
		// by which side of zero the noise fell on. Descending AND past perigee is
		// geometrically impossible, so it is not an answer; the epsilon keeps the
		// branch to rays genuinely still descending, and a perigee that is not
		// ahead means there is nothing to skip rather than nothing to find.
        if (!bAbove && ProbeRate < -1e-4f)
        {
            const float TPerigee = -dot(LocalOrigin, LocalDir);

            if (TPerigee >= T1)
            {
                OutMissed = true;
                return T1;
            }

            if (TPerigee > TSearch)
            {
                TSearch = TPerigee;
                continue;
            }
        }

		// The surface moves to meet the ray, so the closing rate is the sum of
		// the ray's own approach and the surface's slope across the ground it
		// covers. Dividing by the approach alone overshoots without bound at
		// tangent. CloudSlope is in cloud depths per radian, matching the relief
		// that produces the slope.
		//
		// PITFALL: it has to bound the STEEPER surface, and that is usually the
		// base. Every shared relief term reaches the base at BaseRelief of the
		// top's, but BaseStormDrop reaches it whole, over a vortex gate that
		// turns on across a flow texel. Under-declared, the cone overshoots and
		// the search reports a surface it never found.
        const float Horizontal = sqrt(max(1.0f - ProbeRate * ProbeRate, 0.0f));

        const float ClosingRate = Approach
			+ Horizontal * max(F.CloudSlope, 0.1f) * F.CloudThickness * F.Thickness
				/ max(ProbeRadius, 1e-4f);

        const float Advance = Gap * F.Thickness / max(ClosingRate, 1e-5f);

        TSearch += max(Advance * TR_CONE_RELAXATION, 1e-4f);

        if (TSearch >= T1)
        {
            return T1;
        }
    }

    return TSearch;
}

/** Evaluates the cloud field at a direction on the sphere. Height is the shading
 *  point's atmosphere fraction and only affects the 3D volume lookups. Up to six
 *  fetches, depending on which layers survive their fade.
 *
 *  N IS ALREADY SPUN, Flow0 IS ITS FLOW SAMPLE AND Probe IS ITS READING, all
 *  from the caller: the saturation test needs that fetch before it can decide
 *  whether to call this at all, so taking them as arguments keeps the test free
 *  and stops band and pressure being derived twice. Flow0 is also the warp
 *  loop's first iteration, UNWARPED deliberately -- the sim transports
 *  vorticity, so warping the lookup would double-count.
 *
 *  VOLUME SAMPLER STATE: wrap on all three axes, Linear Color. These are scalar
 *  fields and an sRGB decode curves them without erroring. */
TRFieldSample TR_Field(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	Texture3D DetailVolume,
	SamplerState DetailSampler,
	Texture3D StructureVolume,
	SamplerState StructureSampler,
	float3 N,
	float4 Flow0,
	TRFlowProbe Probe,
	float Height,
	TRFieldParams F)
{
    const float Pressure = Probe.Pressure;

    const float Zeta = Probe.Band;

	// One on a band boundary, falling to zero in a band's interior: where the
	// jets and their shear live. Weights the turbulence and the carves' edge
	// bias. The same curve TR_BandHeight takes its magnitude from, so heights
	// and weights agree about where the boundaries are.
    const float Boundary = exp(-Zeta * Zeta);

	// Turbulence follows the shear and the shear lives at the boundaries, so
	// zone interiors go nearly laminar. Without it the bands read as one
	// scalloped curve repeated all the way round.
    const float Turbulence = lerp(F.TurbulenceFloor, 1.0f, Boundary);

    const float StepTime = (F.WarpTime * Turbulence) / (float) TR_WARP_ITERATIONS;

    float3 Pos = N;

    float3 FirstVelocity = 0.0f;
    float3 LastVelocity = 0.0f;

    UNROLL

    for (int It = 0; It < TR_WARP_ITERATIONS; It++)
    {
        const float4 Flow = (It == 0) ? Flow0
			: Flow_Sample(FlowField, FlowSampler, Pos, TR_FLOW_LAYER);

        const float3 Velocity = Flow_TangentVelocity(Pos, Flow.xy);

        if (It == 0)
        {
            FirstVelocity = Velocity;
        }

        LastVelocity = Velocity;

		// Renormalized every step because the displacement leaves the sphere.
		// Only .z is read downstream, so a chord move biases latitude and
		// compounds over several steps.
        Pos = normalize(Pos + Velocity * StepTime);
    }

    const float3 Warped = Pos;

	// A difference rather than a running sum: each step renormalizes, so the sum
	// of the steps is not the distance travelled.
    const float3 FlowWarp = Warped - N;

    float Ridge = 0.5f;
    float3 DeepShear = 0.0f;

	// ADVECTION HAS NOWHERE TO ACCUMULATE. The volumes are resampled from
	// scratch every frame, so a warp anchored to a fixed direction can only
	// wobble. Two phases half a period apart, each ramping its displacement from
	// nothing to TR_CROSSFADE_SPAN and resetting, give features somewhere to
	// travel to; the weight is zero where a phase resets, so the discontinuity
	// happens while that layer contributes nothing. It is a dissolve between two
	// differently sheared copies, so the blend ghosts under shear.
    const float PhaseA = frac(F.CrossfadeTime);
    const float PhaseB = frac(F.CrossfadeTime + 0.5f);

    const float WeightA = 1.0f - abs(2.0f * PhaseA - 1.0f);

    const float WarpMulA = TR_CROSSFADE_SPAN * PhaseA;
    const float WarpMulB = TR_CROSSFADE_SPAN * PhaseB;

	// A FADED LAYER IS SKIPPED, NOT JUST SCALED. Exactly zero, not an epsilon: a
	// skip at a small positive fade is a discontinuity at a fixed fade value,
	// which is a fixed distance from the camera, which is a ring on screen.
	// smoothstep returns exactly 1 past its far edge, so the branch still fires
	// over the whole faded region.
    const bool bWantDetail = (F.DetailFade > 0.0f);
    const bool bWantStructure = (F.StructureFade > 0.0f);

    BRANCH

	// DEEP SHEAR, ONE STEP THROUGH THE DEEP FLOW LAYER: a different sim slice
	// from the coarse warp, which is what makes the shear vertical. Outside
	// either layer's branch because this is geometry rather than noise --
	// computed only where one layer survives, the other would warp differently
	// either side of that layer's fade, a discontinuity in motion.
    if (bWantDetail || bWantStructure)
    {
        const float3 PShear = normalize(N + FlowWarp * F.DetailFlowInherit);

        const float4 DeepFlow = Flow_Sample(FlowField, FlowSampler, PShear, TR_DEEP_FLOW_LAYER);

        DeepShear = Flow_TangentVelocity(PShear, DeepFlow.xy) * (F.DeepShearTime * Turbulence);
    }

	// Each layer's displacement: its FlowInherit of the coarse warp plus its
	// ShearInherit of the deep shear. A displacement field with a large gradient
	// IS strain, so inheriting one whole imposes an order-one strain on a layer
	// regardless of its own flow.
    const float3 DetailWarp = FlowWarp * F.DetailFlowInherit + DeepShear * F.DetailShearInherit;
    const float3 StructureWarp = FlowWarp * F.StructureFlowInherit + DeepShear * F.StructureShearInherit;

    BRANCH

    if (bWantDetail)
    {
		// SAMPLED IN TRUE 3D: the position is a unit direction, so Scale alone
		// would trace a sphere through the volume and discard the vertical
		// structure the bake put there. No independent drift -- a clock
		// scrolling the volume through its own domain makes the detail change
		// whether or not anything is happening to it. If it looks pinned, raise
		// WarpTime.
        const float UVWScale = F.DetailScale + Height * F.DetailVertical;

		// MIP 0, ALWAYS. A footprint-derived mip blurs along the shell and
		// erases the vertical structure a high aspect ratio builds. Undersampled
		// instead: the high frequencies fold down rather than resolve, and the
		// fades remove a layer once that stops being affordable.
        float4 DetailSample;

        BRANCH

        if (F.DetailCrossfade > 0.0f)
        {
			// The two phases differ only in how far along the same displacement
			// they sit, so one flow loop serves both. The deep-flow fetch stays
			// on the unphased position: it decides how the layer is sheared, not
			// where it is.
            const float3 PA = normalize(N + DetailWarp * WarpMulA);
            const float3 PB = normalize(N + DetailWarp * WarpMulB);

            DetailSample = lerp(
				DetailVolume.SampleLevel(DetailSampler, PB * UVWScale, 0.0f),
				DetailVolume.SampleLevel(DetailSampler, PA * UVWScale, 0.0f),
				WeightA);
        }
        else
        {
            DetailSample = DetailVolume.SampleLevel(
				DetailSampler, normalize(N + DetailWarp) * UVWScale, 0.0f);
        }

        Ridge = AtmoNoise_PerlinWorley(
			DetailSample.r,
			AtmoNoise_WorleyLadder(DetailSample.gba, F.DetailNoiseWeights.xyz));
    }

	// Green is the storm-tower gate and 1 is its neutral value, since the tower
	// term reads (1 - StormCells). The fade lerps toward the same 1, so the
	// skipped case and the fully faded case agree.
    float4 Structure = float4(0.5f, 1.0f, 1.0f, 1.0f);

    BRANCH

    if (bWantStructure)
    {
        const float UVWScale = F.StructureScale + Height * F.StructureVertical;

        BRANCH

        if (F.StructureCrossfade > 0.0f)
        {
            const float3 PA = normalize(N + StructureWarp * WarpMulA);
            const float3 PB = normalize(N + StructureWarp * WarpMulB);

            Structure = lerp(
				StructureVolume.SampleLevel(StructureSampler, PB * UVWScale, 0.0f),
				StructureVolume.SampleLevel(StructureSampler, PA * UVWScale, 0.0f),
				WeightA);
        }
        else
        {
			// Zero inheritance is legitimate rather than degenerate: this layer
			// breaks the flow into rounded shapes, and a shape dragged through
			// the flow field is no longer round.
            const float3 PStructure = normalize(N + StructureWarp);

            Structure = StructureVolume.SampleLevel(
				StructureSampler, PStructure * UVWScale, 0.0f);
        }
    }

	// RELIEF THINNING, MEASURED FROM THE FLOW RATHER THAN PRESCRIBED. An
	// incompressible parcel stretched by g must thin vertically by 1/g; without
	// it, filament width shrinks with strain while height does not and the march
	// reads them as spikes. The velocity difference over the distance travelled
	// is a strain rate, from two samples the loop already took -- a prescribed
	// zonal profile reports zero inside a vortex straining material hard.
    const float Travelled = length(FlowWarp);

    const float StrainRate = length(LastVelocity - FirstVelocity) / max(Travelled, 1e-5f);

    const float Winding = StrainRate * F.WarpTime;

    const float ReliefScale = 1.0f / (1.0f + F.ReliefThinning * Winding);

	// EDGE WEIGHTING. Detail applied uniformly is by definition grain: it has no
	// relationship to the structure it sits on. Concentrated on the transitions
	// it ravels the band edges, where a real gas giant's billows live.
    const float Edge = lerp(F.EdgeBias, 1.0f, Boundary);

    const float StructureMix = AtmoNoise_PerlinWorley(
		Structure.r,
		AtmoNoise_WorleyLadder(Structure.gba, F.StructureNoiseWeights.xyz));

	// Fade enters here rather than at the consumption sites, so it scales the
	// noise's effect and leaves its scale alone -- structure stays the same size
	// as it dims rather than growing.
    const float DetailWeight = saturate(Edge * F.DetailNoiseWeights.w * F.DetailFade);
    const float StructureWeight = saturate(Edge * F.StructureNoiseWeights.w * F.StructureFade);

	// EROSION KEEPS ITS NEUTRAL AT 1, since it multiplies density and may only
	// remove material. RELIEF is signed about the median, since it moves a
	// surface and has no reason to prefer a direction.
    const float ShapeDetail = lerp(1.0f, Ridge, DetailWeight);
    const float ShapeStructure = lerp(1.0f, StructureMix, StructureWeight);

#if TR_DETAIL_RELIEF_CENTRED
	// About the median, so turning the layer up or fading it in changes the
	// deck's texture without changing its altitude.
    const float CarveDetail = DetailWeight * (0.5f - Ridge);
#else
    const float CarveDetail = DetailWeight * (1.0f - Ridge);
#endif

    const float ReliefStructure = StructureWeight * (StructureMix - 0.5f);

	// MATERIAL FOLLOWS SHAPE. The band boundary becomes the zero contour of Band
	// plus the signed shapes that move the surface, so a billow near a boundary
	// is made of whichever family its sign points at. Doubled so each term spans
	// +-1 at full weight. PITFALL: keep it additive -- any form depending on
	// sign(Band) flips on the zero contour and redraws the clean line as a
	// discontinuity. The detail term is median-centred regardless of
	// TR_DETAIL_RELIEF_CENTRED, which would push boundaries toward one family.
    const float BandShift = 2.0f * (F.StructureBandMix * ReliefStructure
		+ F.DetailBandMix * DetailWeight * (0.5f - Ridge));

	// THE TOWER GATE RIDES THE SAME FADE. Left raw it holds full height to the
	// skip threshold then vanishes in one step, the tallest feature on the deck
	// popping out at a fixed distance. Not edge-weighted, unlike the shapes: a
	// tower's placement already comes from the vortex gate.
    const float StormGate = lerp(1.0f, Structure.g, saturate(F.StructureFade));

    TRFieldSample Out;

    TR_CloudSurfaces(
		TR_BandHeight(Zeta), CarveDetail, ReliefStructure, Pressure, StormGate, ReliefScale, F,
		Out.Top, Out.Base);

    Out.Pressure = Pressure;
    Out.Band = Zeta;
    Out.BandShift = BandShift;
    Out.ShapeDetail = ShapeDetail;
    Out.ShapeStructure = ShapeStructure;

    return Out;
}

/** The band colour ramp, for the debug material. Colour from the sign of
 *  vorticity scaled by the magnitude, so zero lands on EdgeColour and cores come
 *  out saturated, and the dark line between bands separates the two families
 *  instead of blending them through a muddy midpoint. Scale is the sim debug
 *  view's DebugScale inverted. */
float3 TR_BandColour(float Band, float3 ColourA, float3 ColourB, float3 EdgeColour, float Scale)
{
    const float T = clamp(Band * Scale, -1.0f, 1.0f);

    const float3 Hue = (T < 0.0f) ? ColourB : ColourA;

    return lerp(EdgeColour, Hue, abs(T));
}

/** Density at a point in the shell. LocalPos carries its true radius, unlike
 *  elsewhere in this file; the columnar field is still evaluated at the
 *  normalized direction, the shell being thin enough that the true radius shifts
 *  UVW by less than one lattice cell. StepHalfLength is half the march step in
 *  atmosphere fractions along the radius, so a step straddling the cloud top is
 *  weighted by how much of it lies inside.
 *
 *  Returns:
 *    x  Density in [0,1]. Multiply by an extinction coefficient in the march.
 *    y  BAND, signed and unclamped -- what the material is, not a density term,
 *       shifted by the shapes near the surface.
 *    z  Pressure, for tinting vortices. Negative is cyclonic.
 *    w  The cloud top at this column. Outside the slab the volumes are skipped,
 *       so it is the flow's own top: what TR_CloudSurfaces returns with both
 *       layers neutral, the value the full path reaches as the fades hit zero. */
float4 TR_Density(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	Texture3D DetailVolume,
	SamplerState DetailSampler,
	Texture3D StructureVolume,
	SamplerState StructureSampler,
	float3 LocalPos,
	float StepHalfLength,
	TRFieldParams F)
{
    const float Radius = length(LocalPos);
    const float3 Direction = LocalPos / max(Radius, 1e-4f);

    const float Height = (Radius - F.PlanetRadius) / F.Thickness;

    const float HalfStep = max(StepHalfLength, 0.0f);

    const float3 N = normalize(Atmo_RotateZ(Direction, F.SpinAngle));

    const float4 Flow0 = Flow_Sample(FlowField, FlowSampler, N, TR_FLOW_LAYER);

    const TRFlowProbe Probe = TR_ProbeFromFlow(Flow0, N, F);

    BRANCH

	// ONE FETCH OUTSIDE THE SLAB RATHER THAN SEVEN: density there is exactly
	// zero and the volumes cannot put any back, so the probe's fetch supplies
	// the band and pressure that are all that is left to want. The test uses the
	// step's NEAR edge on each side, keeping the boundary a half step clear of
	// the lattice, and runs against bounds rather than the surfaces themselves,
	// which cost the volumes.
    if (Height + HalfStep <= Probe.BaseLower || Height - HalfStep >= Probe.TopUpper)
    {
        return float4(0.0f, Probe.Band, Probe.Pressure, Probe.TopFlow);
    }

    const TRFieldSample Field = TR_Field(
		FlowField, FlowSampler, DetailVolume, DetailSampler,
		StructureVolume, StructureSampler,
		N, Flow0, Probe, Height, F);

    const float Top = Field.Top;
    const float Base = Field.Base;

	// THE PROFILE IS INTEGRATED ACROSS THE STEP, NOT SAMPLED AT ITS MIDPOINT.
	// One midpoint sample makes the slab a near-binary decision per step, and as
	// a surface drifts against the lattice that decision flips along a line on
	// screen. Both surfaces vary slowly across a step, so they are evaluated
	// once at the centre and only the profile is integrated -- three closed-form
	// evaluations, no extra fetches. The ceiling fade rides the same points.
    const float RampNear = TR_SlabDensity(Height - HalfStep, Top, Base, F)
		* TR_CeilingFade(Height - HalfStep, F);
    const float RampMid = TR_SlabDensity(Height, Top, Base, F)
		* TR_CeilingFade(Height, F);
    const float RampFar = TR_SlabDensity(Height + HalfStep, Top, Base, F)
		* TR_CeilingFade(Height + HalfStep, F);

    const float Gradient = (RampNear + 4.0f * RampMid + RampFar) / 6.0f;

    const float DepthFraction =
		saturate((Top - Height) / max(Top - Base, 1e-4f));

	// Full erosion at the top, none below ErosionDepth into the slab, or the
	// cloud is uniformly pitted rather than solid material with a worked top.
	// Smoothstep rather than linear: a linear falloff leaves the end of erosion
	// C0, a faint shelf edge-on at a constant altitude.
    const float CarveWeight =
		1.0f - smoothstep(0.0f, max(F.ErosionDepth, 1e-4f), DepthFraction);

	// THE CARVE MODULATES THE GRADIENT AND NOTHING ELSE. Multiplicative, and the
	// gradient is exactly zero outside the slab, so nothing the noise does can
	// put density beyond the bounds TR_TopMax and TR_BaseMin computed.
	// Each lerp floors its layer at (1 - erosion) rather than zero, which is
	// what keeps erosion a worked surface rather than coverage.
    const float CarveDetail = lerp(1.0f, Field.ShapeDetail,
		saturate(F.DetailErosion) * CarveWeight);

    const float CarveStructure = lerp(1.0f, Field.ShapeStructure,
		saturate(F.StructureErosion) * CarveWeight);

    const float Density = Gradient * CarveDetail * CarveStructure;

	// Mixing lives in the worked top and is gone by the base, where the
	// early-out reports the probe's unshifted band. Smoothstep so the weight is
	// C1 at both ends and the handoff draws no contour in colour.
    const float MixWeight = 1.0f - smoothstep(0.0f, 1.0f, DepthFraction);

    return float4(Density, Field.Band + Field.BandShift * MixWeight, Field.Pressure, Top);
}

/** How far the shared displacement can move a surface, in atmosphere fractions.
 *  THE ONE DERIVATION OF THE FIELD-WIDE REACH, read by both bounds below.
 *
 *  EVERY TERM IN TR_CloudSurfaces HAS TO APPEAR HERE. An underestimate is not
 *  conservative, it is a clipping error: the cull radius comes from the top
 *  bound, so a term left out slices the tops off the features it belongs to.
 *  TR_BandHeight is in [-1,1] scaled by a half, pressure is soft-saturated
 *  sim-side so it contributes the whole of PressureRelief, the storm term
 *  reaches the whole of StormTowerRelief either way, and ReliefScale never
 *  exceeds one so ignoring it errs safe. The carves are scaled by the fades: a
 *  bound reserving room for a layer a faded ray never sees coarsens the march
 *  wherever that layer is absent, the marched band over cloudSteps being the
 *  step size. */
void TR_ShiftReach(
	TRFieldParams F,
	float DetailFade,
	float StructureFade,
	out float Down,
	out float Up)
{
    const float Span = F.CloudThickness * (0.5f * abs(F.BandRelief)
		+ abs(F.PressureRelief) + abs(F.StormTowerRelief));

    float CarveDown, CarveUp;
    TR_CarveReach(F, DetailFade, StructureFade, CarveDown, CarveUp);

    Down = Span + CarveDown;
    Up = Span + CarveUp;
}

/** The highest any column top can reach, an atmosphere fraction.
 *
 *  CLAMPED AT THE SHELL: the ceiling fade leaves no density above it. Unclamped,
 *  a tall rare feature would widen the marched band and coarsen every step for
 *  the sake of a few columns. */
float TR_TopMax(TRFieldParams F, float DetailFade, float StructureFade)
{
    float Down, Up;
    TR_ShiftReach(F, DetailFade, StructureFade, Down, Up);

    return min(F.CloudBase + F.CloudThickness + Up, 1.0f);
}

/** The lowest any column base can fall, an atmosphere fraction: WHERE THE
 *  MARCHED BAND ENDS, and the altitude a ray passes beneath without meeting
 *  cloud. The base takes a SIGNED share of the displacement, so its reach is the
 *  larger side of that displacement whichever way BaseRelief points -- loose,
 *  and loose in the safe direction. */
float TR_BaseMin(TRFieldParams F, float DetailFade, float StructureFade)
{
    float Down, Up;
    TR_ShiftReach(F, DetailFade, StructureFade, Down, Up);

    return F.CloudBase - abs(F.BaseRelief) * max(Down, Up)
		- F.CloudThickness * max(F.BaseStormDrop, 0.0f);
}
