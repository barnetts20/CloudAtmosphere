#pragma once

#include "/Plugin/CloudAtmosphere/Private/AtmosphereShadowBake.ush"

// The bake's march: one texel of one cascade, from the shell entry to the last
// threshold crossed.
//
// A MODEL DEFINES ELEVEN HOOKS AND INCLUDES THIS. The ray setup, the dyadic step
// lattice, the optical-depth allowance and the crossing accumulation are the
// FORMAT's, and a second field changes none of them -- it changes what sigma is
// at a point, where the ray enters and how wide a cascade reaches.
//
// INCLUDED AFTER THE HOOKS, NOT BEFORE. The hooks close over the model's own
// uniforms and textures, which is why none of them appear in a signature here; a
// model that includes this file too early gets an undeclared-identifier error
// naming the hook it has not written yet.
//
// The interface:
//
//   BakeFieldParams                         the model's field struct
//   BakeField_Params()                      built from its uniforms
//   BakeField_CullRadius(F)                 the shell the map covers
//   BakeField_CascadeExtent(F, Level)       half-width, 0 to collapse a level
//   BakeField_TopBound(F)                   highest the field reaches, unfaded
//   BakeField_Entry(O, D, Len, Top, F)      where to start marching
//   BakeField_HeightStep(F)                 radial advance a step may take
//   BakeField_LateralArc(Radius)            finest lateral feature at a radius
//   BakeField_FoldConstant(F)               folded into every stored depth
//   BakeField_Sigma(...)                    extinction over the texel footprint,
//                                           given as two world vectors per texel
//
// plus a Thickness member on BakeFieldParams, the one field the loop reads
// directly, since every stored depth is expressed in it.

/** Bakes one texel of one cascade: the four crossing depths and, where the
 *  target carries them, the occluder term on the same ray.
 *
 *  EVERY FIELD QUESTION GOES THROUGH A BakeField_ CALL. What is left is the ray
 *  setup, the step lattice and the crossing accumulation, none of which depend
 *  on what fills the shell. A model defines the hooks over its own uniforms
 *  BEFORE including this file, so they close over those uniforms and no texture
 *  has to travel through the signature.
 *
 *  THE PARAMS STRUCT MUST EXPOSE Thickness, the one member read directly here.
 *  Everything else about the field arrives through a hook. */
void AtmoBake_Texel(uint3 DispatchThreadId)
{
    const int Level = int(DispatchThreadId.z) + ShadowFirstLevel;

    if (any(DispatchThreadId.xy >= uint2(ShadowMapSize))
		|| Level < 0 || Level >= ATMO_SHADOW_CASCADES)
    {
        return;
    }

	// One slice per cascade. Only the level index crosses from the CPU: extent
	// and centre are derived here by the same functions the reconstruction
	// calls, so the two cannot disagree about where a slice is.
    const uint3 Texel = uint3(DispatchThreadId.xy, uint(Level));

    BakeFieldParams F = BakeField_Params();

	// The unconditional bound: the map is shared by every pixel, so the shell it
	// covers cannot be narrowed by any one camera's fades.
    const float TopMax = BakeField_TopBound(F);

    const float CloudOuter = BakeField_CullRadius(F);

    float3 ShadowBasisU, ShadowBasisV;
    AtmoShadow_Basis(ShadowLightDir, ShadowBasisU, ShadowBasisV);

    const float ShadowExtent = BakeField_CascadeExtent(F, Level);
    const float Extent0 = BakeField_CascadeExtent(F, 0);

	// A collapsed level -- a layer faded to nothing -- writes the sentinel and
	// is skipped by the walk that reads it.
    if (ShadowExtent <= 0.0f)
    {
        ShadowMapUAV[Texel] = ATMO_SHADOW_NO_DECK;
        AtmoBake_WriteOccluder(Texel, (float4) 0.0f);
        return;
    }

    const float HalfWidth = AtmoShadow_CascadeHalfWidth(Level, ShadowExtent, Extent0);

    const float2 ShadowCentre = AtmoShadow_CascadeCentre(
		Level, ShadowCameraLocal, ShadowBasisU, ShadowBasisV,
		HalfWidth, Extent0, float2(ShadowMapSize));

	// EVERY CASCADE IS A WINDOW OF THE WARPED DISC, mapped to the plane by the
	// same functions the reader inverts. Texels are then ellipses on the plane,
	// so the footprint the subsamples cover is carried as the two vectors one
	// texel moves along each map axis.
    const float2 Disc = ShadowCentre
		+ ((float2(Texel.xy) + 0.5f) * ShadowInvMapSize * 2.0f - 1.0f) * HalfWidth;

    const float2 Plane = AtmoShadow_DiscToPlane(Disc) * Extent0;

    float2 JacobianX, JacobianY;
    AtmoShadow_DiscJacobian(Disc, JacobianX, JacobianY);

	// Still the ray's closest approach to the planet centre: the map plane moved
	// but the shell did not, so the intersection below is unchanged.
    const float3 Offset = ShadowBasisU * Plane.x + ShadowBasisV * Plane.y;

    const float3 Dir = -ShadowLightDir;

	// Offset is perpendicular to Dir by construction, so |Offset + Dir*d| is
	// PerpSq + d*d and the shell crossing is a square root rather than a
	// quadratic.
    const float PerpSq = dot(Offset, Offset);
    const float HalfChordSq = CloudOuter * CloudOuter - PerpSq;

    BRANCH

    if (HalfChordSq <= 0.0f)
    {
        ShadowMapUAV[Texel] = ATMO_SHADOW_NO_DECK;
        AtmoBake_WriteOccluder(Texel, (float4) 0.0f);
        return;
    }

	// Everything below is parameterised by distance from the shell entry, which
	// IS the stored depth: Dir is the depth axis, so an advance along the ray is
	// an advance in depth one for one.
    const float HalfChord = sqrt(HalfChordSq);

    const float3 Origin = Offset - Dir * HalfChord;

    const float RayLength = 2.0f * HalfChord;

	// GEOMETRY IS A SEPARATE TERM AND THE DECK IS MARCHED WHOLE. The march used
	// to stop at the blocker, which is correct only for an all-or-nothing shadow;
	// a graded one is added to the deck behind it and needs that deck to exist.
	// Stored in thicknesses, matching the depth the reader arrives with.
    {
        float Coverage;
        const float TOcc = AtmoBake_Occlusion(
			Offset, HalfChord, OccluderSoftness * F.Thickness, Coverage);

        AtmoBake_WriteOccluder(Texel, AtmoOcc_Encode(
			TOcc / F.Thickness, Coverage, OccluderInset,
			OccluderStrength, OccluderFalloff));
    }

    const float TexelScale = 2.0f * HalfWidth * Extent0 / float(max(ShadowMapSize.x, 1));

	// The footprint, world vectors per texel along each map axis. The field's
	// Sigma offsets along them with a unit TexelWorld, so the subsamples cover
	// the warped texel and not a square of the planar one.
    const float3 FootprintU = (ShadowBasisU * JacobianX.x + ShadowBasisV * JacobianX.y) * TexelScale;
    const float3 FootprintV = (ShadowBasisU * JacobianY.x + ShadowBasisV * JacobianY.y) * TexelScale;

	// The texel's longer axis, where a single length is wanted.
    const float TexelWorld = max(length(FootprintU), length(FootprintV));

    float TEntry = BakeField_Entry(Origin, Dir, RayLength, TopMax, F);

	// WHERE TO START MARCHING, NOT WHAT TO STORE. The traced entry is the centre
	// column's deck top, a point sample that would snap by a texel as the deck
	// advects; nothing is written from it, since the silhouette comes out of the
	// accumulation as ATMO_SHADOW_TAU_ENTRY's crossing like the other three. So it
	// only has to be EARLY ENOUGH: backing off by a texel footprint covers
	// neighbouring columns standing higher than the centre, and starting in empty
	// air costs steps and changes nothing. Converted from a lateral distance by
	// the rate the ray descends, so it grows with obliquity -- which is where
	// columns inside one texel differ most.
    {
        const float3 EntryPos = Origin + Dir * TEntry;
        const float EntryRadius = max(length(EntryPos), 1e-4f);
        const float EntryRate = abs(dot(Dir, EntryPos / EntryRadius));

        TEntry = max(0.0f, TEntry - TexelWorld * ATMO_BAKE_ENTRY_BACKOFF / max(EntryRate, 0.1f));
    }

	// THE FOLD CONSTANT, per WORLD unit. What the field reports here is folded
	// into every stored depth so the thresholds mean transmittance on the fastest
	// channel the material can have, and the reader divides it back out.
	//
	// PITFALL: it has to carry the same thickness conversion the march applies on
	// its own side. Skipping the divide leaves every reconstructed optical depth
	// too large by a whole thickness in world units, and the field reads as opaque
	// everywhere -- which looks like a bad extinction value, not a units error.
    const float AbsMax = BakeField_FoldConstant(F);

	// The radial advance a step is allowed. The gradient is the only part of the
	// profile that varies, so it is what the budget is spent on.
    const float HeightStep = BakeField_HeightStep(F);

	// The outer lattice: fixed multiples of this from t = 0. Constant along the
	// ray, so a boundary is a property of the geometry alone and cannot move
	// when the field changes.
    const float CellSize = max(HeightStep, 1e-4f);

    float Tau = 0.0f;
    float LastSigma = 0.0f;

	// Negative until crossed. Named rather than an array: a dynamically indexed
	// local forces scratch memory for four values that unroll for free.
    float NodeEntry = -1.0f;
    float Node0 = -1.0f;
    float Node1 = -1.0f;
    float Node2 = -1.0f;

	// ANCHORED AT THE SHELL ENTRY, NOT AT THE DECK'S. Snapping the start to the
	// lattice means the sample positions do not slide when the cone trace flips
	// from one column's top to the next -- which it does discontinuously as the
	// deck advects, moving every crossing depth on that ray together.
    float T = floor(TEntry / CellSize) * CellSize;

	// Extinction at the march start. Each step samples only its FAR boundary and
	// inherits the near one, so the boundary scheme costs the same one evaluation
	// per step the midpoint scheme did, plus this seed. Its integration window
	// carries the same obliquity factor as the loop's -- the first step's length
	// is not known yet, so the cell stands in for it.
    const float3 SeedPos = Origin + Dir * T;
    const float SeedRate = abs(dot(Dir, SeedPos / max(length(SeedPos), 1e-4f)));

    float SigmaPrev = BakeField_Sigma(
		SeedPos, FootprintU, FootprintV, 1.0f,
		SeedRate * 0.5f * CellSize / F.Thickness, AbsMax, F);

    LOOP

    for (int Iter = 0; Iter < ATMO_BAKE_MAX_STEPS && T < RayLength; Iter++)
    {
        const float3 Pos = Origin + Dir * T;
        const float Radius = max(length(Pos), 1e-4f);

        const float RadialRate = abs(dot(Dir, Pos / Radius));
        const float LateralRate = sqrt(max(1.0f - RadialRate * RadialRate, 0.0f));

		// Progress toward each limit, per unit of path travelled.
        const float HeightCost = RadialRate / max(HeightStep, 1e-6f);

        const float LateralCost =
			LateralRate / max(BakeField_LateralArc(Radius) * 0.5f, 1e-6f);

        float Demand = rsqrt(max(HeightCost * HeightCost + LateralCost * LateralCost, 1e-12f));

		// The extinction the last step found, the only estimate available before
		// this one is taken. Self-correcting: a step overshooting into dense deck
		// shortens the next, so the error is bounded by one step rather than
		// carried.
        if (LastSigma > 0.0f)
        {
            const float Allowance = ATMO_BAKE_MAX_DTAU * (1.0f + ATMO_BAKE_DTAU_GROWTH * Tau);

            Demand = min(Demand, Allowance / LastSigma);
        }

		// DYADIC SUBDIVISION, NOT RESIZING. The demand halves the cell rather than
		// setting the step directly, so a density change splits a boundary instead
		// of shifting every boundary after it. Existing boundaries persisting is
		// what makes the quadrature converge frame to frame rather than dance:
		// crossings are interpolated inside a step, so a lattice that re-phases
		// moves the silhouette even when the deck has barely moved.
        float Step = CellSize;

        UNROLL

        for (int Halve = 0; Halve < ATMO_BAKE_MAX_HALVINGS; Halve++)
        {
            if (Step <= Demand)
            {
                break;
            }

            Step *= 0.5f;
        }

		// REALIGNED WHEN THE STEP GROWS. A coarsening step taken from inside a
		// finer cell lands off the coarse lattice and stays off it, which is the
		// drift the dyadic scheme exists to prevent. Cutting the step at the next
		// multiple of its own length restores alignment, and since the cell over
		// the step is a power of two, that also lands on every cell boundary.
        Step = min(Step, (floor(T / Step) + 1.0f) * Step - T);

		// Trims the final partial step at the ray's end.
        Step = min(Step, RayLength - T);

		// NO JITTER. A stochastic offset is what a per-pixel march needs to hide
		// its lattice under a blur; this lattice is in the map, shared by every
		// pixel reading it, so jitter prints as fixed noise -- grain that sits
		// still while the deck moves past.
        const float3 Far = Origin + Dir * (T + Step);

		// Half the step along the RADIUS, in atmosphere fractions, which is the
		// axis the profile varies on.
        const float StepHalfHeight = RadialRate * Step * 0.5f / F.Thickness;

        const float SigmaNext = BakeField_Sigma(
			Far, FootprintU, FootprintV, 1.0f, StepHalfHeight, AbsMax, F);

		// TRAPEZOID, NOT MIDPOINT. Sampling the boundaries makes sigma linear
		// across the step, which makes optical depth quadratic and the crossings
		// below solvable to second order. Same number of density evaluations.
        const float TauNext = Tau + 0.5f * (SigmaPrev + SigmaNext) * Step;

        if (NodeEntry < 0.0f && TauNext >= ATMO_SHADOW_TAU_ENTRY)
        {
            NodeEntry = T + Step * AtmoBake_Crossing(
				ATMO_SHADOW_TAU_ENTRY, Tau, SigmaPrev, SigmaNext, Step);
        }

        if (Node0 < 0.0f && TauNext >= ATMO_SHADOW_TAU0)
        {
            Node0 = T + Step * AtmoBake_Crossing(
				ATMO_SHADOW_TAU0, Tau, SigmaPrev, SigmaNext, Step);
        }

        if (Node1 < 0.0f && TauNext >= ATMO_SHADOW_TAU1)
        {
            Node1 = T + Step * AtmoBake_Crossing(
				ATMO_SHADOW_TAU1, Tau, SigmaPrev, SigmaNext, Step);
        }

        if (Node2 < 0.0f && TauNext >= ATMO_SHADOW_TAU2)
        {
            Node2 = T + Step * AtmoBake_Crossing(
				ATMO_SHADOW_TAU2, Tau, SigmaPrev, SigmaNext, Step);
        }

        Tau = TauNext;

		// The far boundary's extinction, which is exact at the next step's start
		// rather than an average over the last one.
        if (SigmaNext > 0.0f)
        {
            LastSigma = SigmaNext;
        }

        SigmaPrev = SigmaNext;

        T += Step;

        if (Node2 >= 0.0f)
        {
            break;
        }
    }

	// Thresholds the ray never reached, extrapolated at the last extinction seen
	// rather than flagged. The result lands past the shell exit and no view sample
	// lives there, being outside the cull radius where the march does not run the
	// deck path. A zero LastSigma sends it to the sentinel.
    const float TailRate = 1.0f / max(LastSigma, 1e-6f);

    if (NodeEntry < 0.0f)
    {
        NodeEntry = T + (ATMO_SHADOW_TAU_ENTRY - Tau) * TailRate;
    }
    if (Node0 < 0.0f)
    {
        Node0 = T + (ATMO_SHADOW_TAU0 - Tau) * TailRate;
    }
    if (Node1 < 0.0f)
    {
        Node1 = T + (ATMO_SHADOW_TAU1 - Tau) * TailRate;
    }
    if (Node2 < 0.0f)
    {
        Node2 = T + (ATMO_SHADOW_TAU2 - Tau) * TailRate;
    }

    float4 Out = min(float4(NodeEntry, Node0, Node1, Node2) / F.Thickness, ATMO_SHADOW_NO_DECK);

    Out = AtmoBake_History(Out, Level, Offset, RayLength / F.Thickness, HalfWidth, Extent0);

	// NO DEBUG REMAP HERE. The march reads this map, so a define rescaling what
	// is written rescales the lighting with it, and the symptom -- a fully
	// shadowed planet with a lit sliver at the terminator -- reads as a
	// reconstruction bug rather than a units mismatch. Scale in the visualisation
	// material instead.
    ShadowMapUAV[Texel] = Out;
}
