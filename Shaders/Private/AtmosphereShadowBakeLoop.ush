#pragma once

#include "/Plugin/CloudAtmosphere/Private/AtmosphereShadowBake.ush"

// The bake's march: one texel of one cascade, from the shell entry to the last
// threshold crossed. Ray setup, step lattice, optical-depth allowance and
// crossing accumulation belong to the map format; everything about the field
// comes through hooks. A model defines the hooks over its own uniforms BEFORE
// including this file; included too early, it fails with an undeclared-identifier
// error naming the missing hook.
//
//   BakeFieldParams                         the model's field struct; must expose
//                                           Thickness, the unit of every stored depth
//   BakeField_Params()                      built from its uniforms
//   BakeField_CullRadius(F)                 the shell the map covers
//   BakeField_CascadeExtent(F, Level)       half-width, 0 to collapse a level
//   BakeField_TopBound(F)                   highest the field reaches
//   BakeField_Entry(O, D, Len, Top, F)      where to start marching
//   BakeField_TerminusRadius(F)             where the light stops, <= 0 for none
//   BakeField_HeightStep(F)                 radial advance a step may take
//   BakeField_LateralArc(Radius)            finest lateral feature at a radius
//   BakeField_FoldConstant(F)               folded into every stored depth
//   BakeField_Sigma(...)                    extinction over the texel footprint,
//                                           given as two world vectors per texel

/** Most a budgeted step grows past the cell: 2^8 cells. */
#define ATMO_BAKE_MAX_DOUBLINGS 8

/** Bakes the four crossing depths of one texel of one cascade. */
void AtmoBake_Texel(uint3 DispatchThreadId)
{
    const int Level = int(DispatchThreadId.z) + ShadowFirstLevel;

    if (any(DispatchThreadId.xy >= uint2(ShadowMapSize))
		|| Level < 0 || Level >= ATMO_SHADOW_CASCADES)
    {
        return;
    }

	// One slice per cascade. Extent and centre derive from the same functions the
	// reconstruction calls, so the two cannot disagree about where a slice is.
    const uint3 Texel = uint3(DispatchThreadId.xy, uint(Level));

    BakeFieldParams F = BakeField_Params();

	// Unconditional bound: the map is shared by every pixel, so no camera's fades may narrow it.
    const float TopMax = BakeField_TopBound(F);

    const float CloudOuter = BakeField_CullRadius(F);

    float3 ShadowBasisU, ShadowBasisV;
    AtmoShadow_Basis(ShadowLightDir, ShadowBasisU, ShadowBasisV);

    const float ShadowExtent = BakeField_CascadeExtent(F, Level);
    const float Extent0 = BakeField_CascadeExtent(F, 0);

	// A collapsed level writes the sentinel, which the reader's walk skips.
    if (ShadowExtent <= 0.0f)
    {
        ShadowMapUAV[Texel] = ATMO_SHADOW_NO_DECK;
        return;
    }

    const float HalfWidth = AtmoShadow_CascadeHalfWidth(Level, ShadowExtent, Extent0);

    const float2 ShadowCentre = AtmoShadow_CascadeCentre(
		Level, ShadowCameraLocal, ShadowBasisU, ShadowBasisV,
		HalfWidth, Extent0, float2(ShadowMapSize));

	// Each cascade is a window of the warped disc, mapped to the plane by the same
	// functions the reader inverts. Texels are ellipses on the plane, so the footprint
	// is carried as the two vectors one texel moves along each map axis.
    const float2 Disc = ShadowCentre
		+ ((float2(Texel.xy) + 0.5f) * ShadowInvMapSize * 2.0f - 1.0f) * HalfWidth;

    const float2 Plane = AtmoShadow_DiscToPlane(Disc) * Extent0;

    float2 JacobianX, JacobianY;
    AtmoShadow_DiscJacobian(Disc, JacobianX, JacobianY);

	// The ray's closest approach to the planet centre.
    const float3 Offset = ShadowBasisU * Plane.x + ShadowBasisV * Plane.y;

    const float3 Dir = -ShadowLightDir;

	// Offset is perpendicular to Dir, so the shell crossing is a square root.
    const float PerpSq = dot(Offset, Offset);
    const float HalfChordSq = CloudOuter * CloudOuter - PerpSq;

    BRANCH

    if (HalfChordSq <= 0.0f)
    {
        ShadowMapUAV[Texel] = ATMO_SHADOW_NO_DECK;
        return;
    }

	// Distance from the shell entry along Dir is the stored depth, one for one.
    const float HalfChord = sqrt(HalfChordSq);

    const float3 Origin = Offset - Dir * HalfChord;

    float RayLength = 2.0f * HalfChord;

	// The chord ends at the terminus: no light reaches past it, and budgeting steps
	// over the planet interior would coarsen every step before it. Unreached
	// thresholds then go to the terminator plane (the chord's closest approach).
    float PlanetDepth = -1.0f;

    {
        const float Terminus = BakeField_TerminusRadius(F);
        const float TerminusSq = Terminus * Terminus - PerpSq;

        if (Terminus > 0.0f && TerminusSq > 0.0f)
        {
            RayLength = max(HalfChord - sqrt(TerminusSq), 0.0f);
            PlanetDepth = HalfChord;
        }
    }

    const float TexelScale = 2.0f * HalfWidth * Extent0 / float(max(ShadowMapSize.x, 1));

	// World vectors per texel along each map axis. Sigma offsets along them with a
	// unit TexelWorld, so the subsamples cover the warped texel.
    const float3 FootprintU = (ShadowBasisU * JacobianX.x + ShadowBasisV * JacobianX.y) * TexelScale;
    const float3 FootprintV = (ShadowBasisU * JacobianY.x + ShadowBasisV * JacobianY.y) * TexelScale;

	// The texel's longer axis, where a single length is wanted.
    const float TexelWorld = max(length(FootprintU), length(FootprintV));

    float TEntry = BakeField_Entry(Origin, Dir, RayLength, TopMax, F);

	// Where to start marching, never what to store: the silhouette comes from the
	// ATMO_SHADOW_TAU_ENTRY crossing, so the traced entry (a point sample that snaps
	// as the deck advects) only has to be early enough. Backing off a texel footprint
	// covers neighbouring columns standing higher; dividing by the descent rate grows
	// the back-off with obliquity, where columns inside a texel differ most.
    {
        const float3 EntryPos = Origin + Dir * TEntry;
        const float EntryRadius = max(length(EntryPos), 1e-4f);
        const float EntryRate = abs(dot(Dir, EntryPos / EntryRadius));

        TEntry = max(0.0f, TEntry - TexelWorld * ATMO_BAKE_ENTRY_BACKOFF / max(EntryRate, 0.1f));
    }

	// Fold constant, per world unit: folded into every stored depth so thresholds
	// mean transmittance on the material's fastest channel; the reader divides it out.
	// PITFALL: it must carry the same thickness conversion the march applies, or every
	// reconstructed optical depth is too large and the field reads opaque everywhere.
    const float AbsMax = BakeField_FoldConstant(F);

	// Radial advance a step may take; the budget is spent on the profile's gradient.
    const float HeightStep = BakeField_HeightStep(F);

	// Outer lattice: fixed multiples from t = 0, so boundaries depend on geometry alone.
    const float CellSize = max(HeightStep, 1e-4f);

    float Tau = 0.0f;
    float LastSigma = 0.0f;

	// Negative until crossed. Scalars, not an array, to avoid scratch memory.
    float NodeEntry = -1.0f;
    float Node0 = -1.0f;
    float Node1 = -1.0f;
    float Node2 = -1.0f;

	// Snapped to a lattice anchored at the shell entry, not the deck's, so sample
	// positions do not slide when the cone-traced entry jumps between columns.
    float T = floor(TEntry / CellSize) * CellSize;

	// Seed extinction at the march start: each step samples only its far boundary.
	// The seed's window carries the loop's obliquity factor, with the cell standing
	// in for the unknown first step length.
    const float3 SeedPos = Origin + Dir * T;
    const float SeedRate = abs(dot(Dir, SeedPos / max(length(SeedPos), 1e-4f)));

    float SigmaPrev = BakeField_Sigma(
		SeedPos, FootprintU, FootprintV, 1.0f,
		SeedRate * 0.5f * CellSize / F.Thickness, AbsMax, F);

    LOOP

    for (int Iter = 0; Iter < ATMO_BAKE_MAX_STEPS && T < RayLength; Iter++)
    {
        const float3 Pos = Origin + Dir * T;
        const float Radius = max(length(Pos), 1e-4f);

        const float RadialRate = abs(dot(Dir, Pos / Radius));
        const float LateralRate = sqrt(max(1.0f - RadialRate * RadialRate, 0.0f));

		// Progress toward each limit, per unit of path travelled.
        const float HeightCost = RadialRate / max(HeightStep, 1e-6f);

        const float LateralCost =
			LateralRate / max(BakeField_LateralArc(Radius) * 0.5f, 1e-6f);

        float Demand = rsqrt(max(HeightCost * HeightCost + LateralCost * LateralCost, 1e-12f));

		// The last step's extinction is the only estimate available; a step overshooting
		// into dense deck shortens the next, so the error is bounded to one step.
        if (LastSigma > 0.0f)
        {
            const float Allowance = ATMO_BAKE_MAX_DTAU * (1.0f + ATMO_BAKE_DTAU_GROWTH * Tau);

            Demand = min(Demand, Allowance / LastSigma);
        }

		// Dyadic subdivision: the demand halves the cell rather than sizing the step, so a
		// density change splits a boundary instead of shifting all later ones. A lattice
		// that re-phases moves the interpolated silhouette even when the deck barely moves.
        float Step = CellSize;

		// Step budget: the mean step the rest of the chord needs, grown to a power of two
		// of cells. It outranks the demand: a ray stopped by ATMO_BAKE_MAX_STEPS loses the
		// shadow behind it.
        const float Budget = (RayLength - T) / float(max(ATMO_BAKE_MAX_STEPS - Iter, 1));

        UNROLL

        for (int Grow = 0; Grow < ATMO_BAKE_MAX_DOUBLINGS; Grow++)
        {
            if (Step >= Budget)
            {
                break;
            }

            Step *= 2.0f;
        }

        UNROLL

        for (int Halve = 0; Halve < ATMO_BAKE_MAX_HALVINGS; Halve++)
        {
            if (Step <= Demand || 0.5f * Step < Budget)
            {
                break;
            }

            Step *= 0.5f;
        }

		// Cut at the next multiple of the step's own length, so a coarsening step taken
		// inside a finer cell lands back on the lattice and every cell boundary.
		// PITFALL: T / Step can round just below a multiple, making the cut zero and
		// spinning the loop to its cap; the small bias prevents it.
        Step = min(Step, (floor(T / Step + 1e-3f) + 1.0f) * Step - T);

		// Trims the final partial step at the ray's end.
        Step = min(Step, RayLength - T);

		// No jitter: the lattice is stored in a map shared by every pixel, so jitter
		// would print as fixed grain while the deck moves past.
        const float3 Far = Origin + Dir * (T + Step);

		// Half the step along the radius, in atmosphere fractions.
        const float StepHalfHeight = RadialRate * Step * 0.5f / F.Thickness;

        const float SigmaNext = BakeField_Sigma(
			Far, FootprintU, FootprintV, 1.0f, StepHalfHeight, AbsMax, F);

		// Trapezoid: boundary samples make sigma linear across the step, so tau is
		// quadratic and AtmoBake_Crossing solves to second order.
        const float TauNext = Tau + 0.5f * (SigmaPrev + SigmaNext) * Step;

        if (NodeEntry < 0.0f && TauNext >= ATMO_SHADOW_TAU_ENTRY)
        {
            NodeEntry = T + Step * AtmoBake_Crossing(
				ATMO_SHADOW_TAU_ENTRY, Tau, SigmaPrev, SigmaNext, Step);
        }

        if (Node0 < 0.0f && TauNext >= ATMO_SHADOW_TAU0)
        {
            Node0 = T + Step * AtmoBake_Crossing(
				ATMO_SHADOW_TAU0, Tau, SigmaPrev, SigmaNext, Step);
        }

        if (Node1 < 0.0f && TauNext >= ATMO_SHADOW_TAU1)
        {
            Node1 = T + Step * AtmoBake_Crossing(
				ATMO_SHADOW_TAU1, Tau, SigmaPrev, SigmaNext, Step);
        }

        if (Node2 < 0.0f && TauNext >= ATMO_SHADOW_TAU2)
        {
            Node2 = T + Step * AtmoBake_Crossing(
				ATMO_SHADOW_TAU2, Tau, SigmaPrev, SigmaNext, Step);
        }

        Tau = TauNext;

		// Far-boundary extinction, exact at the next step's start.
        if (SigmaNext > 0.0f)
        {
            LastSigma = SigmaNext;
        }

        SigmaPrev = SigmaNext;

        T += Step;

        if (Node2 >= 0.0f)
        {
            break;
        }
    }

	// Unreached thresholds: on the terminus they go to PlanetDepth; otherwise they
	// extrapolate at the last extinction from the chord exit, where no view sample
	// lives (the step budget keeps T there), or take the sentinel if no cloud was met.
    float TailBase = T;
    float TailRate = 1.0f / max(LastSigma, 1e-6f);

    if (PlanetDepth >= 0.0f && T >= RayLength)
    {
        TailBase = PlanetDepth;
        TailRate = 0.0f;
    }
    else if (LastSigma <= 0.0f)
    {
        TailBase = ATMO_SHADOW_NO_DECK * F.Thickness;
        TailRate = 0.0f;
    }

    if (NodeEntry < 0.0f)
    {
        NodeEntry = TailBase + max(ATMO_SHADOW_TAU_ENTRY - Tau, 0.0f) * TailRate;
    }
    if (Node0 < 0.0f)
    {
        Node0 = TailBase + max(ATMO_SHADOW_TAU0 - Tau, 0.0f) * TailRate;
    }
    if (Node1 < 0.0f)
    {
        Node1 = TailBase + max(ATMO_SHADOW_TAU1 - Tau, 0.0f) * TailRate;
    }
    if (Node2 < 0.0f)
    {
        Node2 = TailBase + max(ATMO_SHADOW_TAU2 - Tau, 0.0f) * TailRate;
    }

    float4 Out = min(float4(NodeEntry, Node0, Node1, Node2) / F.Thickness, ATMO_SHADOW_NO_DECK);

	// History blends only nodes inside the chord, PlanetDepth included.
    Out = AtmoBake_History(Out, Level, Offset, max(RayLength, PlanetDepth) / F.Thickness,
		HalfWidth, Extent0);

	// PITFALL: no debug remap here. The march reads this map, so rescaling what is
	// written rescales the lighting (a shadowed planet with a lit terminator sliver)
	// and looks like a reconstruction bug. Scale where the map is visualised.
    ShadowMapUAV[Texel] = Out;
}
